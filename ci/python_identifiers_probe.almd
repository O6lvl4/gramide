import self.packages.python.identifiers
import env
import fs
import json

fn scan(t: identifiers.Tables, v: Value) -> Value = {
  let source = json.get_string(v, "source") ?? ""
  match identifiers.scan(t, bytes.from_string(source), json.get_int(v, "start") ?? 0, 1, 1) {
    ok(end) => value.object([("ok", value.bool(true)), ("end", value.int(end))]),
    err(_) => value.object([("ok", value.bool(false))]),
  }
}
effect fn main() -> Unit = {
  let input = json.parse(fs.read_text(list.first(env.args())!)!)!
  let t = identifiers.prepare()
  let points = list.map(json.get_array(input, "points") ?? [], (v) => value.as_int(v) ?? -1)
  let classes = identifiers.classes(t, points)
  println(json.stringify(value.object([
    ("classes", value.array(list.map(classes, (p) => value.array([value.bool(p.0), value.bool(p.1)])))),
    ("scans", value.array(list.map(json.get_array(input, "scans") ?? [], (s) => scan(t, s))))
  ])))
}
