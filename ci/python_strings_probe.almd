import self.packages.python.strings
import env
import fs
import json

fn check(v: Value) -> Value = {
  let source = json.get_string(v, "source") ?? ""
  match strings.scan(bytes.from_string(source), json.get_int(v, "start") ?? 0, 1, 1) {
    ok(end) => value.object([("ok", value.bool(true)), ("end", value.int(end))]),
    err(e) => value.object([("ok", value.bool(false)), ("message", value.str(e.message))]),
  }
}
effect fn main() -> Unit = {
  let path = list.first(env.args())!
  let input = json.parse(fs.read_text(path)!)!
  println(json.stringify(value.array(list.map(json.get_array(input, "cases") ?? [], (c) => check(c)))))
}
