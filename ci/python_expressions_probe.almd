import self.names as nametable
import self.packages.python.expressions
import self.packages.python.lexer
import self.parser
import self.tree
import env
import fs
import json

// Send token indices; carrying the complete token list per node copies it.
fn node_value(n: tree.Node, names: nametable.Names) -> Value = value.object([
  ("kind", value.str(nametable.name_at(names, n.kind))),
  ("start", value.int(n.start)),
  ("kids", value.array(list.map(n.kids, (k) => node_value(k, names))))
])
fn check(source: String, grammar: parser.Compiled) -> Value = match lexer.scan_source(source) {
  err(_) => value.object([("ok", value.bool(false))]),
  ok(tokens) => match expressions.parse_with(grammar, bytes.from_string(source), tokens) {
    err(f) => value.object([("ok", value.bool(false)), ("message", value.str(parser.format_failure(f)))]),
    ok(parsed) => value.object([("ok", value.bool(true)), ("tree", node_value(parsed.root, parsed.names)), ("tokens", value.array(list.map(parsed.toks, (t) => value.str(tree.token_text(bytes.from_string(source), t)))))]),
  },
}
effect fn main() -> Unit = {
  let input = json.parse(fs.read_text(list.first(env.args())!)!)!
  let grammar = parser.compile(expressions.expression_grammar())
  println(json.stringify(value.array(list.map(json.get_array(input, "cases") ?? [], (v) => check(value.as_string(v) ?? "", grammar)))))
}
