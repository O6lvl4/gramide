// Test-only adapter: production layout code consumes tokens, never Python JSON.
import self.packages.python.lexer
import self.tree
import env
import fs
import json

fn row(t: tree.Token) -> Value = value.object([
  ("kind", value.str(t.kind)), ("text", value.str(t.text)),
  ("start", value.int(t.start)), ("end", value.int(t.end)),
  ("line", value.int(t.line)), ("col", value.int(t.col))
])
fn check(v: Value) -> Value = {
  let source = json.get_string(v, "source") ?? ""
  match lexer.scan_source(source) {
    ok(ts) => value.object([("ok", value.bool(true)), ("tokens", value.array(list.map(ts, (t) => row(t))))]),
    err(e) => value.object([("ok", value.bool(false)), ("line", value.int(e.line)), ("message", value.str(e.message))]),
  }
}
effect fn main() -> Unit = {
  let path = list.first(env.args())!
  let input = json.parse(fs.read_text(path)!)!
  println(json.stringify(value.array(list.map(json.get_array(input, "cases") ?? [], (c) => check(c)))))
}
