// registry — the language packages a binary was built with, as a list.
//
// The core knows no language. A binary composes the packages it ships
// (gramide ships every one; a package's own cli/main.almd ships itself) and
// hands the list to every entry point that needs one. Resolution is by file
// extension, and a composition that registers an id or an extension twice is
// refused by name rather than answered by registration order.
import json
import self.package_api

fn resolve_in(packages: List[package_api.Definition], path: String) -> Result[package_api.Definition, String] = {
  let matches = list.filter(packages, (d) => list.any(d.extensions, (ext) => string.ends_with(path, ext)))
  if list.len(matches) > 1 then err(path + ": ambiguous language packages")
  else list.first(matches) |> option.to_result(path + ": no registered grammar for this extension")
}
fn known(packages: List[package_api.Definition], path: String) -> Bool = result.is_ok(resolve_in(packages, path))

fn supports(packages: List[package_api.Definition], path: String, capability: String) -> Bool = match resolve_in(packages, path) {
  ok(d) => list.contains(d.capabilities, capability), err(_) => false,
}

// What `languages` prints. Consumers check the capability they need — hew
// wants `symbols`, a write gate wants `check` — and the schema version.
fn manifest(packages: List[package_api.Definition]) -> String = json.stringify(value.object([
  ("schema_version", value.int(1)),
  ("packages", value.array(list.map(packages, (d) => value.object([
    ("id", value.str(d.id)), ("name", value.str(d.package_name)), ("version", value.str(d.version)),
    ("extensions", value.array(list.map(d.extensions, (e) => value.str(e)))),
    ("capabilities", value.array(list.map(d.capabilities, (c) => value.str(c)))),
  ]))))
]))

// The first thing two packages disagree about, or nothing.
fn conflict(packages: List[package_api.Definition]) -> Option[String] = {
  var found: Option[String] = none
  var ids: List[String] = []
  var exts: List[String] = []
  for d in packages {
    if option.is_none(found) and list.contains(ids, d.id) then found = some("two language packages register the id " + d.id) else ()
    list.push(ids, d.id)
    for ext in d.extensions {
      if option.is_none(found) and list.contains(exts, ext) then found = some("two language packages register the extension " + ext) else ()
      list.push(exts, ext)
    }
  }
  found
}
