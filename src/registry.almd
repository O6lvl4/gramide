// The composition root is the only production place that imports language packages.
import self.packages.gramide_python as lang_python
import json
import self.package_api
import self.packages.gramide_almide as lang_almide
import self.packages.gramide_go as lang_go
import self.packages.gramide_rust as lang_rust

fn packages() -> List[package_api.Definition] = [lang_almide.definition(), lang_go.definition(), lang_rust.definition(), lang_python.definition()]

fn resolve_in(definitions: List[package_api.Definition], path: String) -> Result[package_api.Definition, String] = {
  let matches = list.filter(definitions, (d) => list.any(d.extensions, (ext) => string.ends_with(path, ext)))
  if list.len(matches) > 1 then err(path + ": ambiguous language packages")
  else list.first(matches) |> option.to_result(path + ": no registered grammar for this extension")
}
fn resolve(path: String) -> Result[package_api.Definition, String] = resolve_in(packages(), path)
fn known(path: String) -> Bool = result.is_ok(resolve(path))

fn manifest() -> String = json.stringify(value.object([
  ("schema_version", value.int(1)),
  ("packages", value.array(list.map(packages(), (d) => value.object([
    ("id", value.str(d.id)), ("name", value.str(d.package_name)), ("version", value.str(d.version)),
    ("extensions", value.array(list.map(d.extensions, (e) => value.str(e)))),
    ("capabilities", value.array(list.map(d.capabilities, (c) => value.str(c))))
  ]))))
]))

fn supports(path: String, capability: String) -> Bool = match resolve(path) {
  ok(d) => list.contains(d.capabilities, capability), err(_) => false,
}
