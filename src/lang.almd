// lang — which language a path is in.
//
// A language is a `Language`: a lexer spec (lex.almd) and a compiled grammar
// (parser.almd). Neither is code specific to this module.
//
// ── adding a language ─────────────────────────────────────────────────────
//
// 1. `src/lang_<name>.almd`, exporting `spec() -> lex.Spec` and a grammar. If
//    the lexer spec cannot say how its numbers or its strings are written, add
//    a family to lex.almd rather than a special case here.
// 2. Its extension in EXTENSIONS below.
// 3. A `<name>_lang()` beside the others, and a field for it in `Engines` and
//    `engines_for`.
// 4. A branch in each of the four functions marked `per language` below. They
//    are written out rather than looked up in a list because reading an element
//    out of a list copies it, and a compiled grammar is the largest value in
//    the program. Every other function takes a `Language` a caller already
//    holds, so the extension is consulted only in those four.
// 5. Validate against a corpus of real files in that language: the count that
//    parse, and that everything rejected is rejected by the language's own
//    compiler too. A grammar that has not met a corpus is a guess.

import self.tree
import self.lex
import self.parser
import self.lang_almide
import self.lang_go

let EXTENSIONS = [".almd", ".go"]

fn known(path: String) -> Bool = list.any(EXTENSIONS, (e) => string.ends_with(path, e))

fn lex_error(path: String, e: lex.LexError) -> String =
  path + ":" + int.to_string(e.line) + ":" + int.to_string(e.col) + ": " + e.message

fn unknown_ext(path: String) -> String =
  path + ": no grammar for this extension (known: " + list.join(EXTENSIONS, ", ") + ")"

// ── a language ────────────────────────────────────────────────────────────

type Language = { lex: lex.Spec, grammar: parser.Compiled }

fn almide_lang() -> Language = Language { lex: lang_almide.spec(), grammar: parser.compile(lang_almide.almide()) }
fn go_lang() -> Language = Language { lex: lang_go.spec(), grammar: parser.compile(lang_go.go()) }

// per language
fn language_of(path: String) -> Result[Language, String] =
  if string.ends_with(path, ".go") then ok(go_lang())
  else if string.ends_with(path, ".almd") then ok(almide_lang())
  else err(unknown_ext(path))

// Lexing alone needs no grammar, and compiling one takes about half a
// millisecond, so `tokens` does not pay for one.
// per language
fn spec_of(path: String) -> Result[lex.Spec, String] =
  if string.ends_with(path, ".go") then ok(lang_go.spec())
  else if string.ends_with(path, ".almd") then ok(lang_almide.spec())
  else err(unknown_ext(path))

fn tokens_for(path: String, src: String) -> Result[List[tree.Token], String] =
  lex.tokenize(src, spec_of(path)!) |> result.map_err((e) => lex_error(path, e))

// ── every language this build knows ───────────────────────────────────────
//
// Compiling is per grammar, not per file, so a tool that reads a whole tree
// builds this once and hands the same `Language` to every file in it.

type Engines = { almd: Language, go: Language }

fn engines() -> Engines = Engines { almd: almide_lang(), go: go_lang() }

// A grammar with no rules, so a language none of the files are written in
// costs nothing to have a field for.
fn no_grammar() -> parser.Grammar = parser.Grammar { start: "", rules: [:] }

fn engines_for(paths: List[String]) -> Engines = Engines {
  almd: if list.any(paths, (p) => string.ends_with(p, ".almd")) then almide_lang()
        else Language { lex: lang_almide.spec(), grammar: parser.compile(no_grammar()) },
  go: if list.any(paths, (p) => string.ends_with(p, ".go")) then go_lang()
      else Language { lex: lang_go.spec(), grammar: parser.compile(no_grammar()) },
}

// ── reading a file ────────────────────────────────────────────────────────

// What a reader gets back. `error` is set when the file did not parse and the
// tree is the recovered one: the parts the grammar could still read, with an
// ERROR node over each part it gave up. `check` never uses this; it wants the
// strict answer and nothing else.
type Reading = { parsed: parser.Parsed, error: Option[String], errors: Int }

fn recovered(c: parser.Compiled, toks: List[tree.Token], msg: String) -> Result[Reading, String] =
  match parser.parse_recovering(c, toks) {
    ok(p) => ok(Reading { parsed: p, error: some(msg), errors: parser.error_nodes(p.root) }),
    err(_) => err(msg),
  }

fn read_lang(l: Language, path: String, src: String) -> Result[Reading, String] =
  match lex.tokenize(src, l.lex) {
    // it lexes; the parser decides whether it also parses
    ok(toks) => match parser.parse_with(l.grammar, toks) {
      ok(p) => ok(Reading { parsed: p, error: none, errors: 0 }),
      err(f) => recovered(l.grammar, toks, path + ":" + parser.format_failure(f)),
    },
    // it does not even lex, which is the ordinary state of a half-typed
    // string: lex again turning what it cannot read into `error` tokens
    err(e) => recovered(l.grammar, lex.tokenize_recovering(src, l.lex), lex_error(path, e)),
  }

fn parse_lang(l: Language, path: String, src: String) -> Result[parser.Parsed, String] = {
  let toks = lex.tokenize(src, l.lex) |> result.map_err((e) => lex_error(path, e))!
  parser.parse_with(l.grammar, toks) |> result.map_err((f) => path + ":" + parser.format_failure(f))
}

// One file, compiling its grammar for this call alone.
fn read_source(path: String, src: String) -> Result[Reading, String] = read_lang(language_of(path)!, path, src)
fn parse_source(path: String, src: String) -> Result[parser.Parsed, String] = parse_lang(language_of(path)!, path, src)

// Many files, against grammars compiled once.
// per language
fn read_with(e: Engines, path: String, src: String) -> Result[Reading, String] =
  if string.ends_with(path, ".go") then read_lang(e.go, path, src)
  else if string.ends_with(path, ".almd") then read_lang(e.almd, path, src)
  else err(unknown_ext(path))

// per language
fn parse_with(e: Engines, path: String, src: String) -> Result[parser.Parsed, String] =
  if string.ends_with(path, ".go") then parse_lang(e.go, path, src)
  else if string.ends_with(path, ".almd") then parse_lang(e.almd, path, src)
  else err(unknown_ext(path))
