// lang — the language-neutral host.
//
// Every entry point that starts from a path takes the list of language
// packages the binary was built with (registry.almd); nothing here knows a
// language by name. Engines compile only the packages a batch of files needs,
// and a reader that holds Engines needs nothing else.

import self.tree
import self.lex
import self.parser
import self.package_api
import self.registry

fn known(packages: List[package_api.Definition], path: String) -> Bool = registry.known(packages, path)
fn supports(packages: List[package_api.Definition], path: String, capability: String) -> Bool = registry.supports(packages, path, capability)
fn unknown_ext(path: String) -> String = path + ": no registered grammar for this extension"
fn lex_error(path: String, e: lex.LexError) -> String = path + ":" + int.to_string(e.line) + ":" + int.to_string(e.col) + ": " + e.message

type Language = { definition: package_api.Definition, tokenize: package_api.Tokenizer, grammar: parser.Compiled, sep: String }
type Engines = { loaded: List[Language] }

// Both thunks run once here, per loaded language: the lexer prepares its
// tables, and the grammar is read from the package's compiled table (or,
// for a package that ships only rules, compiled from them).
fn compile(d: package_api.Definition) -> Language = {
  let make_lexer = d.lexer
  let make_grammar = d.grammar
  Language { definition: d, tokenize: make_lexer(), grammar: make_grammar(), sep: d.sep }
}
fn language_of(packages: List[package_api.Definition], path: String) -> Result[Language, String] = ok(compile(registry.resolve_in(packages, path)!))
fn tokens_for(packages: List[package_api.Definition], path: String, src: String) -> Result[List[tree.Token], String] = {
  let d = registry.resolve_in(packages, path)!
  let prepare = d.lexer
  let scan = prepare()
  scan(src, false) |> result.map_err((e) => lex_error(path, e))
}
fn loaded_from(ds: List[package_api.Definition]) -> List[Language] = {
  var out: List[Language] = list.with_capacity(list.len(ds))
  for d in ds { list.push(out, compile(d)) }
  out
}
fn engines(packages: List[package_api.Definition]) -> Engines = Engines { loaded: loaded_from(packages) }
// Only the packages some path in the batch needs: `check src/*.go` compiles
// the Go grammar and no other.
fn engines_for(packages: List[package_api.Definition], paths: List[String]) -> Engines = Engines {
  loaded: loaded_from(list.filter(packages, (d) => list.any(paths, (path) => list.any(d.extensions, (ext) => string.ends_with(path, ext)))))
}
fn loaded_for(e: Engines, path: String) -> Result[Language, String] = {
  let found = list.filter(e.loaded, (l) => list.any(l.definition.extensions, (ext) => string.ends_with(path, ext)))
  guard list.len(found) <= 1 else err(path + ": ambiguous language packages")
  list.first(found) |> option.to_result(unknown_ext(path))
}
fn supports_in(e: Engines, path: String, capability: String) -> Bool = match loaded_for(e, path) {
  ok(l) => list.contains(l.definition.capabilities, capability), err(_) => false,
}
fn tokenize(l: Language, src: String, recover: Bool) -> Result[List[tree.Token], lex.LexError] = {
  let scan = l.tokenize
  scan(src, recover)
}

// ── reading a file ────────────────────────────────────────────────────────

// What a reader gets back. `error` is set when the file did not parse and the
// tree is the recovered one: the parts the grammar could still read, with an
// ERROR node over each part it gave up. `check` never uses this; it wants the
// strict answer and nothing else.
// It carries `sep` so a reader that has a Reading needs nothing else to name a
// method with its type. `gaps` are the brackets a file that does not balance
// left unpaired (token indices): recovery closed each where indentation says
// it ends, which no ERROR node marks, and a reader that trusts only what no
// recovery touched must not trust what holds them.
type Reading = { parsed: parser.Parsed, error: Option[String], errors: Int, sep: String, language: String, symbols: package_api.SymbolRules, gaps: List[Int] }

fn recovered(c: parser.Compiled, source: Bytes, toks: List[tree.Token], msg: String, l: Language) -> Result[Reading, String] =
  match parser.parse_recovering(c, source, toks) {
    ok(p) => ok(Reading { parsed: p, error: some(msg), errors: parser.error_nodes(p.root, parser.error_kind(c)), sep: l.sep, language: l.definition.id, symbols: l.definition.symbols, gaps: [] }),
    err(_) => err(msg),
  }

// What a parser read comes to: the strict tree, or the recovered one with
// why the strict read failed, or that failure alone. The read is taken apart
// where it is owned: matching a field of a borrowed one copies the tree.
fn failure_message(failure: Option[parser.Failure], path: String) -> Option[String] = match failure {
  some(f) => some(path + ":" + parser.format_failure(f)),
  none => none,
}
// The ERROR nodes are counted before the tree goes into the record: read
// after it moved, the tree would be copied to count them
fn reading(p: parser.Parsed, msg: Option[String], l: Language, gaps: List[Int]) -> Reading = {
  let errors = if msg == none then 0 else parser.error_nodes(p.root, parser.error_kind(l.grammar))
  Reading { parsed: p, error: msg, errors: errors, sep: l.sep, language: l.definition.id, symbols: l.definition.symbols, gaps: gaps }
}

fn read_lang(l: Language, path: String, src: String) -> Result[Reading, String] = {
  // The tokens are ranges into this; every reader that wants a name reads it.
  let source = bytes.from_string(src)
  match tokenize(l, src, false) {
    // it lexes; the parser decides whether it also parses
    ok(toks) => match parser.read(l.grammar, source, toks) {
      ok((p, failure, gaps)) => ok(reading(p, failure_message(failure, path), l, gaps)),
      err(f) => err(path + ":" + parser.format_failure(f)),
    },
    // it does not even lex, which is the ordinary state of a half-typed
    // string: lex again turning what it cannot read into `error` tokens
    err(e) => {
      let toks = tokenize(l, src, true) |> result.map_err((failure) => lex_error(path, failure))!
      recovered(l.grammar, source, toks, lex_error(path, e), l)
    },
  }
}

fn parse_lang(l: Language, path: String, src: String) -> Result[parser.Parsed, String] = {
  let toks = tokenize(l, src, false) |> result.map_err((e) => lex_error(path, e))!
  parser.parse_with(l.grammar, bytes.from_string(src), toks) |> result.map_err((f) => path + ":" + parser.format_failure(f))
}

// The gate's own path: the verdict and nothing else, so the engine builds no
// tree. `check` is what an agent runs on every write, and it never looks at
// one.
fn verify_lang(l: Language, path: String, src: String) -> Result[Unit, String] = {
  guard list.contains(l.definition.capabilities, "check") else err(path + ": language package does not provide check")
  let toks = tokenize(l, src, false) |> result.map_err((e) => lex_error(path, e))!
  parser.verify(l.grammar, bytes.from_string(src), toks) |> result.map_err((f) => path + ":" + parser.format_failure(f))
}

// One file, compiling its grammar for this call alone.
fn read_source(packages: List[package_api.Definition], path: String, src: String) -> Result[Reading, String] = read_lang(language_of(packages, path)!, path, src)
fn parse_source(packages: List[package_api.Definition], path: String, src: String) -> Result[parser.Parsed, String] = parse_lang(language_of(packages, path)!, path, src)
fn verify_source(packages: List[package_api.Definition], path: String, src: String) -> Result[Unit, String] = verify_lang(language_of(packages, path)!, path, src)

// The same through engines a batch already compiled.
fn read_with(e: Engines, path: String, src: String) -> Result[Reading, String] = read_lang(loaded_for(e, path)!, path, src)
fn parse_with(e: Engines, path: String, src: String) -> Result[parser.Parsed, String] = parse_lang(loaded_for(e, path)!, path, src)
fn verify_with(e: Engines, path: String, src: String) -> Result[Unit, String] = verify_lang(loaded_for(e, path)!, path, src)
