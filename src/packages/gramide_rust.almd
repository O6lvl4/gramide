// lang_rust — Rust, as a lexer spec and a grammar value.
//
// Two things about Rust need a family of their own in lex.almd. A lifetime is
// written with the same quote as a character, so `'a` and `'a'` are told apart
// only by what closes them; and a raw string can carry any number of hashes,
// so `r##"…"##` ends only at a quote followed by two of them.
//
// Newlines mean nothing here, so the lexer emits none and the grammar never
// mentions them. Statements end at `;` or at a block.
//
// The one context-dependent place is the struct literal, exactly as in Go:
// `if x == T { }` must not read `T { }` as a value. The expression rules are
// generated twice from one function, once allowing a struct literal and once
// (suffix `_nc`) not, and the headers of `if`, `while`, `for` and `match` use
// the second.

import self.package_api
import self.parser
import self.lex
import self.parser.{ tok, lit, keep, r, seq, alt, rep, rep1, opt, wrap, field, ahead, nott, leftf, lits, keeps, any, grammar, recover, recover_all_keeping }

// ── how Rust is lexed ─────────────────────────────────────────────────────

let KEYWORDS = ["as", "async", "await", "break", "const", "continue", "crate", "dyn", "else", "enum",
  "extern", "false", "fn", "for", "if", "impl", "in", "let", "loop", "match", "mod", "move", "mut",
  "pub", "ref", "return", "self", "Self", "static", "struct", "super", "trait", "true", "type",
  "unsafe", "use", "where", "while", "macro_rules"]

// `>>` is deliberately absent: it would close only one of the two brackets in
// `Vec<Vec<T>>`, and a generic close is far more common in Rust than a shift.
// The grammar spells a right shift as two `>` instead, and `>>=` as `>` `>=`.
let OPERATORS = ["<<=", "...", "..=", "::", "->", "=>", "==", "!=", "<=", ">=", "&&", "||",
  "+=", "-=", "*=", "/=", "%=", "^=", "&=", "|=", "<<", "..",
  "+", "-", "*", "/", "%", "^", "!", "&", "|", "<", ">", "=", "@", ".", ",", ";", ":", "#", "$", "?",
  "(", ")", "[", "]", "{", "}", "'"]

fn spec() -> lex.Spec = lex.Spec {
  keywords: KEYWORDS,
  operators: OPERATORS,
  numbers: lex.N_RUST,
  strings: lex.S_RUST,
  newlines: lex.NL_NONE,
  ends_kw: [],
  line_comment: [47, 47],                 // //
  block_open: [47, 42],                   // /*
  block_close: [42, 47],                  // */
  nested_block: true,
  block_comment_newline: false,
  upper_is_type: false,
  backtick_ident: false,
  neg_token: false,
}

// ── the grammar ───────────────────────────────────────────────────────────

let ident = tok("identifier")
let lifetime = seq([lit("'"), alt([ident, lit("static"), lit("_")])])
let literal = alt([tok("integer"), tok("float"), tok("string"), tok("rune"), lits(["true", "false"])])

fn items(x: parser.Rule) -> parser.Rule = opt(seq([x, rep(seq([lit(","), x])), opt(lit(","))]))

// A run of tokens the grammar has no reading of, balanced across brackets:
// what a macro is invoked with, and what an attribute contains.
fn tt_rules() -> List[(String, parser.Rule)] = [
  ("tt", alt([
     seq([lit("("), rep(r("tt")), lit(")")]),
     seq([lit("["), rep(r("tt")), lit("]")]),
     seq([lit("{"), rep(r("tt")), lit("}")]),
     seq([nott(lits([")", "]", "}"])), any()])])),
  ("tt_group", alt([
     seq([lit("("), rep(r("tt")), lit(")")]),
     seq([lit("["), rep(r("tt")), lit("]")]),
     seq([lit("{"), rep(r("tt")), lit("}")])])),
]

// Expressions, generated for a suffix: `_nc` is the copy that may not end in a
// struct literal, so `if x == T {}` reads the block as the body.
fn expr_rules(sfx: String, structs: Bool) -> List[(String, parser.Rule)] = {
  let e = r("expr" + sfx)
  // inside brackets nothing is ambiguous, so the unrestricted expression is
  // used there even in the `_nc` copy
  let inner = r("expr")
  let operand = alt([
    wrap("closure", seq([opt(lit("move")), alt([lit("||"), seq([lit("|"), items(r("closure_param")), lit("|")])]),
       alt([seq([lit("->"), r("type"), r("block")]), e])])),
    r("block_expr"),
    wrap("group", seq([lit("("), items(inner), lit(")")])),
    wrap("array", seq([lit("["), opt(alt([seq([inner, lit(";"), inner]), items(inner)])), lit("]")])),
    wrap("break", seq([lit("break"), opt(lifetime), opt(e)])),
    wrap("continue", seq([lit("continue"), opt(lifetime)])),
    wrap("return", seq([lit("return"), opt(e)])),
    literal,
    wrap("path_expr", seq([lit("<"), r("type"), opt(seq([lit("as"), r("type")])), lit(">"),
       rep(seq([lit("::"), r("expr_segment")]))])),
    wrap("path_expr", seq([field("name", r("expr_path")), opt(alt([
       // a macro: the path, `!`, and a run of tokens with no reading
       seq([lit("!"), r("tt_group")]),
       // `Path { field: value }`, only where a struct literal is allowed
       if structs then seq([lit("{"),
          items(alt([seq([field("field", ident), lit(":"), inner]), seq([lit(".."), inner]), ident])), lit("}")])
       else nott(any())]))]))])
  let postfix = [
    wrap("arguments", seq([lit("("), items(inner), lit(")")])),
    wrap("index", seq([lit("["), inner, lit("]")])),
    wrap("try", lit("?")),
    wrap("await", seq([lit("."), lit("await")])),
    wrap("method_call", seq([lit("."), field("field", ident), opt(seq([lit("::"), r("generic_args")])),
       wrap("arguments", seq([lit("("), items(inner), lit(")")]))])),
    wrap("field_access", seq([lit("."), field("field", alt([ident, tok("integer")]))])),
  ]
  [
    // Both of these parse their operand once and then look at what follows.
    // Written as alternatives that each begin with the operand, an expression
    // would be read twice here and twice again at every level it nests.
    ("expr" + sfx, seq([r("range" + sfx),
       opt(seq([alt([lits(["=", "+=", "-=", "*=", "/=", "%=", "&=", "|=", "^=", "<<="]), seq([lit(">"), lit(">=")])]), e]))])),
    ("range" + sfx, alt([
       seq([lits(["..=", ".."]), opt(r("or" + sfx))]),
       seq([r("or" + sfx), opt(seq([lits(["..=", ".."]), opt(r("or" + sfx))]))])])),
    ("or" + sfx, leftf("binary", r("and" + sfx), keep("||"))),
    ("and" + sfx, leftf("binary", r("cmp" + sfx), keep("&&"))),
    ("cmp" + sfx, leftf("binary", r("bitor" + sfx), keeps(["==", "!=", "<=", ">=", "<", ">"]))),
    ("bitor" + sfx, leftf("binary", r("bitxor" + sfx), keep("|"))),
    ("bitxor" + sfx, leftf("binary", r("bitand" + sfx), keep("^"))),
    ("bitand" + sfx, leftf("binary", r("shift" + sfx), keep("&"))),
    ("shift" + sfx, leftf("binary", r("sum" + sfx), alt([keep("<<"), seq([keep(">"), lit(">")])]))),
    ("sum" + sfx, leftf("binary", r("product" + sfx), keeps(["+", "-"]))),
    ("product" + sfx, leftf("binary", r("cast" + sfx), keeps(["*", "/", "%"]))),
    ("cast" + sfx, seq([r("unary" + sfx), rep(seq([lit("as"), r("type")]))])),
    ("unary" + sfx, alt([
       wrap("unary", seq([field("operator", keeps(["-", "!", "*"])), r("unary" + sfx)])),
       wrap("reference", seq([lits(["&&", "&"]), opt(lifetime), opt(lit("mut")), r("unary" + sfx)])),
       r("postfix" + sfx)])),
    ("postfix" + sfx, seq([operand, rep(alt(postfix))])),
  ]
}

fn rust() -> parser.Grammar = grammar("source_file", tt_rules() + expr_rules("", true) + expr_rules("_nc", false) + [
  ("source_file", wrap("source_file", seq([rep(r("inner_attr")), rep(recover_all_keeping(r("item"), r("decl_head")))]))),

  // `#![…]` at the top of a file or module, `#[…]` on the item below it
  ("inner_attr", seq([lit("#"), lit("!"), lit("["), rep(r("tt")), lit("]")])),
  ("attr", seq([lit("#"), lit("["), rep(r("tt")), lit("]")])),
  ("visibility", opt(seq([lit("pub"), opt(seq([lit("("), alt([lit("crate"), lit("super"), lit("self"), seq([lit("in"), r("path")])]), lit(")")]))]))),

  ("item", wrap("item_envelope", seq([rep(r("attr")), r("visibility"), r("item_kind")]))),
  ("item_kind", alt([
     r("use_decl"), r("mod_decl"), r("fn_decl"), r("struct_decl"), r("enum_decl"), r("union_decl"),
     r("trait_decl"), r("impl_decl"), r("type_alias"), r("const_decl"), r("extern_block"),
     r("extern_crate"), r("macro_def"), r("macro_item")])),

  // what is still worth knowing about an item whose body is half-typed
  ("decl_head", seq([rep(r("attr")), r("visibility"), alt([
     wrap("function_declaration", seq([rep(lits(["const", "async", "unsafe", "extern"])), lit("fn"), field("name", ident)])),
     wrap("type_declaration", seq([lits(["struct", "enum", "union"]), wrap("type_spec", field("name", ident))])),
     wrap("type_declaration", seq([lit("trait"), wrap("type_spec", field("name", ident))])),
     wrap("type_declaration", seq([lit("type"), wrap("type_spec", field("name", ident))])),
     wrap("let_declaration", seq([lits(["const", "static"]), opt(lit("mut")), field("name", ident)]))])])),

  ("use_decl", wrap("use", seq([lit("use"), r("use_tree"), lit(";")]))),
  ("extern_crate", wrap("use", seq([lit("extern"), lit("crate"), field("name", ident),
     opt(seq([lit("as"), ident])), lit(";")]))),
  ("use_tree", alt([
     seq([opt(r("use_path")), lit("*")]),
     seq([opt(r("use_path")), lit("{"), items(r("use_tree")), lit("}")]),
     seq([r("path"), opt(seq([lit("as"), alt([ident, lit("_")])]))])])),
  ("use_path", seq([opt(lit("::")), rep(seq([alt([ident, lit("crate"), lit("self"), lit("super")]), lit("::")]))])),

  ("mod_decl", wrap("mod", seq([lit("mod"), field("name", ident),
     alt([lit(";"), seq([lit("{"), rep(r("inner_attr")), rep(r("item")), lit("}")])])]))),

  ("fn_decl", wrap("function_declaration", seq([
     rep(lits(["const", "async", "unsafe"])), opt(seq([lit("extern"), opt(tok("string"))])),
     lit("fn"), field("name", ident), opt(r("generic_params")), r("params"),
     opt(seq([lit("->"), field("return", r("type"))])), opt(r("where")),
     alt([field("body", r("block")), lit(";")])]))),
  ("params", wrap("parameters", seq([lit("("), items(r("param")), lit(")")]))),
  ("param", alt([
     seq([rep(r("attr")), alt([
        wrap("self_param", seq([opt(lit("&")), opt(lifetime), opt(lit("mut")), lit("self"), opt(seq([lit(":"), r("type")]))])),
        wrap("parameter", seq([field("name", r("pattern")), lit(":"), field("type", r("type"))])),
        wrap("parameter", lit("...")),
        wrap("parameter", field("type", r("type")))])])])),
  // a closure parameter is a pattern with no top-level `|`: the alternation
  // form would eat the bar that closes the parameter list
  ("closure_param", seq([r("pattern_one"), opt(seq([lit(":"), r("type")]))])),

  ("struct_decl", wrap("type_declaration", seq([lit("struct"), wrap("type_spec", seq([
     field("name", ident), opt(r("generic_params")),
     alt([seq([opt(r("where")), lit(";")]),
          seq([opt(r("where")), lit("{"), items(r("field_decl")), lit("}")]),
          seq([lit("("), items(r("tuple_field")), lit(")"), opt(r("where")), lit(";")])])]))]))),
  ("field_decl", wrap("field", seq([rep(r("attr")), r("visibility"), field("name", ident), lit(":"), field("type", r("type"))]))),
  ("tuple_field", seq([rep(r("attr")), r("visibility"), r("type")])),

  ("enum_decl", wrap("type_declaration", seq([lit("enum"), wrap("type_spec", seq([
     field("name", ident), opt(r("generic_params")), opt(r("where")),
     lit("{"), items(r("variant")), lit("}")]))]))),
  ("variant", wrap("variant", seq([rep(r("attr")), field("name", ident),
     opt(alt([seq([lit("{"), items(r("field_decl")), lit("}")]),
              seq([lit("("), items(r("tuple_field")), lit(")")])])),
     opt(seq([lit("="), r("expr")]))]))),

  ("union_decl", wrap("type_declaration", seq([lit("union"), wrap("type_spec", seq([
     field("name", ident), opt(r("generic_params")), opt(r("where")),
     lit("{"), items(r("field_decl")), lit("}")]))]))),

  ("trait_decl", wrap("type_declaration", seq([opt(lit("unsafe")), lit("trait"), wrap("type_spec", seq([
     field("name", ident), opt(r("generic_params")), opt(seq([lit(":"), r("bounds")])), opt(r("where")),
     lit("{"), rep(r("inner_attr")), rep(r("assoc_item")), lit("}")]))]))),

  // `name` is always the type being implemented, so the methods inside can be
  // qualified by it: in `impl Display for S` that is S, not Display. The trait
  // is read first and only then is `for` looked for, which costs one type's
  // worth of backtracking on an inherent impl and nothing on nesting, because
  // an impl does not contain another one.
  ("impl_decl", wrap("impl", seq([opt(lit("unsafe")), lit("impl"), opt(r("generic_params")),
     opt(lit("!")),
     alt([seq([field("trait", r("type")), lit("for"), field("name", r("type"))]),
          field("name", r("type"))]),
     opt(r("where")),
     lit("{"), rep(r("inner_attr")), rep(r("assoc_item")), lit("}")]))),
  ("assoc_item", wrap("item_envelope", seq([rep(r("attr")), r("visibility"), alt([
     r("fn_decl"), r("type_alias"), r("const_decl"), r("macro_item")])]))),

  ("type_alias", wrap("type_declaration", seq([lit("type"), wrap("type_spec", seq([
     field("name", ident), opt(r("generic_params")), opt(seq([lit(":"), r("bounds")])), opt(r("where")),
     opt(seq([lit("="), field("type", r("type"))])), lit(";")]))]))),

  ("const_decl", wrap("let_declaration", seq([lits(["const", "static"]), opt(lit("mut")),
     field("name", alt([ident, lit("_")])), lit(":"), field("type", r("type")),
     opt(seq([lit("="), field("value", r("expr"))])), lit(";")]))),

  ("extern_block", wrap("extern", seq([opt(lit("unsafe")), lit("extern"), opt(tok("string")),
     lit("{"), rep(r("inner_attr")), rep(r("item")), lit("}")]))),

  ("macro_def", wrap("macro_definition", seq([lit("macro_rules"), lit("!"), field("name", ident), r("tt_group")]))),
  ("macro_item", wrap("macro", seq([field("name", r("path")), lit("!"), opt(ident), r("tt_group"), opt(lit(";"))]))),

  // ── types ───────────────────────────────────────────────────────────────
  ("type", alt([
     wrap("reference_type", seq([lits(["&&", "&"]), opt(lifetime), opt(lit("mut")), r("type")])),
     wrap("pointer_type", seq([lit("*"), lits(["const", "mut"]), r("type")])),
     wrap("slice_type", seq([lit("["), r("type"), opt(seq([lit(";"), r("expr")])), lit("]")])),
     wrap("tuple_type", seq([lit("("), items(r("type")), lit(")")])),
     wrap("impl_type", seq([lit("impl"), r("bounds")])),
     wrap("dyn_type", seq([lit("dyn"), r("bounds")])),
     wrap("fn_type", seq([opt(lit("unsafe")), opt(seq([lit("extern"), opt(tok("string"))])), lit("fn"),
        lit("("), items(r("type")), lit(")"), opt(seq([lit("->"), r("type")]))])),
     wrap("never_type", lit("!")),
     wrap("infer_type", lit("_")),
     wrap("qualified_type", seq([lit("<"), r("type"), opt(seq([lit("as"), r("type")])), lit(">"), rep(seq([lit("::"), r("path_segment")]))])),
     wrap("type_name", r("path"))])),
  ("bounds", seq([opt(lit("?")), alt([lifetime, r("type")]), rep(seq([lit("+"), opt(lit("?")), opt(seq([lit("for"), r("generic_params")])), alt([lifetime, r("type")])]))])),

  ("path", seq([opt(lit("::")), r("path_segment"), rep(seq([lit("::"), r("path_segment")]))])),
  ("expr_path", seq([opt(lit("::")), r("expr_segment"), rep(seq([lit("::"), r("expr_segment")]))])),
  ("expr_segment", seq([alt([ident, lit("crate"), lit("self"), lit("Self"), lit("super")]),
     opt(seq([lit("::"), r("generic_args")]))])),
  ("path_segment", seq([alt([ident, lit("crate"), lit("self"), lit("Self"), lit("super")]),
     opt(alt([r("generic_args"), r("fn_args")]))])),
  ("fn_args", seq([lit("("), items(r("type")), lit(")"), opt(seq([lit("->"), r("type")]))])),
  ("generic_args", seq([lit("<"), items(alt([
     seq([ident, lit("="), r("type")]),
     lifetime,
     r("type"),
     r("const_arg")])), lit(">")])),
  ("const_arg", alt([literal, seq([lit("{"), r("expr"), lit("}")]), seq([lit("-"), literal])])),

  ("generic_params", seq([lit("<"), items(alt([
     seq([rep(r("attr")), lifetime, opt(seq([lit(":"), r("bounds")]))]),
     seq([rep(r("attr")), lit("const"), ident, lit(":"), r("type"), opt(seq([lit("="), r("const_arg")]))]),
     seq([rep(r("attr")), ident, opt(seq([lit(":"), r("bounds")])), opt(seq([lit("="), r("type")]))])])), lit(">")])),

  ("where", seq([lit("where"), items(alt([
     seq([lifetime, lit(":"), r("bounds")]),
     seq([opt(seq([lit("for"), r("generic_params")])), r("type"), lit(":"), opt(r("bounds"))])]))])),

  // ── patterns ────────────────────────────────────────────────────────────
  ("pattern", seq([opt(lit("|")), r("pattern_one"), rep(seq([lit("|"), r("pattern_one")]))])),
  ("pattern_one", alt([
     seq([ident, lit("@"), r("pattern_one")]),
     seq([lit("&"), opt(lit("&")), opt(lit("mut")), r("pattern_one")]),
     seq([lit("("), items(r("pattern")), lit(")")]),
     seq([lit("["), items(r("pattern")), lit("]")]),
     seq([opt(lit("ref")), lit("mut"), ident]),
     seq([lit("ref"), ident]),
     lit("_"),
     seq([lit(".."), opt(r("pattern_one"))]),
     wrap("struct_pattern", seq([r("path"), lit("{"),
        items(alt([seq([ident, lit(":"), r("pattern")]), lit(".."), seq([opt(lit("ref")), opt(lit("mut")), ident])])), lit("}")])),
     wrap("tuple_struct_pattern", seq([r("path"), lit("("), items(r("pattern")), lit(")")])),
     seq([alt([seq([lit("-"), literal]), literal]), opt(seq([lits(["..=", "..."]), alt([seq([lit("-"), literal]), literal, r("path")])]))]),
     seq([r("path"), opt(seq([lits(["..=", "..."]), r("path")]))])])),

  // ── statements and blocks ───────────────────────────────────────────────
  ("block", wrap("block", seq([lit("{"), rep(r("inner_attr")), rep(recover(r("stmt"))), lit("}")]))),
  ("stmt", seq([rep(r("attr")), alt([
     lit(";"),
     r("let_stmt"),
     // only look for a declaration when one could start here: an expression
     // statement would otherwise be attempted against every item rule first
     seq([ahead(r("item_start")), r("item_stmt")]),
     wrap("expression_statement", seq([r("expr_path"), lit("!"), lit("{"), rep(r("tt")), lit("}"), opt(lit(";"))])),
     wrap("expression_statement", seq([r("block_expr"), nott(lits([".", "?"])), opt(lit(";"))])),
     // the last expression of a block carries no `;`
     wrap("expression_statement", seq([r("expr"), alt([lit(";"), ahead(lit("}"))])]))])])),
  ("item_start", seq([opt(lit("pub")), alt([
     lits(["use", "struct", "enum", "union", "trait", "impl", "type", "static", "mod", "macro_rules"]),
     seq([rep(lits(["const", "async", "unsafe", "extern"])), lit("fn")]),
     seq([opt(lit("unsafe")), lit("extern"), alt([tok("string"), lit("{"), lit("crate")])]),
     seq([lit("const"), alt([tok("identifier"), lit("_")]), lit(":")])])])),
  ("let_stmt", wrap("let", seq([lit("let"), field("name", r("pattern")),
     opt(seq([lit(":"), field("type", r("type"))])),
     opt(seq([lit("="), field("value", r("expr")), opt(seq([lit("else"), r("block")]))])), lit(";")]))),
  ("item_stmt", seq([r("visibility"), alt([r("use_decl"), r("fn_decl"), r("struct_decl"), r("enum_decl"),
     r("union_decl"), r("trait_decl"), r("impl_decl"), r("type_alias"), r("const_decl"), r("mod_decl"),
     r("extern_crate"), r("extern_block"), r("macro_def")])])),

  // an expression that is a block, and so needs no `;` as a statement
  ("block_expr", alt([
     r("if"), r("match"), r("loop"), r("while"), r("for"),
     seq([lifetime, lit(":"), r("block")]),
     wrap("unsafe_block", seq([lit("unsafe"), r("block")])),
     wrap("async_block", seq([lit("async"), opt(lit("move")), r("block")])),
     r("block")])),
  ("if", wrap("if", seq([lit("if"), field("condition", r("cond")),
     r("block"), opt(seq([lit("else"), alt([r("if"), r("block")])]))]))),
  // a let chain: `if let Some(a) = x && a.ok() && let Some(b) = a.next()`.
  // The right side of a `let` binds tighter than `&&`, so it stops below it.
  ("cond", seq([r("cond_one"), rep(seq([lit("&&"), r("cond_one")]))])),
  ("cond_one", alt([seq([lit("let"), r("pattern"), lit("="), r("cmp_nc")]), r("expr_nc")])),
  ("match", wrap("match", seq([lit("match"), field("condition", r("expr_nc")), lit("{"),
     rep(r("match_arm")), lit("}")]))),
  ("match_arm", wrap("match_arm", seq([rep(r("attr")), r("pattern"),
     opt(seq([lit("if"), r("expr")])), lit("=>"),
     alt([seq([r("block_expr"), nott(lits([".", "?"])), opt(lit(","))]), seq([r("expr"), opt(lit(","))])])]))),
  ("loop", wrap("loop", seq([opt(seq([lifetime, lit(":")])), lit("loop"), r("block")]))),
  ("while", wrap("while", seq([opt(seq([lifetime, lit(":")])), lit("while"),
     field("condition", r("cond")), r("block")]))),
  ("for", wrap("for", seq([opt(seq([lifetime, lit(":")])), lit("for"), r("pattern"), lit("in"),
     field("condition", r("expr_nc")), r("block")]))),
])

// ── tests ─────────────────────────────────────────────────────────────────

fn parse_src(src: String) -> Result[parser.Parsed, String] = {
  let toks = lex.tokenize(src, spec()) |> result.map_err((e) => "lex " + int.to_string(e.line) + ":" + int.to_string(e.col) + " " + e.message)!
  parser.parse(rust(), toks) |> result.map_err((f) => parser.format_failure(f))
}

// Envelopes preserve modifiers/attributes without changing declaration kinds.
fn item_kinds(kids: List[tree.Node]) -> List[String] = list.flat_map(kids, (k) =>
  if k.kind == "item_envelope" then list.map(k.kids, (child) => child.kind) else [k.kind])

fn top_kinds(src: String) -> List[String] = match parse_src(src) {
  ok(p) => item_kinds(p.root.kids),
  err(e) => ["ERROR " + e],
}

fn recovered_kinds(src: String) -> List[String] = {
  let toks = lex.tokenize_recovering(src, spec())
  match parser.parse_recovering(parser.compile(rust()), toks) {
    ok(p) => item_kinds(p.root.kids),
    err(_) => ["NOTHING"],
  }
}

test "a lifetime and a character are told apart by what closes them" {
  let toks = lex.tokenize("fn f<'a>(x: &'a str) -> char { 'q' }", spec())!
  // `'a` is the quote and a name; `'q'` is one token
  assert_eq(list.contains(lex.kinds(toks), "rune"), true)
  assert_eq(list.len(list.filter(toks, (t) => t.kind == "rune")), 1)
  // and a list of lifetimes does not swallow the comma between them
  assert_eq(top_kinds("struct S<'a, 'b> { x: &'a str, y: &'b str }"), ["type_declaration"])
}

test "raw strings end only at the hashes they opened with" {
  let toks = lex.tokenize("let a = r#\"one \" two\"#; let b = b\"bytes\";", spec())!
  assert_eq(list.len(list.filter(toks, (t) => t.kind == "string")), 2)
  assert_eq(list.get(lex.texts(toks), 3), some("r#\"one \" two\"#"))
}

test "numbers carry their type suffix, and `1.` is a float but `1.max` is not" {
  assert_eq(lex.kinds(list.take(lex.tokenize("1u8 0xFFi64 2.0f32 1. 1.max(2)", spec())!, 5)),
    ["integer", "integer", "float", "float", "integer"])
}

test "every kind of item parses" {
  let src = """
#![allow(dead_code)]
use std::collections::{HashMap, HashSet};
mod inner;
pub struct Point { pub x: i32, y: i32 }
enum E { A, B(u8), C { n: u8 } }
pub trait T: Clone { fn f(&self) -> u8 { 0 } }
impl T for Point { fn f(&self) -> u8 { self.x as u8 } }
type Alias<T> = Vec<T>;
pub const N: usize = 3;
static S: &str = "s";
extern "C" { fn c_fn(x: u8); }
macro_rules! m { () => { 1 } }
pub async unsafe fn g<'a, T: Clone>(x: &'a T) -> Option<T> where T: Sized { None }
"""
  assert_eq(top_kinds(src), ["use", "mod", "type_declaration", "type_declaration", "type_declaration",
    "impl", "type_declaration", "let_declaration", "let_declaration", "extern", "macro_definition",
    "function_declaration"])
}

test "`>>` closes two generic brackets, and is still a shift between values" {
  assert_eq(top_kinds("fn f() -> Vec<Vec<u8>> { vec![] }"), ["function_declaration"])
  assert_eq(top_kinds("fn f(a: u32) -> u32 { a >> 2 }"), ["function_declaration"])
  assert_eq(top_kinds("fn f(a: &mut u32) { *a >>= 2; }"), ["function_declaration"])
}

test "`union` is a keyword only where a declaration starts" {
  assert_eq(top_kinds("union U { a: u8, b: u16 }"), ["type_declaration"])
  assert_eq(top_kinds("fn f(a: HashSet<u8>) -> usize { a.union(&a).count() }"), ["function_declaration"])
}

test "closures, let chains, qualified paths and a block that is continued" {
  assert_eq(top_kinds("fn f() { let g = |x| x + 1; let h = |(a, b): (u8, u8)| a < b; }"), ["function_declaration"])
  assert_eq(top_kinds("fn f(x: Option<u8>) { if let Some(a) = x && a > 1 && let Some(b) = x { } }"), ["function_declaration"])
  assert_eq(top_kinds("fn f(w: &[u8]) { <[u8; 8]>::try_from(w).ok(); }"), ["function_declaration"])
  assert_eq(top_kinds("fn f(b: bool) -> String { if b { \"y\" } else { \"n\" }.into() }"), ["function_declaration"])
}

test "a macro body is a run of tokens with no reading, and leaves no nodes" {
  assert_eq(top_kinds("fn f() { println!(\"{} {}\", a, b); thread_local! { static X: u8 = 0; } }"),
    ["function_declaration"])
}

test "a half-typed signature keeps its name" {
  let src = "fn alpha() -> u8 { 1 }\n\nfn beta(x: u8\n\nfn gamma() -> u8 { 3 }\n"
  match parse_src(src) { ok(_) => assert(false), err(_) => () }
  assert_eq(recovered_kinds(src), ["function_declaration", "function_declaration", "ERROR", "function_declaration"])
}


fn symbol_rules() -> package_api.SymbolRules = package_api.SymbolRules {
  declarations: [("function_declaration", "function"), ("method_declaration", "method"), ("method_signature", "method"), ("type_declaration", "type"), ("type_spec", "type"), ("let_declaration", "let"), ("variant", "variant"), ("field", "field"), ("impl", "impl"), ("mod", "mod"), ("macro_definition", "macro")],
  scopes: ["impl", "type_spec", "type_declaration"], namespaces: ["mod"], callables: ["function_declaration", "method_declaration", "method_signature"],
  envelopes: ["item_envelope"], unnamed_envelopes: ["type_declaration"]
}

fn prepare_lexer() -> package_api.Tokenizer = {
  let config = spec()
  (source, recovering) => lex.tokenize_with(source, config, recovering)
}

fn definition() -> package_api.Definition = package_api.Definition {
  id: "rust", package_name: "gramide-rust", version: "0.1.0", extensions: [".rs"],
  capabilities: ["check", "tokens", "parse", "outline", "symbols", "tags", "map"],
  lexer: () => prepare_lexer(), grammar: () => rust(), sep: "::", symbols: symbol_rules()
}
