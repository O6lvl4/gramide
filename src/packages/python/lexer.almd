// UTF-8 Python source -> logical tokens. Grammar and recovery are separate.
import self.packages.python.interpolation
import self.tree
import self.lex
import self.packages.python.layout
import self.packages.python.strings
import self.packages.python.numbers
import self.packages.python.identifiers

type Operator = { text: String, data: Bytes }
fn operators() -> List[Operator] = list.map([
  "**=", "//=", ">>=", "<<=", "...", ":=", "**", "//", "<<", ">>", "<=", ">=", "==", "!=", "->",
  "+=", "-=", "*=", "/=", "%=", "@=", "&=", "|=", "^=",
  "+", "-", "*", "/", "%", "@", "<", ">", "=", "&", "|", "^", "~", ":", ".", ",", ";", "(", ")", "[", "]", "{", "}"
], (s) => Operator { text: s, data: bytes.from_string(s) })
fn matches(source: Bytes, at: Int, pattern: Bytes) -> Bool = {
  var i = 0
  var same = true
  while i < bytes.len(pattern) and same {
    same = bytes.get_or(source, at + i, -1) == bytes.get_or(pattern, i, -2)
    i = i + 1
  }
  same
}
// The three kinds an interpolated literal produces, by family. A frame keeps
// the family name because the grammar's rule names are built from it; the
// token stream keeps numbers.
fn family_start(family: String) -> Int = if family == "fstring" then tree.T_FSTRING_START else tree.T_TSTRING_START
fn family_middle(family: String) -> Int = if family == "fstring" then tree.T_FSTRING_MIDDLE else tree.T_TSTRING_MIDDLE
fn family_end(family: String) -> Int = if family == "fstring" then tree.T_FSTRING_END else tree.T_TSTRING_END

fn make(kind: Int, start: Int, end: Int, line: Int, line_start: Int) -> tree.Token =
  tree.Token { kind: kind, start: start, end: end, line: line, col: start - line_start + 1 }
fn newline_byte(b: Int) -> Bool = b == 10 or b == 13
fn newline_end(source: Bytes, at: Int) -> Int = at + (if bytes.get_or(source, at, -1) == 13 and bytes.get_or(source, at + 1, -1) == 10 then 2 else 1)

// A string prefix is one or two ASCII letters glued to an opening quote: `f"`,
// `rt'`, `TR"""`. Reading it from the bytes keeps every ordinary identifier —
// most of the tokens in a file — off the allocating path, where testing the
// name against a list of spellings built that list and a lowered copy of the
// name for every identifier in the file.
let P_NONE = 0
let P_F = 1
let P_FR = 2
let P_T = 3
let P_TR = 4
fn prefix_code(buffer: Bytes, start: Int, end: Int) -> Int = {
  let width = if strings.quote(bytes.get_or(buffer, end, -1)) then end - start else 0
  let first = strings.lower(bytes.get_or(buffer, start, -1))
  if width == 1 then (if first == 102 then P_F else if first == 116 then P_T else P_NONE)
  else if width == 2 then {
    let second = strings.lower(bytes.get_or(buffer, start + 1, -1))
    if (first == 102 and second == 114) or (first == 114 and second == 102) then P_FR
    else if (first == 116 and second == 114) or (first == 114 and second == 116) then P_TR
    else P_NONE
  } else P_NONE
}

// Roll back the complete outer interpolation, including replacement tokens.
// Keeping a partial opening would leave layout with fabricated unmatched braces.
fn discard_interpolation(mut tokens: List[tree.Token], checkpoint: Int, head: tree.Token, buffer: Bytes, end: Int) -> Unit = {
  while list.len(tokens) > checkpoint { let _ = list.pop(tokens) }
  list.push(tokens, tree.Token { ...head, kind: tree.T_ERROR, end: end })
}

// Scalar dispatch avoids allocating a default string and option-map closure
// on every scanner iteration, including source outside interpolations.
let MODE_NORMAL = 0
let MODE_LITERAL = 1
let MODE_FORMAT = 2
let MODE_CLOSING = 3
let MODE_EXPRESSION = 4
fn frame_mode(frame: Option[interpolation.Frame]) -> Int = match frame {
  none => MODE_NORMAL,
  some(f) => match f.mode {
    "literal" => MODE_LITERAL,
    "format" => MODE_FORMAT,
    "closing" => MODE_CLOSING,
    "expression" => MODE_EXPRESSION,
    _ => MODE_NORMAL
  }
}

fn physical_with(source: String, recovering: Bool) -> Result[List[tree.Token], lex.LexError] = {
  guard not string.contains(source, "\u{0000}") else err(lex.LexError { line: 1, col: 1, message: "source code cannot contain null bytes" })
  let buffer = bytes.from_string(source)
  let classes = identifiers.prepare()
  let ops = operators()
  var tokens: List[tree.Token] = []
  var frames: List[interpolation.Frame] = []
  var checkpoint = 0
  var head = make(tree.T_ERROR, 0, 0, 1, 0)
  var i = 0
  var line = 1
  var line_start = 0
  while i < bytes.len(buffer) {
    let b = bytes.get_or(buffer, i, -1)
    let start = i
    // Retain the starting coordinates; build fallback diagnostics only in
    // the branches that use them, not for every ordinary character.
    let first_line = line
    let first_line_start = line_start
    var kind = tree.T_NONE
    var token_end = -1
    var failure: Option[lex.LexError] = none
    let frame = list.last(frames)
    let mode = frame_mode(frame)
    if mode == MODE_LITERAL or mode == MODE_FORMAT then {
      let f = option.to_result(frame, lex.LexError { line: first_line, col: start - first_line_start + 1, message: "unexpected Python character" })!
      let part = match interpolation.segment(buffer, i, f, line, i - line_start + 1) {
        ok(part) => part,
        err(e) => { failure = some(e); interpolation.Segment { kind: "failed", end: i, next: i } },
      }
      token_end = part.end
      i = part.next
      if part.kind == "failed" then ()
      else if part.kind == "end" then { kind = family_end(f.family); let _ = list.pop(frames) }
      else if part.kind == "open" then {
        kind = tree.T_PUNCT
        list.push(frames, interpolation.Frame { ...f, mode: "expression", depth: 0 })
      } else {
        kind = family_middle(f.family)
        if part.kind == "format_end" then {
          let _ = list.pop(frames)
          list.push(frames, interpolation.Frame { ...f, mode: "closing" })
        } else ()
      }
    }
    else if mode == MODE_CLOSING then { kind = tree.T_PUNCT; i = i + 1; let _ = list.pop(frames) }
    else if b == 32 or b == 9 or b == 12 then i = i + 1
    else if b == 10 or b == 13 then { kind = tree.T_NEWLINE; i = newline_end(buffer, i) }
    else if b == 35 then {
      kind = tree.T_COMMENT
      while i < bytes.len(buffer) and not newline_byte(bytes.get_or(buffer, i, -1)) { i = i + 1 }
    }
    else if b == 92 then {
      if newline_byte(bytes.get_or(buffer, i + 1, -1)) then {
        kind = tree.T_CONTINUATION
        i = newline_end(buffer, i + 1)
      } else failure = some(lex.LexError { line: first_line, col: start - first_line_start + 1, message: "unexpected character after line continuation" })
    }
    else if option.is_some(strings.opening(buffer, i)) then {
      kind = tree.T_STRING
      match strings.scan(buffer, i, line, i - line_start + 1) {
        ok(end) => { i = end },
        err(e) => {
          if list.is_empty(frames) then {
            guard recovering else err(e)
            kind = tree.T_ERROR
            i = strings.recovery_end(buffer, i)
          } else failure = some(e)
        },
      }
    }
    else if numbers.starts(buffer, i) then {
      kind = tree.T_NUMBER
      match numbers.scan(buffer, i, line, i - line_start + 1) {
        ok(end) => { i = end }, err(e) => { failure = some(e) },
      }
    }
    else if identifiers.ascii_start(b) or b >= 128 then {
      kind = tree.T_IDENTIFIER
      match identifiers.scan(classes, buffer, i, line, i - line_start + 1) {
        ok(end) => { i = end }, err(e) => { failure = some(e) },
      }
      let prefix = prefix_code(buffer, start, i)
      if prefix != P_NONE then {
        let q = bytes.get_or(buffer, i, -1)
        let width = if bytes.get_or(buffer, i + 1, -1) == q and bytes.get_or(buffer, i + 2, -1) == q then 3 else 1
        let family = if prefix == P_F or prefix == P_FR then "fstring" else "tstring"
        guard list.len(frames) < 200 else err(lex.LexError { line: first_line, col: start - first_line_start + 1, message: "too many nested interpolated strings" })
        if list.is_empty(frames) then {
          checkpoint = list.len(tokens)
          head = make(tree.T_ERROR, start, i + width, first_line, first_line_start)
        } else ()
        list.push(frames, interpolation.Frame { family: family, quote: q, width: width, raw: prefix == P_FR or prefix == P_TR, mode: "literal", depth: 0 })
        kind = family_start(family)
        i = i + width
      } else ()
    }
    else if mode == MODE_EXPRESSION and (option.map(frame, (f) => f.depth) ?? 0) == 0 and (b == 58 or (b == 33 and bytes.get_or(buffer, i + 1, -1) != 61)) then {
      kind = tree.T_PUNCT
      i = i + 1
    }
    else {
      // Longest match first. Keep the scan here: passing the operator list
      // by value to a helper would still copy it in the pinned native compiler.
      var width = 0
      for op in ops {
        if width == 0 and matches(buffer, i, op.data) then width = bytes.len(op.data) else ()
      }
      if width > 0 then { kind = tree.T_PUNCT; i = i + width }
      else {
        // Quotes, comments, continuations and non-ASCII characters have
        // dedicated branches above. This unknown ASCII byte has no extent
        // beyond itself and cannot establish a new lexical mode.
        if recovering and list.is_empty(frames) then { kind = tree.T_ERROR; i = i + 1 }
        else failure = some(lex.LexError { line: first_line, col: start - first_line_start + 1, message: "unexpected Python character" })
      }
    }
    match failure {
      some(e) => {
        guard recovering and not list.is_empty(frames) else err(e)
        // Only a top-level literal newline has an unambiguous resume boundary.
        // Failed replacement/nested/format states conservatively own the tail.
        let f = option.to_result(frame, e)!
        i = if list.len(frames) == 1 and mode == MODE_LITERAL and e.message == "unterminated interpolated string" then interpolation.failed_literal_end(buffer, start, f) else bytes.len(buffer)
        discard_interpolation(tokens, checkpoint, head, buffer, i)
        frames = []
        kind = tree.T_NONE
      },
      none => (),
    }
    if mode == MODE_EXPRESSION and kind == tree.T_PUNCT then {
      let f = option.to_result(frame, lex.LexError { line: first_line, col: start - first_line_start + 1, message: "unexpected Python character" })!
      let text = bytes.to_string_lossy(bytes.slice(buffer, start, i))
      if f.depth == 0 and text == "}" then { let _ = list.pop(frames) }
      else if f.depth == 0 and text == ":" then {
        let _ = list.pop(frames)
        list.push(frames, interpolation.Frame { ...f, mode: "format" })
      }
      else {
        // one byte, compared: a three-string list built here is three
        // allocations for every bracket in every interpolation
        let only = bytes.get_or(bytes.from_string(text), 0, -1)
        let opens = string.len(text) == 1 and (only == 40 or only == 91 or only == 123)
        let closes = string.len(text) == 1 and (only == 41 or only == 93 or only == 125)
        if opens or closes then {
          let _ = list.pop(frames)
          list.push(frames, interpolation.Frame { ...f, depth: f.depth + (if opens then 1 else -1) })
        } else ()
      }
    } else ()
    if kind != tree.T_NONE then list.push(tokens, make(kind, start, if token_end < 0 then i else token_end, first_line, first_line_start)) else ()
    // Count physical lines once, including those inside multiline strings.
    var at = start
    while at < i {
      if newline_byte(bytes.get_or(buffer, at, -1)) then {
        at = newline_end(buffer, at)
        line = line + 1
        line_start = at
      } else at = at + 1
    }
  }
  if not list.is_empty(frames) then {
    guard recovering else err(lex.LexError { line: line, col: i - line_start + 1, message: "unterminated interpolated string" })
    discard_interpolation(tokens, checkpoint, head, buffer, i)
  } else ()
  list.push(tokens, make(tree.T_EOF, i, i, line, line_start))
  ok(tokens)
}
fn physical(source: String) -> Result[List[tree.Token], lex.LexError] = physical_with(source, false)
fn scan_source_with(source: String, recovering: Bool) -> Result[List[tree.Token], lex.LexError] = layout.apply_with(source, physical_with(source, recovering)!, recovering)
fn scan_source(source: String) -> Result[List[tree.Token], lex.LexError] = scan_source_with(source, false)

test "Python lexer joins lines and does not invent code inside strings" {
  let ts = scan_source("if True:\n    日本語 = (1 +\n        2)\n    text = \"\"\"\nnot code\n\"\"\"\n")!
  assert_eq(list.len(list.filter(ts, (t) => t.kind == tree.T_INDENT)), 1)
  assert_eq(list.len(list.filter(ts, (t) => t.kind == tree.T_NEWLINE)), 3)
  assert_eq(list.len(list.filter(ts, (t) => t.kind == tree.T_STRING)), 1)
  assert(result.is_ok(scan_source("x = f\"{value}\"\n")))
}

test "a string prefix is only f or t, in either order with r, before a quote" {
  assert_eq(prefix_code(bytes.from_string("f'"), 0, 1), P_F)
  assert_eq(prefix_code(bytes.from_string("F'"), 0, 1), P_F)
  assert_eq(prefix_code(bytes.from_string("rf'"), 0, 2), P_FR)
  assert_eq(prefix_code(bytes.from_string("FR'"), 0, 2), P_FR)
  assert_eq(prefix_code(bytes.from_string("t'"), 0, 1), P_T)
  assert_eq(prefix_code(bytes.from_string("Rt'"), 0, 2), P_TR)
  // Byte and unicode prefixes are ordinary strings; the scanner reads them
  // through `strings.opening`, not through an interpolation frame.
  assert_eq(prefix_code(bytes.from_string("b'"), 0, 1), P_NONE)
  assert_eq(prefix_code(bytes.from_string("rb'"), 0, 2), P_NONE)
  assert_eq(prefix_code(bytes.from_string("ft'"), 0, 2), P_NONE)
  assert_eq(prefix_code(bytes.from_string("frf'"), 0, 3), P_NONE)
  // A name is only a prefix when the quote is glued to it.
  assert_eq(prefix_code(bytes.from_string("f "), 0, 1), P_NONE)
}
