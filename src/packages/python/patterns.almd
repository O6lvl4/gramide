// Python match patterns are intentionally narrower than ordinary expressions.
import self.parser
import self.packages.python.containers
import self.packages.python.arguments
import self.parser.{ seq, nott, wrap, r, opt, keep, keeps, lits, alt, rep, tok, lit }

fn more(rule: parser.Rule) -> parser.Rule = seq([rule, rep(rule)])
fn rules() -> List[(String, parser.Rule)] = [
  ("match_stmt", wrap("match_stmt", seq([
    lit("match"), r("match_subject"), lit(":"), tok("newline"), tok("indent"), more(r("case_block")), tok("dedent")
  ]))),
  ("match_subject", alt([
    wrap("tuple", seq([r("star_expression"), lit(","), opt(containers.separated(r("star_expression")))])), r("named_expression")
  ])),
  ("case_block", wrap("case", seq([lit("case"), r("patterns"), wrap("guard", opt(seq([lit("if"), r("named_expression")]))), lit(":"), r("suite")]))),
  ("patterns", alt([r("open_pattern_sequence"), r("pattern")])),
  ("pattern", alt([
    wrap("pattern_as", seq([r("or_pattern"), lit("as"), r("capture_target")])), r("or_pattern")
  ])),
  ("or_pattern", wrap("pattern_or", seq([r("closed_pattern"), rep(seq([lit("|"), r("closed_pattern")]))]))),
  ("closed_pattern", alt([
    r("literal_pattern"), wrap("pattern_capture", r("capture_target")), wrap("pattern_wild", lit("_")),
    wrap("pattern_value", seq([r("pattern_attr"), nott(lits([".", "(", "="]))])),
    seq([lit("("), r("pattern"), lit(")")]), r("sequence_pattern"), r("mapping_pattern"), r("class_pattern")
  ])),
  ("capture_target", seq([nott(lit("_")), r("name"), nott(lits([".", "(", "="]))])),
  ("pattern_attr", wrap("primary", seq([r("name"), more(r("attribute_suffix"))]))),
  ("pattern_class_name", wrap("primary", seq([r("name"), rep(r("attribute_suffix"))]))),
  ("literal_pattern", alt([
    wrap("pattern_singleton", keeps(["None", "True", "False"])), wrap("pattern_value", r("pattern_literal"))
  ])),
  ("pattern_literal", alt([
    seq([r("pattern_signed_number"), nott(lits(["+", "-"]))]),
    wrap("binary", seq([r("pattern_signed_real"), keeps(["+", "-"]), tok("imaginary")])), r("strings")
  ])),
  ("pattern_signed_number", alt([wrap("unary", seq([keep("-"), alt([tok("number"), tok("imaginary")])])), tok("number"), tok("imaginary")])),
  ("pattern_signed_real", alt([wrap("unary", seq([keep("-"), tok("number")])), tok("number")])),
  ("maybe_star_pattern", alt([wrap("pattern_star", seq([lit("*"), alt([r("capture_target"), keep("_")])])), r("pattern")])),
  ("open_pattern_sequence", wrap("pattern_sequence", seq([r("maybe_star_pattern"), lit(","), opt(containers.separated(r("maybe_star_pattern")))]))),
  ("sequence_pattern", alt([
    wrap("pattern_sequence", seq([lit("["), opt(containers.separated(r("maybe_star_pattern"))), lit("]")])),
    seq([lit("("), alt([r("open_pattern_sequence"), wrap("pattern_sequence", seq([]))]), lit(")")])
  ])),
  ("mapping_pattern", wrap("pattern_mapping", seq([lit("{"), opt(alt([
    seq([arguments.comma_list(r("mapping_item")), opt(seq([lit(","), r("mapping_rest")])), opt(lit(","))]),
    seq([r("mapping_rest"), opt(lit(","))])
  ])), lit("}")]))),
  ("mapping_item", wrap("mapping_item", seq([alt([r("pattern_literal"), keeps(["None", "True", "False"]), r("pattern_attr")]), lit(":"), r("pattern")]))),
  ("mapping_rest", wrap("mapping_rest", seq([lit("**"), r("capture_target")]))),
  ("class_pattern", wrap("pattern_class", seq([r("pattern_class_name"), lit("("), opt(seq([alt([
    seq([arguments.comma_list(r("pattern")), opt(seq([lit(","), arguments.comma_list(r("class_keyword"))]))]),
    arguments.comma_list(r("class_keyword"))
  ]), opt(lit(","))])), lit(")")]))),
  ("class_keyword", wrap("class_keyword", seq([r("name"), lit("="), r("pattern")]))),
]
