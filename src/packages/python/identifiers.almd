// Python 3.14 identifier classes, pinned to Unicode 16 independently of Rust.
import self.packages.python.identifier_data
import self.lex

type Tables = { starts: Bytes, continues: Bytes }
fn prepare() -> Tables = Tables { starts: bytes.from_string(identifier_data.start_table()), continues: bytes.from_string(identifier_data.continuation_table()) }
fn hex6(table: Bytes, at: Int) -> Int = {
  var value = 0
  var i = at
  while i < at + 6 {
    let b = bytes.get_or(table, i, 48)
    value = value * 16 + (if b <= 57 then b - 48 else b - 87)
    i = i + 1
  }
  value
}
fn contains(table: Bytes, cp: Int) -> Bool = {
  var low = 0
  var high = bytes.len(table) / 12
  var found = false
  while low < high and not found {
    let mid = (low + high) / 2
    if cp < hex6(table, mid * 12) then high = mid
    else if cp > hex6(table, mid * 12 + 6) then low = mid + 1
    else found = true
  }
  found
}
fn ascii_start(cp: Int) -> Bool = cp == 95 or (cp >= 65 and cp <= 90) or (cp >= 97 and cp <= 122)
fn is_start(t: Tables, cp: Int) -> Bool = if cp < 128 then ascii_start(cp) else contains(t.starts, cp)
fn is_continue(t: Tables, cp: Int) -> Bool = if cp < 128 then ascii_start(cp) or (cp >= 48 and cp <= 57) else contains(t.continues, cp)

// Bulk lookup also permits an exhaustive Unicode oracle without copying tables
// across module boundaries per scalar. Normal lexing uses the same predicates.
fn classes(t: Tables, points: List[Int]) -> List[(Bool, Bool)] = list.map(points, (cp) => (is_start(t, cp), is_continue(t, cp)))

fn scan(t: Tables, source: Bytes, start: Int, line: Int, col: Int) -> Result[Int, lex.LexError] = {
  var i = start
  var scanning = true
  while scanning {
    let b = bytes.get_or(source, i, -1)
    if ascii_start(b) or (b >= 48 and b <= 57) or b >= 128 then {
      let width = if b < 128 then 1 else if b < 224 then 2 else if b < 240 then 3 else 4
      let cp = if b < 128 then b else string.codepoint(bytes.to_string_lossy(bytes.slice(source, i, i + width))) ?? -1
      guard (if i == start then is_start(t, cp) else is_continue(t, cp)) else err(lex.LexError { line: line, col: col + i - start, message: "invalid Python identifier character" })
      i = i + width
    } else scanning = false
  }
  guard i > start else err(lex.LexError { line: line, col: col, message: "expected a Python identifier" })
  ok(i)
}

test "Python identifiers distinguish Unicode starts and continuations" {
  let t = prepare()
  assert(is_start(t, 26085))
  assert(not is_start(t, 769))
  assert(is_continue(t, 769))
  assert(not is_continue(t, 129704))
  assert_eq(scan(t, bytes.from_string("日本語 + 1"), 0, 1, 1), ok(9))
  assert(result.is_err(scan(t, bytes.from_string("name🪨"), 0, 1, 1)))
}
