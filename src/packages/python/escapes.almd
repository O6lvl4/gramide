// Numeric escape validation, without evaluating or decoding literal values.
import self.parser
import self.tree
import self.packages.python.strings

fn hex(b: Int) -> Int = if b >= 48 and b <= 57 then b - 48 else if b >= 65 and b <= 70 then b - 55 else if b >= 97 and b <= 102 then b - 87 else -1
// Offsets are absolute: the source is read where the token sits rather than
// copied out of it, so validating a literal costs no allocation of its own.
fn raw_prefix(source: Bytes, from: Int, to: Int) -> Bool = {
  var i = from
  var raw = false
  while i < to {
    if strings.lower(bytes.get_or(source, i, -1)) == 114 then raw = true else ()
    i = i + 1
  }
  raw
}

fn numeric(source: Bytes, start: Int, end: Int, raw: Bool, byte_literal: Bool, token: tree.Token) -> Result[Unit, parser.Failure] = {
  var i = start
  while i < end and not raw {
    if bytes.get_or(source, i, -1) == 92 then {
      let code = bytes.get_or(source, i + 1, -1)
      let width = if code == 120 then 2 else if not byte_literal and code == 117 then 4 else if not byte_literal and code == 85 then 8 else 0
      if width > 0 then {
        let error = parser.Failure { line: token.line, col: token.col, found: tree.token_text(source, token), expected: ["complete numeric escape within Unicode range"] }
        guard i + 2 + width <= end else err(error)
        var value = 0
        for offset in 0..<width {
          let digit = hex(bytes.get_or(source, i + 2 + offset, -1))
          guard digit >= 0 else err(error)
          value = value * 16 + digit
        }
        guard value <= 1114111 else err(error)
        i = i + 2 + width
      } else i = i + 2
    } else i = i + 1
  }
  ok(())
}
type TokenBuffer = { items: List[tree.Token] }
fn validate(source: Bytes, buffer: TokenBuffer) -> Result[Unit, parser.Failure] = {
  var raw_frames: List[Bool] = []
  for token in buffer.items {
    if token.kind == tree.T_STRING then {
      match strings.opening(source, token.start) {
        some(head) => {
          let width = if bytes.get_or(source, head.at + 1, -1) == head.quote and bytes.get_or(source, head.at + 2, -1) == head.quote then 3 else 1
          numeric(source, head.at + width, token.end - width, raw_prefix(source, token.start, head.at), head.byte_literal, token)!
        },
        none => (),
      }
    } else if token.kind == tree.T_FSTRING_START or token.kind == tree.T_TSTRING_START then {
      list.push(raw_frames, raw_prefix(source, token.start, token.end))
    } else if token.kind == tree.T_FSTRING_END or token.kind == tree.T_TSTRING_END then {
      let _ = list.pop(raw_frames)
    } else if token.kind == tree.T_FSTRING_MIDDLE or token.kind == tree.T_TSTRING_MIDDLE then {
      numeric(source, token.start, token.end, list.last(raw_frames) ?? false, false, token)!
    } else ()
  }
  ok(())
}
