// Strict Python numeric token boundaries; no numeric conversion or evaluation.
import self.lex

fn digit(b: Int, base: Int) -> Bool =
  (b >= 48 and b < 48 + int.min(base, 10)) or
  (base == 16 and ((b >= 65 and b <= 70) or (b >= 97 and b <= 102)))
fn word(b: Int) -> Bool = (b >= 65 and b <= 90) or (b >= 97 and b <= 122) or b == 95 or digit(b, 10) or b >= 128
fn starts(buffer: Bytes, at: Int) -> Bool = digit(bytes.get_or(buffer, at, -1), 10) or
  (bytes.get_or(buffer, at, -1) == 46 and digit(bytes.get_or(buffer, at + 1, -1), 10))

fn digits(buffer: Bytes, start: Int, base: Int, error: lex.LexError) -> Result[Int, lex.LexError] = {
  guard digit(bytes.get_or(buffer, start, -1), base) else err(error)
  var i = start + 1
  var scanning = true
  while scanning {
    let b = bytes.get_or(buffer, i, -1)
    if digit(b, base) then i = i + 1
    else if b == 95 then {
      guard digit(bytes.get_or(buffer, i + 1, -1), base) else err(error)
      i = i + 2
    } else scanning = false
  }
  ok(i)
}

fn boundary(buffer: Bytes, at: Int, error: lex.LexError) -> Result[Unit, lex.LexError] = {
  let b = bytes.get_or(buffer, at, -1)
  if b < 128 and word(b) then {
    var end = at
    while word(bytes.get_or(buffer, end, -1)) { end = end + 1 }
    let suffix = bytes.to_string_lossy(bytes.slice(buffer, at, end))
    // CPython currently accepts these adjoining keywords with SyntaxWarning.
    // Grammar integration must preserve the boundary and report that warning.
    guard list.contains(["and", "else", "for", "if", "in", "is", "or", "not"], suffix) else err(error)
  } else ()
  ok(())
}

fn scan(buffer: Bytes, start: Int, line: Int, col: Int) -> Result[Int, lex.LexError] = {
  let error = lex.LexError { line: line, col: col, message: "invalid numeric literal" }
  guard starts(buffer, start) else err(error)
  let first = bytes.get_or(buffer, start, -1)
  let second = bytes.get_or(buffer, start + 1, -1)
  let base = if second == 120 or second == 88 then 16 else if second == 111 or second == 79 then 8 else if second == 98 or second == 66 then 2 else 0
  if first == 48 and base != 0 then {
    let at = start + 2 + (if bytes.get_or(buffer, start + 2, -1) == 95 then 1 else 0)
    let end = digits(buffer, at, base, error)!
    boundary(buffer, end, error)!
    ok(end)
  } else {
    var i = if first == 46 then start else digits(buffer, start, 10, error)!
    let integer_end = i
    var floating = false
    if bytes.get_or(buffer, i, -1) == 46 then {
      floating = true
      i = i + 1
      if digit(bytes.get_or(buffer, i, -1), 10) then i = digits(buffer, i, 10, error)! else ()
    } else ()
    let exponent_marker = bytes.get_or(buffer, i, -1)
    if exponent_marker == 101 or exponent_marker == 69 then {
      var exponent = i + 1
      let sign_byte = bytes.get_or(buffer, exponent, -1)
      let sign = sign_byte == 43 or sign_byte == 45
      if sign then exponent = exponent + 1 else ()
      if digit(bytes.get_or(buffer, exponent, -1), 10) then {
        floating = true
        i = digits(buffer, exponent, 10, error)!
      } else {
        guard not sign else err(error)
        boundary(buffer, i, error)!
      }
    } else ()
    let suffix_byte = bytes.get_or(buffer, i, -1)
    let imaginary = suffix_byte == 106 or suffix_byte == 74
    if imaginary then i = i + 1 else ()
    if first == 48 and not floating and not imaginary then {
      var at = start
      while at < integer_end {
        let zero_byte = bytes.get_or(buffer, at, -1)
        guard zero_byte == 48 or zero_byte == 95 else err(error)
        at = at + 1
      }
    } else ()
    boundary(buffer, i, error)!
    ok(i)
  }
}

test "Python number starts do not consume operators or names" {
  for text in ["0", "9", ".5", "0x1", "1e2"] { assert(starts(bytes.from_string(text), 0)) }
  for text in [".", "...", "-1", "+1", "inf", "nan", "_1"] { assert(not starts(bytes.from_string(text), 0)) }
}
