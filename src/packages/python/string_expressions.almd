// Python string composition and replacement fields. Raw token text is kept;
// escape decoding and validation are separate from these grammar rules.
import self.parser
import self.tree
import self.packages.python.strings
import self.packages.python.escapes
import self.parser.{ seq, wrap, r, opt, keep, keeps, alt, rep, tok, lit }

fn repeated(rule: parser.Rule) -> parser.Rule = seq([rule, rep(rule)])
fn field(family: String) -> parser.Rule = wrap("replacement", seq([
  lit("{"), alt([r("yield_expression"), r("yield_values")]), opt(keep("=")),
  opt(wrap("conversion", seq([lit("!"), keeps(["s", "r", "a"])]))),
  opt(wrap("format", seq([lit(":"), rep(alt([tok(family + "_middle"), r(family + "_field")]))]))), lit("}")
]))
fn rules() -> List[(String, parser.Rule)] = [
  ("strings", alt([
    wrap("text_strings", repeated(alt([tok("string"), r("fstring")]))),
    wrap("byte_strings", repeated(tok("bytes"))),
    wrap("template_strings", repeated(r("tstring")))
  ])),
  ("fstring", wrap("fstring", seq([tok("fstring_start"), rep(alt([tok("fstring_middle"), r("fstring_field")])), tok("fstring_end")]))),
  ("tstring", wrap("tstring", seq([tok("tstring_start"), rep(alt([tok("tstring_middle"), r("tstring_field")])), tok("tstring_end")]))),
  ("fstring_field", field("fstring")),
  ("tstring_field", field("tstring")),
]

// Keep CPython-compatible lexical STRING tokens and refine bytes only for the
// grammar, and distinguish imaginary numbers for pattern literals. Conversion adjacency is source-sensitive and cannot be a PEG Lit.
fn prepare(tokens: List[tree.Token]) -> Result[List[tree.Token], parser.Failure] = {
  escapes.validate(tokens)!
  for i in 0..<list.len(tokens) {
    let token = tokens[i]
    if token.kind == "punct" and token.text == "!" then {
      let next = list.get(tokens, i + 1)
      guard option.map(next, (t) => t.start == token.end) ?? false else err(parser.Failure {
        line: token.line, col: token.col, found: token.text,
        expected: ["conversion type immediately after !"]
      })
    } else ()
  }
  ok(list.map(tokens, (t) => {
    if t.kind == "string" and (option.map(strings.opening(bytes.from_string(t.text), 0), (o) => o.byte_literal) ?? false) then
      tree.Token { ...t, kind: "bytes" }
    else if t.kind == "number" and string.ends_with(string.to_lower(t.text), "j") then tree.Token { ...t, kind: "imaginary" }
    else t
  }))
}
