// Python 3.14 expression precedence. This reusable rule set is not a complete
// Python grammar; statements and remaining expression forms are added separately.
import self.packages.python.containers
import self.packages.python.arguments
import self.packages.python.comprehensions
import self.packages.python.lambdas
import self.packages.python.string_expressions
import self.tree
import self.parser
import self.parser.{ nest, seq, nott, lits, tok, wrap, r, opt, keep, leftf, prec, alt, rep, keeps, lit, grammar, field, needs }

let HARD_KEYWORDS = ["False", "None", "True", "and", "as", "assert", "async", "await", "break", "class", "continue", "def", "del", "elif", "else", "except", "finally", "for", "from", "global", "if", "import", "in", "is", "lambda", "nonlocal", "not", "or", "pass", "raise", "return", "try", "while", "with", "yield"]

fn rules() -> List[(String, parser.Rule)] = [
  ("name", seq([nott(lits(HARD_KEYWORDS)), tok("identifier")])),
  ("expression", alt([r("lambda"), r("conditional")])),
  ("conditional", nest("conditional", seq([r("disjunction"), opt(seq([keep("if"), r("disjunction"), keep("else"), r("expression")]))]))),
  ("assignment_expression", wrap("named", seq([r("name"), lit(":="), r("expression")]))),
  // The walrus reads `name := expression`, and it was tried first, so every
  // expression that is not one paid for a `name` that led nowhere: 7,690 times
  // in `inspect.py`, 20,700 visits. The other branch already ends in "and no
  // `:=` follows", which is exactly the case the walrus wants, so trying it
  // first decides the common case in one pass and leaves the walrus the
  // failure it is the answer to. Ordered choice, same two branches, same
  // language.
  ("named_expression", alt([seq([r("expression"), nott(lit(":="))]), r("assignment_expression")])),
  // `or` and `and` are one ladder: two levels, lowest first, left-associative
  ("disjunction", prec("boolean", r("inversion"), [keep("or"), keep("and")])),
  ("inversion", alt([wrap("unary", seq([keep("not"), r("inversion")])), r("comparison")])),
  ("comparison", nest("comparison", seq([r("bit_or"), rep(seq([r("comparison_op"), r("bit_or")]))]))),
  ("comparison_op", wrap("comparison_operator", alt([seq([keep("not"), keep("in")]), seq([keep("is"), keep("not")]), keeps(["==", "!=", "<=", "<", ">=", ">", "in", "is"])]))),
  // The six binary levels are one ladder. Written as nested folds, reaching a
  // name cost a rule apiece before the operand was even tried.
  ("bit_or", prec("binary", r("factor"), [
    keep("|"), keep("^"), keep("&"), keeps(["<<", ">>"]), keeps(["+", "-"]), keeps(["*", "@", "/", "//", "%"])
  ])),
  ("factor", alt([wrap("unary", seq([keeps(["+", "-", "~"]), r("factor")])), r("power")])),
  // Power binds less tightly than unary on its right, more tightly on its left.
  ("power", nest("power", seq([r("await_primary"), opt(seq([keep("**"), r("factor")]))]))),
  ("await_primary", alt([wrap("await", seq([lit("await"), r("primary")])), r("primary")])),
  ("primary", nest("primary", seq([r("atom"), rep(r("primary_suffix"))]))),
  // A call is tried before a generator call, not after it. `f(x for y in z)` is
  // rare and `f(x)` is not, and reading `f(x)` as a generator first means
  // parsing `x` as a whole expression, looking for a `for` that is not there,
  // and parsing it again: 2,432 failures and 98,865 visits in `inspect.py`, a
  // quarter of the file's parse. A call that turns out to hold a generator
  // fails on the `)` it does not find and falls through to the branch that
  // reads it, which is what ordered choice is for.
  ("primary_suffix", alt([r("attribute_suffix"), r("call_suffix"), r("generator_call"), r("subscript_suffix")])),
  ("attribute_suffix", wrap("attribute", seq([lit("."), field("field", r("name"))]))),
  ("call_suffix", wrap("call", seq([lit("("), opt(r("call_arguments")), lit(")")]))),
  ("subscript_suffix", wrap("subscript", seq([lit("["), r("slices"), lit("]")]))),
  // and the same for the displays: `[1, 2]` is not a list comprehension, and
  // finding that out by parsing `1` as a comprehension's element first costs
  // the same wasted expression. Each display ends where a `for` would begin, so
  // a display that is a comprehension fails there and the comprehension reads it.
  ("atom", alt([tok("number"), tok("imaginary"), r("strings"), keeps(["True", "False", "None", "..."]), r("name"), r("tuple_display"), r("list_display"), r("dict_display"), r("set_display"), seq([lit("("), alt([r("yield_expression"), r("named_expression")]), lit(")")]), r("comprehension")])),
  ("yield_expression", alt([
    wrap("yield_from", seq([lit("yield"), lit("from"), r("expression")])),
    wrap("yield", seq([lit("yield"), opt(r("yield_values"))]))
  ])),
  ("yield_item", alt([r("starred"), r("expression")])),
  // A tuple needs a comma, and the line-scan guard can see one — outside
  // brackets, before the newline — without parsing anything. Without it, every
  // `return x` and every `x = expr` read the whole expression, looked for the
  // comma that was not there, and read it again: 1,105 failures and 69,808
  // visits in `inspect.py`, a quarter of the parse and the largest single cost
  // left in it. `f(a, b)` is not a false alarm either: that comma is inside
  // brackets, and the scan does not count it.
  ("yield_values", alt([
    seq([needs(lit(",")), wrap("tuple", seq([r("yield_item"), lit(","), opt(containers.separated(r("yield_item")))]))]),
    r("yield_item")
  ])),
] + containers.rules() + arguments.rules() + comprehensions.rules() + lambdas.rules() + string_expressions.rules()

fn expression_grammar() -> parser.Grammar = grammar("evaluation", [
  ("evaluation", seq([alt([r("evaluation_tuple"), r("expression")]), opt(tok("newline"))])),
  ("evaluation_tuple", wrap("tuple", seq([r("expression"), lit(","), opt(containers.separated(r("expression")))])))
] + rules())

// Package entry point applies source-sensitive literal checks before PEG parsing.
fn parse_with(compiled: parser.Compiled, source: Bytes, tokens: List[tree.Token]) -> Result[parser.Parsed, parser.Failure] =
  parser.parse_with(compiled, source, string_expressions.prepare(source, tokens)!)
