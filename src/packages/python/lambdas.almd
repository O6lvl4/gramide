// Python 3.14 lambda parameter ordering, following lambda_parameters in
// CPython's PEG grammar. Parameter delimiters consume commas or look at ':'.
import self.parser
import self.parser.{ seq, nott, wrap, r, opt, keep, alt, rep, lit }

fn one_or_more(rule: parser.Rule) -> parser.Rule = seq([rule, rep(rule)])
fn end_parameter() -> parser.Rule = alt([lit(","), nott(nott(lit(":")))])
fn parameter(default: parser.Rule) -> parser.Rule = seq([wrap("parameter", seq([r("name"), default])), end_parameter()])
fn rules() -> List[(String, parser.Rule)] = [
  ("lambda", wrap("lambda", seq([lit("lambda"), wrap("parameters", opt(r("lambda_parameters"))), lit(":"), r("expression")]))),
  ("lambda_parameters", alt([
    seq([r("lambda_slash_required"), rep(r("lambda_required")), rep(r("lambda_default")), opt(r("lambda_star"))]),
    seq([r("lambda_slash_default"), rep(r("lambda_default")), opt(r("lambda_star"))]),
    seq([one_or_more(r("lambda_required")), rep(r("lambda_default")), opt(r("lambda_star"))]),
    seq([one_or_more(r("lambda_default")), opt(r("lambda_star"))]),
    r("lambda_star")
  ])),
  ("lambda_slash_required", seq([one_or_more(r("lambda_required")), keep("/"), end_parameter()])),
  ("lambda_slash_default", seq([rep(r("lambda_required")), one_or_more(r("lambda_default")), keep("/"), end_parameter()])),
  ("lambda_required", parameter(seq([]))),
  ("lambda_default", parameter(seq([lit("="), r("expression")]))),
  ("lambda_optional", parameter(opt(seq([lit("="), r("expression")])))),
  ("lambda_star", alt([
    seq([wrap("vararg", seq([lit("*"), r("lambda_required")])), rep(r("lambda_optional")), opt(r("lambda_kwarg"))]),
    seq([keep("*"), lit(","), one_or_more(r("lambda_optional")), opt(r("lambda_kwarg"))]),
    r("lambda_kwarg")
  ])),
  ("lambda_kwarg", wrap("kwarg", seq([lit("**"), r("lambda_required")]))),
]
