// Python declarations compose names, signatures and the shared suite grammar.
import self.parser
import self.packages.python.parameters
import self.packages.python.containers
import self.parser.{ seq, wrap, field, r, opt, keep, alt, rep, tok, lit }

fn rules() -> List[(String, parser.Rule)] = [
  ("declaration", alt([r("function_def"), r("class_def")])),
  ("decorators", wrap("decorators", rep(seq([lit("@"), r("named_expression"), tok("newline")])))),
  ("function_def", wrap("function_declaration", seq([
    r("decorators"), opt(keep("async")), lit("def"), field("name", r("name")),
    r("type_parameters"), lit("("), wrap("parameters", opt(r("function_parameters"))), lit(")"),
    wrap("returns", opt(seq([lit("->"), r("expression")]))), lit(":"), r("suite")
  ]))),
  ("class_def", wrap("class_declaration", seq([
    r("decorators"), lit("class"), field("name", r("name")), r("type_parameters"),
    wrap("bases", opt(seq([lit("("), opt(r("call_arguments")), lit(")")]))), lit(":"), r("suite")
  ]))),
  ("type_alias", wrap("type_alias", seq([lit("type"), field("name", r("name")), r("type_parameters"), lit("="), r("expression")]))),
  ("type_parameters", wrap("type_parameters", opt(seq([lit("["), containers.separated(r("type_parameter")), lit("]")])))),
  ("type_parameter", alt([
    wrap("type_var", seq([r("name"), wrap("bound", opt(seq([lit(":"), r("expression")]))), wrap("default", opt(seq([lit("="), r("expression")])))])),
    wrap("type_var_tuple", seq([lit("*"), r("name"), wrap("default", opt(seq([lit("="), r("yield_item")])))])),
    wrap("param_spec", seq([lit("**"), r("name"), wrap("default", opt(seq([lit("="), r("expression")])))]))
  ])),
] + parameters.rules()
