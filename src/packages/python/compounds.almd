// Python block/control-flow grammar. Declarations and match statements share the suite rules.
import self.parser
import self.packages.python.containers
import self.packages.python.arguments
import self.parser.{ seq, nott, wrap, r, opt, keep, alt, rep, tok, lit }

fn more(rule: parser.Rule) -> parser.Rule = seq([rule, rep(rule)])
fn ahead(rule: parser.Rule) -> parser.Rule = nott(nott(rule))
fn branch(keyword: String) -> parser.Rule = wrap("if_stmt", seq([
  lit(keyword), r("named_expression"), lit(":"), r("suite"), opt(alt([r("elif_stmt"), r("else_suite")]))
]))
fn handler(star: Bool) -> parser.Rule = wrap("handler", seq([
  lit("except"), if star then lit("*") else seq([]),
  wrap("exception_spec", if star then r("exception_spec") else opt(r("exception_spec"))),
  lit(":"), r("suite")
]))
fn rules() -> List[(String, parser.Rule)] = [
  ("statement", parser.recover_lines(alt([r("compound_stmt"), r("simple_stmts")]))),
  ("suite", wrap("block", alt([
    seq([tok("newline"), tok("indent"), more(r("statement")), tok("dedent")]),
    r("simple_stmts")
  ]))),
  ("compound_stmt", alt([r("declaration"), r("match_stmt"), r("if_stmt"), r("while_stmt"), r("for_stmt"), r("with_stmt"), r("try_stmt")])),
  ("if_stmt", branch("if")), ("elif_stmt", branch("elif")),
  ("else_suite", wrap("else", seq([lit("else"), lit(":"), r("suite")]))),
  ("finally_suite", wrap("finally", seq([lit("finally"), lit(":"), r("suite")]))),
  ("while_stmt", wrap("while_stmt", seq([lit("while"), r("named_expression"), lit(":"), r("suite"), opt(r("else_suite"))]))),
  ("for_stmt", wrap("for_stmt", seq([opt(keep("async")), lit("for"), r("targets"), lit("in"), r("yield_values"), lit(":"), r("suite"), opt(r("else_suite"))]))),
  ("with_stmt", wrap("with_stmt", seq([opt(keep("async")), lit("with"), wrap("with_items", alt([
    seq([lit("("), containers.separated(r("with_item")), lit(")"), ahead(lit(":"))]),
    arguments.comma_list(r("with_item"))
  ])), lit(":"), r("suite")]))),
  ("with_item", wrap("with_item", seq([r("expression"), opt(seq([lit("as"), r("star_target")]))]))),
  ("try_stmt", alt([
    wrap("try_stmt", seq([lit("try"), lit(":"), r("suite"), wrap("handlers", more(r("handler"))), opt(r("else_suite")), opt(r("finally_suite"))])),
    wrap("try_star", seq([lit("try"), lit(":"), r("suite"), wrap("handlers", more(r("star_handler"))), opt(r("else_suite")), opt(r("finally_suite"))])),
    wrap("try_stmt", seq([lit("try"), lit(":"), r("suite"), r("finally_suite")]))
  ])),
  ("handler", handler(false)), ("star_handler", handler(true)),
  ("exception_spec", alt([
    seq([r("expression"), lit("as"), r("name")]),
    wrap("tuple", seq([r("expression"), lit(","), opt(containers.separated(r("expression")))])),
    r("expression")
  ])),
]
