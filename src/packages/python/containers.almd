// Display and slice rules referenced by the Python expression grammar.
import self.parser
import self.parser.{ seq, nott, tok, wrap, r, opt, keep, alt, rep, lit }

fn separated(item: parser.Rule) -> parser.Rule = seq([item, rep(seq([lit(","), item])), opt(lit(","))])
fn rules() -> List[(String, parser.Rule)] = [
  ("starred", wrap("starred", seq([lit("*"), r("bit_or")]))),
  ("star_expression", alt([r("starred"), r("expression")])),
  ("star_tuple", wrap("tuple", seq([r("star_expression"), lit(","), opt(separated(r("star_expression")))]))),
  ("tuple_display", seq([lit("("), alt([r("star_tuple"), wrap("tuple", seq([]))]), lit(")")])),
  ("list_display", wrap("list", seq([lit("["), opt(separated(r("star_expression"))), lit("]")]))),
  ("set_display", wrap("set", seq([lit("{"), separated(r("star_expression")), lit("}")]))),
  ("dict_display", wrap("dict", seq([lit("{"), opt(separated(r("dict_item"))), lit("}")]))),
  ("dict_item", alt([
    wrap("dict_unpack", seq([lit("**"), r("bit_or")])),
    wrap("pair", seq([r("expression"), lit(":"), r("expression")]))
  ])),
  ("slices", alt([
    seq([r("slice"), nott(lit(","))]),
    wrap("tuple", separated(alt([r("slice"), r("starred")])))
  ])),
  ("slice", alt([
    wrap("slice", seq([opt(r("expression")), keep(":"), opt(r("expression")), opt(seq([keep(":"), opt(r("expression"))]))])),
    r("expression")
  ])),
]
