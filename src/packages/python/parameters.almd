// Python 3.14 function parameters, following parameters in
// CPython's PEG grammar. Parameter delimiters consume commas or look at ')'.
import self.parser
import self.parser.{ seq, nott, wrap, r, opt, keep, alt, rep, lit }

fn one_or_more(rule: parser.Rule) -> parser.Rule = seq([rule, rep(rule)])
fn end_parameter() -> parser.Rule = alt([lit(","), nott(nott(lit(")")))])
fn parameter(default: parser.Rule) -> parser.Rule = seq([wrap("parameter", seq([r("name"), opt(wrap("annotation", seq([lit(":"), r("expression")]))), default])), end_parameter()])
fn rules() -> List[(String, parser.Rule)] = [
  ("function_parameters", alt([
    seq([r("function_slash_required"), rep(r("function_required")), rep(r("function_default")), opt(r("function_star"))]),
    seq([r("function_slash_default"), rep(r("function_default")), opt(r("function_star"))]),
    seq([one_or_more(r("function_required")), rep(r("function_default")), opt(r("function_star"))]),
    seq([one_or_more(r("function_default")), opt(r("function_star"))]),
    r("function_star")
  ])),
  ("function_slash_required", seq([one_or_more(r("function_required")), keep("/"), end_parameter()])),
  ("function_slash_default", seq([rep(r("function_required")), one_or_more(r("function_default")), keep("/"), end_parameter()])),
  ("function_vararg_required", seq([wrap("parameter", seq([r("name"), opt(wrap("annotation", seq([lit(":"), r("yield_item")])))])), end_parameter()])),
  ("function_required", parameter(seq([]))),
  ("function_default", parameter(wrap("default", seq([lit("="), r("expression")])))),
  ("function_optional", parameter(opt(wrap("default", seq([lit("="), r("expression")]))))),
  ("function_star", alt([
    seq([wrap("vararg", seq([lit("*"), r("function_vararg_required")])), rep(r("function_optional")), opt(r("function_kwarg"))]),
    seq([keep("*"), lit(","), one_or_more(r("function_optional")), opt(r("function_kwarg"))]),
    r("function_kwarg")
  ])),
  ("function_kwarg", wrap("kwarg", seq([lit("**"), r("function_required")]))),
]
