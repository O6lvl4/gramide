// Literal-mode transitions for Python f/t strings. Expressions are scanned by
// the ordinary lexer, with a stack retaining their enclosing literal modes.
import self.lex

type Frame = { family: String, quote: Int, width: Int, raw: Bool, mode: String, depth: Int }
type Segment = { kind: String, end: Int, next: Int }
fn closing(source: Bytes, at: Int, f: Frame) -> Bool =
  bytes.get_or(source, at, -1) == f.quote and (f.width == 1 or (bytes.get_or(source, at + 1, -1) == f.quote and bytes.get_or(source, at + 2, -1) == f.quote))
fn segment(source: Bytes, start: Int, f: Frame, line: Int, col: Int) -> Result[Segment, lex.LexError] = {
  let error = lex.LexError { line: line, col: col, message: "unterminated interpolated string" }
  var i = start
  var found: Option[Segment] = none
  while option.is_none(found) {
    let b = bytes.get_or(source, i, -1)
    guard b >= 0 and (f.width == 3 or (b != 10 and b != 13)) else err(error)
    if closing(source, i, f) then {
      guard f.mode != "format" else err(lex.LexError { ...error, message: "unclosed format replacement field" })
      found = some(if i == start then Segment { kind: "end", end: i + f.width, next: i + f.width } else Segment { kind: "middle", end: i, next: i })
    }
    else if b == 123 or b == 125 then {
      guard b != 125 or f.mode == "format" or bytes.get_or(source, i + 1, -1) == 125 else err(lex.LexError { ...error, message: "single closing brace in interpolated string" })
      if f.mode != "format" and bytes.get_or(source, i + 1, -1) == b then
        found = some(Segment { kind: "middle", end: i + 1, next: i + 2 })
      else if b == 125 and f.mode == "format" then found = some(Segment { kind: "format_end", end: i, next: i })
      else found = some(if i == start then Segment { kind: "open", end: i + 1, next: i + 1 } else Segment { kind: "middle", end: i, next: i })
    }
    else if b == 92 then {
      let next = bytes.get_or(source, i + 1, -1)
      if not f.raw and next == 78 and bytes.get_or(source, i + 2, -1) == 123 then {
        i = i + 3
        while bytes.get_or(source, i, -1) >= 0 and bytes.get_or(source, i, -1) != 125 { i = i + 1 }
        guard bytes.get_or(source, i, -1) == 125 else err(error)
        found = some(Segment { kind: "middle", end: i + 1, next: i + 1 })
      } else if next == 123 or next == 125 then i = i + 1
      else i = i + (if next == 13 and bytes.get_or(source, i + 2, -1) == 10 then 3 else 2)
    } else i = i + 1
  }
  option.to_result(found, error)
}

// Called only after literal-mode scanning fails. Triple strings retain the
// remaining source. A single string stops at its first unescaped physical
// newline; the scanner has already established that this is outside a field.
fn failed_literal_end(source: Bytes, start: Int, f: Frame) -> Int = {
  var i = start
  if f.width == 3 then bytes.len(source)
  else {
    while i < bytes.len(source) and bytes.get_or(source, i, -1) != 10 and bytes.get_or(source, i, -1) != 13 {
      if bytes.get_or(source, i, -1) == 92 then i = i + (if bytes.get_or(source, i + 1, -1) == 13 and bytes.get_or(source, i + 2, -1) == 10 then 3 else 2)
      else i = i + 1
    }
    int.min(i, bytes.len(source))
  }
}
