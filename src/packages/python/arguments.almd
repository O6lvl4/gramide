// Call arguments have three ordering phases: positional, keyword/starred,
// and keyword/double-starred. Repetition avoids recursion per argument.
import self.parser
import self.parser.{ seq, nott, wrap, r, opt, alt, rep, lit }

fn comma_list(item: parser.Rule) -> parser.Rule = seq([item, rep(seq([lit(","), item]))])
fn rules() -> List[(String, parser.Rule)] = [
  ("call_keyword", wrap("keyword", seq([r("name"), lit("="), r("expression")]))),
  // Unlike starred display items, call unpacking accepts a full expression.
  ("call_starred", wrap("starred", seq([lit("*"), r("expression")]))),
  ("call_mapping", wrap("mapping", seq([lit("**"), r("expression")]))),
  ("call_arguments", seq([alt([
    seq([comma_list(alt([r("call_starred"), seq([r("expression"), nott(lit("="))])])), opt(seq([lit(","), r("call_keywords")]))]),
    r("call_keywords")
  ]), opt(lit(","))])),
  ("call_keywords", alt([
    seq([r("call_keyword_stars"), lit(","), r("call_keyword_mappings")]),
    r("call_keyword_stars"),
    r("call_keyword_mappings")
  ])),
  ("call_keyword_stars", comma_list(alt([r("call_keyword"), r("call_starred")]))),
  ("call_keyword_mappings", comma_list(alt([r("call_keyword"), r("call_mapping")]))),
]
