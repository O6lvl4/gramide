// Ordinary Python string boundaries. Interpolated f/t strings need their own
// expression-aware scanner and are deliberately not recognized here.
import self.lex

type Opening = { quote: Int, at: Int, byte_literal: Bool }

fn quote(b: Int) -> Bool = b == 34 or b == 39
fn lower(b: Int) -> Int = if b >= 65 and b <= 90 then b + 32 else b

fn opening(buffer: Bytes, start: Int) -> Option[Opening] = {
  let first = bytes.get_or(buffer, start, -1)
  if quote(first) then some(Opening { quote: first, at: start, byte_literal: false })
  else {
    let a = lower(first)
    let second = bytes.get_or(buffer, start + 1, -1)
    if (a == 114 or a == 98 or a == 117) and quote(second) then
      some(Opening { quote: second, at: start + 1, byte_literal: a == 98 })
    else {
      let b = lower(second)
      let third = bytes.get_or(buffer, start + 2, -1)
      if ((a == 114 and b == 98) or (a == 98 and b == 114)) and quote(third) then
        some(Opening { quote: third, at: start + 2, byte_literal: true })
      else none
    }
  }
}

fn scan(buffer: Bytes, start: Int, line: Int, col: Int) -> Result[Int, lex.LexError] = {
  let error = lex.LexError { line: line, col: col, message: "expected an ordinary Python string" }
  let head = opening(buffer, start) |> option.to_result(error)!
  let triple = bytes.get_or(buffer, head.at + 1, -1) == head.quote and bytes.get_or(buffer, head.at + 2, -1) == head.quote
  let width = if triple then 3 else 1
  var i = head.at + width
  var end = -1
  while end < 0 {
    let b = bytes.get_or(buffer, i, -1)
    guard b >= 0 else err(lex.LexError { ...error, message: "unterminated string literal" })
    guard b != 0 else err(lex.LexError { ...error, message: "source code cannot contain null bytes" })
    guard not head.byte_literal or b < 128 else err(lex.LexError { ...error, message: "bytes literals may only contain ASCII characters" })
    guard triple or (b != 10 and b != 13) else err(lex.LexError { ...error, message: "unterminated string literal" })
    if b == head.quote and (not triple or (bytes.get_or(buffer, i + 1, -1) == head.quote and bytes.get_or(buffer, i + 2, -1) == head.quote)) then end = i + width
    else if b == 92 then {
      // Even raw strings escape delimiters lexically; decoding preserves the
      // backslash later. An odd final backslash cannot close a raw string.
      let next = bytes.get_or(buffer, i + 1, -1)
      guard next != 0 else err(lex.LexError { ...error, message: "source code cannot contain null bytes" })
      guard not head.byte_literal or next < 128 else err(lex.LexError { ...error, message: "bytes literals may only contain ASCII characters" })
      i = i + (if next == 13 and bytes.get_or(buffer, i + 2, -1) == 10 then 3 else 2)
    }
    else i = i + 1
  }
  ok(end)
}

// On a known invalid literal, preserve its lexical extent without certifying
// its contents. Escaped newlines stay inside the literal; an unclosed triple
// literal owns the remaining source, including declaration-looking text.
fn recovery_end(buffer: Bytes, start: Int) -> Int = {
  let head = opening(buffer, start) ?? Opening { quote: bytes.get_or(buffer, start, -1), at: start, byte_literal: false }
  let triple = bytes.get_or(buffer, head.at + 1, -1) == head.quote and bytes.get_or(buffer, head.at + 2, -1) == head.quote
  let width = if triple then 3 else 1
  var i = head.at + width
  var end = -1
  while end < 0 {
    let b = bytes.get_or(buffer, i, -1)
    if b < 0 or (not triple and (b == 10 or b == 13)) then end = int.min(i, bytes.len(buffer))
    else if b == head.quote and (not triple or (bytes.get_or(buffer, i + 1, -1) == head.quote and bytes.get_or(buffer, i + 2, -1) == head.quote)) then end = i + width
    else if b == 92 then i = i + (if bytes.get_or(buffer, i + 1, -1) == 13 and bytes.get_or(buffer, i + 2, -1) == 10 then 3 else 2)
    else i = i + 1
  }
  end
}

test "ordinary prefixes exclude interpolation and obsolete combinations" {
  for prefix in ["", "r", "R", "u", "U", "b", "B", "br", "bR", "Br", "BR", "rb", "rB", "Rb", "RB"] {
    assert(option.is_some(opening(bytes.from_string(prefix + "\"x\""), 0)))
  }
  for prefix in ["f", "fr", "t", "tr", "ur", "bu", "rr", "name"] {
    assert_eq(opening(bytes.from_string(prefix + "\"x\""), 0), none)
  }
}
