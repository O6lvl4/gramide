// Static language package contract. Lexer factories may implement layout,
// interpolation or other language-specific scanning outside the shared engine.
import self.lex
import self.tree
import self.parser

type LexError = lex.LexError
type Token = tree.Token

type Tokenizer = (String, Bool) -> Result[List[tree.Token], lex.LexError]
// `arguments`, `field_access` and `type_name` are the shared vocabulary the
// reference walker reads: the node that closes a call in a postfix chain, the
// node that reads a field, and the node that wraps a type mention. A grammar
// that spells them differently says so here rather than renaming its nodes —
// Python's are `call` and `attribute`, and a type is mentioned under an
// `annotation`, a `returns` or a `bases` rather than in a node of its own.
type SymbolRules = {
  declarations: List[(String, String)], scopes: List[String], namespaces: List[String], callables: List[String],
  lexical_owners: Bool, envelopes: List[String], unnamed_envelopes: List[String],
  arguments: String, field_access: String, type_mentions: List[String]
}
type Definition = {
  id: String, package_name: String, version: String, extensions: List[String], capabilities: List[String],
  lexer: () -> Tokenizer, grammar: () -> parser.Grammar,
  sep: String, symbols: SymbolRules
}
