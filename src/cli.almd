// cli — the gramide command line, as a library.
//
// A binary composes the language packages it ships into a Program and hands
// it here with its arguments: `gramide` ships every package, and a language
// package's own `cli/main.almd` ships itself. The commands are the same.
//
//   <name> languages          the registered packages, as versioned JSON
//   <name> version            what this binary was built from
//   <name> check <file>...    exit 0 if every file parses, else the errors and exit 1
//   <name> parse <file>       the tree as an s-expression
//   <name> tokens <file>      the token stream, one per line
//   <name> outline <file>     declarations with their lines
//   <name> symbols <file>     versioned JSON names, owners and ranges (strict parse)
//   <name> symbols-recovered <file>
//                             the same over a recovered parse, where a package offers it
//   <name> tags <file>        definitions and references, for a repo map
//   <name> balance <file>...  delimiters and literals only: the check a language
//                             with no grammar here can still have
//   <name> map <dir> [--budget N] [--task TEXT]
//                             a ranked map of a repository within N tokens (default 1024),
//                             personalised toward what TEXT mentions
//   <name> reparse <file> --edit START:OLD_END:NEW_END --new <edited file>
//                             the file's symbols after an edit, re-read incrementally from
//                             the whole parse of the file (stderr says which it was)
//   <name> reparse-bench <file> [--edits N] [--seed S] [--verify K] [--breaking] [--slow N]
//                             N keystroke edits re-read incrementally, timed; every K
//                             edits the result is checked against a whole parse
//
// `check` is the gate: strict, and its exit code is the verdict. Every other
// command is a reader, and a reader answers about the file it was given even
// when that file does not parse — the tree is the recovered one, with an ERROR
// node over each part the grammar had to give up, and the reason goes to stderr.

import self.about
import self.registry
import self.tree
import self.lang
import self.tags
import self.balance
import self.map
import self.symbols
import self.keystrokes
import self.incremental
import self.parser
import self.package_api
import fs
import process

// What a binary was built from: its own name and version, the language
// packages it composed, and how it runs `check` over many files. Nothing
// else about a language is known here.
type Program = { name: String, version: String, packages: List[package_api.Definition] }

fn usage(p: Program) -> String = "usage: " + p.name + " languages\n       " + p.name + " version\n       "
  + p.name + " (parse | tokens | outline | symbols | symbols-recovered | tags) <file>\n       "
  + p.name + " (check | balance) <file>...\n       " + p.name + " map <dir> [--budget N] [--task TEXT]\n       "
  + p.name + " reparse <file> --edit START:OLD_END:NEW_END --new <edited file>\n       "
  + p.name + " reparse-bench <file> [--edits N] [--seed S] [--verify K] [--breaking] [--slow N]"

// One line per component, so a bug report can say exactly what was linked.
fn version_lines(p: Program) -> List[String] =
  [p.name + " " + p.version, "gramide " + about.VERSION + " (engine)"]
  + list.map(p.packages, (d) => d.package_name + " " + d.version + " (" + list.join(d.extensions, " ") + ")")

effect fn read(path: String) -> Result[String, String] = fs.read_text(path) |> result.map_err((e) => path + ": " + e)

// A reader that had to recover says so, on stderr, so its answer is never
// mistaken for the answer about a file that parses.
effect fn note(d: lang.Reading) -> Unit = match d.error {
  none => (),
  some(e) => eprintln(e + " [recovered, " + int.to_string(d.errors) + " part(s) skipped]"),
}

// One write for a command's whole answer. Rust's stdout is a LineWriter, so a
// `println` per line is a `write` per line whether or not stdout is a terminal:
// 18,966 of them for `tokens` on inspect.py, 253 for `outline` on typing.py.
// The lines are a list by then, and joining them costs one pass over bytes the
// command has already built. `check` keeps its line at a time: its answers are
// interleaved with the diagnostics on stderr, and that order is the output.
effect fn print_lines(lines: List[String]) -> Unit =
  if list.is_empty(lines) then () else println(list.join(lines, "\n"))

// An extension no package registers, and a package that has no such command,
// are different answers; the batch path says the same two things.
fn provides(packages: List[package_api.Definition], path: String, cmd: String) -> Result[Unit, String] = {
  let d = registry.resolve_in(packages, path)!
  guard list.contains(d.capabilities, cmd) else err(path + ": no language package provides " + cmd)
  ok(())
}

effect fn run_one(p: Program, cmd: String, path: String) -> Result[Unit, String] = {
  if cmd == "balance" then () else provides(p.packages, path, cmd)!
  let src = read(path)!
  match cmd {
    "tokens" => {
      let toks = lang.tokens_for(p.packages, path, src)!
      let names = tree.kind_names()
      let source = bytes.from_string(src)
      let _ = print_lines(list.map(toks, (t) => int.to_string(t.line) + ":" + int.to_string(t.col) + " " + tree.kind_name_in(names, t.kind) + " " + tree.token_text(source, t)))
      ok(())
    },
    // the readers answer about the file they were given even when it does not
    // parse: the tree is the recovered one and the reason goes to stderr
    "parse" => { let d = lang.read_source(p.packages, path, src)!; let _ = note(d); println(tree.sexp(d.parsed.root, d.parsed.names)); ok(()) },
    "symbols" => { println(symbols.document(p.packages, path, src)!); ok(()) },
    "symbols-recovered" => { println(symbols.recovered_document(p.packages, path, src)!); ok(()) },
    "outline" => { let d = lang.read_source(p.packages, path, src)!; let _ = note(d); let _ = print_lines(tags.outline(d.parsed.root, d.parsed.toks, bytes.from_string(src), d.parsed.names, d.sep, d.symbols)); ok(()) },
    "tags" => { let d = lang.read_source(p.packages, path, src)!; let _ = note(d); let _ = print_lines(tags.tags(d.parsed.root, d.parsed.toks, bytes.from_string(src), d.parsed.names, d.sep, d.symbols)); ok(()) },
    // the gate. strict, and the only command whose exit code is a verdict
    "check" => { let _ = lang.verify_source(p.packages, path, src)!; println(path + ": ok"); ok(()) },
    // no grammar needed, and no false rejection possible: valid code balances
    "balance" => match balance.check(src) {
      none => { println(path + ": balanced"); ok(()) },
      some(f) => err(path + ":" + int.to_string(f.line) + ":" + int.to_string(f.col) + ": " + f.message),
    },
    _ => err(usage(p)),
  }
}

// One verdict, and which stream it belongs on. Keeping the two streams in ONE
// ordered list rather than two buffers is the whole trick: a caller that has
// merged them with `2>&1` sees exactly the order a sequential run produced.
type Line = { text: String, is_err: Bool }
type Chunk = { lines: List[Line], failed: Bool }

// One slice of the file list, answered rather than printed, so that the arms of
// a `fan` can finish in any order and the output still comes out in list order.
// `packages` is built by the arm itself (see `sequential`).
effect fn check_chunk(packages: List[package_api.Definition], cmd: String, paths: List[String], from: Int, to: Int) -> Chunk = {
  let mine = list.slice(paths, from, to)
  let engines = lang.engines_for(packages, mine)
  var lines: List[Line] = []
  var failed = false
  for p in mine {
    match read(p) {
      err(e) => {
        list.push(lines, Line { text: e, is_err: true })
        failed = true
      },
      ok(src) => if cmd == "balance" then match balance.check(src) {
        none => list.push(lines, Line { text: p + ": balanced", is_err: false }),
        some(f) => {
          list.push(lines, Line { text: p + ":" + int.to_string(f.line) + ":" + int.to_string(f.col) + ": " + f.message, is_err: true })
          failed = true
        },
      } else match lang.verify_with(engines, p, src) {
        err(e) => {
          list.push(lines, Line { text: e, is_err: true })
          failed = true
        },
        ok(_) => list.push(lines, Line { text: p + ": ok", is_err: false }),
      },
    }
  }
  Chunk { lines: lines, failed: failed }
}

// Where to cut the list into `of` slices of roughly equal BYTES. Cutting by
// file count instead looks right and is not: on Go's tree it put 12.9 MB of
// 25.5 into one of eight slices, and the slowest slice is the wall time.
effect fn cut_points(paths: List[String], of: Int) -> List[Int] = {
  var sizes: List[Int] = []
  var total = 0
  for p in paths {
    let s = fs.file_size(p) ?? 0
    list.push(sizes, s)
    total = total + s
  }
  var cuts: List[Int] = [0]
  var acc = 0
  var target = 1
  var i = 0
  while i < list.len(sizes) {
    acc = acc + (list.get(sizes, i) ?? 0)
    if target < of and acc * of >= total * target then {
      list.push(cuts, i + 1)
      target = target + 1
    } else ()
    i = i + 1
  }
  while list.len(cuts) <= of { list.push(cuts, list.len(paths)) }
  cuts
}

fn cut_at(cuts: List[Int], i: Int) -> Int = list.get(cuts, i) ?? 0

// `check` and `balance` take any number of files. Both are what a gate runs
// over a whole tree, and running them in one process compiles each grammar
// once instead of once per file.
//
// The files are independent, so a binary cuts the list into eight slices of
// roughly equal bytes and checks them in a `fan` block, answering the lines
// rather than printing them from inside an arm so that the output still comes
// out in list order: `check` output is byte-identical on all 39,021 corpus
// files, stdout and stderr merged, and 25.5 MB of Go went from 2.74 s to
// 0.70 s. That block stands in each binary's main.almd, not here: a `fan`
// arm may carry only values without closures, a language package's lexer is
// a closure, and so each arm has to build the packages by name — which only
// the binary that composes them can do (see `batch_of`). `sequential` is the
// one-slice batch for a binary that does not.
effect fn sequential(packages: List[package_api.Definition], cmd: String, paths: List[String]) -> List[Chunk] = {
  let only = check_chunk(packages, cmd, paths, 0, list.len(paths))!
  [only]
}

// The slices' lines in list order, each on its stream; exit 1 if any failed.
effect fn report(parts: List[Chunk]) -> Unit = {
  var failed = false
  for c in parts {
    for l in c.lines {
      if l.is_err then eprintln(l.text) else println(l.text)
    }
    if c.failed then failed = true else ()
  }
  if failed then process.exit(1) else ()
}

// `--budget N` and `--task TEXT` after the directory; anything else is the task too.
fn option_after(argv: List[String], flag: String) -> Option[String] = {
  var found: Option[String] = none
  var i = 0
  while i < list.len(argv) {
    if (list.get(argv, i) ?? "") == flag then found = list.get(argv, i + 1) else ()
    i = i + 1
  }
  found
}

effect fn run_map(packages: List[package_api.Definition], argv: List[String]) -> Result[Unit, String] = {
  let dir = list.get(argv, 1) ?? "."
  let budget = int.parse(option_after(argv, "--budget") ?? "1024") ?? 1024
  let task = option_after(argv, "--task") ?? ""
  let scan = map.scan(packages, dir)!
  let m = map.build(scan, task, budget)
  if m.text != "" then println(string.trim_end(m.text)) else ()
  eprintln("# " + int.to_string(m.files_scanned) + " files, " + int.to_string(m.symbols_shown) + " of " + int.to_string(m.symbols_total)
    + " symbols shown, ~" + int.to_string(m.approx_tokens) + " tokens")
  for e in m.errors { eprintln("# " + e) }
  ok(())
}

effect fn run_reparse_bench(packages: List[package_api.Definition], argv: List[String]) -> Result[Unit, String] = {
  let path = list.get(argv, 1) ?? ""
  let edits = int.parse(option_after(argv, "--edits") ?? "1000") ?? 1000
  let seed = int.parse(option_after(argv, "--seed") ?? "7") ?? 7
  let verify = int.parse(option_after(argv, "--verify") ?? "50") ?? 50
  let l = lang.language_of(packages, path)!
  let src = read(path)!
  println(keystrokes.run(l, bytes.from_string(src), edits, seed, verify, option_after(argv, "--dump") ?? "", list.contains(argv, "--breaking"), int.parse(option_after(argv, "--slow") ?? "0") ?? 0)!)
  ok(())
}

// One edit, end to end: parse the file, take the edit and the new text,
// re-read what the edit touched, and answer the symbols of the result.
effect fn run_reparse(packages: List[package_api.Definition], argv: List[String]) -> Result[Unit, String] = {
  let path = list.get(argv, 1) ?? ""
  let spec = option_after(argv, "--edit") ?? ""
  let parts = string.split(spec, ":")
  guard list.len(parts) == 3 else err("--edit START:OLD_END:NEW_END")
  let edit = incremental.Edit { start: int.parse(list.get(parts, 0) ?? "") ?? -1, old_end: int.parse(list.get(parts, 1) ?? "") ?? -1, new_end: int.parse(list.get(parts, 2) ?? "") ?? -1 }
  guard edit.start >= 0 and edit.old_end >= edit.start and edit.new_end >= edit.start else err("--edit START:OLD_END:NEW_END")
  let l = lang.language_of(packages, path)!
  let before = read(path)!
  let after = read(option_after(argv, "--new") ?? "")!
  let scan = l.tokenize
  var c = l.grammar
  let old_source = bytes.from_string(before)
  let new_source = bytes.from_string(after)
  guard bytes.len(new_source) == bytes.len(old_source) + edit.new_end - edit.old_end else err("the new text is not the file with that edit applied: " + int.to_string(bytes.len(new_source)) + " bytes, expected " + int.to_string(bytes.len(old_source) + edit.new_end - edit.old_end))
  let first = parser.parse_with(c, old_source, scan(before, false) |> result.map_err((e) => path + ": " + int.to_string(e.line) + ":" + int.to_string(e.col) + ": " + e.message)!) |> result.map_err((f) => path + ":" + parser.format_failure(f))!
  var doc = incremental.from_parsed(first, old_source, c)
  let status = incremental.reparse_status(doc, new_source, edit, scan, c)
  let parsed = if status == incremental.DONE then incremental.materialize(doc)
    else parser.parse_with(c, new_source, scan(after, false) |> result.map_err((e) => path + ": " + int.to_string(e.line) + ":" + int.to_string(e.col) + ": " + e.message)!) |> result.map_err((f) => path + ":" + parser.format_failure(f))!
  eprintln(if status == incremental.DONE then "reparse: incremental" else "reparse: whole file (" + int.to_string(status) + ")")
  println(symbols.document_parsed(l, parsed, after)!)
  ok(())
}

effect fn fail(e: String) -> Unit = { eprintln(e); process.exit(1) }

// `check` and `balance` over two or more files are a batch, and a batch is
// the one thing a binary runs itself: `fan` arms may carry only values
// without closures, a language package's lexer is one, and so the arms have
// to build the packages by name, which only the binary that composes them
// can do. A binary asks this first and hands the answer to its own
// `parallel` (or to `sequential`), then `report`; everything else is `run`.
//
// One file is not a batch. It is what an agent checks after every write, and
// spawning eight threads to hand seven of them nothing cost it 0.45 ms of a
// 3 ms run; `run_one` answers it with the same text and the same exit code.
fn batch_of(argv: List[String]) -> Option[(String, List[String])] = {
  let cmd = list.get(argv, 0) ?? ""
  let rest = list.drop(argv, 1)
  if (cmd == "check" or cmd == "balance") and list.len(rest) > 1 then some((cmd, rest)) else none
}

// Every command but a batch. A binary that skips `batch_of` still gets a
// correct `check`, one slice at a time.
effect fn run(p: Program, argv: List[String]) -> Unit = {
  match registry.conflict(p.packages) {
    some(e) => { eprintln(p.name + ": " + e); process.exit(2) },
    none => (),
  }
  let cmd = list.get(argv, 0) ?? ""
  if cmd == "languages" then println(registry.manifest(p.packages))
  else if cmd == "version" then print_lines(version_lines(p))
  // matched here rather than handed to a helper: the native backend inserts
  // a `?` on an effect call in argument position, and not on one being matched
  else if cmd == "map" then match run_map(p.packages, argv) { ok(_) => (), err(e) => fail(e) }
  else if cmd == "reparse-bench" then match run_reparse_bench(p.packages, argv) { ok(_) => (), err(e) => fail(e) }
  else if cmd == "reparse" then match run_reparse(p.packages, argv) { ok(_) => (), err(e) => fail(e) }
  else match batch_of(argv) {
    some((batch, paths)) => {
      let parts = sequential(p.packages, batch, paths)!
      report(parts)
    },
    none => match list.get(argv, 1) {
      some(path) => match run_one(p, cmd, path) { ok(_) => (), err(e) => fail(e) },
      none => fail(usage(p)),
    },
  }
}

test "a batch is check or balance over two or more files" {
  assert_eq(batch_of(["check", "a.go", "b.go"]), some(("check", ["a.go", "b.go"])))
  assert_eq(batch_of(["balance", "a.java", "b.java"]), some(("balance", ["a.java", "b.java"])))
  assert_eq(batch_of(["check", "a.go"]), none)
  assert_eq(batch_of(["check"]), none)
  assert_eq(batch_of(["outline", "a.go"]), none)
}

test "option_after reads the value that follows a flag" {
  assert_eq(option_after(["map", ".", "--budget", "64", "--task", "fix"], "--budget"), some("64"))
  assert_eq(option_after(["map", "."], "--task"), none)
}
