// lex — bytes in, tokens out, for every language.
//
// One driver, one set of byte helpers, one operator scanner. What a language
// brings is a `Spec`: its keywords and operators, its comment markers, and a
// choice of family for the two things that genuinely differ between languages,
// numbers and string literals.
//
// The families are named rather than described by flags on purpose. A table
// that tried to describe every string syntax would be wrong the first time it
// met a Rust `r#"…"#` or a Python f-string, and being wrong about a string is
// being wrong about where the code ends. So a family is hand-written, lives
// here beside the others, and a new language either names one that already
// fits or adds one. The rest of a language is data.
//
// Everything is in this one module because the native backend passes a list by
// reference only while every use of it borrows: a byte helper in another module
// would clone the whole source at each call, and a scanner that dispatched to a
// sibling would put the two in a mutually recursive group and clone it again.
// That is why `scan_string` is one self-recursive function with both families
// inside it rather than two functions and a dispatcher.
//
// Positions are byte offsets into the UTF-8 source, plus 1-based line and
// column, computed once as the tokens are made.

import self.tree

// ── character classes over bytes ──────────────────────────────────────────

fn is_digit(b: Int) -> Bool = b >= 48 and b <= 57
fn is_hex(b: Int) -> Bool = is_digit(b) or (b >= 97 and b <= 102) or (b >= 65 and b <= 70)
fn is_alpha(b: Int) -> Bool = (b >= 97 and b <= 122) or (b >= 65 and b <= 90) or b == 95
fn is_ident(b: Int) -> Bool = is_alpha(b) or is_digit(b) or b >= 128
fn is_upper(b: Int) -> Bool = b >= 65 and b <= 90
fn is_space(b: Int) -> Bool = b == 32 or b == 9 or b == 13

fn source_byte_at(buffer: Bytes, i: Int) -> Int = bytes.get_or(buffer, i, -1)

// Copy only buffer[s, e) from the compact byte source, preserving the
// existing lossy UTF-8 decoding behavior for token text.
fn text(buffer: Bytes, s: Int, e: Int) -> String =
  bytes.to_string_lossy(bytes.slice(buffer, s, e))

fn mk(buffer: Bytes, kind: Int, s: Int, e: Int, line: Int, line_start: Int) -> tree.Token =
  tree.Token { kind: kind, text: text(buffer, s, e), start: s, end: e, line: line, col: s - line_start + 1 }

type LexError = { line: Int, col: Int, message: String }

// ── what a language is ────────────────────────────────────────────────────

// How numbers are written.
let N_ALMIDE = 0     // 0x 0b 0o with their own digit sets, `1.5` needs a digit after the dot
let N_GO = 1         // hex floats, `.5` and `1.`, an `i` suffix for imaginaries
let N_RUST = 2       // 0x 0o 0b, `1.` when nothing follows it, a type suffix like `u8`

// How string literals are written.
let S_ALMIDE = 0     // "…" '…' with escapes, ${…} interpolation, """ heredocs, r"…" raw
let S_GO = 1         // "…" '…' one line only, `…` raw across lines
let S_RUST = 2       // "…" across lines, r#"…"# with any number of hashes, b prefixes,
                     //   and `'` that is a character only when it closes like one

// What a newline means.
let NL_EVERY = 0     // a separator wherever one appears, runs collapsed to one
let NL_SEMI = 1      // a separator only after a token that can end a statement
let NL_NONE = 2      // nothing; the language separates with `;` and braces

type Spec = {
  keywords: List[String],
  operators: List[String],          // longest first, so `..<` wins over `..`
  numbers: Int,
  strings: Int,
  newlines: Int,
  ends_kw: List[String],            // NL_SEMI: keywords a statement may end on
  line_comment: List[Int],          // bytes; empty for a language with none
  block_open: List[Int],
  block_close: List[Int],
  nested_block: Bool,               // `/* /* */ */` is one comment
  block_comment_newline: Bool,      // NL_SEMI: a comment spanning lines can separate
  upper_is_type: Bool,              // a capitalised word is a type_name, not an identifier
  backtick_ident: Bool,             // `type` is a name that happens to be a keyword
  neg_token: Bool,                  // a line-initial `-` glued to its operand is its own kind
}

// ── scanners ──────────────────────────────────────────────────────────────

fn matches_at(buffer: Bytes, i: Int, pat: List[Int]) -> Bool = {
  let n = list.len(pat)
  if n == 0 then false
  else {
    var k = 0
    var same = true
    while same and k < n {
      if source_byte_at(buffer, i + k) != (match list.get(pat, k) { some(v) => v, none => -2 }) then same = false else k = k + 1
    }
    same
  }
}

fn scan_word(buffer: Bytes, start: Int) -> Int = {
  var i = start
  while is_ident(source_byte_at(buffer, i)) { i = i + 1 }
  i
}

// `\`type\`` — a keyword used as a name. Returns the end offset past the
// closing backtick, or the start when the backtick opens nothing.
fn scan_backtick(buffer: Bytes, start: Int) -> Int = {
  let e = scan_word(buffer, start + 1)
  if e == start + 1 then start else if source_byte_at(buffer, e) == 96 then e + 1 else e
}

fn starts_number(buffer: Bytes, i: Int, family: Int) -> Bool =
  is_digit(source_byte_at(buffer, i)) or (family == N_GO and source_byte_at(buffer, i) == 46 and is_digit(source_byte_at(buffer, i + 1)))

// How many buffer the character starting with this byte takes.
fn utf8_len(b: Int) -> Int = if b < 128 then 1 else if b < 224 then 2 else if b < 240 then 3 else 4

// Rust writes a lifetime with the same quote it writes a character with, so
// `'a` in `&'a str` and `'a'` are told apart only by what closes them. `q` is
// at the opening quote; the answer is the offset past the closing one, or -1
// when nothing closes it and the quote belongs to a lifetime.
fn rust_char_end(buffer: Bytes, q: Int) -> Int = {
  let j = q + 1
  let b = source_byte_at(buffer, j)
  if b == 92 then {                                    // an escape
    let k = if source_byte_at(buffer, j + 1) == 117 then {          // \u{…}
      var m = j + 2
      while m < j + 16 and source_byte_at(buffer, m) != 125 and source_byte_at(buffer, m) != -1 { m = m + 1 }
      m + 1
    } else j + 2
    if source_byte_at(buffer, k) == 39 then k + 1 else -1
  }
  else if b == -1 or b == 10 or b == 39 then -1
  else {
    let e = j + utf8_len(b)
    if source_byte_at(buffer, e) == 39 then e + 1 else -1
  }
}

fn starts_string(buffer: Bytes, i: Int, family: Int) -> Bool = {
  let b = source_byte_at(buffer, i)
  if family == S_GO then b == 34 or b == 39 or b == 96
  else if family == S_RUST then {
    let q = if b == 98 then i + 1 else i               // a `b` prefix
    let c = source_byte_at(buffer, q)
    if c == 34 then true
    else if c == 39 then rust_char_end(buffer, q) >= 0
    else if c == 114 then {                            // r"…" or r#"…"#
      var k = q + 1
      while source_byte_at(buffer, k) == 35 { k = k + 1 }
      source_byte_at(buffer, k) == 34
    }
    else false
  }
  else b == 34 or b == 39 or (b == 114 and source_byte_at(buffer, i + 1) == 34)
}

// The kind of the literal starting here: a character or a string.
fn literal_kind(buffer: Bytes, i: Int, family: Int) -> Int =
  if family == S_GO then (if source_byte_at(buffer, i) == 39 then tree.T_RUNE else tree.T_STRING)
  else if family == S_RUST then (if source_byte_at(buffer, if source_byte_at(buffer, i) == 98 then i + 1 else i) == 39 then tree.T_RUNE else tree.T_STRING)
  else tree.T_STRING

fn scan_number(buffer: Bytes, start: Int, family: Int) -> (Int, Int) = {
  var i = start
  let b1 = source_byte_at(buffer, i + 1)
  var kind = tree.T_INTEGER
  if family == N_RUST then {
    if source_byte_at(buffer, i) == 48 and (b1 == 120 or b1 == 88) then {           // 0x
      i = i + 2
      while is_hex(source_byte_at(buffer, i)) or source_byte_at(buffer, i) == 95 { i = i + 1 }
    } else if source_byte_at(buffer, i) == 48 and (b1 == 111 or b1 == 79) then {    // 0o
      i = i + 2
      while (source_byte_at(buffer, i) >= 48 and source_byte_at(buffer, i) <= 55) or source_byte_at(buffer, i) == 95 { i = i + 1 }
    } else if source_byte_at(buffer, i) == 48 and (b1 == 98 or b1 == 66) then {     // 0b
      i = i + 2
      while source_byte_at(buffer, i) == 48 or source_byte_at(buffer, i) == 49 or source_byte_at(buffer, i) == 95 { i = i + 1 }
    } else {
      while is_digit(source_byte_at(buffer, i)) or source_byte_at(buffer, i) == 95 { i = i + 1 }
      // `1.5` is a float, and so is `1.`, but `1.max(2)` and `1..2` are not
      if source_byte_at(buffer, i) == 46 and is_digit(source_byte_at(buffer, i + 1)) then {
        i = i + 1
        kind = tree.T_FLOAT
        while is_digit(source_byte_at(buffer, i)) or source_byte_at(buffer, i) == 95 { i = i + 1 }
      } else if source_byte_at(buffer, i) == 46 and not is_ident(source_byte_at(buffer, i + 1)) and source_byte_at(buffer, i + 1) != 46 then {
        i = i + 1
        kind = tree.T_FLOAT
      } else ()
      if source_byte_at(buffer, i) == 101 or source_byte_at(buffer, i) == 69 then {
        let sign = if source_byte_at(buffer, i + 1) == 43 or source_byte_at(buffer, i + 1) == 45 then 1 else 0
        if is_digit(source_byte_at(buffer, i + 1 + sign)) then {
          i = i + 1 + sign
          kind = tree.T_FLOAT
          while is_digit(source_byte_at(buffer, i)) or source_byte_at(buffer, i) == 95 { i = i + 1 }
        } else ()
      } else ()
    }
    // a type suffix, `1u8` or `2.0f32`, is part of the literal
    while is_ident(source_byte_at(buffer, i)) { i = i + 1 }
    (i, kind)
  } else if family == N_GO then {
    if source_byte_at(buffer, i) == 48 and (b1 == 120 or b1 == 88) then {           // 0x, may be a hex float
      i = i + 2
      while is_hex(source_byte_at(buffer, i)) or source_byte_at(buffer, i) == 95 { i = i + 1 }
      if source_byte_at(buffer, i) == 46 then { i = i + 1; kind = tree.T_FLOAT; while is_hex(source_byte_at(buffer, i)) or source_byte_at(buffer, i) == 95 { i = i + 1 } } else ()
      if source_byte_at(buffer, i) == 112 or source_byte_at(buffer, i) == 80 then {              // p exponent
        i = i + 1
        kind = tree.T_FLOAT
        if source_byte_at(buffer, i) == 43 or source_byte_at(buffer, i) == 45 then i = i + 1 else ()
        while is_digit(source_byte_at(buffer, i)) or source_byte_at(buffer, i) == 95 { i = i + 1 }
      } else ()
    } else if source_byte_at(buffer, i) == 48 and (b1 == 98 or b1 == 66 or b1 == 111 or b1 == 79) then {   // 0b 0o
      i = i + 2
      while is_hex(source_byte_at(buffer, i)) or source_byte_at(buffer, i) == 95 { i = i + 1 }
    } else {
      while is_digit(source_byte_at(buffer, i)) or source_byte_at(buffer, i) == 95 { i = i + 1 }
      if source_byte_at(buffer, i) == 46 then {                                       // 1.5 and 1. are floats
        i = i + 1
        kind = tree.T_FLOAT
        while is_digit(source_byte_at(buffer, i)) or source_byte_at(buffer, i) == 95 { i = i + 1 }
      } else ()
      if source_byte_at(buffer, i) == 101 or source_byte_at(buffer, i) == 69 then {
        i = i + 1
        kind = tree.T_FLOAT
        if source_byte_at(buffer, i) == 43 or source_byte_at(buffer, i) == 45 then i = i + 1 else ()
        while is_digit(source_byte_at(buffer, i)) or source_byte_at(buffer, i) == 95 { i = i + 1 }
      } else ()
    }
    if source_byte_at(buffer, i) == 105 then (i + 1, tree.T_IMAGINARY) else (i, kind)      // 2i
  } else {
    if source_byte_at(buffer, i) == 48 and (b1 == 120 or b1 == 88) then {           // 0x
      i = i + 2
      while is_hex(source_byte_at(buffer, i)) or source_byte_at(buffer, i) == 95 { i = i + 1 }
      (i, tree.T_INTEGER)
    } else if source_byte_at(buffer, i) == 48 and (b1 == 98 or b1 == 66) then {     // 0b
      i = i + 2
      while source_byte_at(buffer, i) == 48 or source_byte_at(buffer, i) == 49 or source_byte_at(buffer, i) == 95 { i = i + 1 }
      (i, tree.T_INTEGER)
    } else if source_byte_at(buffer, i) == 48 and (b1 == 111 or b1 == 79) then {    // 0o
      i = i + 2
      while (source_byte_at(buffer, i) >= 48 and source_byte_at(buffer, i) <= 55) or source_byte_at(buffer, i) == 95 { i = i + 1 }
      (i, tree.T_INTEGER)
    } else {
      while is_digit(source_byte_at(buffer, i)) or source_byte_at(buffer, i) == 95 { i = i + 1 }
      // a fraction needs a digit after the dot, so `1..5` and `xs.0` stay apart
      if source_byte_at(buffer, i) == 46 and is_digit(source_byte_at(buffer, i + 1)) then {
        i = i + 1
        while is_digit(source_byte_at(buffer, i)) or source_byte_at(buffer, i) == 95 { i = i + 1 }
        kind = tree.T_FLOAT
      } else ()
      if source_byte_at(buffer, i) == 101 or source_byte_at(buffer, i) == 69 then {
        let sign = if source_byte_at(buffer, i + 1) == 43 or source_byte_at(buffer, i + 1) == 45 then 1 else 0
        if is_digit(source_byte_at(buffer, i + 1 + sign)) then {
          i = i + 1 + sign
          while is_digit(source_byte_at(buffer, i)) { i = i + 1 }
          kind = tree.T_FLOAT
        } else ()
      } else ()
      (i, kind)
    }
  }
}

// One self-recursive function, both families inside it: S_ALMIDE recurses for a
// string written inside `${…}`, and a dispatcher would put the two in a
// mutually recursive group, which clones the source at every call.
// Returns the end offset, or none when the literal is unterminated.
fn scan_string(buffer: Bytes, start: Int, family: Int) -> Option[Int] = {
  if family == S_RUST then {
    let q = if source_byte_at(buffer, start) == 98 then start + 1 else start   // a `b` prefix
    let c = source_byte_at(buffer, q)
    if c == 39 then {
      let e = rust_char_end(buffer, q)
      if e < 0 then none else some(e)
    }
    else if c == 114 then {                            // r"…" or r#"…"#
      var h = 0
      var k = q + 1
      while source_byte_at(buffer, k) == 35 { h = h + 1; k = k + 1 }
      if source_byte_at(buffer, k) != 34 then none
      else {
        var i = k + 1
        var done = false
        var good = true
        while not done {
          let b = source_byte_at(buffer, i)
          if b == -1 then { done = true; good = false }
          else if b == 34 then {
            // the quote closes only when the same number of hashes follows
            var j = 0
            var all = true
            while all and j < h { if source_byte_at(buffer, i + 1 + j) != 35 then all = false else j = j + 1 }
            if all then { i = i + 1 + h; done = true } else i = i + 1
          }
          else i = i + 1
        }
        if good then some(i) else none
      }
    }
    else {                                             // "…", which may span lines
      var i = q + 1
      var done = false
      var good = true
      while not done {
        let b = source_byte_at(buffer, i)
        if b == -1 then { done = true; good = false }
        else if b == 92 then i = i + 2
        else if b == 34 then { i = i + 1; done = true }
        else i = i + 1
      }
      if good then some(i) else none
    }
  }
  else if family == S_GO then {
    let quote = source_byte_at(buffer, start)
    var i = start + 1
    var done = false
    var good = true
    while not done {
      let b = source_byte_at(buffer, i)
      if b == -1 then { done = true; good = false }
      else if b == quote then { i = i + 1; done = true }
      else if b == 92 and quote != 96 then i = i + 2
      else if b == 10 and quote != 96 then { done = true; good = false }
      else i = i + 1
    }
    if good then some(i) else none
  } else {
    let raw = source_byte_at(buffer, start) == 114                                   // r"""
    let q = start + (if raw then 1 else 0)
    let triple = source_byte_at(buffer, q) == 34 and source_byte_at(buffer, q + 1) == 34 and source_byte_at(buffer, q + 2) == 34
    let quote = source_byte_at(buffer, q)                                             // 34 `"` or 39 `'`
    var i = q + (if triple then 3 else 1)
    var done = false
    var good = true
    var depth = 0
    while not done {
      let b = source_byte_at(buffer, i)
      if b == -1 then { done = true; good = false }
      else if depth > 0 then {
        if b == 123 then depth = depth + 1
        else if b == 125 then depth = depth - 1
        else if b == 34 or b == 39 then {                                // a string inside ${}
          match scan_string(buffer, i, family) { some(e) => { i = e - 1 }, none => { done = true; good = false } }
        }
        else if b == 92 then i = i + 1                                    // `\"` written as if still inside the outer string
        else ()
        i = i + 1
      }
      else if b == 92 and not raw then i = i + 2                         // escape
      else if b == 36 and source_byte_at(buffer, i + 1) == 123 and not raw then { depth = 1; i = i + 2 }
      else if triple then {
        if b == 34 and source_byte_at(buffer, i + 1) == 34 and source_byte_at(buffer, i + 2) == 34 then { i = i + 3; done = true }
        else i = i + 1
      }
      else if b == quote then { i = i + 1; done = true }
      else i = i + 1
    }
    if good then some(i) else none
  }
}

// A plain loop, not `list.find` with a lambda: a lambda that reads the
// captured `buffer` clones the whole source per call.
fn scan_operator(buffer: Bytes, start: Int, ops: List[String], patterns: List[Bytes]) -> Option[String] = {
  var found = -1
  var idx = 0
  while found < 0 and idx < list.len(ops) {
    let pattern = patterns[idx]
    var k = 0
    var same = true
    while same and k < bytes.len(pattern) {
      if source_byte_at(buffer, start + k) != bytes.get_or(pattern, k, -2) then same = false else k = k + 1
    }
    if same then found = idx else idx = idx + 1
  }
  list.get(ops, found)
}

// NL_SEMI: does a newline after this token become a separator?
fn ends_statement(t: tree.Token, ends_kw: List[String]) -> Bool =
  t.kind == tree.T_IDENTIFIER or t.kind == tree.T_INTEGER or t.kind == tree.T_FLOAT or t.kind == tree.T_IMAGINARY
  or t.kind == tree.T_STRING or t.kind == tree.T_RUNE
  or (t.kind == tree.T_KEYWORD and list.contains(ends_kw, t.text))
  or (t.kind == tree.T_PUNCT and (t.text == "++" or t.text == "--" or t.text == ")" or t.text == "]" or t.text == "}"))

// Whether the newline about to be passed should be emitted as a token.
fn wants_newline(toks: List[tree.Token], policy: Int, ends_kw: List[String]) -> Bool =
  if policy == NL_NONE then false
  else match list.last(toks) {
    some(t) => if policy == NL_SEMI then ends_statement(t, ends_kw) else t.kind != tree.T_NEWLINE,
    none => false,
  }

// ── the driver ────────────────────────────────────────────────────────────

fn tokenize(source: String, spec: Spec) -> Result[List[tree.Token], LexError] = tokenize_with(source, spec, false)

// Tokens for a file that does not lex. Every run the lexer cannot read becomes
// an `error` token, which no grammar rule asks for, so the parser's recovery
// gives up on the smallest enclosing list rather than on the whole file. An
// unterminated string is the ordinary state of a file someone is typing into.
fn tokenize_recovering(source: String, spec: Spec) -> List[tree.Token] =
  match tokenize_with(source, spec, true) { ok(t) => t, err(_) => [] }

// End of the line `i` is on: how far an unreadable run reaches.
fn to_eol(buffer: Bytes, from: Int) -> Int = {
  let n = bytes.len(buffer)
  var e = from
  while e < n and source_byte_at(buffer, e) != 10 { e = e + 1 }
  e
}

fn tokenize_with(source: String, spec: Spec, recover: Bool) -> Result[List[tree.Token], LexError] = {
  let buffer = bytes.from_string(source)
  let operator_patterns = list.map(spec.operators, (op) => bytes.from_string(op))
  let n = bytes.len(buffer)
  var toks: List[tree.Token] = []
  var i = 0
  var line = 1
  var line_start = 0
  var failure: Option[LexError] = none
  // (no closure here on purpose: one that read `buffer` would clone it per call,
  // and one that read `toks` would see a stale copy)
  while i < n and option.is_none(failure) {
    let b = source_byte_at(buffer, i)
    if is_space(b) then i = i + 1
    else if b == 10 then {
      if wants_newline(toks, spec.newlines, spec.ends_kw) then list.push(toks, mk(buffer, tree.T_NEWLINE, i, i, line, line_start)) else ()
      i = i + 1
      line = line + 1
      line_start = i
    }
    else if matches_at(buffer, i, spec.line_comment) then {
      while i < n and source_byte_at(buffer, i) != 10 { i = i + 1 }
    }
    else if matches_at(buffer, i, spec.block_open) then {
      let s = i
      let open_len = list.len(spec.block_open)
      let close_len = list.len(spec.block_close)
      var depth = 1
      var had_newline = false
      i = i + open_len
      while depth > 0 and i < n {
        if spec.nested_block and matches_at(buffer, i, spec.block_open) then { depth = depth + 1; i = i + open_len }
        else if matches_at(buffer, i, spec.block_close) then { depth = depth - 1; i = i + close_len }
        else {
          if source_byte_at(buffer, i) == 10 then { had_newline = true; line = line + 1; line_start = i + 1 } else ()
          i = i + 1
        }
      }
      if depth > 0 then {
        // unterminated. The nested form has already run to the end of the
        // file, so there is nothing left to give up on.
        if recover and not spec.nested_block then list.push(toks, mk(buffer, tree.T_ERROR, s, n, line, line_start))
        else if not recover then failure = some(LexError { line: line, col: (if spec.nested_block then i else s) - line_start + 1, message: "unterminated block comment" })
        else ()
      } else if spec.block_comment_newline and had_newline and wants_newline(toks, spec.newlines, spec.ends_kw) then
        list.push(toks, mk(buffer, tree.T_NEWLINE, s, s, line, line_start))
      else ()
    }
    else if starts_string(buffer, i, spec.strings) then {
      match scan_string(buffer, i, spec.strings) {
        some(e) => {
          list.push(toks, mk(buffer, literal_kind(buffer, i, spec.strings), i, e, line, line_start))
          // a literal may span lines; keep the line counter honest
          var k = i
          while k < e { if source_byte_at(buffer, k) == 10 then { line = line + 1; line_start = k + 1 } else (); k = k + 1 }
          i = e
        },
        none => if recover then {
          let e = to_eol(buffer, i)
          list.push(toks, mk(buffer, tree.T_ERROR, i, e, line, line_start))
          i = e
        } else { failure = some(LexError { line: line, col: i - line_start + 1, message: "unterminated string" }) },
      }
    }
    else if starts_number(buffer, i, spec.numbers) then {
      let (e, kind) = scan_number(buffer, i, spec.numbers)
      list.push(toks, mk(buffer, kind, i, e, line, line_start))
      i = e
    }
    else if is_alpha(b) or b >= 128 then {
      let e = scan_word(buffer, i)
      let word = text(buffer, i, e)
      let kind = if list.contains(spec.keywords, word) then tree.T_KEYWORD
        else if spec.upper_is_type and is_upper(b) then tree.T_TYPE_NAME
        else tree.T_IDENTIFIER
      list.push(toks, mk(buffer, kind, i, e, line, line_start))
      i = e
    }
    else if spec.backtick_ident and b == 96 then {
      let e = scan_backtick(buffer, i)
      if e == i and recover then {
        list.push(toks, mk(buffer, tree.T_ERROR, i, i + 1, line, line_start))
        i = i + 1
      }
      else if e == i then { failure = some(LexError { line: line, col: i - line_start + 1, message: "empty backtick name" }) }
      else {
        list.push(toks, mk(buffer, if spec.upper_is_type and is_upper(source_byte_at(buffer, i + 1)) then tree.T_TYPE_NAME else tree.T_IDENTIFIER, i, e, line, line_start))
        i = e
      }
    }
    else match scan_operator(buffer, i, spec.operators, operator_patterns) {
      some(op) => {
        // a line-initial `-` glued to its operand starts a statement (`-1`),
        // it never continues the line above as a binary minus
        let at_line_start = match list.last(toks) { some(t) => t.kind == tree.T_NEWLINE, none => true }
        let glued = spec.neg_token and op == "-" and at_line_start and not is_space(source_byte_at(buffer, i + 1)) and source_byte_at(buffer, i + 1) != 10
        list.push(toks, mk(buffer, if glued then tree.T_NEG else tree.T_PUNCT, i, i + string.len(op), line, line_start))
        i = i + string.len(op)
      },
      none => if recover then {
        list.push(toks, mk(buffer, tree.T_ERROR, i, i + 1, line, line_start))
        i = i + 1
      } else { failure = some(LexError { line: line, col: i - line_start + 1, message: "unexpected character " + string.from_bytes([b]) }) },
    }
  }
  match failure {
    some(e) => err(e),
    none => {
      if wants_newline(toks, spec.newlines, spec.ends_kw) then list.push(toks, mk(buffer, tree.T_NEWLINE, n, n, line, line_start)) else ()
      list.push(toks, mk(buffer, tree.T_EOF, n, n, line, line_start))
      ok(toks)
    },
  }
}

fn kinds(toks: List[tree.Token]) -> List[String] = {
  let names = tree.kind_names()
  list.map(toks, (t) => tree.kind_name_in(names, t.kind))
}
fn texts(toks: List[tree.Token]) -> List[String] = list.map(toks, (t) => t.text)

// A language this build does not have, written only as data: `#` to end of
// line, `<# … #>` blocks that do not nest, its own words and operators. If a
// test like this needs a change to lex.almd, the spec is missing something.
fn toy() -> Spec = Spec {
  keywords: ["when", "do"],
  operators: ["->", "=", "+", "(", ")"],
  numbers: N_ALMIDE,
  strings: S_GO,
  newlines: NL_EVERY,
  ends_kw: [],
  line_comment: [35],                     // #
  block_open: [60, 35],                   // <#
  block_close: [35, 62],                  // #>
  nested_block: false,
  block_comment_newline: false,
  upper_is_type: false,
  backtick_ident: false,
  neg_token: false,
}

test "a language the module has never heard of, given as data" {
  let toks = tokenize("when x -> y # a comment\n<# a block #> do 1 + 2", toy())!
  assert_eq(kinds(toks), ["keyword", "identifier", "punct", "identifier", "newline",
    "keyword", "integer", "punct", "integer", "newline", "eof"])
  assert_eq(texts(list.take(toks, 4)), ["when", "x", "->", "y"])
}

test "the newline policies differ, and nothing else has to" {
  // NL_EVERY emits a separator at each run of newlines
  assert_eq(list.len(list.filter(tokenize("a\n\n\nb\n", toy())!, (t) => t.kind == tree.T_NEWLINE)), 2)
  // NL_SEMI emits one only after a token a statement can end on
  let semi = Spec { keywords: toy().keywords, operators: toy().operators, numbers: toy().numbers,
    strings: toy().strings, newlines: NL_SEMI, ends_kw: [], line_comment: toy().line_comment,
    block_open: toy().block_open, block_close: toy().block_close, nested_block: false,
    block_comment_newline: false, upper_is_type: false, backtick_ident: false, neg_token: false }
  assert_eq(list.len(list.filter(tokenize("a\n+\nb\n", semi)!, (t) => t.kind == tree.T_NEWLINE)), 2)
}
