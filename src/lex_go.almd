// lex_go — Go source to tokens.
//
// Go's statement separator is the semicolon, and the compiler inserts one
// at a newline that follows an identifier, a literal, one of the keywords
// `break continue fallthrough return`, or `++ -- ) ] }`. That rule lives
// here: such a newline becomes a `newline` token and every other newline
// is dropped, so the grammar only ever sees a separator where Go sees one.
//
// Raw strings (`…`) span lines; a block comment containing a newline counts
// as a newline for the rule above, as in the Go spec.

import self.tree
import self.lexer
import self.lexer.{ is_digit, is_hex, is_alpha, is_ident, is_space, LexError }

// Local copies of the byte helpers: a list passed to a function in another
// module is cloned at the call, so the helpers that take `bytes` live here.
fn at(bytes: List[Int], i: Int) -> Int = list.get(bytes, i) ?? -1

fn scan_word(bytes: List[Int], start: Int) -> Int = {
  var i = start
  while is_ident(at(bytes, i)) { i = i + 1 }
  i
}

fn text(bytes: List[Int], s: Int, e: Int) -> String = {
  var out: List[Int] = []
  var k = s
  while k < e { list.push(out, at(bytes, k)); k = k + 1 }
  string.from_bytes(out)
}

fn mk(bytes: List[Int], kind: String, s: Int, e: Int, line: Int, line_start: Int) -> tree.Token =
  tree.Token { kind: kind, text: text(bytes, s, e), start: s, end: e, line: line, col: s - line_start + 1 }

let KEYWORDS = ["break", "case", "chan", "const", "continue", "default", "defer", "else", "fallthrough",
  "for", "func", "go", "goto", "if", "import", "interface", "map", "package", "range", "return",
  "select", "struct", "switch", "type", "var"]

let OPERATORS = ["<<=", ">>=", "&^=", "...", "&&", "||", "<-", "++", "--", "==", "!=", "<=", ">=", ":=",
  "+=", "-=", "*=", "/=", "%=", "&=", "|=", "^=", "<<", ">>", "&^",
  "+", "-", "*", "/", "%", "&", "|", "^", "<", ">", "=", "!", "(", ")", "[", "]", "{", "}", ",", ";", ".", ":", "~"]

let ENDS_STATEMENT_KW = ["break", "continue", "fallthrough", "return"]

// Does a newline after this token become a separator?
fn ends_statement(t: tree.Token) -> Bool =
  t.kind == "identifier" or t.kind == "integer" or t.kind == "float" or t.kind == "imaginary"
  or t.kind == "string" or t.kind == "rune"
  or (t.kind == "keyword" and list.contains(ENDS_STATEMENT_KW, t.text))
  or (t.kind == "punct" and (t.text == "++" or t.text == "--" or t.text == ")" or t.text == "]" or t.text == "}"))

fn last_ends(toks: List[tree.Token]) -> Bool = match list.last(toks) { some(t) => ends_statement(t), none => false }

fn scan_number(bytes: List[Int], start: Int) -> (Int, String) = {
  var i = start
  let b1 = at(bytes, i + 1)
  var kind = "integer"
  if at(bytes, i) == 48 and (b1 == 120 or b1 == 88) then {           // 0x, may be a hex float
    i = i + 2
    while is_hex(at(bytes, i)) or at(bytes, i) == 95 { i = i + 1 }
    if at(bytes, i) == 46 then { i = i + 1; kind = "float"; while is_hex(at(bytes, i)) or at(bytes, i) == 95 { i = i + 1 } } else ()
    if at(bytes, i) == 112 or at(bytes, i) == 80 then {              // p exponent
      i = i + 1
      kind = "float"
      if at(bytes, i) == 43 or at(bytes, i) == 45 then i = i + 1 else ()
      while is_digit(at(bytes, i)) or at(bytes, i) == 95 { i = i + 1 }
    } else ()
  } else if at(bytes, i) == 48 and (b1 == 98 or b1 == 66 or b1 == 111 or b1 == 79) then {   // 0b 0o
    i = i + 2
    while is_hex(at(bytes, i)) or at(bytes, i) == 95 { i = i + 1 }
  } else {
    while is_digit(at(bytes, i)) or at(bytes, i) == 95 { i = i + 1 }
    if at(bytes, i) == 46 then {                                       // 1.5 and 1. are floats
      i = i + 1
      kind = "float"
      while is_digit(at(bytes, i)) or at(bytes, i) == 95 { i = i + 1 }
    } else ()
    if at(bytes, i) == 101 or at(bytes, i) == 69 then {
      i = i + 1
      kind = "float"
      if at(bytes, i) == 43 or at(bytes, i) == 45 then i = i + 1 else ()
      while is_digit(at(bytes, i)) or at(bytes, i) == 95 { i = i + 1 }
    } else ()
  }
  if at(bytes, i) == 105 then (i + 1, "imaginary") else (i, kind)      // 2i
}

// `"…"` with escapes, `` `…` `` raw across lines, `'…'` runes. None when unterminated.
fn scan_string(bytes: List[Int], start: Int) -> Option[Int] = {
  let quote = at(bytes, start)
  var i = start + 1
  var done = false
  var good = true
  while not done {
    let b = at(bytes, i)
    if b == -1 then { done = true; good = false }
    else if b == quote then { i = i + 1; done = true }
    else if b == 92 and quote != 96 then i = i + 2
    else if b == 10 and quote != 96 then { done = true; good = false }
    else i = i + 1
  }
  if good then some(i) else none
}

// A plain loop, not `list.find` with a lambda: a lambda that reads the
// captured `bytes` clones the whole source per call.
fn scan_operator(bytes: List[Int], start: Int) -> Option[String] = {
  var found: Option[String] = none
  var idx = 0
  while option.is_none(found) and idx < list.len(OPERATORS) {
    let op = list.get(OPERATORS, idx) ?? ""
    let ob = string.to_bytes(op)
    var k = 0
    var same = true
    while same and k < list.len(ob) {
      if at(bytes, start + k) != (list.get(ob, k) ?? -2) then same = false else k = k + 1
    }
    if same then found = some(op) else idx = idx + 1
  }
  found
}

fn tokenize(source: String) -> Result[List[tree.Token], LexError] = tokenize_with(source, false)

// Tokens for a file that does not lex: every run the lexer cannot read becomes
// an `error` token, which no grammar rule asks for. See lexer.almd.
fn tokenize_recovering(source: String) -> List[tree.Token] =
  match tokenize_with(source, true) { ok(t) => t, err(_) => [] }

fn to_eol(bytes: List[Int], from: Int) -> Int = {
  let n = list.len(bytes)
  var e = from
  while e < n and at(bytes, e) != 10 { e = e + 1 }
  e
}

fn tokenize_with(source: String, recover: Bool) -> Result[List[tree.Token], LexError] = {
  let bytes = string.to_bytes(source)
  let n = list.len(bytes)
  var toks: List[tree.Token] = []
  var i = 0
  var line = 1
  var line_start = 0
  var failure: Option[LexError] = none
  // (no closure here on purpose: one that read `bytes` would clone it per call)
  // (reading `toks` inside a closure would see a stale copy, so the
  // newline rule is applied inline at each site via last_ends)
  while i < n and option.is_none(failure) {
    let b = at(bytes, i)
    if is_space(b) then i = i + 1
    else if b == 10 then {
      if last_ends(toks) then list.push(toks, mk(bytes, "newline", i, i, line, line_start)) else ()
      i = i + 1
      line = line + 1
      line_start = i
    }
    else if b == 47 and at(bytes, i + 1) == 47 then {                  // // comment
      while i < n and at(bytes, i) != 10 { i = i + 1 }
    }
    else if b == 47 and at(bytes, i + 1) == 42 then {                  // /* comment */
      let s = i
      var had_newline = false
      i = i + 2
      while i < n and not (at(bytes, i) == 42 and at(bytes, i + 1) == 47) {
        if at(bytes, i) == 10 then { had_newline = true; line = line + 1; line_start = i + 1 } else ()
        i = i + 1
      }
      if i >= n and recover then list.push(toks, mk(bytes, "error", s, n, line, line_start))
      else if i >= n then failure = some(LexError { line: line, col: s - line_start + 1, message: "unterminated block comment" })
      else {
        i = i + 2
        if had_newline and last_ends(toks) then list.push(toks, mk(bytes, "newline", s, s, line, line_start)) else ()
      }
    }
    else if b == 34 or b == 39 or b == 96 then {
      match scan_string(bytes, i) {
        some(e) => {
          list.push(toks, mk(bytes, if b == 39 then "rune" else "string", i, e, line, line_start))
          var k = i
          while k < e { if at(bytes, k) == 10 then { line = line + 1; line_start = k + 1 } else (); k = k + 1 }
          i = e
        },
        none => if recover then {
          let e = to_eol(bytes, i)
          list.push(toks, mk(bytes, "error", i, e, line, line_start))
          i = e
        } else { failure = some(LexError { line: line, col: i - line_start + 1, message: "unterminated string" }) },
      }
    }
    else if is_digit(b) or (b == 46 and is_digit(at(bytes, i + 1))) then {
      let (e, kind) = scan_number(bytes, i)
      list.push(toks, mk(bytes, kind, i, e, line, line_start))
      i = e
    }
    else if is_alpha(b) or b >= 128 then {
      let e = scan_word(bytes, i)
      let word = text(bytes, i, e)
      list.push(toks, mk(bytes, if list.contains(KEYWORDS, word) then "keyword" else "identifier", i, e, line, line_start))
      i = e
    }
    else match scan_operator(bytes, i) {
      some(op) => { list.push(toks, mk(bytes, "punct", i, i + string.len(op), line, line_start)); i = i + string.len(op) },
      none => if recover then {
        list.push(toks, mk(bytes, "error", i, i + 1, line, line_start))
        i = i + 1
      } else { failure = some(LexError { line: line, col: i - line_start + 1, message: "unexpected character " + string.from_bytes([b]) }) },
    }
  }
  match failure {
    some(e) => err(e),
    none => {
      if last_ends(toks) then list.push(toks, mk(bytes, "newline", n, n, line, line_start)) else ()
      list.push(toks, mk(bytes, "eof", n, n, line, line_start))
      ok(toks)
    },
  }
}

test "semicolons are inserted only after statement-ending tokens" {
  let toks = tokenize("package p\n\nimport (\n\t\"fmt\"\n)\n\nfunc f(a,\n\tb int) int {\n\treturn a +\n\t\tb\n}\n")!
  assert_eq(lexer.texts(toks), ["package", "p", "", "import", "(", "\"fmt\"", "", ")", "", "func", "f", "(", "a", ",", "b", "int", ")", "int", "{", "return", "a", "+", "b", "", "}", "", ""])
}

test "numbers, runes, raw strings, operators" {
  let toks = tokenize("x := 0x1p-2 + 1e3 + 2i + 'a' + `raw\nstring` &^ y")!
  assert_eq(lexer.kinds(list.take(toks, 12)), ["identifier", "punct", "float", "punct", "float", "punct", "imaginary", "punct", "rune", "punct", "string", "punct"])
  assert_eq(list.get(lexer.texts(toks), 11), some("&^"))
}
