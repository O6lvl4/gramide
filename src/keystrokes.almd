// keystrokes — the cost of one edit: `reparse` against the whole parse, on
// the edit sequence bench/tree_sitter_ranges.c replays for tree-sitter.
//
// Edits go into words of 13 letters or more, six letters in, so that a
// letter typed or deleted leaves the file as it was syntactically; that is
// the edit an editor sees most. The position comes from a 31-bit linear
// congruential generator, the same one in C, so both tools see the same
// edits in the same order. Every `verify_every` edits the incremental
// document is checked against a whole parse of the same text; a difference
// is counted, and would fail a language package's check.
import self.tree
import self.parser
import self.lang
import self.incremental
import datetime
import fs

fn lcg(state: Int) -> Int = (state * 1103515245 + 12345) % 2147483648

fn letter(b: Int) -> Bool = (b >= 97 and b <= 122) or (b >= 65 and b <= 90) or b == 95
fn digit(b: Int) -> Bool = b >= 48 and b <= 57

fn edit_position(text: Bytes, from: Int) -> Int = {
  let len = bytes.len(text)
  var found = -1
  var pass = 0
  while found < 0 and pass < 2 {
    var p = if pass == 0 then from else 0
    while found < 0 and p < len {
      while p < len and not letter(bytes.get_or(text, p, -1)) { p = p + 1 }
      let s = p
      while p < len and letter(bytes.get_or(text, p, -1)) { p = p + 1 }
      // not the letters of a number (`0xFFFFFFFFFFFFFFFFn`)
      if p - s >= 13 and not digit(bytes.get_or(text, s - 1, -1)) then found = s + 6 else ()
    }
    pass = pass + 1
  }
  found
}

fn median(sorted: List[Int]) -> Int = list.get(sorted, list.len(sorted) / 2) ?? 0
fn percentile(sorted: List[Int], p: Int) -> Int = list.get(sorted, (list.len(sorted) * p) / 100) ?? 0
fn us(ns: Int) -> String = int.to_string(ns / 1000) + "." + int.to_string((ns % 1000) / 100)

// `renamed` is, per edit, how many items lost their id (a fall-back renames every item)
type Report = { edits: Int, fallbacks: Int, mismatches: Int, incremental_ns: List[Int], whole_ns: List[Int], reasons: List[Int], initial_mismatch: Bool, items: Int, renamed: List[Int] }

fn render(r: Report) -> String = {
  let inc = list.sort(r.incremental_ns)
  let whole = list.sort(r.whole_ns)
  "{\"tool\":\"gramide\",\"edits\":" + int.to_string(r.edits)
    + ",\"median_us\":" + us(median(inc)) + ",\"p90_us\":" + us(percentile(inc, 90)) + ",\"max_us\":" + us(list.last(inc) ?? 0)
    + ",\"fallbacks\":" + int.to_string(r.fallbacks) + ",\"mismatches\":" + int.to_string(r.mismatches) + ",\"initial_mismatch\":" + (if r.initial_mismatch then "true" else "false")
    + ",\"fallback_reasons\":{\"no_lex\":" + int.to_string(list.count(r.reasons, (x) => x == incremental.NO_LEX)) + ",\"no_head\":" + int.to_string(list.count(r.reasons, (x) => x == incremental.NO_HEAD))
    + ",\"no_parse\":" + int.to_string(list.count(r.reasons, (x) => x == incremental.NO_PARSE)) + ",\"no_site\":" + int.to_string(list.count(r.reasons, (x) => x == incremental.NO_SITE)) + ",\"root_own\":" + int.to_string(list.count(r.reasons, (x) => x == incremental.ROOT_OWN)) + ",\"error_near\":" + int.to_string(list.count(r.reasons, (x) => x == incremental.ERROR_NEAR)) + "}"
    + ",\"whole_parse_samples\":" + int.to_string(list.len(whole)) + ",\"whole_parse_median_us\":" + us(median(whole))
    + ",\"items\":" + int.to_string(r.items) + ",\"items_renamed_median\":" + int.to_string(median(list.sort(r.renamed))) + ",\"items_renamed_p90\":" + int.to_string(percentile(list.sort(r.renamed), 90)) + ",\"items_renamed_max\":" + int.to_string(list.last(list.sort(r.renamed)) ?? 0)
    + ",\"edits_renaming_none\":" + int.to_string(list.count(r.renamed, (x) => x == 0)) + "}"
}

// The whole parse a document is checked against: strict, or recovering
// where the text no longer parses (a breaking edit was made), which is the
// document a reader would be given.
fn whole_of(c: parser.Compiled, scan: (String, Bool) -> Result[List[tree.Token], lex.LexError], source: Bytes) -> Result[parser.Parsed, String] = {
  let text = bytes.to_string_lossy(source)
  match scan(text, false) {
    ok(toks) => match parser.parse_with(c, source, toks) {
      ok(p) => ok(p),
      err(_) => parser.parse_recovering(c, source, toks) |> result.map_err((f) => "no recovery: " + parser.format_failure(f)),
    },
    err(e) => {
      let toks = scan(text, true) |> result.map_err((f) => "lex error " + int.to_string(f.line) + ":" + int.to_string(f.col) + " " + f.message)!
      parser.parse_recovering(c, source, toks) |> result.map_err((f) => "no recovery: " + parser.format_failure(f))
    },
  }
}

// `breaking`: every tenth edit inserts an unmatched `{` at the position
// instead of a letter, so the file stops parsing, and the edits after it
// land in a file with an ERROR item; the check against the recovering
// whole parse still has to hold, and a window inside the damage falls back.
// `slow` > 0 prints that many of the slowest edits to stderr, each with
// its position, line and the text around it: where the items are big.
effect fn run(l: lang.Language, source0: Bytes, edits: Int, seed: Int, verify_every: Int, dump: String, breaking: Bool, slow: Int) -> Result[String, String] = {
  let scan = l.tokenize
  var timed: List[(Int, Int, Int)] = []
  let c = l.grammar
  var source = source0
  let first = whole_of(c, scan, source)!
  var doc = incremental.from_parsed(first, source, c)
  var state = seed
  var report = Report { edits: edits, fallbacks: 0, mismatches: 0, incremental_ns: [], whole_ns: [], reasons: [], initial_mismatch: false, items: list.len(incremental.items(doc)), renamed: [] }
  if verify_every > 0 and not incremental.same(incremental.materialize(doc), first) then {
    report.initial_mismatch = true
    eprintln("before any edit: " + incremental.first_difference(incremental.materialize(doc), first))
  } else ()
  var i = 0
  while i < edits {
    state = lcg(state)
    let pos = edit_position(source, state % (bytes.len(source) + 1))
    guard pos >= 0 else err("no word of 13 letters to edit")
    let breaks = breaking and i % 10 == 9
    let typed = bytes.from_list([if breaks then 123 else 97 + (state / 65536) % 26])
    let edit = if i % 2 == 0 or breaks then incremental.Edit { start: pos, old_end: pos, new_end: pos + 1 } else incremental.Edit { start: pos, old_end: pos + 1, new_end: pos }
    let insert = if i % 2 == 0 or breaks then typed else bytes.new(0)
    source = incremental.apply(source, edit, insert)
    let before = list.sort(list.map(incremental.items(doc), (r) => r.id))
    let t0 = datetime.monotonic_ns()
    let status = incremental.reparse_status(doc, source, edit, scan, c)
    let fine = status == incremental.DONE
    if not fine then { doc = fallen_back(report, doc, status, c, scan, source, i)! } else ()
    let t1 = datetime.monotonic_ns()
    list.push(report.incremental_ns, t1 - t0)
    let after = list.sort(list.map(incremental.items(doc), (r) => r.id))
    list.push(report.renamed, missing(before, after))
    if slow > 0 then list.push(timed, (t1 - t0, pos, i)) else ()
    if verify_every > 0 and i % verify_every == 0 then { let _ = verified(report, doc, c, scan, source, i, pos)! } else ()
    i = i + 1
  }
  if dump != "" then { let _ = fs.write(dump, bytes.to_string_lossy(source)) } else ()
  if slow > 0 then { let _ = print_slowest(timed, slow, source) } else ()
  ok(render(report))
}
// how many of the sorted ids `before` are not among the sorted ids `after`
fn missing(before: List[Int], after: List[Int]) -> Int = {
  var gone = 0
  var a = 0
  for id in before {
    while a < list.len(after) and (list.get(after, a) ?? 0) < id { a = a + 1 }
    if (list.get(after, a) ?? -1) != id then gone = gone + 1 else ()
  }
  gone
}
// the document read again from a whole parse, the reason tallied and the
// first few traces printed
effect fn fallen_back(mut report: Report, doc: incremental.Document, status: Int, c: parser.Compiled, scan: (String, Bool) -> Result[List[tree.Token], lex.LexError], source: Bytes, i: Int) -> Result[incremental.Document, String] = {
  report.fallbacks = report.fallbacks + 1
  list.push(report.reasons, status)
  if list.len(report.reasons) <= 5 then { for t in doc.trace { eprintln("edit " + int.to_string(i) + ": " + t) } } else ()
  let again = whole_of(c, scan, source)!
  ok(incremental.from_parsed(again, source, c))
}
// the whole parse of the text now, timed, against the document
effect fn verified(mut report: Report, doc: incremental.Document, c: parser.Compiled, scan: (String, Bool) -> Result[List[tree.Token], lex.LexError], source: Bytes, i: Int, pos: Int) -> Result[Unit, String] = {
  let w0 = datetime.monotonic_ns()
  let whole = whole_of(c, scan, source)!
  let w1 = datetime.monotonic_ns()
  list.push(report.whole_ns, w1 - w0)
  if not incremental.same(incremental.materialize(doc), whole) then {
    report.mismatches = report.mismatches + 1
    eprintln("edit " + int.to_string(i) + " at " + int.to_string(pos) + ": " + incremental.first_difference(incremental.materialize(doc), whole))
  } else ()
  ok(())
}
effect fn print_slowest(timed: List[(Int, Int, Int)], slow: Int, source: Bytes) -> Unit = {
  let by_time = list.reverse(list.sort_by(timed, (t) => t.0))
  for t in list.take(by_time, slow) {
    let line = 1 + list.count(bytes.to_list(bytes.slice(source, 0, t.1)), (b) => b == 10)
    eprintln("slow: " + us(t.0) + " us, edit " + int.to_string(t.2) + " at " + int.to_string(t.1) + " line " + int.to_string(line) + ": " + string.replace(bytes.to_string_lossy(bytes.slice(source, int.max(0, t.1 - 40), int.min(bytes.len(source), t.1 + 40))), "\n", " "))
  }
  ()
}
