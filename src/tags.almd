// tags — what a file defines and what it mentions.
//
// `def <kind> <name> L<start>-<end>` for every declaration, `ref call <name> L<n>`
// for every call (qualified as `module.name` when written that way) and
// `ref type <Name> L<n>` for every type mention. This is the input a repo
// map needs: definitions to rank, references to rank them by.
//
// A function that belongs to a type is named with the type: `SpineDb::open`,
// `Shape.Area`. A `def` line is read on its own — in a repo map, in a grep,
// in a flat list of a file's symbols — and a bare `open` there is worth
// nothing. Which languages write which separator is not known here; it
// arrives as `sep`, from lang.almd.

import self.names as nametable
import json
import self.tree
import self.package_api
import self.parser

// Local copies of the tree helpers that take the token list: a list handed to
// a function in another module is cloned at the call, and these run once per
// node. They carry their own names — `leaf_word`, `joined_words`, `last_line`,
// `named_child` — because a local function that merely shares a name with an
// imported one is not reliably the one an unqualified call resolves to.
fn leaf_word(n: tree.Node, toks: List[tree.Token], source: Bytes) -> String = match list.get(toks, n.start) { some(t) => tree.token_text(source, t), none => "" }
fn first_line(n: tree.Node, toks: List[tree.Token]) -> Int = match list.get(toks, n.start) { some(t) => t.line, none => 0 }
// Layout markers can point at the next declaration. Ranges end at source code.
fn code_end(n: tree.Node, toks: List[tree.Token]) -> Int = {
  var end = n.end
  while end > n.start and (option.map(list.get(toks, end - 1), (t) => t.kind == tree.T_NEWLINE or t.kind == tree.T_DEDENT or t.kind == tree.T_INDENT) ?? false) { end = end - 1 }
  end
}
// A token can cover line terminators — a heredoc, a multiline string, an
// error token over a whole tail — so its last line is its first plus the
// breaks in the source it spans. CRLF is one break.
fn line_breaks(source: Bytes, t: tree.Token) -> Int = {
  var i = t.start
  var breaks = 0
  while i < t.end {
    let b = bytes.get_or(source, i, -1)
    if b == 13 then {
      breaks = breaks + 1
      i = i + (if bytes.get_or(source, i + 1, -1) == 10 then 2 else 1)
    } else {
      if b == 10 then breaks = breaks + 1 else ()
      i = i + 1
    }
  }
  breaks
}
fn last_line(n: tree.Node, toks: List[tree.Token], source: Bytes) -> Int = match list.get(toks, code_end(n, toks) - 1) {
  some(t) => {
    // A zero-width token — a layout marker, EOF — ends on no byte of its own,
    // so the byte before it is not its last one.
    let last = if t.end > t.start then bytes.get_or(source, t.end - 1, -1) else -1
    // A recovery token can consume EOF immediately after a line terminator.
    t.line + line_breaks(source, t) - (if last == 10 or last == 13 then 1 else 0)
  },
  none => 0,
}

// A name of more than one token — `salsa::Database`, `Vec<u8>` — is joined
// from the tokens, not cut out of the source. A token's offsets count bytes
// and `string.slice` counts characters, so cutting the source puts a name in
// a file with a `—` in a comment somewhere above it out by as many bytes as
// that comment cost. Nothing here needs the gaps between tokens anyway.
fn joined_words(n: tree.Node, toks: List[tree.Token], source: Bytes) -> String = {
  var s = ""
  var i = n.start
  while i < n.end {
    match list.get(toks, i) { some(t) => { s = s + tree.token_text(source, t) }, none => () }
    i = i + 1
  }
  s
}

// `name` is what is printed; `base` is the original name without type or namespace qualification, and is
// what a reference can be matched against. A call site says `as_str`, never
// `Applicability::as_str` — gramide resolves no names — so a repo map has to
// join the two on the bare name while showing the useful one. For a `ref`, and
// for anything that belongs to neither a type nor a namespace, they are equal.
type Tag = { role: String, kind: String, name: String, base: String, line: Int, end_line: Int }

fn render(t: Tag) -> String =
  if t.role == "def" then "def " + t.kind + " " + t.name + " L" + int.to_string(t.line) + "-" + int.to_string(t.end_line)
  else "ref " + t.kind + " " + t.name + " L" + int.to_string(t.line)

// The node kinds that define a name, across languages, each mapped to the word
// the output uses for it. Every other kind answers "", which is how the
// walkers tell a declaration from anything else. A grouped Go `type ( … )` is
// a type_declaration without a name whose type_specs carry the names.
//
// This is the whole vocabulary. A grammar that invents a kind still parses; it
// is simply invisible to `outline`, `tags` and `map`.
// Keep the public package mapping as tuples. Prepare borrowable records once
// per traversal; native tuple iteration otherwise clones both strings per node.
// A node's kind is a number, so the rules a package states by name are
// resolved once per file and compared as numbers from then on. A name this
// grammar never uses answers -1, which no node carries.
// `name` is the syntax kind's own name, resolved here once so that the walk
// that prints it never carries the name table down the tree: a Names record
// is a blob and two lists, and a parameter like that is copied per visit.
type DeclarationEntry = { syntax: Int, name: String, kind: String }
type DeclarationTable = { entries: List[DeclarationEntry], scopes: List[Int], namespaces: List[Int],
  callables: List[Int], envelopes: List[Int], unnamed_envelopes: List[Int],
  type_name: Int, identifier: Int, arguments: Int, field_access: Int, type_mentions: List[Int],
  f_name: Int, f_trait: Int, f_receiver: Int, f_field: Int }
// Loops, not `list.map`: a closure over the name table copied the table for
// every entry it mapped.
fn ids_in(names: nametable.Names, keys: List[String]) -> List[Int] = {
  var out: List[Int] = list.with_capacity(list.len(keys))
  for k in keys { list.push(out, nametable.id_of(names, k)) }
  out
}
fn entries_in(names: nametable.Names, declarations: List[(String, String)]) -> List[DeclarationEntry] = {
  var out: List[DeclarationEntry] = list.with_capacity(list.len(declarations))
  for d in declarations { list.push(out, DeclarationEntry { syntax: nametable.id_of(names, d.0), name: d.0, kind: d.1 }) }
  out
}
fn declaration_table(rules: package_api.SymbolRules, names: nametable.Names) -> DeclarationTable =
  DeclarationTable {
    entries: entries_in(names, rules.declarations),
    scopes: ids_in(names, rules.scopes),
    namespaces: ids_in(names, rules.namespaces),
    callables: ids_in(names, rules.callables),
    envelopes: ids_in(names, rules.envelopes),
    unnamed_envelopes: ids_in(names, rules.unnamed_envelopes),
    type_name: nametable.id_of(names, "type_name"), identifier: nametable.id_of(names, "identifier"),
    arguments: nametable.id_of(names, rules.arguments), field_access: nametable.id_of(names, rules.field_access),
    type_mentions: ids_in(names, rules.type_mentions),
    f_name: nametable.id_of(names, "name"), f_trait: nametable.id_of(names, "trait"),
    f_receiver: nametable.id_of(names, "receiver"), f_field: nametable.id_of(names, "field")
  }
fn decl_kind(k: Int, table: DeclarationTable) -> String = {
  var found = ""
  var matched = false
  for entry in table.entries {
    if not matched and entry.syntax == k then { found = entry.kind; matched = true } else ()
  }
  found
}

// The syntax kind's name, for a node `decl_kind` answered for.
fn syntax_name(k: Int, table: DeclarationTable) -> String = {
  var found = ""
  var matched = false
  for entry in table.entries {
    if not matched and entry.syntax == k then { found = entry.name; matched = true } else ()
  }
  found
}

fn is_scope(k: Int, table: DeclarationTable) -> Bool = {
  var found = false
  for candidate in table.scopes { if candidate == k then found = true else () }
  found
}
fn is_callable(k: Int, table: DeclarationTable) -> Bool = {
  var found = false
  for candidate in table.callables { if candidate == k then found = true else () }
  found
}
// A type is mentioned inside one of these, and its name is the first thing in
// it: `type:(type_name (identifier))` in Rust, `(annotation (identifier))` in
// Python. Anything else under them — a subscript, a union, a keyword argument
// — is left alone, because a repo map ranks names and those are not one.
fn mentions_type(k: Int, table: DeclarationTable) -> Bool = {
  var found = false
  for candidate in table.type_mentions { if candidate == k then found = true else () }
  found
}

// The native list.find lowering currently clones its complete input and each
// candidate. Borrow the scan and copy only the matching field, never its siblings.
fn named_child(n: tree.Node, field: Int) -> Option[tree.Node] = {
  // A name this grammar never uses is -1, and so is "this child has no name":
  // asking for one must not answer with the other.
  if field < 0 then none else {
  var found = -1
  var index = 0
  for k in n.kids {
    if found < 0 and k.field == field then found = index else ()
    index = index + 1
  }
  list.get(n.kids, found)
  }
}

fn bare_name(n: tree.Node, toks: List[tree.Token], source: Bytes, table: DeclarationTable) -> String = match named_child(n, table.f_name) {
  some(m) => if list.is_empty(m.kids) then leaf_word(m, toks, source) else joined_words(m, toks, source),
  none => "",
}
fn name_of(n: tree.Node, toks: List[tree.Token], source: Bytes, table: DeclarationTable) -> String = {
  let name = bare_name(n, toks, source, table)
  match named_child(n, table.f_trait) {
    some(trait_node) => joined_words(trait_node, toks, source) + " for " + name,
    none => name,
  }
}
fn qualified(prefix: String, name: String, sep: String) -> String = if prefix == "" then name else prefix + sep + name
fn flat_name(n: tree.Node, name: String, own: String, namespace: String, toks: List[tree.Token], source: Bytes, sep: String, rules: package_api.SymbolRules, table: DeclarationTable) -> String = match named_child(n, table.f_trait) {
  some(trait_node) => joined_words(trait_node, toks, source) + " for " + qualified(namespace, bare_name(n, toks, source, table), sep),
  none => qualified(namespace, if rules.lexical_owners then name else qualified(own, name, sep), sep),
}
fn namespace_under(n: tree.Node, namespace: String, toks: List[tree.Token], source: Bytes, sep: String, table: DeclarationTable) -> String =
  if list.contains(table.namespaces, n.kind) then qualified(namespace, bare_name(n, toks, source, table), sep) else namespace

// The bare name to qualify by. A Rust impl is named by a whole type, and
// nobody greps for `Vec<u8>::len`, so only the head of it is taken; a type
// with no head to take — `[u8]`, `(A, B)` — qualifies nothing.
fn scope_of(n: tree.Node, toks: List[tree.Token], source: Bytes, table: DeclarationTable) -> String = match named_child(n, table.f_name) {
  some(m) => if list.is_empty(m.kids) or m.kind == table.type_name then leaf_word(m, toks, source) else "",
  none => "",
}

fn type_name_in(n: tree.Node, toks: List[tree.Token], source: Bytes, table: DeclarationTable) -> String =
  if n.kind == table.type_name then leaf_word(n, toks, source)
  else {
    var found = ""
    for k in n.kids { if found == "" then { found = type_name_in(k, toks, source, table) } else () }
    found
  }

// Go names the owner in a receiver instead of by nesting, so a method there is
// found at the top level with its type one field away.
fn owner_for(n: tree.Node, owner: String, toks: List[tree.Token], source: Bytes, table: DeclarationTable) -> String =
  if not is_callable(n.kind, table) then ""
  else match named_child(n, table.f_receiver) {
    some(p) => type_name_in(p, toks, source, table),
    none => owner,
  }

fn scope_under(n: tree.Node, owner: String, toks: List[tree.Token], source: Bytes, table: DeclarationTable) -> String =
  if is_callable(n.kind, table) then ""            // a function body holds no methods
  else if is_scope(n.kind, table) then scope_of(n, toks, source, table)
  else owner

// Walk the tree. Calls are recognised on the flat postfix chain the grammar
// produces: `identifier arguments` or `identifier field_access arguments`.
// The chain is read with one step of memory (what the previous two kids
// were) rather than by looking ahead, because reading a kid with list.get
// copies its whole subtree — a look-ahead would copy every subtree twice.
fn walk(n: tree.Node, toks: List[tree.Token], source: Bytes, scope: String, namespace: String, sep: String, rules: package_api.SymbolRules, table: DeclarationTable) -> List[Tag] = {
  var out: List[Tag] = []
  let kind = decl_kind(n.kind, table)
  let name = if kind != "" then name_of(n, toks, source, table) else ""
  if name != "" then {
    let own = owner_for(n, scope, toks, source, table)
    list.push(out, Tag {
      role: "def",
      kind: if own == "" then kind else "method",
      name: flat_name(n, name, own, namespace, toks, source, sep, rules, table),
      base: bare_name(n, toks, source, table),
      line: first_line(n, toks), end_line: last_line(n, toks, source) })
  }
  else if mentions_type(n.kind, table) and not list.is_empty(n.kids) then {
    match list.get(n.kids, 0) {
      some(leaf) => if (leaf.kind == table.type_name or leaf.kind == table.identifier) and list.is_empty(leaf.kids) then
        list.push(out, Tag { role: "ref", kind: "type", name: leaf_word(leaf, toks, source), base: leaf_word(leaf, toks, source), line: first_line(leaf, toks), end_line: 0 })
      else (),
      none => (),
    }
  }
  else ()
  let inner = scope_under(n, scope, toks, source, table)
  let inner_namespace = namespace_under(n, namespace, toks, source, sep, table)
  var prev_kind = -1          // the kid before this one
  var prev_name = ""          // its leaf text (identifier) or field name (field_access)
  var prev_line = 0
  var before_kind = -1        // the kid before that
  var before_name = ""
  var i = 0
  let count = list.len(n.kids)
  while i < count {
    match list.get(n.kids, i) {
      none => (),
      some(k) => {
        if k.kind == table.arguments and prev_kind == table.identifier then
          list.push(out, Tag { role: "ref", kind: "call", name: prev_name, base: prev_name, line: prev_line, end_line: 0 })
        else if k.kind == table.arguments and prev_kind == table.field_access then {
          let owner = if before_kind == table.identifier then before_name + "." else ""
          list.push(out, Tag { role: "ref", kind: "call", name: owner + prev_name, base: owner + prev_name, line: prev_line, end_line: 0 })
        }
        else ()
        before_kind = prev_kind
        before_name = prev_name
        prev_kind = k.kind
        prev_line = first_line(k, toks)
        prev_name = if k.kind == table.identifier then leaf_word(k, toks, source)
          else if k.kind == table.field_access then (match named_child(k, table.f_field) { some(m) => leaf_word(m, toks, source), none => "" })
          else ""
        for t in walk(k, toks, source, inner, inner_namespace, sep, rules, table) { list.push(out, t) }
      },
    }
    i = i + 1
  }
  out
}

fn of_tree(root: tree.Node, toks: List[tree.Token], source: Bytes, names: nametable.Names, sep: String, rules: package_api.SymbolRules) -> List[Tag] = walk(root, toks, source, "", "", sep, rules, declaration_table(rules, names))

fn tags(root: tree.Node, toks: List[tree.Token], source: Bytes, names: nametable.Names, sep: String, rules: package_api.SymbolRules) -> List[String] =
  list.map(of_tree(root, toks, source, names, sep, rules), (t) => render(t))

// `outline`: the definitions only, one per line, nested ones indented by
// how many definitions enclose them. The name is qualified here too, even
// though the indentation already shows what encloses what, so that one line
// cut out of the output still says what it is.
fn outline(root: tree.Node, toks: List[tree.Token], source: Bytes, names: nametable.Names, sep: String, rules: package_api.SymbolRules) -> List[String] = {
  var out: List[String] = []
  outline_walk(root, toks, source, 0, "", sep, rules, declaration_table(rules, names), out)
  out
}

// The lines go onto one list the caller owns and hands down; returning them a
// level at a time copied every line once per level of nesting.
fn outline_walk(n: tree.Node, toks: List[tree.Token], source: Bytes, depth: Int, scope: String, sep: String, rules: package_api.SymbolRules, table: DeclarationTable, mut out: List[String]) -> Unit = {
  let kind = decl_kind(n.kind, table)
  let name = if kind != "" then name_of(n, toks, source, table) else ""
  if name != "" then {
    let own = owner_for(n, scope, toks, source, table)
    list.push(out, string.repeat("  ", depth) + "L" + int.to_string(first_line(n, toks)) + "-" + int.to_string(last_line(n, toks, source))
      + " " + (if own == "" then kind else "method")
      + " " + (if own == "" then name else own + sep + name))
  }
  else ()
  let deeper = if name == "" then depth else depth + 1
  let inner = scope_under(n, scope, toks, source, table)
  for k in n.kids {
    if not list.is_empty(k.kids) then outline_walk(k, toks, source, deeper, inner, sep, rules, table, out) else ()
  }
}

// Keep this walk beside the shared naming helpers. Cross-module calls in
// the current native backend copy the token list; doing that per node makes
// structured reads quadratic in the size of the source.
//
// A row is its JSON object, rendered the moment the declaration is found, and
// the rows are pushed onto one list the caller owns and hands down. Building
// them as `Value` trees, returning them up a level at a time and stringifying
// the lot cost 4.6 ms for 800 Go functions — half of what `symbols` took, and
// more than the parse. Byte offsets are zero-based, end-exclusive; line ranges
// are one-based and inclusive. The byte range rides beside the text because
// the recovered document filters on it.
type SymbolRow = { json: String, start_byte: Int, end_byte: Int }

// A JSON string literal. Names are identifiers and paths, so nearly every one
// takes the fast path, decided by native scans and no allocation; anything
// holding a quote, a backslash or a line break goes through the library's
// escaping instead. Another control byte cannot reach here on its own: every
// name is joined from tokens, and the only token that can hold one is a
// string, which the quote check already sends the slow way.
fn json_string(s: String) -> String =
  if string.contains(s, "\"") or string.contains(s, "\\") or string.contains(s, "\n") or string.contains(s, "\r") or string.contains(s, "\t")
  then json.stringify(value.str(s))
  else "\"" + s + "\""

fn symbol_rows_in(n: tree.Node, start: Int, toks: List[tree.Token], source: Bytes, scope: String, namespace: String, sep: String, rules: package_api.SymbolRules, table: DeclarationTable, mut out: List[SymbolRow]) -> Unit = {
  let kind = decl_kind(n.kind, table)
  let name = if kind == "" then "" else name_of(n, toks, source, table)
  if name != "" then {
    let own = owner_for(n, scope, toks, source, table)
    match (list.get(toks, start), list.get(toks, code_end(n, toks) - 1)) {
      // one interpolation, one allocation: a chain of `+` allocated a string per piece
      (some(first), some(last)) => list.push(out, SymbolRow {
        json: "{\"kind\":${json_string(if own == "" then kind else "method")},\"name\":${json_string(flat_name(n, name, own, namespace, toks, source, sep, rules, table))},\"owner\":${json_string(if rules.lexical_owners and own != "" then namespace else own)},\"syntax_kind\":${json_string(syntax_name(n.kind, table))},\"start\":${int.to_string(first.line)},\"end\":${int.to_string(last_line(n, toks, source))},\"start_byte\":${int.to_string(first.start)},\"end_byte\":${int.to_string(last.end)}}",
        start_byte: first.start, end_byte: last.end }),
      _ => (),
    }
  } else ()
  let inner = scope_under(n, scope, toks, source, table)
  let inner_namespace = namespace_under(n, namespace, toks, source, sep, table)
  let envelope = list.contains(table.envelopes, n.kind) or (list.contains(table.unnamed_envelopes, n.kind) and name == "")
  for k in n.kids {
    // An envelope changes only the reported start, not the subtree. Keep it
    // separate so the native backend borrows children instead of cloning them.
    // A leaf cannot contain the name field required for a declaration.
    if not list.is_empty(k.kids) then {
      let first = if envelope and decl_kind(k.kind, table) != "" then start else k.start
      symbol_rows_in(k, first, toks, source, inner, inner_namespace, sep, rules, table, out)
    } else ()
  }
}

fn symbol_rows(n: tree.Node, toks: List[tree.Token], source: Bytes, names: nametable.Names, scope: String, sep: String, rules: package_api.SymbolRules) -> List[SymbolRow] = {
  var out: List[SymbolRow] = []
  symbol_rows_in(n, n.start, toks, source, scope, "", sep, rules, declaration_table(rules, names), out)
  out
}

test "a JSON string takes the fast path unless it has to be escaped" {
  assert_eq(json_string("Box::read"), "\"Box::read\"")
  assert_eq(json_string("a\"b"), "\"a\\\"b\"")
  assert_eq(json_string("a\\b"), "\"a\\\\b\"")
  assert_eq(json_string("tab\there"), "\"tab\\there\"")
  assert_eq(json_string("two\nlines"), "\"two\\nlines\"")
}

// What `symbols` reports as total_lines, counted in one pass over the bytes
// rather than by splitting the source into a list of lines: the same number
// `string.lines` gives, which is what a reader compares it with.
fn line_count(source: Bytes) -> Int = {
  let n = bytes.len(source)
  var count = 0
  var i = 0
  while i < n {
    if bytes.get_or(source, i, 0) == 10 then count = count + 1 else ()
    i = i + 1
  }
  if n > 0 and bytes.get_or(source, n - 1, 0) != 10 then count + 1 else count
}

test "line_count says what string.lines says" {
  for s in ["", "a", "a\n", "a\nb", "a\nb\n", "\n", "\n\n", "a\r\nb\r\n", "a\r\nb", "日本語\n", "a\n\nb"] {
    assert_eq(line_count(bytes.from_string(s)), list.len(string.lines(s)))
  }
}


// Recovery ranges are in source order and disjoint: ERROR nodes have no children.
type ErrorRange = { start: Int, end: Int, start_byte: Int, end_byte: Int }
fn append_errors(n: tree.Node, toks: List[tree.Token], source: Bytes, error: Int, mut ranges: List[ErrorRange]) -> Unit = {
  if n.kind == error then {
    match (list.get(toks, n.start), list.get(toks, code_end(n, toks) - 1)) {
      (some(first), some(last)) => list.push(ranges, ErrorRange { start: first.line, end: last_line(n, toks, source), start_byte: first.start, end_byte: last.end }),
      _ => (),
    }
  } else for k in n.kids { append_errors(k, toks, source, error, ranges) }
}
fn error_ranges(n: tree.Node, toks: List[tree.Token], source: Bytes, names: nametable.Names) -> List[ErrorRange] = {
  var ranges: List[ErrorRange] = []
  append_errors(n, toks, source, nametable.id_of(names, "ERROR"), ranges)
  ranges
}
// The ERROR ranges with a range over each unpaired bracket (`gaps`, in
// source order) added: a declaration that holds one lost a closer that
// recovery put back where indentation says, and is not error-free. A bracket
// under an ERROR node already is not added again; the ranges stay ordered and
// disjoint.
fn with_gaps(ranges: List[ErrorRange], gaps: List[Int], toks: List[tree.Token]) -> List[ErrorRange] = {
  var out: List[ErrorRange] = []
  var i = 0
  for g in gaps {
    match list.get(toks, g) {
      some(t) => {
        while i < list.len(ranges) and (list.get(ranges, i) ?? ErrorRange { start: 0, end: 0, start_byte: 0, end_byte: 0 }).end_byte <= t.start {
          list.push(out, list.get(ranges, i) ?? ErrorRange { start: 0, end: 0, start_byte: 0, end_byte: 0 })
          i = i + 1
        }
        let under = match list.get(ranges, i) { some(r) => r.start_byte < t.end, none => false }
        let after_last = match list.last(out) { some(r) => r.end_byte <= t.start, none => true }
        if not under and after_last and t.end > t.start then list.push(out, ErrorRange { start: t.line, end: t.line, start_byte: t.start, end_byte: t.end }) else ()
      },
      none => (),
    }
  }
  while i < list.len(ranges) {
    list.push(out, list.get(ranges, i) ?? ErrorRange { start: 0, end: 0, start_byte: 0, end_byte: 0 })
    i = i + 1
  }
  out
}
test "an unpaired bracket is a range of its own unless an ERROR range holds it" {
  let toks = [
    tree.Token { kind: tree.T_PUNCT, start: 0, end: 1, line: 1, col: 1 },
    tree.Token { kind: tree.T_PUNCT, start: 10, end: 11, line: 2, col: 1 },
    tree.Token { kind: tree.T_PUNCT, start: 30, end: 31, line: 4, col: 1 },
  ]
  let errors = [ErrorRange { start: 2, end: 3, start_byte: 8, end_byte: 20 }]
  let merged = with_gaps(errors, [0, 1, 2], toks)
  assert_eq(list.map(merged, (r) => r.start_byte), [0, 8, 30])
  assert_eq(list.map(merged, (r) => r.end_byte), [1, 20, 31])
}
fn overlaps(ranges: List[ErrorRange], start: Int, end: Int) -> Bool = {
  var lo = 0
  var hi = list.len(ranges)
  while lo < hi {
    let mid = (lo + hi) / 2
    match list.get(ranges, mid) {
      some(r) => { if r.end_byte <= start then lo = mid + 1 else hi = mid },
      none => { hi = mid },
    }
  }
  match list.get(ranges, lo) { some(r) => r.start_byte < end, none => false }
}
fn error_free_rows(rows: List[SymbolRow], ranges: List[ErrorRange]) -> List[SymbolRow] = {
  var kept: List[SymbolRow] = []
  for row in rows {
    if row.start_byte >= 0 and row.end_byte > row.start_byte and not overlaps(ranges, row.start_byte, row.end_byte) then list.push(kept, row) else ()
  }
  kept
}

test "prepared declarations preserve first mapping including empty kinds" {
  let rules = package_api.SymbolRules {
    declarations: [], scopes: [], namespaces: [], callables: [], lexical_owners: false, envelopes: [], unnamed_envelopes: [],
    arguments: "arguments", field_access: "field_access", type_mentions: ["type_name"]
  }
  let names = nametable.names_of(["hidden", "item", "missing"])
  let table = declaration_table(package_api.SymbolRules { ...rules, declarations: [("hidden", ""), ("hidden", "function"), ("item", "first"), ("item", "second")] }, names)
  assert_eq(decl_kind(0, table), "")
  assert_eq(decl_kind(1, table), "first")
  assert_eq(decl_kind(2, table), "")
  let empty: List[(String, String)] = []
  assert_eq(decl_kind(1, declaration_table(package_api.SymbolRules { ...rules, declarations: empty }, names)), "")
}
