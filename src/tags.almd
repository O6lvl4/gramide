// tags — what a file defines and what it mentions.
//
// `def <kind> <name> L<start>-<end>` for every declaration, `ref call <name> L<n>`
// for every call (qualified as `module.name` when written that way) and
// `ref type <Name> L<n>` for every type mention. This is the input a repo
// map needs: definitions to rank, references to rank them by.
//
// A function that belongs to a type is named with the type: `SpineDb::open`,
// `Shape.Area`. A `def` line is read on its own — in a repo map, in a grep,
// in a flat list of a file's symbols — and a bare `open` there is worth
// nothing. Which languages write which separator is not known here; it
// arrives as `sep`, from lang.almd.

import self.tree
import self.package_api
import self.lex
import self.packages.gramide_almide as lang_almide
import self.packages.gramide_go as lang_go
import self.packages.gramide_rust as lang_rust
import self.parser

// Local copies of the tree helpers that take the token list: a list handed to
// a function in another module is cloned at the call, and these run once per
// node.
fn leaf_text(n: tree.Node, toks: List[tree.Token]) -> String = match list.get(toks, n.start) { some(t) => t.text, none => "" }
fn start_line(n: tree.Node, toks: List[tree.Token]) -> Int = match list.get(toks, n.start) { some(t) => t.line, none => 0 }
// Layout markers can point at the next declaration. Ranges end at source code.
fn code_end(n: tree.Node, toks: List[tree.Token]) -> Int = {
  var end = n.end
  while end > n.start and (option.map(list.get(toks, end - 1), (t) => list.contains(["newline", "dedent", "indent"], t.kind)) ?? false) { end = end - 1 }
  end
}
fn end_line(n: tree.Node, toks: List[tree.Token]) -> Int = match list.get(toks, code_end(n, toks) - 1) {
  some(t) => {
    let breaks = string.count(t.text, "\n") + string.count(t.text, "\r") - string.count(t.text, "\r\n")
    // A recovery token can consume EOF immediately after a line terminator.
    t.line + breaks - (if string.ends_with(t.text, "\n") or string.ends_with(t.text, "\r") then 1 else 0)
  },
  none => 0,
}

// A name of more than one token — `salsa::Database`, `Vec<u8>` — is joined
// from the tokens, not cut out of the source. A token's offsets count bytes
// and `string.slice` counts characters, so cutting the source puts a name in
// a file with a `—` in a comment somewhere above it out by as many bytes as
// that comment cost. Nothing here needs the gaps between tokens anyway.
fn span_text(n: tree.Node, toks: List[tree.Token]) -> String = {
  var s = ""
  var i = n.start
  while i < n.end {
    match list.get(toks, i) { some(t) => { s = s + t.text }, none => () }
    i = i + 1
  }
  s
}

// `name` is what is printed; `base` is the original name without type or namespace qualification, and is
// what a reference can be matched against. A call site says `as_str`, never
// `Applicability::as_str` — gramide resolves no names — so a repo map has to
// join the two on the bare name while showing the useful one. For a `ref`, and
// for anything that belongs to neither a type nor a namespace, they are equal.
type Tag = { role: String, kind: String, name: String, base: String, line: Int, end_line: Int }

fn render(t: Tag) -> String =
  if t.role == "def" then "def " + t.kind + " " + t.name + " L" + int.to_string(t.line) + "-" + int.to_string(t.end_line)
  else "ref " + t.kind + " " + t.name + " L" + int.to_string(t.line)

// The node kinds that define a name, across languages, each mapped to the word
// the output uses for it. Every other kind answers "", which is how the
// walkers tell a declaration from anything else. A grouped Go `type ( … )` is
// a type_declaration without a name whose type_specs carry the names.
//
// This is the whole vocabulary. A grammar that invents a kind still parses; it
// is simply invisible to `outline`, `tags` and `map`.
fn decl_kind(k: String, rules: package_api.SymbolRules) -> String = {
  var found = -1
  var index = 0
  for d in rules.declarations {
    if found < 0 and d.0 == k then found = index else ()
    index = index + 1
  }
  option.map(list.get(rules.declarations, found), (d) => d.1) ?? ""
}
fn is_scope(k: String, rules: package_api.SymbolRules) -> Bool = list.contains(rules.scopes, k)
fn is_callable(k: String, rules: package_api.SymbolRules) -> Bool = list.contains(rules.callables, k)

// The native list.find lowering currently clones its complete input and each
// candidate. Borrow the scan and copy only the matching field, never its siblings.
fn child(n: tree.Node, field: String) -> Option[tree.Node] = {
  var found = -1
  var index = 0
  for k in n.kids {
    if found < 0 and k.field == field then found = index else ()
    index = index + 1
  }
  list.get(n.kids, found)
}

fn bare_name(n: tree.Node, toks: List[tree.Token]) -> String = match child(n, "name") {
  some(m) => if list.is_empty(m.kids) then leaf_text(m, toks) else span_text(m, toks),
  none => "",
}
fn name_of(n: tree.Node, toks: List[tree.Token]) -> String = {
  let name = bare_name(n, toks)
  match child(n, "trait") {
    some(trait_node) => span_text(trait_node, toks) + " for " + name,
    none => name,
  }
}
fn qualified(prefix: String, name: String, sep: String) -> String = if prefix == "" then name else prefix + sep + name
fn flat_name(n: tree.Node, name: String, own: String, namespace: String, toks: List[tree.Token], sep: String, rules: package_api.SymbolRules) -> String = match child(n, "trait") {
  some(trait_node) => span_text(trait_node, toks) + " for " + qualified(namespace, bare_name(n, toks), sep),
  none => qualified(namespace, if rules.lexical_owners then name else qualified(own, name, sep), sep),
}
fn namespace_under(n: tree.Node, namespace: String, toks: List[tree.Token], sep: String, rules: package_api.SymbolRules) -> String =
  if list.contains(rules.namespaces, n.kind) then qualified(namespace, bare_name(n, toks), sep) else namespace

// The bare name to qualify by. A Rust impl is named by a whole type, and
// nobody greps for `Vec<u8>::len`, so only the head of it is taken; a type
// with no head to take — `[u8]`, `(A, B)` — qualifies nothing.
fn scope_of(n: tree.Node, toks: List[tree.Token]) -> String = match child(n, "name") {
  some(m) => if list.is_empty(m.kids) or m.kind == "type_name" then leaf_text(m, toks) else "",
  none => "",
}

fn type_name_in(n: tree.Node, toks: List[tree.Token]) -> String =
  if n.kind == "type_name" then leaf_text(n, toks)
  else {
    var found = ""
    for k in n.kids { if found == "" then { found = type_name_in(k, toks) } else () }
    found
  }

// Go names the owner in a receiver instead of by nesting, so a method there is
// found at the top level with its type one field away.
fn owner_for(n: tree.Node, owner: String, toks: List[tree.Token], rules: package_api.SymbolRules) -> String =
  if not is_callable(n.kind, rules) then ""
  else match child(n, "receiver") {
    some(p) => type_name_in(p, toks),
    none => owner,
  }

fn scope_under(n: tree.Node, owner: String, toks: List[tree.Token], rules: package_api.SymbolRules) -> String =
  if is_callable(n.kind, rules) then ""            // a function body holds no methods
  else if is_scope(n.kind, rules) then scope_of(n, toks)
  else owner

// Walk the tree. Calls are recognised on the flat postfix chain the grammar
// produces: `identifier arguments` or `identifier field_access arguments`.
// The chain is read with one step of memory (what the previous two kids
// were) rather than by looking ahead, because reading a kid with list.get
// copies its whole subtree — a look-ahead would copy every subtree twice.
fn walk(n: tree.Node, toks: List[tree.Token], scope: String, namespace: String, sep: String, rules: package_api.SymbolRules) -> List[Tag] = {
  var out: List[Tag] = []
  let kind = decl_kind(n.kind, rules)
  let name = if kind != "" then name_of(n, toks) else ""
  if name != "" then {
    let own = owner_for(n, scope, toks, rules)
    list.push(out, Tag {
      role: "def",
      kind: if own == "" then kind else "method",
      name: flat_name(n, name, own, namespace, toks, sep, rules),
      base: bare_name(n, toks),
      line: start_line(n, toks), end_line: end_line(n, toks) })
  }
  else if n.kind == "type_name" and not list.is_empty(n.kids) then {
    match list.get(n.kids, 0) {
      some(leaf) => if (leaf.kind == "type_name" or leaf.kind == "identifier") and list.is_empty(leaf.kids) then
        list.push(out, Tag { role: "ref", kind: "type", name: leaf_text(leaf, toks), base: leaf_text(leaf, toks), line: start_line(leaf, toks), end_line: 0 })
      else (),
      none => (),
    }
  }
  else ()
  let inner = scope_under(n, scope, toks, rules)
  let inner_namespace = namespace_under(n, namespace, toks, sep, rules)
  var prev_kind = ""          // the kid before this one
  var prev_name = ""          // its leaf text (identifier) or field name (field_access)
  var prev_line = 0
  var before_kind = ""        // the kid before that
  var before_name = ""
  var i = 0
  let count = list.len(n.kids)
  while i < count {
    match list.get(n.kids, i) {
      none => (),
      some(k) => {
        if k.kind == "arguments" and prev_kind == "identifier" then
          list.push(out, Tag { role: "ref", kind: "call", name: prev_name, base: prev_name, line: prev_line, end_line: 0 })
        else if k.kind == "arguments" and prev_kind == "field_access" then {
          let owner = if before_kind == "identifier" then before_name + "." else ""
          list.push(out, Tag { role: "ref", kind: "call", name: owner + prev_name, base: owner + prev_name, line: prev_line, end_line: 0 })
        }
        else ()
        before_kind = prev_kind
        before_name = prev_name
        prev_kind = k.kind
        prev_line = start_line(k, toks)
        prev_name = if k.kind == "identifier" then leaf_text(k, toks)
          else if k.kind == "field_access" then (match child(k, "field") { some(m) => leaf_text(m, toks), none => "" })
          else ""
        for t in walk(k, toks, inner, inner_namespace, sep, rules) { list.push(out, t) }
      },
    }
    i = i + 1
  }
  out
}

fn of_tree(root: tree.Node, toks: List[tree.Token], sep: String, rules: package_api.SymbolRules) -> List[Tag] = walk(root, toks, "", "", sep, rules)

fn tags(root: tree.Node, toks: List[tree.Token], sep: String, rules: package_api.SymbolRules) -> List[String] =
  list.map(of_tree(root, toks, sep, rules), (t) => render(t))

test "definitions, calls and type mentions" {
  let src = "type P = { x: Int }\nfn area(p: P) -> Int = int.abs(p.x) * sq(2)\n"
  let toks = lex.tokenize(src, lang_almide.spec()) |> result.map_err((e) => e.message)!
  let p = parser.parse(lang_almide.almide(), toks) |> result.map_err((f) => parser.format_failure(f))!
  assert_eq(tags(p.root, toks, ".", lang_almide.symbol_rules()), ["def type P L1-1", "def field x L1-1", "ref type Int L1", "def function area L2-2", "ref type P L2", "ref type Int L2", "ref call int.abs L2", "ref call sq L2"])
}

// `outline`: the definitions only, one per line, nested ones indented by
// how many definitions enclose them. The name is qualified here too, even
// though the indentation already shows what encloses what, so that one line
// cut out of the output still says what it is.
fn outline(root: tree.Node, toks: List[tree.Token], sep: String, rules: package_api.SymbolRules) -> List[String] =
  outline_walk(root, toks, "", "", sep, rules)

fn outline_walk(n: tree.Node, toks: List[tree.Token], indent: String, scope: String, sep: String, rules: package_api.SymbolRules) -> List[String] = {
  let kind = decl_kind(n.kind, rules)
  let name = if kind != "" then name_of(n, toks) else ""
  var out: List[String] = []
  if name != "" then {
    let own = owner_for(n, scope, toks, rules)
    list.push(out, indent + "L" + int.to_string(start_line(n, toks)) + "-" + int.to_string(end_line(n, toks))
      + " " + (if own == "" then kind else "method")
      + " " + (if own == "" then name else own + sep + name))
  }
  else ()
  let deeper = if name == "" then indent else indent + "  "
  let inner = scope_under(n, scope, toks, rules)
  var i = 0
  let count = list.len(n.kids)
  while i < count {
    match list.get(n.kids, i) {
      some(k) => for l in outline_walk(k, toks, deeper, inner, sep, rules) { list.push(out, l) },
      none => (),
    }
    i = i + 1
  }
  out
}

test "a Rust method is named with the type it is implemented on" {
  let src = """mod inner {
    pub struct S { pub a: u8 }
    impl S { pub fn new() -> S { S { a: 0 } } }
    impl fmt::Display for S { fn fmt(&self) -> u8 { 0 } }
    pub trait T { fn go(&self) -> u8; }
}
"""
  let toks = lex.tokenize(src, lang_rust.spec()) |> result.map_err((e) => e.message)!
  let p = parser.parse(lang_rust.rust(), toks) |> result.map_err((f) => parser.format_failure(f))!
  assert_eq(outline(p.root, toks, "::", lang_rust.symbol_rules()), [
    "L1-6 mod inner",
    "  L2-2 type S",
    "    L2-2 field a",
    "  L3-3 impl S",
    "    L3-3 method S::new",
    // `impl Display for S` is an impl of S, so its methods are S's
    "  L4-4 impl fmt::Display for S",
    "    L4-4 method S::fmt",
    "  L5-5 type T",
    "    L5-5 method T::go",
  ])
}

test "a Go method is named with its receiver, which is not where it is written" {
  let src = "package p\n\ntype Shape struct{ w int }\n\nfunc (s *Shape) Area() int { return s.w }\n"
  let toks = lex.tokenize(src, lang_go.spec()) |> result.map_err((e) => e.message)!
  let p = parser.parse(lang_go.go(), toks) |> result.map_err((f) => parser.format_failure(f))!
  assert(list.contains(outline(p.root, toks, ".", lang_go.symbol_rules()), "L5-5 method Shape.Area"))
}

test "a function in a plain module keeps its own name" {
  let src = "mod inner { pub fn free() -> u8 { 0 } }\n"
  let toks = lex.tokenize(src, lang_rust.spec()) |> result.map_err((e) => e.message)!
  let p = parser.parse(lang_rust.rust(), toks) |> result.map_err((f) => parser.format_failure(f))!
  assert_eq(outline(p.root, toks, "::", lang_rust.symbol_rules()), ["L1-1 mod inner", "  L1-1 function free"])
}

test "a multi-byte character above a name does not shift the name" {
  // Every token offset counts bytes; `string.slice` counts characters. Cut a
  // name out of the source and this file gives `eDb {}` where it should give
  // `SpineDb`, one byte per non-ASCII character above it.
  let src = "//! ≥ and — and §\nimpl salsa::Database for SpineDb {}\n"
  let toks = lex.tokenize(src, lang_rust.spec()) |> result.map_err((e) => e.message)!
  let p = parser.parse(lang_rust.rust(), toks) |> result.map_err((f) => parser.format_failure(f))!
  assert_eq(outline(p.root, toks, "::", lang_rust.symbol_rules()), ["L2-2 impl salsa::Database for SpineDb"])
}

test "a function written inside a method body is not a method of the type" {
  let src = "impl S { fn m() { fn helper() -> u8 { 0 } } }\n"
  let toks = lex.tokenize(src, lang_rust.spec()) |> result.map_err((e) => e.message)!
  let p = parser.parse(lang_rust.rust(), toks) |> result.map_err((f) => parser.format_failure(f))!
  assert_eq(outline(p.root, toks, "::", lang_rust.symbol_rules()), ["L1-1 impl S", "  L1-1 method S::m", "    L1-1 function helper"])
}

// Keep this walk beside the shared naming helpers. Cross-module calls in
// the current native backend copy the token list; doing that per node makes
// structured reads quadratic in the size of the source.
// Stable machine-readable declaration ranges: byte offsets are zero-based,
// end-exclusive; line ranges are one-based and inclusive.
fn symbol_rows_in(n: tree.Node, start: Int, toks: List[tree.Token], scope: String, namespace: String, sep: String, rules: package_api.SymbolRules) -> List[Value] = {
  var out: List[Value] = []
  let kind = decl_kind(n.kind, rules)
  let name = if kind == "" then "" else name_of(n, toks)
  if name != "" then {
    let own = owner_for(n, scope, toks, rules)
    match (list.get(toks, start), list.get(toks, code_end(n, toks) - 1)) {
      (some(first), some(last)) => list.push(out, value.object([
        ("kind", value.str(if own == "" then kind else "method")),
        ("name", value.str(flat_name(n, name, own, namespace, toks, sep, rules))),
        ("owner", value.str(if rules.lexical_owners and own != "" then namespace else own)), ("syntax_kind", value.str(n.kind)),
        ("start", value.int(first.line)), ("end", value.int(end_line(n, toks))),
        ("start_byte", value.int(first.start)), ("end_byte", value.int(last.end))
      ])),
      _ => (),
    }
  } else ()
  let inner = scope_under(n, scope, toks, rules)
  let inner_namespace = namespace_under(n, namespace, toks, sep, rules)
  let envelope = list.contains(rules.envelopes, n.kind) or (list.contains(rules.unnamed_envelopes, n.kind) and name == "")
  for k in n.kids {
    // An envelope changes only the reported start, not the subtree. Keep it
    // separate so the native backend borrows children instead of cloning them.
    // A leaf cannot contain the name field required for a declaration.
    if not list.is_empty(k.kids) then {
      let first = if envelope and decl_kind(k.kind, rules) != "" then start else k.start
      for sym in symbol_rows_in(k, first, toks, inner, inner_namespace, sep, rules) { list.push(out, sym) }
    } else ()
  }
  out
}

fn symbol_rows(n: tree.Node, toks: List[tree.Token], scope: String, sep: String, rules: package_api.SymbolRules) -> List[Value] =
  symbol_rows_in(n, n.start, toks, scope, "", sep, rules)

test "flat Rust names preserve nested modules and trait display without changing bases" {
  let src = "mod outer { mod inner { impl PartialEq<S> for S { fn eq(&self) {} } fn free() {} } }"
  let toks = lex.tokenize(src, lang_rust.spec()) |> result.map_err((e) => e.message)!
  let p = parser.parse(lang_rust.rust(), toks) |> result.map_err((f) => parser.format_failure(f))!
  let defs = list.filter(of_tree(p.root, toks, "::", lang_rust.symbol_rules()), (t) => t.role == "def")
  assert_eq(list.map(defs, (t) => t.name), ["outer", "outer::inner", "PartialEq<S> for outer::inner::S", "outer::inner::S::eq", "outer::inner::free"])
  assert_eq(list.map(defs, (t) => t.base), ["outer", "inner", "S", "eq", "free"])
  assert_eq(list.map(defs, (t) => t.kind), ["mod", "mod", "impl", "method", "function"])
}
