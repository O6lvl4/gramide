// tags — what a file defines and what it mentions.
//
// `def <kind> <name> L<start>-<end>` for every declaration, `ref call <name> L<n>`
// for every call (qualified as `module.name` when written that way) and
// `ref type <Name> L<n>` for every type mention. This is the input a repo
// map needs: definitions to rank, references to rank them by.

import self.tree
import self.lex
import self.lang_almide
import self.parser

// Local copies of the tree helpers that take the token list: a list handed to
// a function in another module is cloned at the call, and these run once per
// node.
fn leaf_text(n: tree.Node, toks: List[tree.Token]) -> String = match list.get(toks, n.start) { some(t) => t.text, none => "" }
fn start_line(n: tree.Node, toks: List[tree.Token]) -> Int = match list.get(toks, n.start) { some(t) => t.line, none => 0 }
fn end_line(n: tree.Node, toks: List[tree.Token]) -> Int = match list.get(toks, n.end - 1) { some(t) => t.line, none => 0 }
fn text_of(n: tree.Node, toks: List[tree.Token], src: String) -> String =
  match (list.get(toks, n.start), list.get(toks, n.end - 1)) {
    (some(f), some(l)) => string.slice(src, f.start, l.end),
    _ => "",
  }

type Tag = { role: String, kind: String, name: String, line: Int, end_line: Int }

fn render(t: Tag) -> String =
  if t.role == "def" then "def " + t.kind + " " + t.name + " L" + int.to_string(t.line) + "-" + int.to_string(t.end_line)
  else "ref " + t.kind + " " + t.name + " L" + int.to_string(t.line)

// Node kinds that define a name, across languages. A grouped Go `type ( … )`
// is a type_declaration without a name whose type_specs carry the names.
let DECLS = ["function_declaration", "method_declaration", "type_declaration", "let_declaration", "test_declaration",
  "protocol_declaration", "method_signature", "variant", "type_spec", "var_spec", "const_spec", "field"]

fn decl_kind(k: String) -> String = match k {
  "function_declaration" => "function",
  "method_declaration" => "method",
  "type_spec" => "type",
  "var_spec" => "var",
  "const_spec" => "const",
  "field" => "field",
  "type_declaration" => "type",
  "let_declaration" => "let",
  "test_declaration" => "test",
  "protocol_declaration" => "protocol",
  "method_signature" => "method",
  "variant" => "variant",
  _ => k,
}

fn child(n: tree.Node, field: String) -> Option[tree.Node] = list.find(n.kids, (k) => k.field == field)

fn name_of(n: tree.Node, toks: List[tree.Token], src: String) -> String = match child(n, "name") {
  some(m) => if list.is_empty(m.kids) then leaf_text(m, toks) else text_of(m, toks, src),
  none => "",
}

// Walk the tree. Calls are recognised on the flat postfix chain the grammar
// produces: `identifier arguments` or `identifier field_access arguments`.
// The chain is read with one step of memory (what the previous two kids
// were) rather than by looking ahead, because reading a kid with list.get
// copies its whole subtree — a look-ahead would copy every subtree twice.
fn walk(n: tree.Node, toks: List[tree.Token], src: String) -> List[Tag] = {
  var out: List[Tag] = []
  let name = if list.contains(DECLS, n.kind) then name_of(n, toks, src) else ""
  if name != "" then
    list.push(out, Tag { role: "def", kind: decl_kind(n.kind), name: name, line: start_line(n, toks), end_line: end_line(n, toks) })
  else if n.kind == "type_name" and not list.is_empty(n.kids) then {
    match list.get(n.kids, 0) {
      some(leaf) => if (leaf.kind == "type_name" or leaf.kind == "identifier") and list.is_empty(leaf.kids) then
        list.push(out, Tag { role: "ref", kind: "type", name: leaf_text(leaf, toks), line: start_line(leaf, toks), end_line: 0 })
      else (),
      none => (),
    }
  }
  else ()
  var prev_kind = ""          // the kid before this one
  var prev_name = ""          // its leaf text (identifier) or field name (field_access)
  var prev_line = 0
  var before_kind = ""        // the kid before that
  var before_name = ""
  var i = 0
  let count = list.len(n.kids)
  while i < count {
    match list.get(n.kids, i) {
      none => (),
      some(k) => {
        if k.kind == "arguments" and prev_kind == "identifier" then
          list.push(out, Tag { role: "ref", kind: "call", name: prev_name, line: prev_line, end_line: 0 })
        else if k.kind == "arguments" and prev_kind == "field_access" then {
          let owner = if before_kind == "identifier" then before_name + "." else ""
          list.push(out, Tag { role: "ref", kind: "call", name: owner + prev_name, line: prev_line, end_line: 0 })
        }
        else ()
        before_kind = prev_kind
        before_name = prev_name
        prev_kind = k.kind
        prev_line = start_line(k, toks)
        prev_name = if k.kind == "identifier" then leaf_text(k, toks)
          else if k.kind == "field_access" then (match child(k, "field") { some(m) => leaf_text(m, toks), none => "" })
          else ""
        for t in walk(k, toks, src) { list.push(out, t) }
      },
    }
    i = i + 1
  }
  out
}

fn tags(root: tree.Node, toks: List[tree.Token], src: String) -> List[String] = list.map(walk(root, toks, src), (t) => render(t))

test "definitions, calls and type mentions" {
  let src = "type P = { x: Int }\nfn area(p: P) -> Int = int.abs(p.x) * sq(2)\n"
  let toks = lex.tokenize(src, lang_almide.spec()) |> result.map_err((e) => e.message)!
  let p = parser.parse(lang_almide.almide(), toks) |> result.map_err((f) => parser.format_failure(f))!
  assert_eq(tags(p.root, toks, src), ["def type P L1-1", "def field x L1-1", "ref type Int L1", "def function area L2-2", "ref type P L2", "ref type Int L2", "ref call int.abs L2", "ref call sq L2"])
}

// `outline`: the definitions only, one per line, nested ones indented by
// how many definitions enclose them.
fn outline(root: tree.Node, toks: List[tree.Token], src: String) -> List[String] = outline_walk(root, toks, src, "")

fn outline_walk(n: tree.Node, toks: List[tree.Token], src: String, indent: String) -> List[String] = {
  let name = if list.contains(DECLS, n.kind) then name_of(n, toks, src) else ""
  var out: List[String] = []
  if name != "" then
    list.push(out, indent + "L" + int.to_string(start_line(n, toks)) + "-" + int.to_string(end_line(n, toks)) + " " + decl_kind(n.kind) + " " + name)
  else ()
  let deeper = if name == "" then indent else indent + "  "
  var i = 0
  let count = list.len(n.kids)
  while i < count {
    match list.get(n.kids, i) {
      some(k) => for l in outline_walk(k, toks, src, deeper) { list.push(out, l) },
      none => (),
    }
    i = i + 1
  }
  out
}
