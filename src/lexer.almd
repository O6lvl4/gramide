// lexer — bytes in, tokens out.
//
// Hand-written per language rather than table-driven: every language's
// lexer has two or three places (string interpolation, heredocs, nested
// comments) where a table cannot say what happens, and those are exactly
// the places a syntax check has to get right. The parser above this is
// generic; the lexer is the language's own.
//
// Newlines are tokens. Almide separates statements with them, so the
// grammar must see them; runs of blank lines collapse to one. Whitespace
// and comments are dropped here and never reach the grammar.
//
// Positions are byte offsets into the UTF-8 source, plus 1-based line and
// column, computed once as the tokens are made.

import self.tree

// ── character classes over bytes ──────────────────────────────────────────

fn is_digit(b: Int) -> Bool = b >= 48 and b <= 57
fn is_hex(b: Int) -> Bool = is_digit(b) or (b >= 97 and b <= 102) or (b >= 65 and b <= 70)
fn is_alpha(b: Int) -> Bool = (b >= 97 and b <= 122) or (b >= 65 and b <= 90) or b == 95
fn is_ident(b: Int) -> Bool = is_alpha(b) or is_digit(b) or b >= 128
fn is_upper(b: Int) -> Bool = b >= 65 and b <= 90
fn is_space(b: Int) -> Bool = b == 32 or b == 9 or b == 13

fn at(bytes: List[Int], i: Int) -> Int = list.get(bytes, i) ?? -1

// The text of bytes[s, e). Built with list.get rather than list.slice: the
// native backend borrows a list parameter only while every use of it is a
// borrowing one, and list.slice consumes its argument, which would make
// every token clone the whole source.
fn text(bytes: List[Int], s: Int, e: Int) -> String = {
  var out: List[Int] = []
  var k = s
  while k < e { list.push(out, at(bytes, k)); k = k + 1 }
  string.from_bytes(out)
}

fn mk(bytes: List[Int], kind: String, s: Int, e: Int, line: Int, line_start: Int) -> tree.Token =
  tree.Token { kind: kind, text: text(bytes, s, e), start: s, end: e, line: line, col: s - line_start + 1 }

// The keywords of Almide. `word` tokens that are not here are identifiers.
let KEYWORDS = ["module", "import", "type", "protocol", "for", "in", "fn", "let", "var", "mut", "if", "then", "else",
  "match", "true", "false", "not", "and", "or", "pub", "effect", "test", "guard", "break", "continue", "while",
  "local", "mod", "fan",
  // not Almide, and never an identifier in Almide code: rejecting them here
  // makes `return x` or `class Foo` fail instead of parsing as two statements
  "return", "class", "impl", "deriving", "newtype"]

// Multi-character operators, longest first so `..<` wins over `..`.
// `&&` and `||` are not Almide (it has `and` / `or`), but lexing them as one
// token each makes the parse error name the whole operator a writer typed
// rather than half of it.
let OPERATORS = ["..<", "...", "?.", "??", "->", "=>", "==", "!=", "<=", ">=", "|>", ">>", "**", "..", "&&", "||",
  "=", "+", "-", "*", "/", "%", "^", "<", ">", "!", "?", ".", ",", ":", ";", "(", ")", "[", "]",
  "{", "}", "|", "@", "&", "#"]

type LexError = { line: Int, col: Int, message: String }

// One token being built; the scanners below advance `i` and return the
// end offset for the token starting at `start`.

fn scan_word(bytes: List[Int], start: Int) -> Int = {
  var i = start
  while is_ident(at(bytes, i)) { i = i + 1 }
  i
}

// `\`type\`` — a keyword used as a name. Returns the end offset past the
// closing backtick, or the start when the backtick opens nothing.
fn scan_backtick(bytes: List[Int], start: Int) -> Int = {
  let e = scan_word(bytes, start + 1)
  if e == start + 1 then start else if at(bytes, e) == 96 then e + 1 else e
}

fn scan_number(bytes: List[Int], start: Int) -> (Int, String) = {
  var i = start
  let b1 = at(bytes, i + 1)
  if at(bytes, i) == 48 and (b1 == 120 or b1 == 88) then {           // 0x
    i = i + 2
    while is_hex(at(bytes, i)) or at(bytes, i) == 95 { i = i + 1 }
    (i, "integer")
  } else if at(bytes, i) == 48 and (b1 == 98 or b1 == 66) then {     // 0b
    i = i + 2
    while at(bytes, i) == 48 or at(bytes, i) == 49 or at(bytes, i) == 95 { i = i + 1 }
    (i, "integer")
  } else if at(bytes, i) == 48 and (b1 == 111 or b1 == 79) then {    // 0o
    i = i + 2
    while (at(bytes, i) >= 48 and at(bytes, i) <= 55) or at(bytes, i) == 95 { i = i + 1 }
    (i, "integer")
  } else {
    while is_digit(at(bytes, i)) or at(bytes, i) == 95 { i = i + 1 }
    var kind = "integer"
    // a fraction needs a digit after the dot, so `1..5` and `xs.0` stay apart
    if at(bytes, i) == 46 and is_digit(at(bytes, i + 1)) then {
      i = i + 1
      while is_digit(at(bytes, i)) or at(bytes, i) == 95 { i = i + 1 }
      kind = "float"
    } else ()
    if at(bytes, i) == 101 or at(bytes, i) == 69 then {
      let sign = if at(bytes, i + 1) == 43 or at(bytes, i + 1) == 45 then 1 else 0
      if is_digit(at(bytes, i + 1 + sign)) then {
        i = i + 1 + sign
        while is_digit(at(bytes, i)) { i = i + 1 }
        kind = "float"
      } else ()
    } else ()
    (i, kind)
  }
}

// `"…"` with escapes and `${…}` interpolation (braces balanced inside),
// `"""…"""` heredocs, `r"""…"""` raw heredocs, `'…'` single-quote strings.
// The whole literal is one token; what is inside `${}` is not parsed at
// this stage. Returns none when the string is unterminated.
fn scan_string(bytes: List[Int], start: Int) -> Option[Int] = {
  let raw = at(bytes, start) == 114                                   // r"""
  let q = start + (if raw then 1 else 0)
  let triple = at(bytes, q) == 34 and at(bytes, q + 1) == 34 and at(bytes, q + 2) == 34
  let quote = at(bytes, q)                                             // 34 `"` or 39 `'`
  var i = q + (if triple then 3 else 1)
  var done = false
  var good = true
  var depth = 0
  while not done {
    let b = at(bytes, i)
    if b == -1 then { done = true; good = false }
    else if depth > 0 then {
      if b == 123 then depth = depth + 1
      else if b == 125 then depth = depth - 1
      else if b == 34 or b == 39 then {                                // a string inside ${}
        match scan_string(bytes, i) { some(e) => { i = e - 1 }, none => { done = true; good = false } }
      }
      else if b == 92 then i = i + 1                                    // `\"` written as if still inside the outer string
      else ()
      i = i + 1
    }
    else if b == 92 and not raw then i = i + 2                         // escape
    else if b == 36 and at(bytes, i + 1) == 123 and not raw then { depth = 1; i = i + 2 }
    else if triple then {
      if b == 34 and at(bytes, i + 1) == 34 and at(bytes, i + 2) == 34 then { i = i + 3; done = true }
      else i = i + 1
    }
    else if b == quote then { i = i + 1; done = true }
    else i = i + 1
  }
  if good then some(i) else none
}

// A plain loop, not `list.find` with a lambda: a lambda that reads the
// captured `bytes` clones the whole source per call.
fn scan_operator(bytes: List[Int], start: Int) -> Option[String] = {
  var found: Option[String] = none
  var idx = 0
  while option.is_none(found) and idx < list.len(OPERATORS) {
    let op = list.get(OPERATORS, idx) ?? ""
    let ob = string.to_bytes(op)
    var k = 0
    var same = true
    while same and k < list.len(ob) {
      if at(bytes, start + k) != (list.get(ob, k) ?? -2) then same = false else k = k + 1
    }
    if same then found = some(op) else idx = idx + 1
  }
  found
}

// ── the driver ────────────────────────────────────────────────────────────

fn tokenize(source: String) -> Result[List[tree.Token], LexError] = tokenize_with(source, false)

// Tokens for a file that does not lex. Every run the lexer cannot read becomes
// an `error` token, which no grammar rule asks for, so the parser's recovery
// gives up on the smallest enclosing list rather than on the whole file. An
// unterminated string is the ordinary state of a file someone is typing into.
fn tokenize_recovering(source: String) -> List[tree.Token] =
  match tokenize_with(source, true) { ok(t) => t, err(_) => [] }

// End of the line `i` is on: how far an unreadable run reaches.
fn to_eol(bytes: List[Int], from: Int) -> Int = {
  let n = list.len(bytes)
  var e = from
  while e < n and at(bytes, e) != 10 { e = e + 1 }
  e
}

fn tokenize_with(source: String, recover: Bool) -> Result[List[tree.Token], LexError] = {
  let bytes = string.to_bytes(source)
  let n = list.len(bytes)
  var toks: List[tree.Token] = []
  var i = 0
  var line = 1
  var line_start = 0
  var failure: Option[LexError] = none
  // (no closure here on purpose: one that read `bytes` would clone it per call)
  while i < n and option.is_none(failure) {
    let b = at(bytes, i)
    if is_space(b) then i = i + 1
    else if b == 10 then {
      // one newline token per run of blank lines
      match list.last(toks) { some(t) => if t.kind != "newline" then list.push(toks, mk(bytes, "newline", i, i, line, line_start)) else (), none => () }
      i = i + 1
      line = line + 1
      line_start = i
    }
    else if b == 47 and at(bytes, i + 1) == 47 then {                 // // comment
      while i < n and at(bytes, i) != 10 { i = i + 1 }
    }
    else if b == 47 and at(bytes, i + 1) == 42 then {                 // /* comment */, nested
      var depth = 1
      i = i + 2
      while depth > 0 and i < n {
        if at(bytes, i) == 47 and at(bytes, i + 1) == 42 then { depth = depth + 1; i = i + 2 }
        else if at(bytes, i) == 42 and at(bytes, i + 1) == 47 then { depth = depth - 1; i = i + 2 }
        else { if at(bytes, i) == 10 then { line = line + 1; line_start = i + 1 } else (); i = i + 1 }
      }
      if depth > 0 and not recover then failure = some(LexError { line: line, col: i - line_start + 1, message: "unterminated block comment" }) else ()
    }
    else if b == 34 or b == 39 or (b == 114 and at(bytes, i + 1) == 34) then {
      match scan_string(bytes, i) {
        some(e) => {
          list.push(toks, mk(bytes, "string", i, e, line, line_start))
          // a heredoc spans lines; keep the line counter honest
          var k = i
          while k < e { if at(bytes, k) == 10 then { line = line + 1; line_start = k + 1 } else (); k = k + 1 }
          i = e
        },
        none => if recover then {
          let e = to_eol(bytes, i)
          list.push(toks, mk(bytes, "error", i, e, line, line_start))
          i = e
        } else { failure = some(LexError { line: line, col: i - line_start + 1, message: "unterminated string" }) },
      }
    }
    else if is_digit(b) then {
      let (e, kind) = scan_number(bytes, i)
      list.push(toks, mk(bytes, kind, i, e, line, line_start))
      i = e
    }
    else if is_alpha(b) or b >= 128 then {
      let e = scan_word(bytes, i)
      let word = text(bytes, i, e)
      let kind = if list.contains(KEYWORDS, word) then "keyword"
        else if is_upper(b) then "type_name"
        else "identifier"
      list.push(toks, mk(bytes, kind, i, e, line, line_start))
      i = e
    }
    else if b == 96 then {
      let e = scan_backtick(bytes, i)
      if e == i and recover then {
        list.push(toks, mk(bytes, "error", i, i + 1, line, line_start))
        i = i + 1
      }
      else if e == i then { failure = some(LexError { line: line, col: i - line_start + 1, message: "empty backtick name" }) }
      else {
        list.push(toks, mk(bytes, if is_upper(at(bytes, i + 1)) then "type_name" else "identifier", i, e, line, line_start))
        i = e
      }
    }
    else match scan_operator(bytes, i) {
      some(op) => {
        // a line-initial `-` glued to its operand starts a statement (`-1`),
        // it never continues the line above as a binary minus
        let at_line_start = match list.last(toks) { some(t) => t.kind == "newline", none => true }
        let glued = op == "-" and at_line_start and not is_space(at(bytes, i + 1)) and at(bytes, i + 1) != 10
        list.push(toks, mk(bytes, if glued then "neg" else "punct", i, i + string.len(op), line, line_start))
        i = i + string.len(op)
      },
      none => if recover then {
        list.push(toks, mk(bytes, "error", i, i + 1, line, line_start))
        i = i + 1
      } else { failure = some(LexError { line: line, col: i - line_start + 1, message: "unexpected character " + string.from_bytes([b]) }) },
    }
  }
  match failure {
    some(e) => err(e),
    none => {
      match list.last(toks) { some(t) => if t.kind != "newline" then list.push(toks, mk(bytes, "newline", n, n, line, line_start)) else (), none => () }
      list.push(toks, mk(bytes, "eof", n, n, line, line_start))
      ok(toks)
    },
  }
}

fn kinds(toks: List[tree.Token]) -> List[String] = list.map(toks, (t) => t.kind)
fn texts(toks: List[tree.Token]) -> List[String] = list.map(toks, (t) => t.text)

test "words, keywords, numbers, operators" {
  let toks = tokenize("fn add(x: Int) -> Int = x + 0x1F")!
  assert_eq(texts(toks), ["fn", "add", "(", "x", ":", "Int", ")", "->", "Int", "=", "x", "+", "0x1F", "", ""])
  assert_eq(kinds(toks), ["keyword", "identifier", "punct", "identifier", "punct", "type_name", "punct", "punct", "type_name", "punct", "identifier", "punct", "integer", "newline", "eof"])
}

test "floats and ranges do not eat each other" {
  assert_eq(texts(tokenize("1.5 1..5 xs.0 2e3")!), ["1.5", "1", "..", "5", "xs", ".", "0", "2e3", "", ""])
}

test "strings: escapes, interpolation with nested braces and quotes, heredoc, raw" {
  let toks = tokenize("\"a\\\"b\" \"x \${ f({y: \"}\"}) } z\" \"\"\"\nmulti\n\"\"\" r\"\"\"raw \\ \"\"\" 'q'")!
  assert_eq(kinds(list.take(toks, 5)), ["string", "string", "string", "string", "string"])
  assert_eq(list.get(texts(toks), 1), some("\"x \${ f({y: \"}\"}) } z\""))
}

test "an unterminated string is an error with a position" {
  assert_eq(result.is_err(tokenize("let s = \"abc")), true)
  match tokenize("let s = \"abc") { err(e) => { assert_eq(e.line, 1); assert_eq(e.col, 9) }, ok(_) => assert(false) }
}

test "comments vanish, newlines collapse, `?` is always its own token, backtick names" {
  let toks = tokenize("// c\nfn f() = 1 /* a /* b */ c */\n\n\nfn is_ok?(x: Int) -> Bool = x?\nlet `type` = 1\n")!
  assert_eq(texts(toks), ["fn", "f", "(", ")", "=", "1", "", "fn", "is_ok", "?", "(", "x", ":", "Int", ")", "->", "Bool", "=", "x", "?", "", "let", "`type`", "=", "1", "", ""])
  assert_eq(list.get(kinds(toks), 22), some("identifier"))
}

test "line and column are 1-based and survive a heredoc" {
  let toks = tokenize("a\n\"\"\"\nx\n\"\"\"\nb")!
  let b = list.find(toks, (t) => t.text == "b")
  assert_eq(option.map(b, (t) => t.line), some(5))
  assert_eq(option.map(b, (t) => t.col), some(1))
}
