// parser — a grammar is a value; parsing is interpreting it over tokens.
//
// Rules are ordinary Almide data, built with the constructors at the
// bottom of this file and looked up by name in a Grammar. The engine is a
// backtracking parser with ordered choice (a PEG): `alt` tries its
// alternatives in order and commits to the first that matches, `rep` is
// greedy, and a rule either matches at a position or does not. No
// separate generator step, no tables — a grammar is edited and run.
//
// Left recursion is not supported and not needed: expressions are written
// as precedence levels (`sum = product (("+" | "-") product)*`) and the
// binary nodes are folded left after the match, which is what every
// hand-written parser does.
//
// Errors: the parser remembers the FARTHEST token any rule failed at and
// what was expected there. That position is where a human would say the
// syntax breaks, and it is what `check` reports.

import self.names as nametable
import self.tree

type Rule =
  | Tok(String)                 // a token of this kind → leaf node (identifier, integer, …)
  | Lit(String)                 // a token with exactly this text, dropped from the tree
  | Keep(String)                // a token with this text, kept as a leaf (operators in binary nodes)
  | Ref(String)                 // another rule, by name
  | Seq(List[Rule])
  | Alt(List[Rule])
  | Rep(Rule)                   // zero or more
  | Rep1(Rule)                  // one or more
  | Opt(Rule)
  | Wrap(String, Rule)          // wrap what the rule produced in a node of this kind
  | Field(String, Rule)         // name the node(s) the rule produced
  | Not(Rule)                   // negative lookahead, consumes nothing
  | Ahead(Rule)                 // positive lookahead, consumes nothing
  | Left(String, Rule, Rule)    // operand (op operand)* folded left into nodes of this kind
  | Nest(String, Rule)          // a node of this kind, unless the rule left exactly one
                               // behind: a rule that only ever stands in front of another
                               // says nothing by wrapping it
  | Needs(Rule)                 // a necessary condition, checked by a scan rather than by
                               // parsing what follows and failing: one of these literals has
                               // to stand in the rest of the logical line, outside brackets
  | Prec(String, Rule, List[Rule])
                               // the same fold over several precedence levels at once:
                               // the operand, then one operator per level, lowest first.
                               // Every level is left-associative and makes nodes of the
                               // same kind, and every level's operator must be a literal
                               // terminal, because the ladder peeks at the token to find
                               // which level it belongs to before running anything.
  | Any                         // any one token but the end of the file, kept out of the tree
  | Recover(Rule, Rule)         // on a recovering parse: skip to where the first matches
  | RecoverAll(Rule, Rule)      //   again, keeping what the second reads of the failed item
                                //   and leaving an ERROR node over the rest
  | RecoverLines(Rule)         // resume at a logical line in the same indent scope
  | Eps

type Grammar = { start: String, rules: Map[String, Rule] }

// ── the compiled grammar ─────────────────────────────────────────────────
//
// A Rule value is what a grammar author writes; the engine runs on a flat
// arena instead. Each node is three integers: a kind, and `a`/`b` whose
// meaning depends on the kind (a child index, a target rule, a range in
// the shared child list). Texts live in a parallel list and are fetched
// only by the nodes that need one. So a node visit copies twelve bytes —
// in the native backend every value read is a copy, and running the engine
// on the Rule tree itself cloned a whole sub-grammar at every reference.
//
// Terminals are interned. A terminal named by kind carries the number the
// lexer already wrote on the token (`tree.kind_id`); a terminal named by text
// carries a number `compile` assigns to every distinct spelling a rule asks
// for, and `number_tokens` numbers the stream's texts the same way once. A
// terminal match is then an integer compare rather than a string compare, and
// the few spellings the engine tests itself are pinned by `SEEDS`.
type Op = { kind: Int, a: Int, b: Int }
type Compiled = { ops: List[Op], kids: List[Int], start: Int,
  spelling: List[Int], spelling_start: List[Int], spelling_end: List[Int], bucket: List[Int], bucket_next: List[Int],
  lit_mask: List[Int], head_kinds: List[Int], head_mask: List[Int], head_start: List[Int], head_len: List[Int], head_run: List[Int],
  kind_of: List[Int], names: nametable.Names, extra: Int }

// Every terminal spelling, byte by byte and end to end, in atom order, plus a
// bucket chain keyed by a spelling's first byte and its length. Numbering the
// token stream then reads the source where the token sits: an ordinary name —
// most of the tokens in a file — lands in an empty bucket and answers -1
// without a string being cut out of the source to hash.
// A byte and a width, which is every key the bucket table can be asked for:
// 256 first bytes by 17 widths. The table is that size and is read by index —
// a hash of the same two numbers would cost more than the answer.
fn atom_key(first: Int, width: Int) -> Int = first * 17 + (if width > 16 then 16 else width)
let ATOM_SLOTS = 4352
let ATOM_IDS = 65536

fn pack_atoms(spellings: List[String]) -> (List[Int], List[Int], List[Int], List[Int], List[Int]) = {
  var data: List[Int] = []
  var starts: List[Int] = []
  var ends: List[Int] = []
  var slots: List[Int] = list.with_capacity(list.len(spellings))
  for text in spellings {
    let raw = bytes.from_string(text)
    let width = bytes.len(raw)
    list.push(starts, list.len(data))
    var k = 0
    while k < width {
      list.push(data, bytes.get_or(raw, k, 0))
      k = k + 1
    }
    list.push(ends, list.len(data))
    list.push(slots, atom_key(bytes.get_or(raw, 0, 0), width))
  }
  // Both tables are filled by appending, never by writing at an index:
  // `list.set` on this backend copies the whole list, and a 4,352-slot table
  // written 249 times that way is a millisecond of startup on its own.
  // The chain looks backward for the last spelling in the same slot, and the
  // heads are read off one sorted pass, slot by slot.
  var chain: List[Int] = list.with_capacity(list.len(slots))
  var id = 0
  while id < list.len(slots) {
    let mine = match list.get(slots, id) { some(v) => v, none => -1 }
    var back = id - 1
    var prev = -1
    while prev < 0 and back >= 0 {
      if (match list.get(slots, back) { some(v) => v, none => -1 }) == mine then prev = back else back = back - 1
    }
    list.push(chain, prev)
    id = id + 1
  }
  var keys: List[Int] = list.with_capacity(list.len(slots))
  var n = 0
  while n < list.len(slots) {
    list.push(keys, (match list.get(slots, n) { some(v) => v, none => 0 }) * ATOM_IDS + n)
    n = n + 1
  }
  let sorted = list.sort(keys)
  var head: List[Int] = list.with_capacity(ATOM_SLOTS)
  var at = 0
  var slot = 0
  while slot < ATOM_SLOTS {
    var last = -1
    while at < list.len(sorted) and (match list.get(sorted, at) { some(v) => v, none => 0 }) / ATOM_IDS == slot {
      last = (match list.get(sorted, at) { some(v) => v, none => 0 }) % ATOM_IDS
      at = at + 1
    }
    list.push(head, last)
    slot = slot + 1
  }
  (data, starts, ends, head, chain)
}

fn same_span(spelling: List[Int], at: Int, source: Bytes, start: Int, width: Int) -> Bool = {
  var i = 0
  var same = true
  while same and i < width {
    same = (match list.get(spelling, at + i) { some(b) => b, none => -1 }) == bytes.get_or(source, start + i, -2)
    i = i + 1
  }
  same
}

// The atom for the source between `start` and `end`, or -1 for a stretch of
// source no terminal spells.
fn atom_at(c: Compiled, source: Bytes, start: Int, end: Int) -> Int = {
  let width = end - start
  if width <= 0 then -1 else {
    let first = bytes.get_or(source, start, -1)
    var id = if first < 0 then -1 else (match list.get(c.bucket, atom_key(first, width)) { some(v) => v, none => -1 })
    var found = -1
    while id >= 0 and found < 0 {
      let at = match list.get(c.spelling_start, id) { some(v) => v, none => 0 }
      let stop = match list.get(c.spelling_end, id) { some(v) => v, none => 0 }
      if stop - at == width and same_span(c.spelling, at, source, start, width) then found = id
      else id = match list.get(c.bucket_next, id) { some(v) => v, none => -1 }
    }
    found
  }
}

let A_LPAREN = 0
let A_RPAREN = 1
let A_LBRACK = 2
let A_RBRACK = 3
let A_LBRACE = 4
let A_RBRACE = 5
let A_SEMI = 6
let SEEDS = ["(", ")", "[", "]", "{", "}", ";"]

let K_EPS = 0
let K_TOK = 1
let K_LIT = 2
let K_KEEP = 3
let K_REF = 4
let K_SEQ = 5
let K_ALT = 6
let K_REP = 7
let K_REP1 = 8
let K_OPT = 9
let K_WRAP = 10
let K_FIELD = 11
let K_NOT = 12
let K_AHEAD = 13
let K_LEFT = 14
let K_ANY = 15
let K_RECOVER = 16
let K_RECOVER_ALL = 17
let K_RECOVER_LINES = 18
let K_PREC = 19
let K_NEEDS = 20
let K_NEST = 21
// A wrap whose body is a sequence, fused: the engine walks the children where
// it stands instead of calling a rule that does nothing else.
let K_WRAP_SEQ = 22
let K_NEST_SEQ = 23
// A negation of a terminal, and a sequence of nothing but terminal tests. Both
// are leaves the engine used to reach by calling itself: `name` is
// `seq([nott(lits(HARD_KEYWORDS)), tok("identifier")])`, four visits to decide
// that an identifier is not a keyword, and it is a fifth of every visit a
// Python file costs.
let K_NOT_LIT = 24
let K_NOT_TOK = 25
let K_TERMS = 26

// The engine names six things the grammar does not: a kept operator, a
// recovered range, the three parts of a fold, and the absence of a name. They
// are appended to the text table, and `c.extra` is where they start.
let X_NONE = 0
let X_OP = 1
let X_ERROR = 2
let X_LEFT = 3
let X_OPERATOR = 4
let X_RIGHT = 5

// Append a rule's subtree to the arena and answer where its own node landed.
// The three lists are the arena itself, handed down rather than returned:
// building a private arena per subtree and copying it into the parent made
// compiling a grammar quadratic in its size, and a grammar is compiled once
// per file.
fn emit(r: Rule, mut ops: List[Op], mut texts: List[String], mut kids: List[Int]) -> Int = {
  let (kind, text, subs) = match r {
    Eps => (K_EPS, "", []),
    Tok(k) => (K_TOK, k, []),
    Lit(t) => (K_LIT, t, []),
    Keep(t) => (K_KEEP, t, []),
    Ref(n) => (K_REF, n, []),
    Seq(xs) => (K_SEQ, "", xs),
    Alt(xs) => (K_ALT, "", xs),
    Rep(x) => (K_REP, "", [x]),
    Rep1(x) => (K_REP1, "", [x]),
    Opt(x) => (K_OPT, "", [x]),
    Wrap(k, x) => (K_WRAP, k, [x]),
    Field(f, x) => (K_FIELD, f, [x]),
    Not(x) => (K_NOT, "", [x]),
    Ahead(x) => (K_AHEAD, "", [x]),
    Left(k, x, y) => (K_LEFT, k, [x, y]),
    Prec(k, x, ys) => (K_PREC, k, [x] + ys),
    Needs(x) => (K_NEEDS, "", [x]),
    Nest(k, x) => (K_NEST, k, [x]),
    Any => (K_ANY, "", []),
    Recover(x, h) => (K_RECOVER, "", [x, h]),
    RecoverAll(x, h) => (K_RECOVER_ALL, "", [x, h]),
    RecoverLines(x) => (K_RECOVER_LINES, "", [x]),
  }
  var ids: List[Int] = []
  for s in subs {
    list.push(ids, emit(s, ops, texts, kids))
  }
  let op = if kind == K_SEQ or kind == K_ALT then {
    let first = list.len(kids)
    for id in ids { list.push(kids, id) }
    Op { kind: kind, a: first, b: list.len(ids) }
  } else if kind == K_PREC then {
    // the operand, then one operator rule per level: `b` counts the levels
    let first = list.len(kids)
    for id in ids { list.push(kids, id) }
    Op { kind: kind, a: first, b: list.len(ids) - 1 }
  } else if kind == K_LEFT or kind == K_RECOVER or kind == K_RECOVER_ALL then Op { kind: kind, a: list.get(ids, 0) ?? 0, b: list.get(ids, 1) ?? 0 }
  else Op { kind: kind, a: list.get(ids, 0) ?? -1, b: 0 }
  list.push(ops, op)
  list.push(texts, text)
  list.len(ops) - 1
}

// Is every branch of this alternation the same kind of literal? Branches are
// emitted before their parent, so they are already resolved here.
fn all_branches(resolved: List[Op], kids: List[Int], op: Op, kind: Int) -> Bool = {
  var all = op.b > 1
  var j = 0
  while all and j < op.b {
    let child = match list.get(kids, op.a + j) { some(v) => v, none => -1 }
    all = (match list.get(resolved, child) { some(o) => o.kind, none => -1 }) == kind
    j = j + 1
  }
  all
}

// One run for the whole alternation: every branch's atom, then every branch's
// node id, so a failure still names each spelling separately.
fn merged_run(resolved: List[Op], mut kids: List[Int], op: Op) -> Int = {
  let run = list.len(kids)
  var j = 0
  while j < op.b {
    let child = match list.get(kids, op.a + j) { some(v) => v, none => -1 }
    let at = match list.get(resolved, child) { some(o) => o.a, none => 0 }
    list.push(kids, match list.get(kids, at) { some(v) => v, none => -1 })
    j = j + 1
  }
  var m = 0
  while m < op.b {
    let child = match list.get(kids, op.a + m) { some(v) => v, none => -1 }
    let at = match list.get(resolved, child) { some(o) => o.a, none => 0 }
    list.push(kids, match list.get(kids, at + 1) { some(v) => v, none => -1 })
    m = m + 1
  }
  run
}

// A reference does nothing but stand in front of the rule it names: the engine
// visited it, dispatched, and called `parse_rule` again on its target. Once
// every target is known, each field that pointed at a reference points at what
// the reference pointed at, following a chain of aliases to its end. A
// reference to a rule the grammar never defines keeps its place, because its
// failure is what names the missing rule.
fn single_child(kind: Int) -> Bool = kind == K_REP or kind == K_REP1 or kind == K_OPT
  or kind == K_WRAP or kind == K_FIELD or kind == K_NOT or kind == K_AHEAD or kind == K_RECOVER_LINES
fn two_children(kind: Int) -> Bool = kind == K_LEFT or kind == K_RECOVER or kind == K_RECOVER_ALL

fn target_of(resolved: List[Op], id: Int) -> Int = {
  var at = id
  var going = true
  var hops = 0
  while going and hops < 64 {
    let op = match list.get(resolved, at) { some(o) => o, none => Op { kind: K_EPS, a: 0, b: 0 } }
    if op.kind == K_REF and op.a >= 0 then {
      at = op.a
      hops = hops + 1
    } else going = false
  }
  at
}

// `upto` is where the arena's own child lists end: everything emitted for a
// rule tree comes first, and the literal runs `compile` appends after it are
// atom numbers and node ids, not children to follow.
fn shortcut_kids(resolved: List[Op], kids: List[Int], upto: Int) -> List[Int] = {
  var out: List[Int] = list.with_capacity(list.len(kids))
  var i = 0
  while i < list.len(kids) {
    let v = match list.get(kids, i) { some(x) => x, none => 0 }
    list.push(out, if i < upto then target_of(resolved, v) else v)
    i = i + 1
  }
  out
}

fn fuse_wraps(ops: List[Op]) -> List[Op] = {
  var out: List[Op] = list.with_capacity(list.len(ops))
  var i = 0
  while i < list.len(ops) {
    let op = match list.get(ops, i) { some(o) => o, none => Op { kind: K_EPS, a: 0, b: 0 } }
    let body = match list.get(ops, op.a) { some(o) => o, none => Op { kind: K_EPS, a: 0, b: 0 } }
    if (op.kind == K_WRAP or op.kind == K_NEST) and body.kind == K_SEQ then
      list.push(out, Op { kind: if op.kind == K_WRAP then K_WRAP_SEQ else K_NEST_SEQ, a: body.a, b: body.b })
    else list.push(out, op)
    i = i + 1
  }
  out
}

// A literal set answers "is the token spelled one of these" by walking the
// set, and the set that decides an identifier is not a keyword has 35 members
// — walked in full every time, because an ordinary name matches none of them.
// One 64-bit sketch per set turns every one of those misses into a shift and
// a test; only a hit is worth walking.
fn lit_masks(ops: List[Op], kids: List[Int]) -> List[Int] = {
  var out: List[Int] = list.with_capacity(list.len(ops))
  var i = 0
  while i < list.len(ops) {
    let op = match list.get(ops, i) { some(o) => o, none => Op { kind: K_EPS, a: 0, b: 0 } }
    var mask = 0
    if op.kind == K_LIT or op.kind == K_KEEP or op.kind == K_NOT_LIT then {
      var j = 0
      while j < op.b {
        mask = int.bor(mask, int.bshl(1, int.band(match list.get(kids, op.a + j) { some(v) => v, none => 0 }, 63)))
        j = j + 1
      }
    } else ()
    list.push(out, mask)
    i = i + 1
  }
  out
}

fn leafy(kind: Int) -> Bool = kind == K_TOK or kind == K_LIT or kind == K_KEEP or kind == K_NOT_LIT or kind == K_NOT_TOK

// Two rewrites, in this order because the second reads what the first wrote.
// A negation of a terminal is one op, and a sequence whose every member is a
// terminal test — negated or not — is one op that runs them where it stands.
fn fuse_leaves(ops: List[Op], kids: List[Int]) -> List[Op] = {
  var once: List[Op] = list.with_capacity(list.len(ops))
  var i = 0
  while i < list.len(ops) {
    let op = match list.get(ops, i) { some(o) => o, none => Op { kind: K_EPS, a: 0, b: 0 } }
    let body = match list.get(ops, op.a) { some(o) => o, none => Op { kind: K_EPS, a: 0, b: 0 } }
    if op.kind == K_NOT and body.kind == K_LIT then list.push(once, Op { kind: K_NOT_LIT, a: body.a, b: body.b })
    else if op.kind == K_NOT and body.kind == K_TOK then list.push(once, Op { kind: K_NOT_TOK, a: op.a, b: body.b })
    else list.push(once, op)
    i = i + 1
  }
  var out: List[Op] = list.with_capacity(list.len(once))
  var j = 0
  while j < list.len(once) {
    let op = match list.get(once, j) { some(o) => o, none => Op { kind: K_EPS, a: 0, b: 0 } }
    var all = op.kind == K_SEQ and op.b > 0
    var m = 0
    while all and m < op.b {
      let child = match list.get(kids, op.a + m) { some(v) => v, none => -1 }
      all = leafy(match list.get(once, child) { some(o) => o.kind, none => -1 })
      m = m + 1
    }
    list.push(out, if all then Op { kind: K_TERMS, a: op.a, b: op.b } else op)
    j = j + 1
  }
  out
}

fn shortcut_ops(resolved: List[Op]) -> List[Op] = {
  var out: List[Op] = list.with_capacity(list.len(resolved))
  for op in resolved {
    if two_children(op.kind) then list.push(out, Op { kind: op.kind, a: target_of(resolved, op.a), b: target_of(resolved, op.b) })
    else if single_child(op.kind) then list.push(out, Op { kind: op.kind, a: target_of(resolved, op.a), b: op.b })
    else list.push(out, op)
  }
  out
}

// The terminal a rule must begin with, when it always begins with one. A
// sequence answers for its first element, and only for an element that cannot
// match nothing: an optional, a repetition or a lookahead in front of it means
// the rule can begin elsewhere, and the answer is -1, which asks nobody to
// skip anything. This is what lets an alternation pass over a branch, and a
// repetition stop, by reading the token rather than walking in and failing.
//
// One linear pass propagates the answer one level; a reference may point at a
// rule emitted later, so the passes repeat until nothing moves. Walking the
// chain recursively instead costs the whole table at every node — 2.7 ms of
// startup on a file that has none to spare.
// A head set: the terminals a rule can begin with, when they are all known. A
// sequence answers for its first element, an alternation for the union of its
// branches, and anything that can match nothing answers the empty set, which
// means "no idea, walk in and see". The sets live as runs in one shared list.
let HEAD_LIMIT = 48

// A lookahead reads no token, so it is not what a rule begins with. Skipping it
// answers with what follows, which is a superset of the truth — a lookahead can
// only remove possibilities — and a superset is what a head set must be.
// Without this, `name` (not a keyword, then an identifier) has no head, and
// every rule that reaches an expression through it has none either: 55% of
// Python's arena, the whole expression ladder included.
fn zero_width(kind: Int) -> Bool =
  kind == K_NOT or kind == K_AHEAD or kind == K_NOT_LIT or kind == K_NOT_TOK or kind == K_EPS

fn first_consuming(resolved: List[Op], kids: List[Int], at: Int, count: Int) -> Int = {
  var j = 0
  var found = -1
  while found < 0 and j < count {
    let child = match list.get(kids, at + j) { some(v) => v, none => -1 }
    let kind = match list.get(resolved, child) { some(o) => o.kind, none => K_EPS }
    if child >= 0 and not zero_width(kind) then found = child else ()
    j = j + 1
  }
  found
}

// A rule that can match nothing does not decide what follows it, so a sequence
// that begins with one begins with everything the next element does as well.
// `function_declaration` begins with `decorators`, which is a `rep` and matches
// nothing at all in a file without decorators — so it had no head set, and
// every statement in the file was read into it as far as the `def` that was not
// there: 2,357 failures and 23,570 visits in `inspect.py`.
//
// True where it is not certain: saying a rule can match nothing only ever adds
// the next element's terminals to the set, and a head set is allowed to be
// larger than the truth.
fn nullable_at(resolved: List[Op], id: Int, depth: Int) -> Bool =
  if id < 0 or depth > 8 then false
  else {
    let op = match list.get(resolved, id) { some(o) => o, none => Op { kind: K_EPS, a: 0, b: 0 } }
    if op.kind == K_OPT or op.kind == K_REP or zero_width(op.kind) then true
    else if op.kind == K_WRAP or op.kind == K_NEST or op.kind == K_FIELD then nullable_at(resolved, op.a, depth + 1)
    else false
  }

// What a child begins with, when the child itself is allowed to begin with
// nothing: an `opt` or a `rep` answers for what it wraps. The table the engine
// reads keeps answering "no idea" for those ops themselves, because `may_start`
// must never refuse one — it can always match.
fn head_source(resolved: List[Op], id: Int, depth: Int) -> Int =
  if id < 0 or depth > 8 then -1
  else {
    let op = match list.get(resolved, id) { some(o) => o, none => Op { kind: K_EPS, a: 0, b: 0 } }
    if op.kind == K_OPT or op.kind == K_REP then head_source(resolved, op.a, depth + 1)
    else if (op.kind == K_WRAP or op.kind == K_NEST or op.kind == K_FIELD) and nullable_at(resolved, op.a, depth + 1) then
      head_source(resolved, op.a, depth + 1)
    else id
  }

fn head_through(resolved: List[Op], op: Op, kids: List[Int]) -> Int =
  if op.kind == K_WRAP or op.kind == K_NEST or op.kind == K_FIELD or op.kind == K_REP1 or op.kind == K_LEFT then op.a
  // a sequence, a fused wrap and a ladder all keep their first child in the
  // child list, where `a` is an index into it rather than a node of its own
  else if op.kind == K_PREC then match list.get(kids, op.a) { some(v) => v, none => -1 }
  else if (op.kind == K_SEQ or op.kind == K_WRAP_SEQ or op.kind == K_NEST_SEQ or op.kind == K_TERMS) and op.b > 0 then
    first_consuming(resolved, kids, op.a, op.b)
  else -1

fn copy_head(mut run: List[Int], start: List[Int], width: List[Int], prev_start: List[Int], prev_len: List[Int], prev_run: List[Int], here: Int, child: Int) -> Bool = {
  let known = if child < here then (match list.get(width, child) { some(v) => v, none => 0 })
    else (match list.get(prev_len, child) { some(v) => v, none => 0 })
  if known == 0 then false
  else {
    let at = if child < here then (match list.get(start, child) { some(v) => v, none => 0 })
      else (match list.get(prev_start, child) { some(v) => v, none => 0 })
    var m = 0
    while m < known {
      list.push(run, if child < here then (match list.get(run, at + m) { some(v) => v, none => -1 })
        else (match list.get(prev_run, at + m) { some(v) => v, none => -1 }))
      m = m + 1
    }
    true
  }
}

fn heads_pass(resolved: List[Op], kids: List[Int], prev_start: List[Int], prev_len: List[Int], prev_run: List[Int]) -> (List[Int], List[Int], List[Int]) = {
  var start: List[Int] = list.with_capacity(list.len(resolved))
  var width: List[Int] = list.with_capacity(list.len(resolved))
  var run: List[Int] = []
  var i = 0
  while i < list.len(resolved) {
    let op = match list.get(resolved, i) { some(o) => o, none => Op { kind: K_EPS, a: 0, b: 0 } }
    let from = list.len(run)
    if op.kind == K_LIT or op.kind == K_KEEP or op.kind == K_TOK then list.push(run, i)
    else if op.kind == K_ALT then {
      var known = op.b > 0
      var j = 0
      while known and j < op.b {
        known = copy_head(run, start, width, prev_start, prev_len, prev_run, i, match list.get(kids, op.a + j) { some(v) => v, none => -1 })
        j = j + 1
      }
      if not known or list.len(run) - from > HEAD_LIMIT then {
        while list.len(run) > from { let _ = list.pop(run) }
      } else ()
    }
    else if (op.kind == K_SEQ or op.kind == K_WRAP_SEQ or op.kind == K_NEST_SEQ or op.kind == K_TERMS) and op.b > 0 then {
      var j = 0
      var known = true
      var settled = false
      while known and not settled and j < op.b {
        let child = match list.get(kids, op.a + j) { some(v) => v, none => -1 }
        let kind = match list.get(resolved, child) { some(o) => o.kind, none => K_EPS }
        if child < 0 or zero_width(kind) then ()
        else {
          known = copy_head(run, start, width, prev_start, prev_len, prev_run, i, head_source(resolved, child, 0))
          if not nullable_at(resolved, child, 0) then settled = true else ()
        }
        j = j + 1
      }
      // every element could match nothing, so the sequence could too
      if not known or not settled or list.len(run) - from > HEAD_LIMIT then {
        while list.len(run) > from { let _ = list.pop(run) }
      } else ()
    }
    else {
      let through = head_through(resolved, op, kids)
      if through >= 0 then {
        let _ = copy_head(run, start, width, prev_start, prev_len, prev_run, i, through)
      } else ()
    }
    list.push(start, from)
    list.push(width, list.len(run) - from)
    i = i + 1
  }
  (start, width, run)
}

fn head_terminals(resolved: List[Op], kids: List[Int]) -> (List[Int], List[Int], List[Int]) = {
  var start: List[Int] = []
  var width: List[Int] = []
  var run: List[Int] = []
  var i = 0
  while i < list.len(resolved) { list.push(start, 0); list.push(width, 0); i = i + 1 }
  var round = 0
  var moving = true
  while moving and round < 16 {
    let (s2, w2, r2) = heads_pass(resolved, kids, start, width, run)
    moving = w2 != width or r2 != run
    start = s2
    width = w2
    run = r2
    round = round + 1
  }
  (start, width, run)
}

// The fixpoint answers in op indices, which is what it needs to compare one
// round against the last. The engine wants something it can test in a couple
// of reads, so the table is turned once, at the end, into what a token is
// actually compared against: a bitmask of the kinds a rule can begin with, a
// 64-bit sketch of the spellings it can begin with, and the spellings
// themselves for the test that has to be exact.
//
// A rule with no known head answers -1 for its kinds, so the first test
// already says yes and nothing else is read.
fn head_index(ops: List[Op], kids: List[Int], start: List[Int], width: List[Int], run: List[Int]) -> (List[Int], List[Int], List[Int], List[Int], List[Int]) = {
  var kinds: List[Int] = list.with_capacity(list.len(ops))
  var mask: List[Int] = list.with_capacity(list.len(ops))
  var vstart: List[Int] = list.with_capacity(list.len(ops))
  var vlen: List[Int] = list.with_capacity(list.len(ops))
  var vals: List[Int] = []
  var i = 0
  while i < list.len(ops) {
    let n = match list.get(width, i) { some(v) => v, none => 0 }
    let at = match list.get(start, i) { some(v) => v, none => 0 }
    let from = list.len(vals)
    var bits = 0
    var sketch = 0
    var m = 0
    while m < n {
      let h = match list.get(run, at + m) { some(v) => v, none => -1 }
      let op = match list.get(ops, h) { some(o) => o, none => Op { kind: K_EPS, a: 0, b: 0 } }
      if op.kind == K_TOK then bits = int.bor(bits, int.bshl(1, op.b))
      else {
        var j = 0
        while j < op.b {
          let atom = match list.get(kids, op.a + j) { some(v) => v, none => -1 }
          list.push(vals, atom)
          sketch = int.bor(sketch, int.bshl(1, int.band(atom, 63)))
          j = j + 1
        }
      }
      m = m + 1
    }
    list.push(kinds, if n == 0 then -1 else bits)
    list.push(mask, sketch)
    list.push(vstart, from)
    list.push(vlen, list.len(vals) - from)
    i = i + 1
  }
  (kinds, mask, vstart, vlen, vals)
}

// Every node kind and field name is a number: the first entry that spells a
// name answers for every later one, so two nodes the grammar spelled the same
// compare equal without a string ever being copied out of the arena.
fn canonical_kinds(texts: List[String], empty: Int) -> List[Int] = {
  var seen: Map[String, Int] = [:]
  var out: List[Int] = list.with_capacity(list.len(texts))
  var i = 0
  while i < list.len(texts) {
    let text = match list.get(texts, i) { some(t) => t, none => "" }
    // Most nodes in the arena are structure — sequence, choice, repetition —
    // and carry no name at all. They share one number without being asked.
    if text == "" then list.push(out, empty)
    else match map.get(seen, text) {
      some(first) => list.push(out, first),
      none => {
        map.insert(seen, text, i)
        list.push(out, i)
      },
    }
    i = i + 1
  }
  out
}

fn compile(g: Grammar) -> Compiled = {
  var ops: List[Op] = []
  var texts: List[String] = []
  var kids: List[Int] = []
  var names: Map[String, Int] = [:]
  for (name, rule) in map.entries(g.rules) {
    map.insert(names, name, emit(rule, ops, texts, kids))
  }
  // the start rule plus eof, then resolve every reference to its target
  let start = emit(Seq([Ref(g.start), Tok("eof")]), ops, texts, kids)
  // resolve every reference to its target, and number every terminal's text
  var atoms: Map[String, Int] = [:]
  var spellings: List[String] = []
  var next = 0
  for s in SEEDS {
    map.insert(atoms, s, next)
    list.push(spellings, s)
    next = next + 1
  }
  var resolved: List[Op] = []
  // every child list the rule trees needed is already here; what `compile`
  // appends below is literal runs, which are not children
  let arena_kids = list.len(kids)
  var i = 0
  while i < list.len(ops) {
    let op = list.get(ops, i) ?? Op { kind: K_EPS, a: 0, b: 0 }
    let text = list.get(texts, i) ?? ""
    if op.kind == K_REF then {
      let target = map.get(names, text) ?? -1
      list.push(resolved, Op { kind: K_REF, a: target, b: 0 })
    } else if op.kind == K_TOK then {
      // A terminal named by kind resolves to the number the lexer writes, so
      // the grammar's text table holds only the spellings literals ask for.
      list.push(resolved, Op { kind: K_TOK, a: op.a, b: tree.kind_id(text) })
    } else if op.kind == K_LIT or op.kind == K_KEEP then {
      match map.get(atoms, text) {
        some(_) => (),
        none => {
          map.insert(atoms, text, next)
          list.push(spellings, text)
          next = next + 1
        },
      }
      let run = list.len(kids)
      list.push(kids, map.get(atoms, text) ?? -1)
      list.push(kids, i)
      list.push(resolved, Op { kind: op.kind, a: run, b: 1 })
    } else if op.kind == K_ALT and all_branches(resolved, kids, op, K_LIT) then {
      list.push(resolved, Op { kind: K_LIT, a: merged_run(resolved, kids, op), b: op.b })
    } else if op.kind == K_ALT and all_branches(resolved, kids, op, K_KEEP) then {
      list.push(resolved, Op { kind: K_KEEP, a: merged_run(resolved, kids, op), b: op.b })
    } else list.push(resolved, op)
    i = i + 1
  }
  let (spelling, spelling_start, spelling_end, bucket, bucket_next) = pack_atoms(spellings)
  let extra = list.len(texts)
  for name in ["", "op", "ERROR", "left", "operator", "right"] { list.push(texts, name) }
  let kinds = canonical_kinds(texts, extra + X_NONE)
  let linked_kids = shortcut_kids(resolved, kids, arena_kids)
  let linked = fuse_leaves(fuse_wraps(shortcut_ops(resolved)), linked_kids)
  let heads = head_terminals(linked, linked_kids)
  let masks = lit_masks(linked, linked_kids)
  let index = head_index(linked, linked_kids, heads.0, heads.1, heads.2)
  Compiled { ops: linked, kids: linked_kids,
    start: target_of(resolved, start),
    spelling: spelling, spelling_start: spelling_start, spelling_end: spelling_end,
    bucket: bucket, bucket_next: bucket_next,
    lit_mask: masks, head_kinds: index.0, head_mask: index.1,
    head_start: index.2, head_len: index.3, head_run: index.4,
    kind_of: kinds, names: nametable.names_of(texts), extra: extra }
}

// ── a grammar compiled ahead of time ─────────────────────────────────────
//
// Compiling the grammar is 0.8 ms, and it is 0.8 ms of every run, before a
// byte of the file has been read. The arena it produces is a pile of integers
// and a list of names, so it can be written down instead: `Tables` is exactly
// that arena, flat enough to be a literal, and this turns it back into what
// the engine runs on. `scripts/gen_grammar_tables.py` writes them and checks
// they still match the grammar, which stays the source of truth.
//
// The bucket table is the one thing not stored as it is used: it is 4,352
// slots and nearly all of them are empty, so it travels as the slots that are
// not, in order, and is spread out here.
type Tables = { ops: List[Int], blob: String, kids: List[Int], start: Int, extra: Int,
  spelling: List[Int], spelling_start: List[Int], spelling_end: List[Int],
  bucket_at: List[Int], bucket_next: List[Int],
  lit_mask: List[Int], head_kinds: List[Int], head_mask: List[Int],
  head_start: List[Int], head_len: List[Int], head_run: List[Int], kind_of: List[Int] }

fn spread_buckets(pairs: List[Int]) -> List[Int] = {
  var bucket: List[Int] = list.with_capacity(ATOM_SLOTS)
  var at = 0
  var slot = 0
  while slot < ATOM_SLOTS {
    var v = -1
    while at + 1 < list.len(pairs) and (match list.get(pairs, at) { some(x) => x, none => -1 }) == slot {
      v = match list.get(pairs, at + 1) { some(x) => x, none => -1 }
      at = at + 2
    }
    list.push(bucket, v)
    slot = slot + 1
  }
  bucket
}

fn from_tables(t: Tables) -> Compiled = {
  var ops: List[Op] = list.with_capacity(list.len(t.ops) / 3)
  var i = 0
  while i + 2 < list.len(t.ops) {
    list.push(ops, Op {
      kind: match list.get(t.ops, i) { some(v) => v, none => K_EPS },
      a: match list.get(t.ops, i + 1) { some(v) => v, none => 0 },
      b: match list.get(t.ops, i + 2) { some(v) => v, none => 0 },
    })
    i = i + 3
  }
  Compiled { ops: ops, kids: t.kids, start: t.start,
    spelling: t.spelling, spelling_start: t.spelling_start, spelling_end: t.spelling_end,
    bucket: spread_buckets(t.bucket_at), bucket_next: t.bucket_next,
    lit_mask: t.lit_mask, head_kinds: t.head_kinds, head_mask: t.head_mask,
    head_start: t.head_start, head_len: t.head_len, head_run: t.head_run,
    kind_of: t.kind_of, extra: t.extra,
    names: nametable.names_in(bytes.from_string(t.blob)) }
}

// The same arena, flattened, so a generator can write it down.
fn to_tables(c: Compiled) -> Tables = {
  var flat: List[Int] = list.with_capacity(list.len(c.ops) * 4)
  for op in c.ops {
    list.push(flat, op.kind)
    list.push(flat, op.a)
    list.push(flat, op.b)
  }
  var pairs: List[Int] = []
  var slot = 0
  while slot < ATOM_SLOTS {
    let v = match list.get(c.bucket, slot) { some(x) => x, none => -1 }
    if v >= 0 then {
      list.push(pairs, slot)
      list.push(pairs, v)
    } else ()
    slot = slot + 1
  }
  Tables { ops: flat, blob: bytes.to_string_lossy(c.names.blob),
    kids: c.kids, start: c.start, extra: c.extra,
    spelling: c.spelling, spelling_start: c.spelling_start, spelling_end: c.spelling_end,
    bucket_at: pairs, bucket_next: c.bucket_next,
    lit_mask: c.lit_mask, head_kinds: c.head_kinds, head_mask: c.head_mask,
    head_start: c.head_start, head_len: c.head_len, head_run: c.head_run, kind_of: c.kind_of }
}

// Keep the owned token stream available for Parsed/failure output while
// numbering through a borrowed record, without copying the stream twice.
type TokenInput = { tokens: List[tree.Token] }
// One array, a token's kind and its text number side by side: the engine reads
// both of a token at once, and one argument travels instead of two.
type NumberedTokens = { pairs: List[Int], balanced: Bool }
// Two numbers a token, its kind and its text number, side by side. A
// recovering parse appends three a token after all of them
// (`pair_brackets`): the bracket it pairs with, the closer of the innermost
// pair around it, and the innermost bracket open where it stands. A strict
// parse carries only the two it reads: the array is walked for every token.
// `balanced` says whether every bracket pairs with one of its kind, the
// way a file that parses has them: a reader takes a verdict without a tree
// first when they do not (`read`).
fn number_tokens(c: Compiled, source: Bytes, input: TokenInput) -> NumberedTokens = {
  var pairs: List[Int] = list.with_capacity(list.len(input.tokens) * 2)
  var open: List[Int] = []
  var unpaired = false
  for t in input.tokens {
    let atom = atom_at(c, source, t.start, t.end)
    list.push(pairs, t.kind)
    list.push(pairs, atom)
    // the six bracket atoms are 0 to 5, each opener even and its closer next;
    // only punctuation is a bracket — a Python f-string's middle can be `)`
    if atom >= 0 and atom <= A_RBRACE and t.kind == tree.T_PUNCT then {
      if int.band(atom, 1) == 0 then list.push(open, atom)
      else if (list.last(open) ?? -1) == atom - 1 then { let _ = list.pop(open) }
      else unpaired = true
    } else ()
  }
  NumberedTokens { pairs: pairs, balanced: not unpaired and list.is_empty(open) }
}
// The same numbers without the bracket count, for the reads that never ask
// whether the brackets balance: `check` runs on every write, and the count
// is a branch and a push a token.
fn plain_numbers(c: Compiled, source: Bytes, input: TokenInput) -> List[Int] = {
  var pairs: List[Int] = list.with_capacity(list.len(input.tokens) * 2)
  for t in input.tokens {
    list.push(pairs, t.kind)
    list.push(pairs, atom_at(c, source, t.start, t.end))
  }
  pairs
}

fn kind_of(num: List[Int], pos: Int) -> Int = list.get(num, pos * 2) ?? -1
fn is_recover_op(c: Compiled, id: Int) -> Bool = match list.get(c.ops, id) {
  some(o) => o.kind == K_RECOVER or o.kind == K_RECOVER_ALL,
  none => false,
}
// Where a paired stream's pairing numbers begin: after the kinds and text
// numbers of all its tokens, five numbers a token in all
fn pairing_base(num: List[Int]) -> Int = list.len(num) / 5 * 2
// The bracket a bracket pairs with (`pair_brackets`), or -1
fn match_of(num: List[Int], pos: Int) -> Int = list.get(num, pairing_base(num) + pos * 3) ?? -1
// Where an unpaired opener ends for the parse (`pair_brackets`): the token
// it ends before, or -1 for the end of the file
fn vclose_of(num: List[Int], pos: Int) -> Int = {
  let m = match_of(num, pos)
  if m <= -2 then -2 - m else -1
}
// The closer of the innermost pair of brackets around `pos` — `pos` itself
// for a closer that pairs — or the end of the file
fn enclosing_closer(num: List[Int], pos: Int) -> Int = list.get(num, pairing_base(num) + pos * 3 + 1) ?? eof_index(num)
// The innermost opener still open where the token at `pos` stands — paired
// later or never — or -1
fn open_before(num: List[Int], pos: Int) -> Int = list.get(num, pairing_base(num) + pos * 3 + 2) ?? -1
// The end of the file in a paired stream
fn eof_index(num: List[Int]) -> Int = eof_at(num, list.len(num) / 5)
fn eof_at(num: List[Int], n: Int) -> Int = if n > 0 and kind_of(num, n - 1) == tree.T_EOF then n - 1 else n

// Pair the brackets of a numbered stream, by kind: a closer pairs with the
// nearest open bracket of its kind, and the brackets open above that one
// stay unpaired, as ones the file never closed; a closer with no open
// bracket of its kind is unpaired. With `leads` (`line_leads`, for a file
// whose brackets do not balance) the file's indentation has a say: a closer
// that begins its line, where the nearest open bracket of its kind stands on
// a line indented deeper, pairs with the next one of its kind on a line
// indented as its own, and the nearer ones are the ones that lost their
// closers — the `}` of an `if` gone, the function's `}` is still the
// function's. An unpaired opener then ends, for the parse, before the first
// token that begins a line indented no deeper than its own, outside every
// pair opened after it (`vclose_of`), or before the closer that ends what
// holds it. The pairs nest, so one pass back over them gives every opener
// its closer and every token the closer of the innermost pair around it.
// Recovery reads the pairing to know where a list ends (`skip_limit`), to
// tell a closer that ends the list it is in from one the list should step
// over (`recover_here`), to take a closer the file lacks as there
// (`literal_here`, `recovering_seq`), and to know an opener no closer
// answers.
fn pair_brackets(num: List[Int], leads: List[Int]) -> List[Int] = {
  let n = list.len(num) / 2
  let eof = eof_at(num, n)
  let by_indent = list.len(leads) > 0
  var closer_pair: List[Int] = list.with_capacity(n)
  var open_atoms: List[Int] = []
  var open_at: List[Int] = []
  var q = 0
  while q < n {
    let x = real_atom(num, q)
    var paired = -1
    if is_opener(x) then { list.push(open_atoms, x); list.push(open_at, q) }
    else if is_closer(x) and list.contains(open_atoms, opener_of(x)) then {
      let partner = if by_indent then indent_partner(open_atoms, open_at, leads, opener_of(x), lead_of(leads, q)) else -1
      while paired < 0 and list.len(open_at) > 0 {
        let depth = list.len(open_at) - 1
        let top = list.pop(open_atoms) ?? -1
        let at = list.pop(open_at) ?? 0
        if top == opener_of(x) and (partner < 0 or depth == partner) then paired = at else ()
      }
    } else ()
    list.push(closer_pair, paired)
    q = q + 1
  }
  // back to front: a pair opens where the pass meets its closer and closes
  // where it meets its opener; the innermost open one encloses the token
  var back: List[Int] = list.with_capacity(n * 2)
  var starts: List[Int] = []
  var ends: List[Int] = []
  var p = n - 1
  while p >= 0 {
    var opener_pair = -1
    if (list.last(starts) ?? -1) == p then {
      opener_pair = list.pop(ends) ?? -1
      let _ = list.pop(starts)
    } else ()
    let a = list.get(closer_pair, p) ?? -1
    if a >= 0 then { list.push(starts, a); list.push(ends, p) } else ()
    list.push(back, opener_pair)
    list.push(back, list.last(ends) ?? eof)
    p = p - 1
  }
  // front to back: the innermost bracket open where each token stands, and
  // where an unpaired opener ends
  var innermost: List[Int] = list.with_capacity(n)
  var ends_at: Map[Int, Int] = map.new()
  var open: List[Int] = []
  var r = 0
  while r < n {
    list.push(innermost, list.last(open) ?? -1)
    if by_indent and lead_of(leads, r) >= 0 then indent_ends(open, back, n, leads, r, ends_at) else ()
    let x = real_atom(num, r)
    if is_opener(x) then list.push(open, r)
    else if is_closer(x) and (list.get(closer_pair, r) ?? -1) >= 0 then {
      let partner = list.get(closer_pair, r) ?? -1
      var going = true
      while going {
        match list.pop(open) {
          some(u) => { if u == partner then going = false else map.insert(ends_at, u, r) },
          none => { going = false },
        }
      }
    } else ()
    r = r + 1
  }
  var out: List[Int] = list.with_capacity(n * 5)
  var k = 0
  while k < n * 2 {
    list.push(out, list.get(num, k) ?? -1)
    k = k + 1
  }
  var i = 0
  while i < n {
    let b = (n - 1 - i) * 2
    let cp = list.get(closer_pair, i) ?? -1
    let op = list.get(back, b) ?? -1
    // an unpaired opener carries where it ends, as -2 - that token
    list.push(out, if cp >= 0 then cp else if op >= 0 or not is_opener(real_atom(num, i)) then op else match map.get(ends_at, i) { some(e) => 0 - 2 - e, none => -1 })
    list.push(out, list.get(back, b + 1) ?? eof)
    list.push(out, list.get(innermost, i) ?? -1)
    i = i + 1
  }
  out
}

// The unpaired openers the token at `at`, which begins its line, ends: every
// one on top of the open brackets whose line is indented as deep as the
// token's or deeper
fn indent_ends(mut open: List[Int], back: List[Int], n: Int, leads: List[Int], at: Int, mut ends_at: Map[Int, Int]) -> Unit = {
  let lead = lead_of(leads, at)
  var going = true
  while going {
    match list.last(open) {
      some(u) => {
        if (list.get(back, (n - 1 - u) * 2) ?? -1) < 0 and line_indent_of(leads, u) >= lead then {
          let _ = list.pop(open)
          map.insert(ends_at, u, at)
        } else going = false
      },
      none => { going = false },
    }
  }
}

// Where a closer that begins its line, `indent` deep, pairs when the nearest
// open bracket of its kind stands on a line indented deeper: the next one of
// its kind on a line indented as deep as the closer, as a place on the stack
// of open brackets; -1 for the nearest (the closer does not begin its line,
// the nearest is not deeper, or no deeper one is as deep as the closer)
fn indent_partner(open_atoms: List[Int], open_at: List[Int], leads: List[Int], want: Int, indent: Int) -> Int =
  if indent < 0 then -1 else {
    var j = list.len(open_at) - 1
    var found = -1
    var nearest = true
    while j >= 0 {
      if (list.get(open_atoms, j) ?? -1) == want then {
        let li = line_indent_of(leads, list.get(open_at, j) ?? 0)
        if li < indent then j = -1
        else if li == indent then { if not nearest then found = j else (); j = -1 }
        else { nearest = false; j = j - 1 }
      } else j = j - 1
    }
    found
  }

// Where each token stands on its line, two numbers a token: how deep its
// line is indented when the token begins it, else -1, and how deep the line
// it is on is indented. Tokens that are not code — a newline, an indent, a
// comment, the end — begin nothing. Tabs and spaces count one each: a file
// indents one way.
fn line_leads(source: Bytes, toks: List[tree.Token]) -> List[Int] = {
  var out: List[Int] = list.with_capacity(list.len(toks) * 2)
  var line = 0
  // by index: a list walked with `for` is taken whole, and this one is the
  // file's tokens
  var i = 0
  while i < list.len(toks) {
    let t = list.get(toks, i) ?? tree.Token { kind: tree.T_EOF, start: 0, end: 0, line: 0, col: 0 }
    let code = t.end > t.start and t.kind != tree.T_NEWLINE and t.kind != tree.T_INDENT and t.kind != tree.T_DEDENT
      and t.kind != tree.T_EOF and t.kind != tree.T_COMMENT and t.kind != tree.T_CONTINUATION
    let lead = if code then indent_before(source, t.start) else -1
    if lead >= 0 then line = lead else ()
    list.push(out, lead)
    list.push(out, line)
    i = i + 1
  }
  out
}
fn lead_of(leads: List[Int], at: Int) -> Int = list.get(leads, at * 2) ?? -1
fn line_indent_of(leads: List[Int], at: Int) -> Int = list.get(leads, at * 2 + 1) ?? 0
// How much blank is before `at` on its line, when nothing else is; else -1
fn indent_before(source: Bytes, at: Int) -> Int = {
  var i = at - 1
  var width = 0
  var result = -2
  while result == -2 {
    if i < 0 then result = width
    else {
      let b = bytes.get_or(source, i, 10)
      if b == 32 or b == 9 then { width = width + 1; i = i - 1 }
      else if b == 10 or b == 13 then result = width
      else result = -1
    }
  }
  result
}

// Parser state, threaded through every rule and returned with each result.
// `far` is the farthest token index at which something failed to match, and
// it only ever moves forward.
//
// What was expected at `far` is not in here. It is a list the caller owns
// and the engine appends to, for two reasons. It only moves forward, so
// backtracking never has to undo it. And a record holding a list is copied
// on every one of the engine's calls, where a record of two scalars is not:
// State exists to be cheap.
//
// The set is filled only on the second pass. A parse that succeeds never
// looks at it, and keeping it costs a linear scan and an append at every
// failed alternative, which is the busiest path in the engine. So the first
// pass runs with `collect: false` and `parse` runs the whole thing again
// with `collect: true` when, and only when, it has an error to describe.
// `recover` is off for the parse that answers "does this file parse". It is
// on for the second parse a reader makes after the first said no, where a
// `Recover` rule may skip past what it could not read and leave an ERROR node
// behind rather than give up on the whole file.
// `build` is what separates the gate from a reader. Whether a rule matches
// never depends on the nodes it built — the tree is output, not state — so a
// caller that only wants the verdict can have the engine skip every node it
// would have made. `check` is that caller, and it is the one an agent runs on
// every write. Verified: `check` output is byte-identical on all 39,021 files
// of the validation corpus with the tree off.
// What a pass does, fixed before it starts. The flags never change while it
// runs, except that a lookahead or a negation reads with `M_AHEAD` and
// `M_PEEK`, and a recovery tries its ways without `M_BUILD`; `far` is a
// cell, so neither travels in the result: the
// mode is one scalar argument. What comes back from a rule is then two
// words — whether it matched and where it ended — which fit in registers,
// where the four-field record it used to carry did not.
let M_COLLECT = 1
let M_RECOVER = 2
let M_BUILD = 4
// a strict read that logs every recover item it reads (`strict_item`), for
// the pass that names what a failed parse expected (`failure_of`). Only a
// read that already failed once asks for it: the log is four numbers an
// item, and a file that parses never reads it
let M_LOG = 8
// inside a lookahead of a recovering parse: an opener no closer answers
// cannot begin anything the lookahead is looking for
let M_AHEAD = 16
// inside a lookahead or a negation of a recovering parse: it asks what the
// next token is, so no closer the file lacks is taken as there for it
// (`closer_pairs_outward`, `closer_never_came`)
let M_PEEK = 32
fn wants(mode: Int, flag: Int) -> Bool = int.band(mode, flag) != 0
// Above the flags a recovering mode carries a bound: the token where the
// unpaired opener a sequence read ends (`recovering_seq`). No list inside
// reads at it or past it, and no skip reaches it. Being in the mode, it
// holds for what the sequence reads after the opener and nothing else.
let MODE_FLAGS = 64
fn bound_of(mode: Int) -> Int = mode / MODE_FLAGS - 1
fn with_bound(mode: Int, at: Int) -> Int = {
  let b = bound_of(mode)
  int.band(mode, MODE_FLAGS - 1) + (if b >= 0 and b < at then b else at) * MODE_FLAGS + MODE_FLAGS
}

fn fresh(collect: Bool) -> Int = if collect then M_COLLECT + M_BUILD else M_BUILD
fn verifying() -> Int = 0
fn recovering() -> Int = M_RECOVER + M_BUILD
// The collecting pass that names what was expected: no tree, and every
// branch walked at the farthest failure the first pass noted (`unpruned`)
fn collecting() -> Int = M_COLLECT
fn ahead_mode(mode: Int) -> Int = if wants(mode, M_RECOVER) then int.bor(int.bor(mode, M_AHEAD), M_PEEK) else mode
// A negation asks whether a token is there at all, so it tests an opener
// as the token it is: the rule a bracket tree is read with refuses a lone
// bracket through a negation, and must go on refusing an unpaired one
fn not_ahead(mode: Int) -> Int = {
  let peeking = if wants(mode, M_RECOVER) then int.bor(mode, M_PEEK) else mode
  if wants(peeking, M_AHEAD) then peeking - M_AHEAD else peeking
}

// The cell every pass carries:
//   repair_at, repair_atom  a repair a recover site is trying: the token
//         index where a closer the file lacks is taken as there (zero tokens
//         wide), and the atom of that closer; -1 when none
//   list_start, list_owner  the list being read (`recover_here`): where it
//         began, and the recover op of its items; -1 when none
//   depth  how many lists of recover items a recovering read is inside
//   floor  below this position the collecting pass prunes as the first did
//   flags  what the reads of the recover item being worked out leaned on
//         (`FL_REPAIRED`, `FL_EOF`), for the memo to know where its answer holds
//   errors  how many ERROR nodes a recovering pass has made, ever
//   first_error  where the first ERROR node the recover item being worked
//         out made begins; -1 when none
//   far   the farthest failure
//   memo  what recover sites worked out (`memo_find`); it rides in the cell
//         so that the parser's functions take one argument fewer
// A record whose fields a pass sets in place: every recover item sets and
// restores several of them, and as a list each was a rebuild of all ten.
type Cell = {
  repair_at: Int, repair_atom: Int, list_start: Int, list_owner: Int, depth: Int,
  floor: Int, flags: Int, errors: Int, first_error: Int, far: Int,
  memo: Map[Int, List[Int]],
}
fn far_cell() -> Cell = Cell {
  repair_at: 0 - 1, repair_atom: 0 - 1, list_start: 0, list_owner: 0 - 1, depth: 0,
  floor: 0, flags: 0, errors: 0, first_error: 0 - 1, far: 0,
  memo: map.new(),
}
fn far_of(far: Cell) -> Int = far.far
fn set_far(mut far: Cell, pos: Int) -> Unit = { far.far = pos }
fn note_far(mut far: Cell, pos: Int) -> Unit = if pos > far.far then { far.far = pos } else ()
fn repair_of(far: Cell) -> Int = far.repair_at
fn repair_atom(far: Cell) -> Int = far.repair_atom
fn set_repair(mut far: Cell, at: Int, atom: Int) -> Unit = {
  far.repair_at = at
  far.repair_atom = atom
}
fn list_start(far: Cell) -> Int = far.list_start
fn list_owner(far: Cell) -> Int = far.list_owner
fn list_depth(far: Cell) -> Int = far.depth
// The list being read: where it began, whose items it holds, and how many
// lists it is inside
fn set_list(mut far: Cell, start: Int, owner: Int, depth: Int) -> Unit = {
  far.list_start = start
  far.list_owner = owner
  far.depth = depth
}
fn floor_of(far: Cell) -> Int = far.floor
fn set_floor(mut far: Cell, pos: Int) -> Unit = { far.floor = pos }
fn flags_of(far: Cell) -> Int = far.flags
fn set_flags(mut far: Cell, flags: Int) -> Unit = { far.flags = flags }
fn add_flags(mut far: Cell, flags: Int) -> Unit = { far.flags = int.bor(far.flags, flags) }
fn errors_made(far: Cell) -> Int = far.errors
// An ERROR node on `out`, counted
fn push_error(mut out: List[tree.Node], mut far: Cell, kind: Int, from: Int, to: Int) -> Unit = {
  list.push(out, tree.node(kind, [], from, to))
  far.errors = far.errors + 1
  note_first_error(far, from)
}
fn first_error_of(far: Cell) -> Int = far.first_error
fn set_first_error(mut far: Cell, at: Int) -> Unit = { far.first_error = at }
fn note_first_error(mut far: Cell, at: Int) -> Unit =
  if at >= 0 and (far.first_error < 0 or at < far.first_error) then { far.first_error = at } else ()
// Whether a collecting pass walks every branch at `pos`: at and past the
// farthest failure the first pass noted. Below it a branch the token cannot
// begin fails where it starts, and what it expected there is forgotten when
// the pass moves on, so pruning it changes nothing the message says
fn unpruned(mode: Int, far: Cell, pos: Int) -> Bool = wants(mode, M_COLLECT) and pos >= far.floor

fn is_closer(x: Int) -> Bool = x == A_RPAREN or x == A_RBRACK or x == A_RBRACE
fn is_opener(x: Int) -> Bool = x == A_LPAREN or x == A_LBRACK or x == A_LBRACE
fn opener_of(closer: Int) -> Int = if closer == A_RPAREN then A_LPAREN else if closer == A_RBRACK then A_LBRACK else A_LBRACE
// The atom of the token at `pos` when it is punctuation: a string, a piece
// of an f-string or template, or a negation marker is never a bracket
fn real_atom(num: List[Int], pos: Int) -> Int = {
  let k = list.get(num, pos * 2) ?? -1
  if k != tree.T_PUNCT then -1 else list.get(num, pos * 2 + 1) ?? -1
}
// Whether the closer at `pos` pairs with an opener before `from`: the
// closer of something that holds the tokens from `from` on
fn pairs_outward(num: List[Int], pos: Int, from: Int) -> Bool = {
  let m = match_of(num, pos)
  m >= 0 and m < from
}
// Whether the token at `pos` is an opener no closer answers
fn unpaired_opener(num: List[Int], pos: Int) -> Bool = is_opener(real_atom(num, pos)) and match_of(num, pos) < 0
// Whether the wanted literal is a closer, the token at `pos` a closer of
// another kind that pairs, and the parse a recovering one: the wanted
// closer is taken as there, zero tokens wide, since the file's next closer
// belongs to something outside — a `)` gone from a call inside braces, a
// `}` gone from a body inside a call. The strict parse never does this,
// and the pairing is only filled for a recovering parse.
fn closer_pairs_outward(c: Compiled, num: List[Int], mode: Int, op: Op, pos: Int) -> Bool =
  op.kind == K_LIT and wants(mode, M_RECOVER) and not wants(mode, M_PEEK) and is_closer(real_atom(num, pos)) and match_of(num, pos) >= 0
  and (spelled(c, op, A_RPAREN) or spelled(c, op, A_RBRACK) or spelled(c, op, A_RBRACE))
// Whether the literal is the closer a repair takes as there at `pos`
fn repaired_here(c: Compiled, far: Cell, op: Op, pos: Int) -> Bool =
  op.kind == K_LIT and repair_of(far) == pos and spelled(c, op, repair_atom(far))

// A rule reports whether it matched and where it stopped. The nodes it built
// are not carried in the result: they are pushed onto a single list that the
// caller owns and passes down, so a child's subtree is never copied into its
// parent. A rule that fails must leave that list exactly as it found it,
// which `rollback` does; `mark` is the length on entry.
type Out = { ok: Bool, pos: Int }

// Where a read failed, what it found there and what it expected; `note`,
// when not empty, says it instead (a bracket that does not pair)
type Failure = { line: Int, col: Int, found: String, expected: List[String], note: String }

// `exp` holds arena node ids, not strings: a name is only needed once, when
// the message is written.
fn noted(mut exp: List[Int], mut far: Cell, pos: Int, what: Int) -> Unit = {
  // below the first pass's farthest failure nothing noted would last
  if pos < floor_of(far) then ()
  else if pos > far_of(far) then {
    list.clear(exp)
    list.push(exp, what)
    set_far(far, pos)
  } else {
    if pos == far_of(far) and not list.contains(exp, what) then list.push(exp, what) else ()
  }
}

// `far` and the expectation set are only ever read from the pass that collects
// them: a parse that fails runs a second time with `collect` on, and the
// message comes from that run. Every parse that succeeds, and the first half
// of every one that does not, therefore records nothing at a failed
// alternative — which is the busiest path in the engine, and was 20% of a
// 2.5 MB parse in a CPU sample.
fn miss(mut exp: List[Int], mut far: Cell, mode: Int, pos: Int, what: Int) -> Out = {
  if wants(mode, M_COLLECT) then noted(exp, far, pos, what) else note_far(far, pos)
  Out { ok: false, pos: pos }
}
fn good(pos: Int) -> Out = Out { ok: true, pos: pos }
fn bad(pos: Int) -> Out = Out { ok: false, pos: pos }

// A lookahead reports on the token stream without becoming part of it, and
// restores the state it was given. What it expected has to go back too, or
// a rule that was only ever consulted would name itself in the message.
fn untrack(mut exp: List[Int], mark: Int) -> Unit = {
  while list.len(exp) > mark {
    match list.pop(exp) { some(_) => (), none => () }
  }
}

// How far a recovery may skip from `from`.
//
// Never past the end of the file. If `bounded`, never past a closing bracket
// that pairs with an opener before `from` (`pair_brackets`): a statement
// list inside braces must not recover by eating the brace that ends it. A
// closer that pairs inside the skipped tokens, or with nothing, is stepped
// over: it is part of what could not be read. At the top level nothing
// encloses the skip.
fn skip_limit(num: List[Int], from: Int, bounded: Bool, mode: Int) -> Int = {
  let limit = if bounded then enclosing_closer(num, from) else eof_index(num)
  let bound = bound_of(mode)
  if bound >= from and bound < limit then bound else limit
}

// Where the run of separators (line ends, `;`, layout) that ends at `to`
// begins, no earlier than `from`
fn separators_before(num: List[Int], from: Int, to: Int) -> Int = {
  var t = to
  while t > from and not real_at(num, t - 1) { t = t - 1 }
  t
}
fn real_at(num: List[Int], i: Int) -> Bool = {
  let k = list.get(num, i * 2) ?? -1
  let x = list.get(num, i * 2 + 1) ?? -1
  k != tree.T_NEWLINE and k != tree.T_INDENT and k != tree.T_DEDENT and not (k != tree.T_STRING and x == A_SEMI)
}

// Is there anything between these two positions but separators? Giving up on
// a run of newlines is not an error, it is the end of a list, and a recovery
// that reported one would put an ERROR node at the end of every file.
fn real_between(num: List[Int], from: Int, to: Int) -> Bool = {
  var i = from
  var found = false
  while not found and i < to {
    match list.get(num, i * 2) {
      none => { i = to },
      some(k) => {
        let x = match list.get(num, i * 2 + 1) { some(v) => v, none => -1 }
        if k != tree.T_NEWLINE and not (k != tree.T_STRING and x == A_SEMI) then found = true else ()
        i = i + 1
      },
    }
  }
  found
}

// Drop everything appended since `mark`. `list.pop` moves the element out, so
// this frees the nodes without copying them.
fn rollback(mut out: List[tree.Node], mark: Int) -> Unit = {
  while list.len(out) > mark {
    match list.pop(out) { some(_) => (), none => () }
  }
}

// Move everything appended since `mark` into a list of its own, in order.
// Zero/one child already has its final order; return that allocation directly.
// Larger drains use two pops/pushes per node: `list.reverse` would copy.
// Exact drain lengths avoid growth reallocations and spare capacity in kids.
fn take_from(mut out: List[tree.Node], mark: Int) -> List[tree.Node] = {
  var rev: List[tree.Node] = list.with_capacity(list.len(out) - mark)
  while list.len(out) > mark {
    match list.pop(out) { some(n) => list.push(rev, n), none => () }
  }
  if list.len(rev) <= 1 then rev else {
    var fwd: List[tree.Node] = list.with_capacity(list.len(rev))
    while list.len(rev) > 0 {
      match list.pop(rev) { some(n) => list.push(fwd, n), none => () }
    }
    fwd
  }
}

// Name every node appended since `mark`, in place.
fn label_from(mut out: List[tree.Node], mark: Int, name: Int) -> Unit = {
  var rev: List[tree.Node] = list.with_capacity(list.len(out) - mark)
  while list.len(out) > mark {
    var n = match list.pop(out) { some(x) => x, none => tree.leaf(-1, 0) }
    tree.set_field(n, name)
    list.push(rev, n)
  }
  while list.len(rev) > 0 {
    match list.pop(rev) { some(n) => list.push(out, n), none => () }
  }
}

// The left fold's three parts in one drain: [mark, opmark) is the left
// operand, [opmark, rmark) the operator, [rmark, end) the right operand.
// Only the end of the list can be popped, so naming them in one pass is
// also the only way to name a middle range without copying the list.
fn fold_kids(mut out: List[tree.Node], mark: Int, opmark: Int, rmark: Int, left: Int, operator: Int, right: Int) -> List[tree.Node] = {
  var rev: List[tree.Node] = list.with_capacity(list.len(out) - mark)
  var idx = list.len(out)
  while idx > mark {
    var n = match list.pop(out) { some(x) => x, none => tree.leaf(-1, 0) }
    idx = idx - 1
    tree.set_field(n, if idx >= rmark then right else if idx >= opmark then operator else left)
    list.push(rev, n)
  }
  var fwd: List[tree.Node] = list.with_capacity(list.len(rev))
  while list.len(rev) > 0 {
    match list.pop(rev) { some(n) => list.push(fwd, n), none => () }
  }
  fwd
}

fn text_at(c: Compiled, id: Int) -> String = nametable.name_at(c.names, id)
fn kid_at(c: Compiled, i: Int) -> Int = match list.get(c.kids, i) { some(k) => k, none => 0 }
// The number that stands for this node's spelling, the same for every node the
// grammar spelled the same way.
fn kind_at(c: Compiled, id: Int) -> Int = match list.get(c.kind_of, id) { some(k) => k, none => -1 }

// A literal terminal holds a set of spellings, not one: `a` starts a run of
// `b` atom numbers followed by `b` node ids, and an alternation whose every
// branch is a literal is compiled into one of these. `lits(HARD_KEYWORDS)`
// guards every name in a Python file and was 35 alternatives tried one call
// at a time; it is now one op and 35 integer compares.
fn spelled(c: Compiled, op: Op, x: Int) -> Bool = {
  var i = 0
  var hit = false
  while not hit and i < op.b {
    hit = kid_at(c, op.a + i) == x
    i = i + 1
  }
  hit
}

// A token no terminal spells carries -1 and matches nothing; a token whose
// number is not in the set's sketch matches nothing either. Both answers are
// exact, and both are reached without touching the set.
fn spelled_at(c: Compiled, id: Int, op: Op, x: Int) -> Bool =
  if x < 0 then false
  else if int.band(int.bshr(match list.get(c.lit_mask, id) { some(v) => v, none => -1 }, int.band(x, 63)), 1) == 0 then false
  else spelled(c, op, x)

// Which level's operator stands at `pos`, or -1 for none. The token is read,
// not consumed: a level whose operator is not a literal terminal can never be
// found here, which is why `prec` asks for literals.
fn level_at(c: Compiled, op: Op, num: List[Int], pos: Int) -> Int = {
  let x = match list.get(num, pos * 2 + 1) { some(v) => v, none => -1 }
  let k = match list.get(num, pos * 2) { some(v) => v, none => tree.T_EOF }
  if k == tree.T_STRING or k == tree.T_NEG then -1
  else {
    var found = -1
    var i = 0
    while found < 0 and i < op.b {
      let level = match list.get(c.ops, kid_at(c, op.a + 1 + i)) { some(o) => o, none => Op { kind: K_EPS, a: 0, b: 0 } }
      if (level.kind == K_LIT or level.kind == K_KEEP) and spelled(c, level, x) then found = i else ()
      i = i + 1
    }
    found
  }
}

// Fold the operation on top of the pending stack into one node, and answer
// where the operand that results begins — in the output list and in the tokens.
fn reduce_top(c: Compiled, mut out: List[tree.Node], mut marks: List[Int], mut opmarks: List[Int],
  mut levels: List[Int], mut froms: List[Int], id: Int, right: Int, to: Int, build: Bool) -> (Int, Int) = {
  let mark = match list.pop(marks) { some(v) => v, none => right }
  let opmark = match list.pop(opmarks) { some(v) => v, none => right }
  let from = match list.pop(froms) { some(v) => v, none => 0 }
  let _ = list.pop(levels)
  if build then {
    let kids = fold_kids(out, mark, opmark, right, c.extra + X_LEFT, c.extra + X_OPERATOR, c.extra + X_RIGHT)
    list.push(out, tree.node(kind_at(c, id), kids, from, to))
  } else ()
  (mark, from)
}

// Could the token at `pos` begin this rule? A rule with no mandatory first
// terminal answers yes, so a no is only ever used to skip work that would
// certainly fail. The collecting pass never asks, so the expectations a
// skipped branch would have named are still named when a message needs them.
fn may_start(c: Compiled, id: Int, num: List[Int], pos: Int) -> Bool = {
  let kinds = match list.get(c.head_kinds, id) { some(v) => v, none => -1 }
  let k = match list.get(num, pos * 2) { some(v) => v, none => -1 }
  if k < 0 or int.band(int.bshr(kinds, k), 1) == 1 then true
  // a string or a negation marker is never read as punctuation, so it can
  // only ever begin a rule by its kind
  else if k == tree.T_STRING or k == tree.T_NEG then false
  else {
    let x = match list.get(num, pos * 2 + 1) { some(v) => v, none => -1 }
    let mask = match list.get(c.head_mask, id) { some(v) => v, none => 0 }
    if x < 0 or int.band(int.bshr(mask, int.band(x, 63)), 1) == 0 then false
    else {
      let at = match list.get(c.head_start, id) { some(v) => v, none => 0 }
      let n = match list.get(c.head_len, id) { some(v) => v, none => 0 }
      var i = 0
      var can = false
      while not can and i < n {
        can = (match list.get(c.head_run, at + i) { some(v) => v, none => -1 }) == x
        i = i + 1
      }
      can
    }
  }
}

// Does one of these spellings stand in the rest of the logical line, outside
// brackets? A newline at depth zero ends the line, and a string or a negation
// marker is not read as punctuation, exactly as the recovery scans read it.
fn needs_here(c: Compiled, num: List[Int], want: Op, pos: Int) -> Bool = {
  var q = pos
  var depth = 0
  var found = false
  var going = true
  while going {
    let k = match list.get(num, q * 2) { some(v) => v, none => tree.T_EOF }
    if k == tree.T_EOF or (depth == 0 and (k == tree.T_NEWLINE or k == tree.T_INDENT or k == tree.T_DEDENT)) then going = false
    else {
      let x = match list.get(num, q * 2 + 1) { some(v) => v, none => -1 }
      let real = k != tree.T_STRING and k != tree.T_NEG
      if real and (x == A_LPAREN or x == A_LBRACK or x == A_LBRACE) then depth = depth + 1
      else if real and (x == A_RPAREN or x == A_RBRACK or x == A_RBRACE) then depth = int.max(0, depth - 1)
      else if depth == 0 and real and spelled(c, want, x) then { found = true; going = false }
      else ()
      q = q + 1
    }
  }
  found
}

// A literal that did not match names every spelling it would have taken, which
// is what the alternation's branches named one by one before.
fn missed(c: Compiled, mut exp: List[Int], mut far: Cell, mode: Int, pos: Int, op: Op) -> Out = {
  if wants(mode, M_COLLECT) then {
    var i = 0
    while i < op.b {
      noted(exp, far, pos, kid_at(c, op.a + op.b + i))
      i = i + 1
    }
  } else note_far(far, pos)
  Out { ok: false, pos: pos }
}

// Match arena node `id` at token `pos`.
//
// One self-recursive function on purpose: sequence, choice, repetition and
// the left fold are loops inside it rather than helper functions. The
// native backend passes a list by reference only when the function is not
// part of a mutually recursive group; helpers would make every call copy
// the grammar and the token list, and parsing would go quadratic. For the
// same reason there is no `??` on anything holding `c`: that form makes
// the analysis treat the parameter as escaping.
// The two terminals, lifted out of the dispatch so the engine's one big
// function stays about choosing what to do rather than about doing it. Neither
// calls `parse_rule`, so neither joins its recursive group.
fn token_here(c: Compiled, num: List[Int], mut out: List[tree.Node], mut exp: List[Int], mut far: Cell, mode: Int, id: Int, op: Op, pos: Int) -> Out = {
    match list.get(num, pos * 2) {
      some(k) => if k != op.b then miss(exp, far, mode, pos, id)
        else if op.b == tree.T_NEWLINE or op.b == tree.T_EOF then good(pos + 1)
        else {
          if wants(mode, M_BUILD) then list.push(out, tree.leaf(kind_at(c, id), pos)) else ()
          good(pos + 1)
        },
      none => miss(exp, far, mode, pos, id),
    }
}

// A literal the token at `pos` is not: a closer the file lacks is taken as
// there when recovering (`repaired_here`, `closer_pairs_outward`,
// `closer_never_came`), and one taken at the end of the file is noted, for
// the recover site that reads it to weigh against skipping; anything else
// is a miss.
fn lacking_here(c: Compiled, num: List[Int], mut exp: List[Int], mut far: Cell, mode: Int, op: Op, pos: Int) -> Out =
  if repaired_here(c, far, op, pos) or closer_pairs_outward(c, num, mode, op, pos) then good(pos)
  else if closer_never_came(c, num, mode, op, pos) then {
    if pos >= eof_index(num) then add_flags(far, FL_EOF) else ()
    good(pos)
  }
  else missed(c, exp, far, mode, pos, op)
// Whether the wanted literal is a closer, the parse a recovering one, and
// the innermost bracket open where the token at `pos` stands one no closer
// answers: the closer is taken as there, zero tokens wide, where the parse
// first wants it — a `)` gone from a call, read as the call ends at the `;`.
// The pairing says the file never closes that bracket, so every closer
// wanted inside it before an enclosing one comes is one the file lacks. At
// the end of the file every bracket still open is such a one: a body an
// edit left open closes there and keeps what it read.
fn closer_never_came(c: Compiled, num: List[Int], mode: Int, op: Op, pos: Int) -> Bool =
  op.kind == K_LIT and wants(mode, M_RECOVER) and not wants(mode, M_PEEK) and unclosed_around(num, pos)
  and (spelled(c, op, A_RPAREN) or spelled(c, op, A_RBRACK) or spelled(c, op, A_RBRACE))
fn unclosed_around(num: List[Int], pos: Int) -> Bool = {
  let o = open_before(num, pos)
  o >= 0 and match_of(num, o) < 0
}
fn literal_here(c: Compiled, num: List[Int], mut out: List[tree.Node], mut exp: List[Int], mut far: Cell, mode: Int, id: Int, op: Op, pos: Int) -> Out = {
  match list.get(num, pos * 2 + 1) {
    some(x) => if not spelled_at(c, id, op, x) then lacking_here(c, num, exp, far, mode, op, pos)
      else match list.get(num, pos * 2) {
        some(k) => if k == tree.T_STRING or k == tree.T_NEG then missed(c, exp, far, mode, pos, op)
          else if wants(mode, M_AHEAD) and unpaired_opener(num, pos) then missed(c, exp, far, mode, pos, op)
          else if op.kind == K_LIT then good(pos + 1)
          else {
            if wants(mode, M_BUILD) then list.push(out, tree.leaf(c.extra + X_OP, pos)) else ()
            good(pos + 1)
          },
        none => missed(c, exp, far, mode, pos, op),
      },
    none => missed(c, exp, far, mode, pos, op),
  }
}

// The line-recovery rule, out of the dispatch and into its own function. It
// calls `parse_rule` back, which the pinned compiler now borrows through: a
// read-only heap parameter of a mutually recursive group is passed by
// reference on native, so the arena and the token lists are no longer copied
// at the call. Measured at the boundary: extracting an arm this way moves the
// three code-heavy files by less than half a percent either way.
fn recover_lines_here(c: Compiled, num: List[Int], mut out: List[tree.Node], mut exp: List[Int], mut far: Cell, mode: Int, id: Int, op: Op, pos: Int) -> Out = {
    let mark = list.len(out)
    let o = parse_rule(c, num, out, exp, far, mode, op.a, pos)
    // a line item is stamped like any recover item: the incremental reader re-reads it alone
    if o.ok then { stamp(out, mark, id); o }
    else {
      rollback(out, mark)
      if not wants(mode, M_RECOVER) then Out { ok: false, pos: pos }
      else {
        // Only a logical line at the original indentation may resume. Never
        // lift a declaration from a skipped nested suite into its parent.
        var q = pos
        var depth = 0
        var line_start = false
        var resume = -1
        var limit = -1
        while resume < 0 and limit < 0 {
          let k = list.get(num, q * 2) ?? tree.T_EOF
          if k == tree.T_EOF or (k == tree.T_DEDENT and depth == 0) then limit = q
          else {
            if k == tree.T_INDENT then { depth = depth + 1; line_start = false }
            else if k == tree.T_DEDENT then { depth = depth - 1; line_start = true }
            else if k == tree.T_NEWLINE then line_start = true
            else {
              if line_start and depth == 0 and q > pos then {
                let a = parse_rule(c, num, out, exp, far, trial_mode(mode), op.a, q)
                rollback(out, mark)
                if a.ok and a.pos > q then resume = q else ()
              } else ()
              line_start = false
            }
            if resume < 0 then q = q + 1 else ()
          }
        }
        let stop = if resume >= 0 then resume else limit
        if not real_between(num, pos, stop) then Out { ok: false, pos: pos }
        else {
          push_error(out, far, c.extra + X_ERROR, pos, stop)
          stamp(out, list.len(out) - 1, id)
          if resume >= 0 then {
            let resumed = list.len(out)
            let a = parse_rule(c, num, out, exp, far, mode, op.a, resume)
            if a.ok then { stamp(out, resumed, id); a } else { rollback(out, mark); Out { ok: false, pos: pos } }
          } else good(stop)
        }
      }
    }
}

// A rule that names what it matched. `K_NEST` keeps quiet when the rule left
// exactly one node behind, because a node with one child and a name that only
// says which rule ran says nothing a reader can use.
fn wrapped_seq_here(c: Compiled, num: List[Int], mut out: List[tree.Node], mut exp: List[Int], mut far: Cell, mode: Int, id: Int, op: Op, pos: Int) -> Out = {
  let mark = list.len(out)
  var p = pos
  var failed = false
  if closing(mode) then {
    let read = recovering_seq(c, num, out, exp, far, mode, op, pos)
    p = read.pos
    failed = not read.ok
  } else {
    var i = 0
    while not failed and i < op.b {
      let o = parse_rule(c, num, out, exp, far, mode, kid_at(c, op.a + i), p)
      if o.ok then { p = o.pos } else { failed = true }
      i = i + 1
    }
  }
  if failed then {
    rollback(out, mark)
    bad(pos)
  } else {
    if wants(mode, M_BUILD) and (op.kind == K_WRAP_SEQ or list.len(out) - mark != 1) then {
      let kids = take_from(out, mark)
      list.push(out, tree.node(kind_at(c, id), kids, pos, p))
    } else ()
    good(p)
  }
}

// Every operator a precedence read still holds, folded at the end of the
// expression
fn reduce_all(c: Compiled, mut out: List[tree.Node], mut marks: List[Int], mut opmarks: List[Int],
  mut levels: List[Int], mut froms: List[Int], id: Int, right: Int, to: Int, build: Bool) -> Unit = {
  var mark = right
  while list.len(levels) > 0 {
    let (m, _) = reduce_top(c, out, marks, opmarks, levels, froms, id, mark, to, build)
    mark = m
  }
}

// A negation: the rule read without keeping anything, the answer inverted
fn not_here(c: Compiled, num: List[Int], mut out: List[tree.Node], mut exp: List[Int], mut far: Cell, mode: Int, op: Op, pos: Int) -> Out = {
  let mark = list.len(out)
  let emark = list.len(exp)
  let o = parse_rule(c, num, out, exp, far, not_ahead(mode), op.a, pos)
  rollback(out, mark)
  if wants(mode, M_COLLECT) then untrack(exp, emark) else ()
  if o.ok then Out { ok: false, pos: pos } else good(pos)
}
// Whether a read takes closers the file lacks as there: recovering, and not
// inside a lookahead or a negation, which ask what the next token is
fn closing(mode: Int) -> Bool = wants(mode, M_RECOVER) and not wants(mode, M_PEEK)
// A sequence in a recovering read (`recovering_seq`), its nodes rolled back
// when it fails
fn seq_recovering(c: Compiled, num: List[Int], mut out: List[tree.Node], mut exp: List[Int], mut far: Cell, mode: Int, op: Op, pos: Int) -> Out = {
  let mark = list.len(out)
  let o = recovering_seq(c, num, out, exp, far, mode, op, pos)
  if o.ok then o else {
    rollback(out, mark)
    Out { ok: false, pos: pos }
  }
}

// The items of a sequence, in a recovering read. When one of them reads an
// opener no closer answers (`pair_brackets`), what the sequence reads after
// it is bounded where that opener ends (`with_bound`): its lists stop there
// and no skip reaches it. The closer the sequence then wants for that opener
// is taken as there, zero tokens wide, where the parse gets to it — the
// body of an `if` whose `}` went missing ends before the line indented as
// the `if` is, and the function around it goes on. Nodes a failed read made
// are the caller's to roll back.
fn recovering_seq(c: Compiled, num: List[Int], mut out: List[tree.Node], mut exp: List[Int], mut far: Cell, mode: Int, op: Op, pos: Int) -> Out = {
  var p = pos
  var failed = false
  var i = 0
  var m = mode
  var opened = -1
  while not failed and i < op.b {
    let kid = kid_at(c, op.a + i)
    if opened >= 0 and closes_opener(c, kid, real_atom(num, opened)) then {
      if p >= eof_index(num) then add_flags(far, FL_EOF) else ()
      m = mode
      opened = -1
    } else {
      let o = parse_rule(c, num, out, exp, far, m, kid, p)
      if not o.ok then failed = true
      else {
        if o.pos == p + 1 and unpaired_opener(num, p) then {
          opened = p
          let v = vclose_of(num, p)
          if v >= 0 then m = with_bound(m, v) else ()
        } else ()
        p = o.pos
      }
    }
    i = i + 1
  }
  Out { ok: not failed, pos: p }
}
// Whether the op is the literal that closes the opener `atom`
fn closes_opener(c: Compiled, id: Int, atom: Int) -> Bool = match list.get(c.ops, id) {
  some(o) => (o.kind == K_LIT or o.kind == K_KEEP) and spelled(c, o, atom + 1),
  none => false,
}

// A negation of a terminal. The terminal itself never builds a node the
// negation keeps and never names an expectation it keeps either, so what is
// left of it is the test and its answer, inverted.
fn not_lit_here(c: Compiled, num: List[Int], mut out: List[tree.Node], mut exp: List[Int], mut far: Cell, mode: Int, id: Int, op: Op, pos: Int) -> Out = {
  let emark = list.len(exp)
  let o = literal_here(c, num, out, exp, far, not_ahead(mode), id, Op { kind: K_LIT, a: op.a, b: op.b }, pos)
  if wants(mode, M_COLLECT) then untrack(exp, emark) else ()
  if o.ok then bad(pos) else good(pos)
}

fn not_tok_here(c: Compiled, num: List[Int], mut out: List[tree.Node], mut exp: List[Int], mut far: Cell, mode: Int, op: Op, pos: Int) -> Out = {
  let mark = list.len(out)
  let emark = list.len(exp)
  let o = token_here(c, num, out, exp, far, mode, op.a, Op { kind: K_TOK, a: -1, b: op.b }, pos)
  rollback(out, mark)
  if wants(mode, M_COLLECT) then untrack(exp, emark) else ()
  if o.ok then bad(pos) else good(pos)
}

fn leaf_here(c: Compiled, num: List[Int], mut out: List[tree.Node], mut exp: List[Int], mut far: Cell, mode: Int, id: Int, op: Op, pos: Int) -> Out =
  if op.kind == K_LIT or op.kind == K_KEEP then literal_here(c, num, out, exp, far, mode, id, op, pos)
  else if op.kind == K_TOK then token_here(c, num, out, exp, far, mode, id, op, pos)
  else if op.kind == K_NOT_LIT then not_lit_here(c, num, out, exp, far, mode, id, op, pos)
  else not_tok_here(c, num, out, exp, far, mode, op, pos)

// A sequence of nothing but terminal tests, run where it stands. Like any
// sequence it builds no node of its own: what its members left behind belongs
// to whatever wraps it.
fn terms_here(c: Compiled, num: List[Int], mut out: List[tree.Node], mut exp: List[Int], mut far: Cell, mode: Int, op: Op, pos: Int) -> Out = {
  let mark = list.len(out)
  var p = pos
  var failed = false
  var i = 0
  while not failed and i < op.b {
    let cid = kid_at(c, op.a + i)
    let co = match list.get(c.ops, cid) { some(o) => o, none => Op { kind: K_EPS, a: 0, b: 0 } }
    let o = leaf_here(c, num, out, exp, far, mode, cid, co, p)
    if o.ok then { p = o.pos } else { failed = true }
    i = i + 1
  }
  if failed then {
    rollback(out, mark)
    bad(pos)
  } else good(p)
}

fn wrapped_here(c: Compiled, num: List[Int], mut out: List[tree.Node], mut exp: List[Int], mut far: Cell, mode: Int, id: Int, op: Op, pos: Int) -> Out = {
  let mark = list.len(out)
  let o = parse_rule(c, num, out, exp, far, mode, op.a, pos)
  if o.ok then {
    if wants(mode, M_BUILD) and (op.kind == K_WRAP or list.len(out) - mark != 1) then {
      let kids = take_from(out, mark)
      list.push(out, tree.node(kind_at(c, id), kids, pos, o.pos))
    } else ()
    good(o.pos)
  } else {
    rollback(out, mark)
    bad(pos)
  }
}

// The rest of the ladder. Every kind below carries less than one visit in a
// hundred on a Python file, and leaving them in front of `parse_rule`'s common
// arms cost every visit the compares to walk past them.
fn uncommon_here(c: Compiled, num: List[Int], mut out: List[tree.Node], mut exp: List[Int], mut far: Cell, mode: Int, id: Int, op: Op, pos: Int) -> Out = {
  if op.kind == K_RECOVER_LINES then recover_lines_here(c, num, out, exp, far, mode, id, op, pos)
  else if op.kind == K_NEEDS then (if unpruned(mode, far, pos) or needs_here(c, num, match list.get(c.ops, op.a) { some(o) => o, none => Op { kind: K_EPS, a: 0, b: 0 } }, pos) then good(pos) else miss(exp, far, mode, pos, id))
  else if op.kind == K_NOT_TOK then not_tok_here(c, num, out, exp, far, mode, op, pos)
  // the body of a macro is a balanced run of tokens the grammar has no reading
  // of; `any` consumes one and leaves nothing behind
  else if op.kind == K_FIELD then {
    let mark = list.len(out)
    let o = parse_rule(c, num, out, exp, far, mode, op.a, pos)
    if o.ok then {
      label_from(out, mark, kind_at(c, id))
      good(o.pos)
    } else {
      rollback(out, mark)
      Out { ok: false, pos: pos }
    }
  }
  else if op.kind == K_REF then {
    if op.a < 0 then miss(exp, far, mode, pos, id)
    else parse_rule(c, num, out, exp, far, mode, op.a, pos)
  }
  // the collecting pass never refuses here, so a file that fails is described
  // by the branches themselves and the message is the same message
  else if op.kind == K_LEFT then {
    let mark = list.len(out)
    let o = parse_rule(c, num, out, exp, far, mode, op.a, pos)
    if not o.ok then {
      rollback(out, mark)
      Out { ok: false, pos: pos }
    } else {
      var p = o.pos
      var go = true
      while go {
        // out holds the left operand from `mark`; the operator lands at
        // `opmark` and the right operand at `rmark`, so one drain can name
        // all three and fold them into a single node
        let opmark = list.len(out)
        let oo = parse_rule(c, num, out, exp, far, mode, op.b, p)
        if not oo.ok then {
          rollback(out, opmark)
          go = false
        } else {
          let rmark = list.len(out)
          let rr = parse_rule(c, num, out, exp, far, mode, op.a, oo.pos)
          if not rr.ok then {
            rollback(out, opmark)
            go = false
          } else {
            if wants(mode, M_BUILD) then {
              let kids = fold_kids(out, mark, opmark, rmark, c.extra + X_LEFT, c.extra + X_OPERATOR, c.extra + X_RIGHT)
              list.push(out, tree.node(kind_at(c, id), kids, pos, rr.pos))
            } else ()
            p = rr.pos
          }
        }
      }
      good(p)
    }
  }
  else if op.kind == K_AHEAD then {
    let mark = list.len(out)
    let emark = list.len(exp)
    let o = parse_rule(c, num, out, exp, far, ahead_mode(mode), op.a, pos)
    rollback(out, mark)
    if wants(mode, M_COLLECT) then untrack(exp, emark) else ()
    if o.ok then good(pos) else Out { ok: false, pos: pos }
  }
  else if op.kind == K_EPS then good(pos)
  else if op.kind == K_ANY then {
    match list.get(num, pos * 2) {
      some(k) => if k == tree.T_EOF then miss(exp, far, mode, pos, id) else good(pos + 1),
      none => miss(exp, far, mode, pos, id),
    }
  }
  else recover_here(c, num, out, exp, far, mode, id, op, pos)   // K_RECOVER and K_RECOVER_ALL: the rarest arm carries the chain
}

// The tokens under ERROR nodes (kind `err`) among the nodes pushed since
// `mark`. Only the kind goes in, never the grammar: a closure that captured
// it would make every caller up the chain pass it by value, and copy it.
// Both walks are `for` loops over borrowed lists: `list.get` and a fold's
// closure copy the node they are handed, subtree and all, which made
// counting what went under ERROR in a large item cost more than reading it.
// `out` is `mut` only so that it is borrowed: iterating a plain list
// parameter takes it by value on the native target
fn error_tokens(error_kind: Int, mut out: List[tree.Node], mark: Int) -> Int = {
  var total = 0
  var i = 0
  for n in out {
    if i >= mark then total = total + error_tokens_in(error_kind, n) else ()
    i = i + 1
  }
  total
}
fn error_tokens_in(error_kind: Int, n: tree.Node) -> Int =
  if n.kind == error_kind then n.end - n.start
  else {
    var total = 0
    for k in n.kids { total = total + error_tokens_in(error_kind, k) }
    total
  }

// A recover site: the item as written, else the least that can be given up.
// When the item fails there are two ways on — skip to the next place the
// rule reads (an ERROR node over what is skipped, after whatever head of the
// item is readable on its own), or read it with one closer the file lacks
// taken as there where it failed farthest (`repair_trial`) — and a third is
// the first read itself when it closed brackets at the end of the file
// (`closer_never_came`), keeping a body an edit left open: that read is
// weighed against skipping. The way that puts fewer tokens under ERROR wins;
// a skip that finds no resume point and no real token gives up.
//
// A list stops at a closer that pairs with an opener before the list began
// (`pairs_outward`): that closer ends something the list is inside, and
// what follows the list reads it. A closer that pairs inside the list —
// its opener went under an ERROR node — or with nothing is one error token,
// and the list reads on: it would otherwise end the list where the list's
// own closer should, so that the item holding the list fails and is read
// again at every way its site has, and again at every level above.
//
// What a site works out is remembered (`memo_find`). The ways read the item
// again, and an enclosing item's ways read everything in it again, so
// without the memo a break nested k lists deep costs the ways to the k-th
// power. The ways are tried without a tree (`trial_mode`); the one chosen is
// read again with the tree when the pass builds one, and the items in it
// replay what they worked out (`memo_apply`).
let E_WRITTEN = 0
let E_CLOSE = 1
let E_REPAIR = 2
let E_SKIP = 3
let E_FAIL = 4
// what an answer leaned on: a repair taken somewhere in its reads, and a
// closer taken as there at the end of the file somewhere in its reads
let FL_REPAIRED = 1
let FL_EOF = 2

fn trial_mode(mode: Int) -> Int = if wants(mode, M_BUILD) then mode - M_BUILD else mode

fn recover_here(c: Compiled, num: List[Int], mut out: List[tree.Node], mut exp: List[Int], mut far: Cell, mode: Int, id: Int, op: Op, pos: Int) -> Out =
  if not wants(mode, M_RECOVER) then {
    if wants(mode, M_COLLECT) then collected_item(c, num, out, exp, far, mode, id, op, pos)
    else strict_item(c, num, out, exp, far, mode, id, op, pos)
  } else {
    let at = repair_of(far)
    if at >= 0 and pos > at then {
      // a repair behind this item cannot reach it: it reads as if none were
      // under way, and may take one of its own
      let atom = repair_atom(far)
      set_repair(far, 0 - 1, 0 - 1)
      let o = recover_site(c, num, out, exp, far, mode, id, op, pos)
      set_repair(far, at, atom)
      o
    } else recover_site(c, num, out, exp, far, mode, id, op, pos)
  }

// A recover item in a strict pass: read as written, and what it read to
// logged on `exp` — site, position, end (-1: failed), farthest failure —
// for the pass that names what a failed parse expected (`failure_of`)
fn strict_item(c: Compiled, num: List[Int], mut out: List[tree.Node], mut exp: List[Int], mut far: Cell, mode: Int, id: Int, op: Op, pos: Int) -> Out =
  if not wants(mode, M_LOG) then {
    let mark = list.len(out)
    let o = parse_rule(c, num, out, exp, far, mode, op.a, pos)
    if o.ok then { stamp(out, mark, id); o } else { rollback(out, mark); Out { ok: false, pos: pos } }
  } else logged_item(c, num, out, exp, far, mode, id, op, pos)
fn logged_item(c: Compiled, num: List[Int], mut out: List[tree.Node], mut exp: List[Int], mut far: Cell, mode: Int, id: Int, op: Op, pos: Int) -> Out = {
  let mark = list.len(out)
  let outer = far_of(far)
  set_far(far, pos)
  let o = parse_rule(c, num, out, exp, far, mode, op.a, pos)
  let item_far = far_of(far)
  list.push(exp, id)
  list.push(exp, pos)
  list.push(exp, if o.ok then o.pos else 0 - 1)
  list.push(exp, item_far)
  if item_far < outer then set_far(far, outer) else ()
  if o.ok then { stamp(out, mark, id); o } else { rollback(out, mark); Out { ok: false, pos: pos } }
}

// A recover item in a collecting pass: one the strict pass read without
// reaching its farthest failure is stepped over (`failure_of`), the rest
// read as written
fn collected_item(c: Compiled, num: List[Int], mut out: List[tree.Node], mut exp: List[Int], mut far: Cell, mode: Int, id: Int, op: Op, pos: Int) -> Out =
  match map.get(far.memo, memo_key(id, pos, 0)) {
    some(e) => if e_at(e, 0) == 1 then good(e_at(e, 1)) else Out { ok: false, pos: pos },
    none => {
      let mark = list.len(out)
      let o = parse_rule(c, num, out, exp, far, mode, op.a, pos)
      if o.ok then { stamp(out, mark, id); o } else { rollback(out, mark); Out { ok: false, pos: pos } }
    },
  }

// Lists nested deeper than this are not read: every `{` an edit typed that
// no `}` answers opens one more, and the read of a file with thousands of
// them would outrun the stack. Code nests a few dozen deep.
let MAX_LIST_DEPTH = 256

fn recover_site(c: Compiled, num: List[Int], mut out: List[tree.Node], mut exp: List[Int], mut far: Cell, mode: Int, id: Int, op: Op, pos: Int) -> Out =
  if is_closer(real_atom(num, pos)) and list_owner(far) == id then closer_item(c, num, out, exp, far, mode, id, op, pos)
  else if list_depth(far) > MAX_LIST_DEPTH then too_deep(c, num, out, far, mode, id, op, pos)
  // inside a lookahead or a negation an answer is worked out apart: the
  // rules that hold there differ, so it is neither looked up nor kept
  else if wants(mode, M_PEEK) then recover_fresh(c, num, out, exp, far, mode, id, op, pos, false)
  else match memo_find(far, num, id, pos, mode) {
    some(e) => memo_apply(c, num, out, exp, far, mode, id, op, pos, e),
    none => recover_fresh(c, num, out, exp, far, mode, id, op, pos, repair_of(far) < 0),
  }

// An item past `MAX_LIST_DEPTH`: what its list may reach goes under one
// ERROR node, unread
fn too_deep(c: Compiled, num: List[Int], mut out: List[tree.Node], mut far: Cell, mode: Int, id: Int, op: Op, pos: Int) -> Out = {
  let limit = skip_limit(num, pos, op.kind == K_RECOVER, mode)
  if not real_between(num, pos, limit) then Out { ok: false, pos: pos }
  else {
    push_error(out, far, c.extra + X_ERROR, pos, limit)
    stamp(out, list.len(out) - 1, id)
    good(limit)
  }
}

// The item at a closer: as written, else the list ends there when the
// closer pairs outward, else the closer is one error token. Where the list
// began decides it, so the answer is not remembered.
fn closer_item(c: Compiled, num: List[Int], mut out: List[tree.Node], mut exp: List[Int], mut far: Cell, mode: Int, id: Int, op: Op, pos: Int) -> Out = {
  let mark = list.len(out)
  let o = parse_rule(c, num, out, exp, far, mode, op.a, pos)
  if o.ok then { stamp(out, mark, id); o }
  else {
    rollback(out, mark)
    if pairs_outward(num, pos, list_start(far)) then Out { ok: false, pos: pos }
    else {
      push_error(out, far, c.extra + X_ERROR, pos, pos + 1)
      stamp(out, mark, id)
      good(pos + 1)
    }
  }
}

// ── the memo ─────────────────────────────────────────────────────────────
// A site's answer at a position:
//   [ok, end, errors, far, flags, way, the way's four numbers, first error, bound]
// `errors` counts the tokens it put under ERROR, `first error` is where the
// first of them begins, `far` is the farthest any
// of its reads failed, `flags` what they leaned on. A repair under way
// changes nothing for reads that never failed at its place and took no
// repair of their own. `M_BUILD` changes nothing a rule matches, so one
// answer serves a read with or without a tree; the bound a read is under
// (`with_bound`) does, so an answer serves reads under its own.
fn memo_key(site: Int, pos: Int, close: Int) -> Int = (site * 4294967296 + pos) * 2 + close
fn e_at(e: List[Int], i: Int) -> Int = list.get(e, i) ?? 0
fn holds_under_repair(e: List[Int], at: Int) -> Bool = at < 0 or (e_at(e, 3) < at and int.band(e_at(e, 4), FL_REPAIRED) == 0)
fn memo_find(far: Cell, num: List[Int], site: Int, pos: Int, mode: Int) -> Option[List[Int]] =
  match map.get(far.memo, memo_key(site, pos, 0)) {
    some(e) => if holds_under_repair(e, repair_of(far)) and e_at(e, 11) == bound_of(mode) then some(e) else none,
    none => none,
  }

// A remembered answer used: its farthest failure and what it leaned on go
// to the enclosing item; without a tree only the count of what went under
// ERROR is carried, and with one the way is read again, the items in it
// replaying theirs.
fn memo_apply(c: Compiled, num: List[Int], mut out: List[tree.Node], mut exp: List[Int], mut far: Cell, mode: Int, id: Int, op: Op, pos: Int, e: List[Int]) -> Out = {
  note_far(far, e_at(e, 3))
  add_flags(far, e_at(e, 4))
  if e_at(e, 0) == 0 then Out { ok: false, pos: pos }
  else if not wants(mode, M_BUILD) then {
    // the count stands at the answer's first ERROR, for `swallowed_at`
    let first = int.max(0, e_at(e, 10))
    if e_at(e, 2) > 0 then push_error(out, far, c.extra + X_ERROR, first, first + e_at(e, 2)) else ()
    good(e_at(e, 1))
  } else take_way(c, num, out, exp, far, mode, id, op, pos, e)
}

// A site's answer worked out. Its reads note their farthest failure and
// what they leaned on from here; the enclosing item's come back after,
// joined with them. The answer is remembered when `store`.
fn recover_fresh(c: Compiled, num: List[Int], mut out: List[tree.Node], mut exp: List[Int], mut far: Cell, mode: Int, id: Int, op: Op, pos: Int, store: Bool) -> Out = {
  let mark = list.len(out)
  let outer_far = far_of(far)
  let outer_flags = flags_of(far)
  let errors_before = errors_made(far)
  let outer_first = first_error_of(far)
  set_far(far, pos)
  set_flags(far, 0)
  set_first_error(far, 0 - 1)
  var way: List[Int] = [0, 0, 0, 0, 0, E_FAIL, 0, 0, 0, 0]
  let o = recover_ways(c, num, out, exp, far, mode, id, op, pos, way)
  let item_far = far_of(far)
  let item_flags = int.bor(flags_of(far), if e_at(way, 5) == E_REPAIR then FL_REPAIRED else 0)
  let item_first = first_error_of(far)
  // an item that read as written, leaning on nothing, is remembered only by
  // a trial: a read with a tree reaches it once, and the trials of an
  // enclosing item that fails remember it when they read it
  let plain = e_at(way, 5) == E_WRITTEN and item_flags == 0 and wants(mode, M_BUILD)
  if store and not plain then {
    let errors = if not o.ok or errors_made(far) == errors_before then 0 else error_tokens(c.extra + X_ERROR, out, mark)
    map.insert(far.memo, memo_key(id, pos, 0), [if o.ok then 1 else 0, o.pos, errors, item_far, item_flags, e_at(way, 5), e_at(way, 6), e_at(way, 7), e_at(way, 8), e_at(way, 9), if errors > 0 then item_first else 0 - 1, bound_of(mode)])
  } else ()
  set_flags(far, int.bor(outer_flags, item_flags))
  if item_far < outer_far then set_far(far, outer_far) else ()
  set_first_error(far, outer_first)
  note_first_error(far, item_first)
  o
}

// The way a site worked out, in the answer's layout (slot 5 and on)
fn set_way(mut way: List[Int], code: Int, a: Int, b: Int, d: Int, e: Int) -> Unit = {
  list.clear(way)
  for x in [0, 0, 0, 0, 0, code, a, b, d, e] { list.push(way, x) }
}

// The item read, and the ways on when it fails, `way` set to the one taken
fn recover_ways(c: Compiled, num: List[Int], mut out: List[tree.Node], mut exp: List[Int], mut far: Cell, mode: Int, id: Int, op: Op, pos: Int, mut way: List[Int]) -> Out = {
  let mark = list.len(out)
  let errors_before = errors_made(far)
  let o = parse_rule(c, num, out, exp, far, mode, op.a, pos)
  // a read that closed brackets at the end of the file is weighed against skipping
  let closed = int.band(flags_of(far), FL_EOF) != 0
  let first_error = first_error_of(far)
  if o.ok and not closed then { stamp(out, mark, id); set_way(way, E_WRITTEN, 0, 0, 0, 0); o }
  else if not o.ok and refused_here(c, num, out, exp, far, mode, op.a, pos) then {
    set_way(way, E_FAIL, 0, 0, 0, 0)
    Out { ok: false, pos: pos }
  }
  else {
    let failed_at = far_of(far)
    let close_loses = if not o.ok then 0 - 1 else if errors_made(far) == errors_before then 0 else error_tokens(c.extra + X_ERROR, out, mark)
    // the closed read's nodes are set aside while the skip is worked out
    var closed_nodes: List[tree.Node] = []
    if o.ok then closed_nodes = take_from(out, mark) else rollback(out, mark)
    var plan: List[Int] = []
    let skip_loses = skip_plan(c, num, out, exp, far, mode, op, pos, plan)
    // closing loses when it swallowed an item of its own list; else it wins
    // when the skip would read on to where it ends anyway, the same tokens
    // with fewer of them, or when it loses less
    let close_wins = o.ok and (skip_loses < 0
      or (not swallowed_at(c, num, out, exp, far, mode, op, pos, e_at(plan, 3), first_error)
        and (e_at(plan, 5) >= o.pos or close_loses < skip_loses
          or close_loses < skip_loses + read_on_errors(c, num, out, exp, far, mode, id, op, e_at(plan, 5), o.pos))))
    if close_wins then {
      put_back(out, closed_nodes)
      stamp(out, mark, id)
      set_way(way, E_CLOSE, 0, 0, 0, 0)
      o
    } else {
      // a closed read that loses to skipping took its closers at the end of
      // the file, where a repair has nothing to add
      var best: List[Int] = [0 - 1, 0 - 1]
      if not o.ok then repair_trial(c, num, out, exp, far, mode, op.a, pos, e_at(plan, 4), failed_at, best) else ()
      if e_at(best, 0) >= 0 and (skip_loses < 0 or e_at(best, 1) < skip_loses) then {
        set_way(way, E_REPAIR, failed_at, e_at(best, 0), 0, 0)
        take_way(c, num, out, exp, far, mode, id, op, pos, way)
      } else if skip_loses < 0 then { set_way(way, E_FAIL, 0, 0, 0, 0); Out { ok: false, pos: pos } }
      else {
        set_way(way, E_SKIP, e_at(plan, 0), e_at(plan, 1), e_at(plan, 2), e_at(plan, 3))
        take_way(c, num, out, exp, far, mode, id, op, pos, way)
      }
    }
  }
}

// Whether the item begins with a negation that refuses the token at `pos`:
// the grammar's word that its list ends there — a case body at the next
// `case` — so the list ends as a strict read would, with nothing skipped
fn refused_here(c: Compiled, num: List[Int], mut out: List[tree.Node], mut exp: List[Int], mut far: Cell, mode: Int, item: Int, pos: Int) -> Bool = {
  let op = match list.get(c.ops, item) { some(o) => o, none => Op { kind: K_EPS, a: 0, b: 0 } }
  if op.kind != K_SEQ or op.b == 0 then false
  else {
    let first = kid_at(c, op.a)
    let kind = match list.get(c.ops, first) { some(o) => o.kind, none => K_EPS }
    if kind != K_NOT and kind != K_NOT_LIT and kind != K_NOT_TOK then false
    else {
      let mark = list.len(out)
      let o = parse_rule(c, num, out, exp, far, trial_mode(mode), first, pos)
      rollback(out, mark)
      not o.ok
    }
  }
}

let LONG_TRY = 64
let LONG_TRIES = 32

// Whether a read that closed at the end of the file swallowed an item of
// its own list: its first ERROR begins where the item rule reads — a Go
// method after a function that lost its `}`, read inside the function as a
// few statements and an ERROR over `func`. Such a read ends too late
// however few tokens it loses, and the skip, which resumes at the first
// place the item rule reads, puts the item back where it was.
fn swallowed_at(c: Compiled, num: List[Int], mut out: List[tree.Node], mut exp: List[Int], mut far: Cell, mode: Int, op: Op, pos: Int, resume: Int, first_error: Int) -> Bool =
  if resume < 0 or first_error <= pos then false
  else {
    let mark = list.len(out)
    let a = parse_rule(c, num, out, exp, far, trial_mode(mode), op.a, first_error)
    rollback(out, mark)
    a.ok
  }

// What the items after a skip's resumed one put under ERROR, read on
// without a tree up to `to`, where the closed read ended: the closed read's
// ERROR tokens past the resume point are the same tokens the skip reads on
// through, and a skip is not lighter for counting only what it skips. Only
// a site whose list reads the items after it (`list_owner`) reads on.
fn read_on_errors(c: Compiled, num: List[Int], mut out: List[tree.Node], mut exp: List[Int], mut far: Cell, mode: Int, id: Int, op: Op, from: Int, to: Int) -> Int =
  if from < 0 or list_owner(far) != id then 0
  else {
    let tmode = trial_mode(mode)
    var q = from
    var total = 0
    var going = true
    while going and q < to {
      let mark = list.len(out)
      let before = errors_made(far)
      let r = recover_here(c, num, out, exp, far, tmode, id, op, q)
      if r.ok and r.pos > q then {
        if errors_made(far) != before then total = total + error_tokens(c.extra + X_ERROR, out, mark) else ()
        q = r.pos
      } else going = false
      rollback(out, mark)
    }
    total
  }

// The skip worked out without a tree: where the rule reads again, what head
// of the failed item is readable on its own, and how many tokens skipping
// gives up (-1: nothing real to give up and nowhere to resume). `plan` gets
// [kept, from, stop, resume, limit, where the item read from `resume` ends].
fn skip_plan(c: Compiled, num: List[Int], mut out: List[tree.Node], mut exp: List[Int], mut far: Cell, mode: Int, op: Op, pos: Int, mut plan: List[Int]) -> Int = {
  let mark = list.len(out)
  let tmode = trial_mode(mode)
  let limit = skip_limit(num, pos, op.kind == K_RECOVER, mode)
  var q = pos + 1
  var resume = -1
  var resumed_to = -1
  // Tries that read far before failing are counted: a run of them is one
  // construct read again from every token in it — a list of two thousand
  // names, each try reading to the same end — and past `LONG_TRIES` of them
  // the search goes on from the farthest any failed at.
  var long_tries = 0
  var farthest = pos
  while resume < 0 and q < limit {
    let outer = far_of(far)
    set_far(far, q)
    let a = parse_rule(c, num, out, exp, far, tmode, op.a, q)
    let reached = far_of(far)
    if reached < outer then set_far(far, outer) else ()
    rollback(out, mark)
    if a.ok then { resume = q; resumed_to = a.pos }
    else {
      if reached - q > LONG_TRY then { long_tries = long_tries + 1; farthest = int.max(farthest, reached) } else ()
      // an opener no closer answers that the item does not read from is
      // stepped over whole, to where indentation ends it: tries inside it
      // would each read to that same end. The separators before that end are
      // tried again, since an item may begin with one
      let ends = if unpaired_opener(num, q) then separators_before(num, q + 1, vclose_of(num, q)) else -1
      if long_tries >= LONG_TRIES and farthest > q + 1 then { q = farthest; long_tries = 0 }
      else if ends > q + 1 then q = ends
      else q = q + 1
    }
  }
  // where the tokens given up end: at the next item, or at the end of what
  // this list may reach
  let stop = if resume >= 0 then resume else limit
  // keep whatever of the failed item is readable on its own
  let h = parse_rule(c, num, out, exp, far, tmode, op.b, pos)
  let kept = h.ok and h.pos > pos and h.pos <= stop
  rollback(out, mark)
  let from = if kept then h.pos else pos
  list.clear(plan)
  for x in [if kept then 1 else 0, from, stop, resume, limit, resumed_to] { list.push(plan, x) }
  if resume < 0 and not real_between(num, pos, limit) then 0 - 1 else stop - from
}

// The repair worked out without a tree: each of `)`, `]`, `}` taken as there
// at `at`, where the item failed farthest when read as written; `best` gets
// the atom of the read that loses least and that count, or stays [-1, -1].
// Nothing is tried inside a repair already under way, or where the item
// failed at its first token or at the end of what its list may reach —
// there a closer of another kind is taken as there already
// (`closer_pairs_outward`), and at the end of the file closing does it.
fn repair_trial(c: Compiled, num: List[Int], mut out: List[tree.Node], mut exp: List[Int], mut far: Cell, mode: Int, item: Int, pos: Int, limit: Int, at: Int, mut best: List[Int]) -> Unit = {
  let mark = list.len(out)
  if repair_of(far) >= 0 or at <= pos or at >= limit then ()
  else for atom in [A_RPAREN, A_RBRACK, A_RBRACE] {
    let errors_before = errors_made(far)
    set_repair(far, at, atom)
    let o = parse_rule(c, num, out, exp, far, trial_mode(mode), item, pos)
    set_repair(far, 0 - 1, 0 - 1)
    if o.ok and o.pos > at then {
      let loses = if errors_made(far) == errors_before then 0 else error_tokens(c.extra + X_ERROR, out, mark)
      if e_at(best, 1) < 0 or loses < e_at(best, 1) then {
        list.clear(best)
        list.push(best, atom)
        list.push(best, loses)
      } else ()
    } else ()
    rollback(out, mark)
  }
}

// The item read the way worked out (`w` in the answer's layout: the way in
// slot 5, its numbers after)
fn take_way(c: Compiled, num: List[Int], mut out: List[tree.Node], mut exp: List[Int], mut far: Cell, mode: Int, id: Int, op: Op, pos: Int, w: List[Int]) -> Out = {
  let mark = list.len(out)
  let way = e_at(w, 5)
  if way == E_SKIP then skip_way(c, num, out, exp, far, mode, id, op, pos, w)
  else if way == E_FAIL then Out { ok: false, pos: pos }
  else {
    let repairing = way == E_REPAIR
    if repairing then set_repair(far, e_at(w, 6), e_at(w, 7)) else ()
    let o = parse_rule(c, num, out, exp, far, mode, op.a, pos)
    if repairing then set_repair(far, 0 - 1, 0 - 1) else ()
    if o.ok then stamp(out, mark, id) else rollback(out, mark)
    o
  }
}

fn skip_way(c: Compiled, num: List[Int], mut out: List[tree.Node], mut exp: List[Int], mut far: Cell, mode: Int, id: Int, op: Op, pos: Int, w: List[Int]) -> Out = {
  let mark = list.len(out)
  let from = e_at(w, 7)
  let stop = e_at(w, 8)
  let resume = e_at(w, 9)
  if e_at(w, 6) == 1 then { let _ = parse_rule(c, num, out, exp, far, mode, op.b, pos) } else ()
  if real_between(num, from, stop) then {
    push_error(out, far, c.extra + X_ERROR, from, stop)
    stamp(out, list.len(out) - 1, id)
  } else ()
  if resume >= 0 then {
    let resumed = list.len(out)
    let a = parse_rule(c, num, out, exp, far, mode, op.a, resume)
    if a.ok then { stamp(out, resumed, id); good(a.pos) } else {
      rollback(out, mark)
      Out { ok: false, pos: pos }
    }
  } else good(stop)
}

// The nodes taken from `out` by `take_from`, back on it in their order
fn put_back(mut out: List[tree.Node], mut kept: List[tree.Node]) -> Unit = {
  var rev: List[tree.Node] = []
  while list.len(kept) > 0 { match list.pop(kept) { some(n) => list.push(rev, n), none => () } }
  while list.len(rev) > 0 { match list.pop(rev) { some(n) => list.push(out, n), none => () } }
}

// A recover item that came out as one node is stamped with the recover op
// that read it, in the node's `field` below -1 where no field name lives:
// the incremental reader re-reads such a node alone, with the same op.
// A reader of fields compares against names, which are never negative, and
// the s-expression prints a negative field as none.
fn stamp(mut out: List[tree.Node], mark: Int, site: Int) -> Unit =
  if list.len(out) == mark + 1 then match list.pop(out) {
    some(n) => list.push(out, if n.field < 0 then tree.Node { ...n, field: 0 - 2 - site } else n),
    none => (),
  } else ()
fn site_of(n: tree.Node) -> Int = if n.field <= -2 then 0 - 2 - n.field else -1
fn body_of(c: Compiled, site: Int) -> Int = match list.get(c.ops, site) { some(o) => o.a, none => -1 }
// True when `site` reads what `first` reads after leading separators: its
// body is a sequence ending in `first`'s body (`sep item` after `item`).
fn reads_after_separator(c: Compiled, site: Int, first: Int) -> Bool = {
  let body = match list.get(c.ops, body_of(c, site)) { some(o) => o, none => Op { kind: K_EPS, a: 0, b: 0 } }
  // a sequence's `b` counts its members, from the kid table at `a`
  body.kind == K_SEQ and body.b >= 2 and same_body(c, kid_at(c, body.a + body.b - 1), body_of(c, first))
}
// A file or block rule may read its first item at one recover site and
// `sep item` at another; the two are partners. `rest_site_of` is the partner
// that reads after a separator (`site` itself when it is that one, or has
// none); `first_site_of` the partner that reads the bare item.
fn rest_site_of(c: Compiled, site: Int) -> Int = {
  let kind = match list.get(c.ops, site) { some(o) => o.kind, none => K_EPS }
  var found = -1
  var id = 0
  while found < 0 and id < list.len(c.ops) {
    let op = match list.get(c.ops, id) { some(o) => o, none => Op { kind: K_EPS, a: 0, b: 0 } }
    if id != site and op.kind == kind and reads_after_separator(c, id, site) then found = id else ()
    id = id + 1
  }
  if found < 0 then site else found
}
fn first_site_of(c: Compiled, site: Int) -> Int = {
  let kind = match list.get(c.ops, site) { some(o) => o.kind, none => K_EPS }
  var found = -1
  var id = 0
  while found < 0 and id < list.len(c.ops) {
    let op = match list.get(c.ops, id) { some(o) => o, none => Op { kind: K_EPS, a: 0, b: 0 } }
    if id != site and op.kind == kind and reads_after_separator(c, site, id) then found = id else ()
    id = id + 1
  }
  if found < 0 then site else found
}
// the same op, or two references to the same rule
fn same_body(c: Compiled, x: Int, y: Int) -> Bool = x == y or (match (list.get(c.ops, x), list.get(c.ops, y)) {
  (some(p), some(q)) => p.kind == K_REF and q.kind == K_REF and p.a == q.a,
  _ => false,
})

// `rep` and `rep1`: the item for as long as it reads and moves on
// A list in a recovering read. A list of recover items says where it began,
// whose items it holds and how deep it is, for the recover sites in it; the
// enclosing list's come back after. Apart from `parse_rule`, whose strict
// arms stay as small as the compiler inlines them.
fn rep_recovering(c: Compiled, num: List[Int], mut out: List[tree.Node], mut exp: List[Int], mut far: Cell, mode: Int, op: Op, pos: Int) -> Out =
  if is_recover_op(c, op.a) then {
    let outer_start = list_start(far)
    let outer_owner = list_owner(far)
    let outer_depth = list_depth(far)
    set_list(far, pos, op.a, outer_depth + 1)
    let o = rep_bounded(c, num, out, exp, far, mode, op, pos)
    set_list(far, outer_start, outer_owner, outer_depth)
    o
  } else rep_bounded(c, num, out, exp, far, mode, op, pos)

// The items of a list in a recovering read, stopping at the bound the mode
// carries (`with_bound`)
fn rep_bounded(c: Compiled, num: List[Int], mut out: List[tree.Node], mut exp: List[Int], mut far: Cell, mode: Int, op: Op, pos: Int) -> Out = {
  var p = pos
  var count = 0
  var go = true
  let bound = bound_of(mode)
  while go {
    if bound >= 0 and p >= bound then go = false
    else if not (unpruned(mode, far, p) or may_start(c, op.a, num, p)) then go = false
    else {
      let mark = list.len(out)
      let o = parse_rule(c, num, out, exp, far, mode, op.a, p)
      if o.ok and o.pos != p then { p = o.pos; count = count + 1 }
      else {
        rollback(out, mark)
        go = false
      }
    }
  }
  if op.kind == K_REP1 and count == 0 then Out { ok: false, pos: pos } else good(p)
}

fn parse_rule(c: Compiled, num: List[Int], mut out: List[tree.Node], mut exp: List[Int], mut far: Cell, mode: Int, id: Int, pos: Int) -> Out = {
  let op = match list.get(c.ops, id) { some(o) => o, none => Op { kind: K_EPS, a: 0, b: 0 } }
  if op.kind == K_ALT then {
    let mark = list.len(out)
    var p = pos
    var done = false
    var i = 0
    while not done and i < op.b {
      let branch = kid_at(c, op.a + i)
      // a branch the token cannot begin is not walked into; the collecting
      // pass walks every one of them, so the message is the same message
      if unpruned(mode, far, pos) or may_start(c, branch, num, pos) then {
        let o = parse_rule(c, num, out, exp, far, mode, branch, pos)
        if o.ok then { done = true; p = o.pos } else rollback(out, mark)
      } else ()
      i = i + 1
    }
    Out { ok: done, pos: p }
  }
  else if op.kind == K_WRAP_SEQ or op.kind == K_NEST_SEQ then wrapped_seq_here(c, num, out, exp, far, mode, id, op, pos)
  else if op.kind == K_OPT then {
    if not (unpruned(mode, far, pos) or may_start(c, op.a, num, pos)) then good(pos)
    else {
      let mark = list.len(out)
      let o = parse_rule(c, num, out, exp, far, mode, op.a, pos)
      if o.ok then o else {
        rollback(out, mark)
        good(pos)
      }
    }
  }
  else if op.kind == K_LIT or op.kind == K_KEEP then literal_here(c, num, out, exp, far, mode, id, op, pos)
  else if op.kind == K_SEQ then {
    let mark = list.len(out)
    if closing(mode) then seq_recovering(c, num, out, exp, far, mode, op, pos) else {
    var p = pos
    var failed = false
    var i = 0
    while not failed and i < op.b {
      let o = parse_rule(c, num, out, exp, far, mode, kid_at(c, op.a + i), p)
      if o.ok then { p = o.pos } else { failed = true }
      i = i + 1
    }
    if failed then {
      rollback(out, mark)
      Out { ok: false, pos: pos }
    } else good(p)
    }
  }
  else if op.kind == K_REP or op.kind == K_REP1 then {
    if wants(mode, M_RECOVER) then rep_recovering(c, num, out, exp, far, mode, op, pos) else {
    var p = pos
    var count = 0
    var go = true
    while go {
      if not (unpruned(mode, far, p) or may_start(c, op.a, num, p)) then go = false
      else {
        let mark = list.len(out)
        let o = parse_rule(c, num, out, exp, far, mode, op.a, p)
        if o.ok and o.pos != p then { p = o.pos; count = count + 1 }
        else {
          rollback(out, mark)
          go = false
        }
      }
    }
    if op.kind == K_REP1 and count == 0 then Out { ok: false, pos: pos } else good(p)
    }
  }
  else if op.kind == K_TERMS then terms_here(c, num, out, exp, far, mode, op, pos)
  else if op.kind == K_PREC then {
    // One pass over the levels rather than one rule per level: the operand is
    // parsed once, and each operator found is held on a stack until an
    // operator of its precedence or lower arrives, which is what nesting the
    // folds did by returning.
    let operand = kid_at(c, op.a)
    let base = list.len(out)
    let o = parse_rule(c, num, out, exp, far, mode, operand, pos)
    if not o.ok then {
      rollback(out, base)
      Out { ok: false, pos: pos }
    } else {
      var p = o.pos
      var mark = base                  // where the rightmost operand starts in `out`
      var from = pos                   // and at which token
      var marks: List[Int] = []
      var opmarks: List[Int] = []
      var levels: List[Int] = []
      var froms: List[Int] = []
      var going = true
      while going {
        let l = level_at(c, op, num, p)
        if l < 0 then going = false
        else {
          while list.len(levels) > 0 and (match list.last(levels) { some(v) => v, none => -1 }) >= l {
            let (m, f) = reduce_top(c, out, marks, opmarks, levels, froms, id, mark, p, wants(mode, M_BUILD))
            mark = m
            from = f
          }
          let opmark = list.len(out)
          let oo = parse_rule(c, num, out, exp, far, mode, kid_at(c, op.a + 1 + l), p)
          if not oo.ok then going = false
          else {
            let rmark = list.len(out)
            let rr = parse_rule(c, num, out, exp, far, mode, operand, oo.pos)
            if not rr.ok then {
              rollback(out, opmark)
              going = false
            } else {
              list.push(marks, mark)
              list.push(opmarks, opmark)
              list.push(levels, l)
              list.push(froms, from)
              mark = rmark
              from = oo.pos
              p = rr.pos
            }
          }
        }
      }
      reduce_all(c, out, marks, opmarks, levels, froms, id, mark, p, wants(mode, M_BUILD))
      good(p)
    }
  }
  else if op.kind == K_NOT_LIT then not_lit_here(c, num, out, exp, far, mode, id, op, pos)
  else if op.kind == K_WRAP or op.kind == K_NEST then wrapped_here(c, num, out, exp, far, mode, id, op, pos)
  else if op.kind == K_TOK then token_here(c, num, out, exp, far, mode, id, op, pos)
  else if op.kind == K_NOT then not_here(c, num, out, exp, far, mode, op, pos)
  else uncommon_here(c, num, out, exp, far, mode, id, op, pos)
}

type Parsed = { root: tree.Node, toks: List[tree.Token], names: nametable.Names }

// What an arena node expected, for the error message.
fn expectation(c: Compiled, id: Int) -> String = {
  let op = match list.get(c.ops, id) { some(o) => o, none => Op { kind: K_EPS, a: 0, b: 0 } }
  let text = text_at(c, id)
  if op.kind == K_ANY then "a token"
  else if op.kind == K_TOK then text
  else if op.kind == K_REF then "<missing rule " + text + ">"
  else "`" + text + "`"
}

fn failure_at(c: Compiled, source: Bytes, toks: List[tree.Token], far: Int, exp: List[Int]) -> Failure = {
  let t = list.get(toks, far)
  Failure {
    line: option.map(t, (x) => x.line) ?? 0,
    col: option.map(t, (x) => x.col) ?? 0,
    found: match t { some(x) => if x.kind == tree.T_EOF then "end of file" else if x.kind == tree.T_NEWLINE then "end of line" else "`" + tree.token_text(source, x) + "`", none => "end of file" },
    expected: list.map(exp, (id) => expectation(c, id)),
    note: "",
  }
}

fn format_failure(f: Failure) -> String = {
  let exp = if list.is_empty(f.expected) then "" else " (expected " + list.join(list.take(list.unique(f.expected), 6), ", ") + ")"
  int.to_string(f.line) + ":" + int.to_string(f.col) + ": " + (if f.note != "" then f.note else "unexpected " + f.found + exp)
}

// Parse the whole token stream with the grammar's start rule. The start
// rule must consume everything up to `eof`; anything left over is the
// error, reported at the farthest point the grammar reached.
fn parse(g: Grammar, source: Bytes, toks: List[tree.Token]) -> Result[Parsed, Failure] = parse_with(compile(g), source, toks)

// The same, against a grammar that is already compiled. Compiling is a
// per-grammar cost, not a per-file one: a tool that reads a whole repository
// should pay it once.
fn parse_with(c: Compiled, source: Bytes, toks: List[tree.Token]) -> Result[Parsed, Failure] = {
  let input = TokenInput { tokens: toks }
  let num = plain_numbers(c, source, input)
  strict_tree(c, source, input.tokens, num)
}

fn strict_tree(c: Compiled, source: Bytes, toks: List[tree.Token], num: List[Int]) -> Result[Parsed, Failure] = {
  var out: List[tree.Node] = []
  var exp: List[Int] = []
  var far: Cell = far_cell()
  let o = parse_rule(c, num, out, exp, far, fresh(false), c.start, 0)
  if o.ok then ok(Parsed { root: root_of(c, out, list.len(toks)), toks: toks, names: c.names })
  else err(logged_failure(c, source, toks, num))
}

// What a strict read that failed expected where it failed: read again, no
// tree, logging its recover items, and then the pass that collects the
// expectations steps over every item that did not reach the failure
fn logged_failure(c: Compiled, source: Bytes, toks: List[tree.Token], num: List[Int]) -> Failure = {
  var out: List[tree.Node] = []
  var log: List[Int] = []
  var far: Cell = far_cell()
  let _ = parse_rule(c, num, out, log, far, M_LOG, c.start, 0)
  failure_of(c, source, toks, num, far_of(far), log)
}

// The start rule leaves one node; it is taken without copying it, which
// means draining the list rather than reading its first element
fn root_of(c: Compiled, mut out: List[tree.Node], count: Int) -> tree.Node = {
  var rev: List[tree.Node] = []
  while list.len(out) > 0 {
    match list.pop(out) { some(n) => list.push(rev, n), none => () }
  }
  match list.pop(rev) { some(n) => n, none => tree.node(kind_at(c, c.start), [], 0, count) }
}

// What a failed parse expected at its farthest failure `far`. The first
// pass knows where it failed but not what it wanted there; a second pass
// collects that, and only a file that fails pays for it. It walks every
// branch at `far` and prunes below it as the first did (`unpruned`), and it
// steps over every recover item the first pass logged (`strict_item`) as
// read without reaching `far`: such an item notes nothing that lasts. What
// is left to read is the items the failure is in.
fn failure_of(c: Compiled, source: Bytes, toks: List[tree.Token], num: List[Int], far: Int, log: List[Int]) -> Failure = {
  var cell: Cell = far_cell()
  var i = 0
  while i + 3 < list.len(log) {
    let end = e_at(log, i + 2)
    if e_at(log, i + 3) < far and end < far then map.insert(cell.memo, memo_key(e_at(log, i), e_at(log, i + 1), 0), [if end >= 0 then 1 else 0, end]) else ()
    i = i + 4
  }
  var again: List[tree.Node] = []
  var wanted: List[Int] = []
  set_floor(cell, far)
  let _ = parse_rule(c, num, again, wanted, cell, collecting(), c.start, 0)
  failure_at(c, source, toks, far_of(cell), wanted)
}

// The gate: does this parse, and if not, where. No tree is built, because
// nothing above asks for one and whether a rule matches never depended on the
// nodes it made — the tree is output. A file that fails is read again to
// collect what was expected (`failure_of`), and it is not the one anybody is
// timing.
fn verify(c: Compiled, source: Bytes, toks: List[tree.Token]) -> Result[Unit, Failure] = {
  let input = TokenInput { tokens: toks }
  let num = plain_numbers(c, source, input)
  verified(c, source, input.tokens, num)
}

fn verified(c: Compiled, source: Bytes, toks: List[tree.Token], num: List[Int]) -> Result[Unit, Failure] = {
  var out: List[tree.Node] = []
  var exp: List[Int] = []
  var far: Cell = far_cell()
  let o = parse_rule(c, num, out, exp, far, verifying(), c.start, 0)
  if o.ok then ok(())
  else err(logged_failure(c, source, toks, num))
}

// A tree for a file that does not parse, if the grammar says where it is
// worth carrying on. Every `Recover` rule that fails skips to the next place
// it reads and leaves an ERROR node over what it gave up, so an outline of a
// file someone is halfway through editing still names the parts that are
// whole. This never answers "does this file parse": `check` uses the strict
// parse above, and a reader should run this only after that has said no.
fn parse_recovering(c: Compiled, source: Bytes, toks: List[tree.Token]) -> Result[Parsed, Failure] = {
  let input = TokenInput { tokens: toks }
  let numbered = number_tokens(c, source, input)
  recovered_tree(c, source, input.tokens, numbered.pairs, numbered.balanced)
}

fn recovered_tree(c: Compiled, source: Bytes, toks: List[tree.Token], num: List[Int], balanced: Bool) -> Result[Parsed, Failure] = {
  // a file whose brackets balance pairs them as written; one whose do not
  // asks its indentation which of them lost a closer
  let paired = pair_brackets(num, if balanced then [] else line_leads(source, toks))
  match recovered_from(c, toks, paired) {
    some(p) => ok(p),
    // the recovering pass noted no strict failure: every branch is walked
    none => err(failure_of(c, source, toks, num, 0, [])),
  }
}
fn recovered_from(c: Compiled, toks: List[tree.Token], paired: List[Int]) -> Option[Parsed] = {
  var out: List[tree.Node] = []
  var exp: List[Int] = []
  var far: Cell = far_cell()
  let o = parse_rule(c, paired, out, exp, far, recovering(), c.start, 0)
  if o.ok then some(Parsed { root: root_of(c, out, list.len(toks)), toks: toks, names: c.names }) else none
}

// Why a file whose brackets do not balance is not the language: the first
// bracket the pairing leaves unpaired (`pair_brackets`) — an opener no
// closer answers, the one that lost its closer when indentation could tell,
// or a closer that answers none
fn bracket_failure(source: Bytes, toks: List[tree.Token], paired: List[Int], gaps: List[Int]) -> Failure = {
  let at = list.first(gaps) ?? -1
  let t = list.get(toks, at)
  let text = "`" + (match t { some(x) => tree.token_text(source, x), none => "" }) + "`"
  Failure {
    line: option.map(t, (x) => x.line) ?? 0,
    col: option.map(t, (x) => x.col) ?? 0,
    found: text,
    expected: [],
    note: if at < 0 then "the brackets do not balance" else if is_opener(real_atom(paired, at)) then text + " is never closed" else text + " closes nothing",
  }
}

// The brackets the pairing leaves unpaired, as token indices in order
fn unpaired_brackets(paired: List[Int]) -> List[Int] = {
  var out: List[Int] = []
  var i = 0
  let n = list.len(paired) / 5
  while i < n {
    let x = real_atom(paired, i)
    if (is_opener(x) or is_closer(x)) and match_of(paired, i) < 0 then list.push(out, i) else ()
    i = i + 1
  }
  out
}

// A reader's parse: the tree, why the file is not the language when it is
// not (the tree is then the one recovery makes of it), and the brackets it
// left unpaired (`gaps`); an error when even recovery gives up. One
// numbering of the tokens serves every pass. The three come back as a tuple
// rather than a record, so that a reader takes the tree out without a copy.
// Every grammar reads a bracket only as one of a pair, so a file whose
// brackets do not balance is not the language: it is not read strictly,
// and why it fails is the bracket the pairing leaves unpaired. A strict read
// of such a file would fail only after reading everything up to where the
// pairing gave out, which for a `}` gone from a function is the end of the
// file, and would say only that the file ended.
fn read(c: Compiled, source: Bytes, toks: List[tree.Token]) -> Result[(Parsed, Option[Failure], List[Int]), Failure] = {
  let input = TokenInput { tokens: toks }
  let numbered = number_tokens(c, source, input)
  if not numbered.balanced then {
    let paired = pair_brackets(numbered.pairs, line_leads(source, input.tokens))
    let gaps = unpaired_brackets(paired)
    let failure = bracket_failure(source, input.tokens, paired, gaps)
    match recovered_from(c, input.tokens, paired) {
      some(p) => ok((p, some(failure), gaps)),
      none => err(failure),
    }
  } else {
    // the strict read inline: the grammar, source and tokens stay this
    // function's, so neither way on copies them
    var out: List[tree.Node] = []
    var exp: List[Int] = []
    var far: Cell = far_cell()
    let o = parse_rule(c, numbered.pairs, out, exp, far, fresh(false), c.start, 0)
    if o.ok then ok((Parsed { root: root_of(c, out, list.len(input.tokens)), toks: input.tokens, names: c.names }, none, []))
    else {
      let f = logged_failure(c, source, input.tokens, numbered.pairs)
      match recovered_tree(c, source, input.tokens, numbered.pairs, true) {
        ok(p) => ok((p, some(f), [])),
        err(_) => err(f),
      }
    }
  }
}

// ── one top-level item at a time ─────────────────────────────────────────
// A file whose start rule repeats a `recover_all` item can be read one item at
// a time: `item_op` finds that recover op under the start rule (the site the
// nodes are stamped with), and `parse_item` parses one item from a position
// in a numbered token stream with a site's body. The incremental reader is
// built on this; nothing here changes the grammar.
fn child_ops(c: Compiled, op: Op) -> List[Int] =
  if op.kind == K_SEQ or op.kind == K_ALT or op.kind == K_WRAP_SEQ or op.kind == K_NEST_SEQ or op.kind == K_TERMS or op.kind == K_PREC then {
    var out: List[Int] = []
    var k = 0
    while k <= op.b { list.push(out, kid_at(c, op.a + k)); k = k + 1 }
    out
  }
  else if op.kind == K_REF or single_child(op.kind) or op.kind == K_NEST or op.kind == K_LEFT then [op.a]
  else []

fn item_op(c: Compiled) -> Int = {
  var seen: List[Int] = []
  var pending: List[Int] = [c.start]
  var found = -1
  while found < 0 and not list.is_empty(pending) {
    let id = list.pop(pending) ?? -1
    if id < 0 or list.contains(seen, id) then () else {
      list.push(seen, id)
      let op = match list.get(c.ops, id) { some(o) => o, none => Op { kind: K_EPS, a: 0, b: 0 } }
      if op.kind == K_RECOVER_ALL then found = id
      else for k in child_ops(c, op) { list.push(pending, k) }
    }
  }
  found
}

fn number(c: Compiled, source: Bytes, toks: List[tree.Token]) -> List[Int] = plain_numbers(c, source, TokenInput { tokens: toks })

// One item from `pos`: its node and where it ended, or none where the item
// rule does not match there.
fn parse_item(c: Compiled, site: Int, num: List[Int], pos: Int) -> Option[(tree.Node, Int)] = {
  var out: List[tree.Node] = []
  var exp: List[Int] = []
  var far: Cell = far_cell()
  let o = parse_rule(c, num, out, exp, far, fresh(false), body_of(c, site), pos)
  if o.ok and list.len(out) == 1 then { stamp(out, 0, site); match list.pop(out) { some(n) => some((n, o.pos)), none => none } } else none
}

// Why an item did not parse at `pos`: the collecting pass, for a trace.
fn explain_item(c: Compiled, site: Int, source: Bytes, toks: List[tree.Token], num: List[Int], pos: Int) -> String = {
  var out: List[tree.Node] = []
  var exp: List[Int] = []
  var far: Cell = far_cell()
  let _ = parse_rule(c, num, out, exp, far, fresh(true), body_of(c, site), pos)
  format_failure(failure_at(c, source, toks, far_of(far), exp))
}

// How much of the tree the parser had to give up on.
// The number a recovered range answers to, for a reader that wants to count or
// exclude them without knowing how the engine spells it.
fn error_kind(c: Compiled) -> Int = c.extra + X_ERROR

fn error_nodes(n: tree.Node, error: Int) -> Int = {
  var total = if n.kind == error then 1 else 0
  for k in n.kids { total = total + error_nodes(k, error) }
  total
}

// ── constructors, so a grammar reads like a grammar ──────────────────────
fn tok(k: String) -> Rule = Tok(k)
fn lit(t: String) -> Rule = Lit(t)
fn keep(t: String) -> Rule = Keep(t)
fn r(name: String) -> Rule = Ref(name)
fn seq(xs: List[Rule]) -> Rule = Seq(xs)
fn alt(xs: List[Rule]) -> Rule = Alt(xs)
fn rep(x: Rule) -> Rule = Rep(x)
fn rep1(x: Rule) -> Rule = Rep1(x)
fn opt(x: Rule) -> Rule = Opt(x)
fn wrap(kind: String, x: Rule) -> Rule = Wrap(kind, x)
fn field(name: String, x: Rule) -> Rule = Field(name, x)
fn nott(x: Rule) -> Rule = Not(x)
fn ahead(x: Rule) -> Rule = Ahead(x)
fn any() -> Rule = Any
fn leftf(kind: String, operand: Rule, op: Rule) -> Rule = Left(kind, operand, op)
// A ladder of left-associative levels in one rule, lowest precedence first.
// `prec("binary", r("factor"), [keep("|"), …, keeps(["*", "/"])])` is what six
// nested `leftf`s say, and the engine reaches the operand without walking a
// rule per level. Each level's operator has to be a literal terminal.
fn prec(kind: String, operand: Rule, levels: List[Rule]) -> Rule = Prec(kind, operand, levels)
// `needs(lits([…]))` in front of an alternation whose every branch wants one of
// those spellings somewhere on the line. It consumes nothing and decides
// nothing; it only refuses early, so the branches are not each parsed to the
// same conclusion. The set has to be a necessary condition for all of them.
fn needs(what: Rule) -> Rule = Needs(what)
// `wrap` that keeps quiet about a single child. A precedence level, a suffix
// chain or a conditional with nothing optional taken is the thing it wrapped,
// and a reader that has to walk past four such nodes to reach a name is
// walking four nodes that say nothing.
fn nest(kind: String, rule: Rule) -> Rule = Nest(kind, rule)
// An item in a list that a reader would rather skip than lose the list over.
// `recover` is for a list inside brackets, `recover_all` for the file itself.
// The `_keeping` forms name a prefix of the item worth having on its own: a
// declaration whose signature is half-typed still has a name, and an outline
// that names it is the whole point of reading a file mid-edit.
fn nothing() -> Rule = Alt([])
fn recover_lines(x: Rule) -> Rule = RecoverLines(x)
fn recover(x: Rule) -> Rule = Recover(x, nothing())
fn recover_all(x: Rule) -> Rule = RecoverAll(x, nothing())
fn recover_keeping(x: Rule, head: Rule) -> Rule = Recover(x, head)
fn recover_all_keeping(x: Rule, head: Rule) -> Rule = RecoverAll(x, head)
fn lits(ts: List[String]) -> Rule = Alt(list.map(ts, (t) => Lit(t)))
fn keeps(ts: List[String]) -> Rule = Alt(list.map(ts, (t) => Keep(t)))
// `a, b, c` with an optional trailing comma
fn comma_list(x: Rule) -> Rule = opt(seq([x, rep(seq([lit(","), x])), opt(lit(","))]))

fn grammar(start: String, rules: List[(String, Rule)]) -> Grammar = {
  var m: Map[String, Rule] = [:]
  for (name, rule) in rules { map.insert(m, name, rule) }
  Grammar { start: start, rules: m }
}

// ── a grammar small enough to test the engine with ───────────────────────
fn arith() -> Grammar = grammar("expr", [
  ("expr", leftf("binary", r("term"), keeps(["+", "-"]))),
  ("term", leftf("binary", r("atom"), keeps(["*", "/"]))),
  ("atom", alt([tok("integer"), seq([lit("("), r("expr"), lit(")")])])),
])

// A test writes a token stream as its spellings. `src_of` joins them into the
// source those tokens' ranges point into, so the pair behaves like a real lex.
fn src_of(texts: List[String]) -> Bytes = bytes.from_string(list.join(texts, ""))
fn parse_texts(g: Grammar, texts: List[String]) -> Result[Parsed, Failure] = parse(g, src_of(texts), toks_of(texts))
fn toks_of(texts: List[String]) -> List[tree.Token] = {
  var out: List[tree.Token] = []
  var i = 0
  for t in texts {
    let kind = if t == "" then tree.T_EOF else if string.is_digit(t) then tree.T_INTEGER else tree.T_PUNCT
    list.push(out, tree.Token { kind: kind, start: i, end: i + string.len(t), line: 1, col: i + 1 })
    i = i + string.len(t)
  }
  out
}

test "left fold builds ((1 + 2) - 3) and precedence nests * under +" {
  let p = parse_texts(arith(), ["1", "+", "2", "-", "3", ""])!
  assert_eq(tree.sexp(p.root, p.names), "(binary left:(binary left:(integer) operator:(op) right:(integer)) operator:(op) right:(integer))")
  let q = parse_texts(arith(), ["1", "+", "2", "*", "3", ""])!
  assert_eq(tree.sexp(q.root, q.names), "(binary left:(integer) operator:(op) right:(binary left:(integer) operator:(op) right:(integer)))")
}

test "parentheses and a lone atom" {
  let p = parse_texts(arith(), ["(", "1", "+", "2", ")", "*", "3", ""])!
  assert_eq(tree.sexp(p.root, p.names), "(binary left:(binary left:(integer) operator:(op) right:(integer)) operator:(op) right:(integer))")
  let lone = parse_texts(arith(), ["7", ""])!
  assert_eq(tree.sexp(lone.root, lone.names), "(integer)")
}

test "the error names the farthest point and what was expected there" {
  match parse_texts(arith(), ["1", "+", "", ""]) {
    ok(_) => assert(false),
    err(f) => {
      assert_eq(f.col, 3)
      assert(list.contains(f.expected, "integer"))
      assert(list.contains(f.expected, "`(`"))
    },
  }
  match parse_texts(arith(), ["1", "2", ""]) {
    ok(_) => assert(false),
    err(f) => assert_eq(f.col, 2),
  }
}

test "a recovering parse skips what it cannot read and names the rest" {
  // a list of `<integer>;` items, recoverable one item at a time
  let g = grammar("list", [
    ("list", wrap("list", rep(recover_all(seq([r("item"), lit(";")]))))),
    ("item", wrap("item", tok("integer"))),
  ])
  let c = compile(g)
  let spellings = ["1", ";", "!", "!", "2", ";", ""]
  let source = src_of(spellings)
  let toks = toks_of(spellings)
  // strict: the whole thing fails
  match parse_with(c, source, toks) { ok(_) => assert(false), err(_) => () }
  // recovering: both items survive, with one ERROR node over what was skipped
  match parse_recovering(c, source, toks) {
    err(_) => assert(false),
    ok(p) => {
      assert_eq(tree.sexp(p.root, p.names), "(list (item (integer)) (ERROR) (item (integer)))")
      assert_eq(error_nodes(p.root, error_kind(c)), 1)
    },
  }
}

test "a closer the file never gets to is taken as there when recovering" {
  // a block of `<integer>;` items between braces, whose `}` an edit removed
  let g = grammar("file", [
    ("file", wrap("file", rep(recover_all(r("block"))))),
    ("block", wrap("block", seq([lit("{"), rep(recover(seq([r("item"), lit(";")]))), lit("}")]))),
    ("item", wrap("item", tok("integer"))),
  ])
  let c = compile(g)
  let spellings = ["{", "1", ";", "2", ";", ""]
  let source = src_of(spellings)
  let toks = toks_of(spellings)
  // strict: the missing `}` fails the file
  match parse_with(c, source, toks) { ok(_) => assert(false), err(_) => () }
  // recovering: the block closes at the end and keeps both items, no ERROR
  match parse_recovering(c, source, toks) {
    err(_) => assert(false),
    ok(p) => {
      assert_eq(tree.sexp(p.root, p.names), "(file (block (item (integer)) (item (integer))))")
      assert_eq(error_nodes(p.root, error_kind(c)), 0)
    },
  }
}

test "a skip stops at the closer of its own list even past a bracket the item left open" {
  // `1 (` lost its `)` inside the first block: the block's `}` must end the
  // skip, not stand for the `(`, or the resume point is found in the second
  // block and the first swallows it
  let g = grammar("file", [
    ("file", wrap("file", rep(recover_all(r("block"))))),
    ("block", wrap("block", seq([lit("{"), rep(recover(seq([r("item"), lit(";")]))), lit("}")]))),
    ("item", wrap("item", alt([seq([tok("integer"), lit("("), tok("integer"), lit(")")]), tok("integer")]))),
  ])
  let c = compile(g)
  let spellings = ["{", "1", "(", ";", "}", "{", "4", ";", "}", ""]
  let source = src_of(spellings)
  let toks = toks_of(spellings)
  match parse_recovering(c, source, toks) {
    err(_) => assert(false),
    ok(p) => assert_eq(tree.sexp(p.root, p.names), "(file (block (ERROR)) (block (item (integer))))"),
  }
}

test "a closer that pairs with nothing, or inside the list, is one error token and the list reads on" {
  // `)` with no `(` open: the block's list must not end there
  let g = grammar("file", [
    ("file", wrap("file", rep(recover_all(r("block"))))),
    ("block", wrap("block", seq([lit("{"), rep(recover(seq([r("item"), lit(";")]))), lit("}")]))),
    ("item", wrap("item", alt([seq([tok("integer"), lit("("), tok("integer"), lit(")")]), tok("integer")]))),
  ])
  let c = compile(g)
  let stray = ["{", "1", ";", ")", "2", ";", "}", ""]
  match parse_recovering(c, src_of(stray), toks_of(stray)) {
    err(_) => assert(false),
    ok(p) => assert_eq(tree.sexp(p.root, p.names), "(file (block (item (integer)) (ERROR) (item (integer))))"),
  }
  // `1 ( ;` lost its `2` and `)`: the `(` goes under the ERROR node, and the
  // `)` that pairs with it, two items on, is an error token too
  let inside = ["{", "1", "(", ";", "2", ";", ")", "3", ";", "}", ""]
  match parse_recovering(c, src_of(inside), toks_of(inside)) {
    err(_) => assert(false),
    ok(p) => assert_eq(tree.sexp(p.root, p.names), "(file (block (ERROR) (item (integer)) (ERROR) (item (integer))))"),
  }
}

test "a closer the file lacks is taken as there where a closer of another kind pairs outward" {
  // `1 ( 2` lost its `)`; the block's `}` is next, so the `)` is taken as
  // there before it, and nothing goes under an ERROR node
  let g = grammar("file", [
    ("file", wrap("file", rep(recover_all(r("block"))))),
    ("block", wrap("block", seq([lit("{"), rep(recover(seq([r("item"), lit(";")]))), lit("}")]))),
    ("item", wrap("item", alt([seq([tok("integer"), lit("("), tok("integer"), lit(")")]), tok("integer")]))),
  ])
  let c = compile(g)
  let spellings = ["{", "1", "(", "2", ";", "}", ""]
  match parse_with(c, src_of(spellings), toks_of(spellings)) { ok(_) => assert(false), err(_) => () }
  match parse_recovering(c, src_of(spellings), toks_of(spellings)) {
    err(_) => assert(false),
    ok(p) => {
      assert_eq(tree.sexp(p.root, p.names), "(file (block (item (integer) (integer))))")
      assert_eq(error_nodes(p.root, error_kind(c)), 0)
    },
  }
}

test "a closer the file lacks is taken as there where the item failed farthest" {
  // `( <integer> )` items, one of which lost its `)`: the item is read with
  // a `)` taken as there at the `;`, and nothing is given up
  let g = grammar("file", [
    ("file", wrap("file", rep(recover_all(seq([r("item"), lit(";")]))))),
    ("item", wrap("item", seq([lit("("), tok("integer"), lit(")")]))),
  ])
  let c = compile(g)
  let spellings = ["(", "1", ")", ";", "(", "2", ";", "(", "3", ")", ";", ""]
  let source = src_of(spellings)
  let toks = toks_of(spellings)
  match parse_with(c, source, toks) { ok(_) => assert(false), err(_) => () }
  match parse_recovering(c, source, toks) {
    err(_) => assert(false),
    ok(p) => {
      assert_eq(tree.sexp(p.root, p.names), "(file (item (integer)) (item (integer)) (item (integer)))")
      assert_eq(error_nodes(p.root, error_kind(c)), 0)
    },
  }
}

test "a closer the file lacks is taken as there before the body that follows" {
  // `( <integer> ) { … }` items; the first lost its `)`, and its block is read
  let g = grammar("file", [
    ("file", wrap("file", rep(recover_all(r("item"))))),
    ("item", wrap("item", seq([lit("("), tok("integer"), lit(")"), r("block")]))),
    ("block", wrap("block", seq([lit("{"), rep(recover(seq([tok("integer"), lit(";")]))), lit("}")]))),
  ])
  let c = compile(g)
  let spellings = ["(", "1", "{", "2", ";", "}", "(", "3", ")", "{", "}", ""]
  match parse_recovering(c, src_of(spellings), toks_of(spellings)) {
    err(_) => assert(false),
    ok(p) => assert_eq(tree.sexp(p.root, p.names), "(file (item (integer) (block (integer))) (item (integer) (block)))"),
  }
}

// A test's lines as a lexer would give them: each line indented so deep,
// its spellings one space apart
fn indented(lines: List[(Int, List[String])]) -> (Bytes, List[tree.Token]) = {
  var text = ""
  var toks: List[tree.Token] = []
  var line = 1
  for (depth, words) in lines {
    let line_start = string.len(text)
    text = text + string.repeat(" ", depth)
    var first = true
    for w in words {
      if first then first = false else text = text + " "
      let start = string.len(text)
      list.push(toks, tree.Token { kind: if string.is_digit(w) then tree.T_INTEGER else tree.T_PUNCT, start: start, end: start + string.len(w), line: line, col: start - line_start + 1 })
      text = text + w
    }
    text = text + "\n"
    line = line + 1
  }
  list.push(toks, tree.Token { kind: tree.T_EOF, start: string.len(text), end: string.len(text), line: line, col: 1 })
  (bytes.from_string(text), toks)
}

fn nested_blocks() -> Grammar = grammar("file", [
  ("file", wrap("file", rep(recover_all(r("block"))))),
  ("block", wrap("block", seq([lit("{"), rep(recover(r("stmt"))), lit("}")]))),
  ("stmt", alt([r("block"), wrap("item", seq([tok("integer"), lit(";")]))])),
])

test "a closer that begins its line pairs with the bracket indented as it is" {
  // the inner block lost its `}`: the `}` under the outer `{` is the outer
  // one's, and the inner block ends before the line indented as it is
  let (source, toks) = indented([(0, ["{"]), (2, ["{"]), (4, ["1", ";"]), (2, ["2", ";"]), (0, ["}"]), (0, ["{"]), (2, ["3", ";"]), (0, ["}"])])
  let c = compile(nested_blocks())
  match parse_recovering(c, source, toks) {
    err(_) => assert(false),
    ok(p) => {
      assert_eq(tree.sexp(p.root, p.names), "(file (block (block (item (integer))) (item (integer))) (block (item (integer))))")
      assert_eq(error_nodes(p.root, error_kind(c)), 0)
    },
  }
}

test "a read of a file whose brackets do not balance names the one that lost its closer" {
  let (source, toks) = indented([(0, ["{"]), (2, ["{"]), (4, ["1", ";"]), (2, ["2", ";"]), (0, ["}"])])
  match read(compile(nested_blocks()), source, toks) {
    err(_) => assert(false),
    ok((_, failure, gaps)) => {
      assert_eq(gaps, [1])
      match failure {
        none => assert(false),
        some(f) => {
          assert_eq(f.line, 2)
          assert_eq(f.col, 3)
          assert_eq(format_failure(f), "2:3: `{` is never closed")
        },
      }
    },
  }
}

test "a Recover rule that matches leaves no trace of itself in the tree" {
  let g = grammar("list", [
    ("list", wrap("list", rep(recover_all(seq([r("item"), lit(";")]))))),
    ("item", wrap("item", tok("integer"))),
  ])
  let c = compile(g)
  match parse_with(c, src_of(["1", ";", "2", ";", ""]), toks_of(["1", ";", "2", ";", ""])) {
    err(_) => assert(false),
    ok(p) => assert_eq(tree.sexp(p.root, p.names), "(list (item (integer)) (item (integer)))"),
  }
}


test "child drains preserve prefix, nested nodes and sibling order" {
  let prefix = tree.leaf(0, 0)
  let child = tree.node(1, [tree.leaf(2, 2)], 1, 3)
  var out = [prefix]
  assert_eq(list.len(take_from(out, 1)), 0)
  assert_eq(out, [prefix])
  list.push(out, child)
  assert_eq(take_from(out, 1), [child])
  assert_eq(out, [prefix])
  list.push(out, child)
  list.push(out, tree.leaf(3, 3))
  list.push(out, tree.leaf(4, 4))
  assert_eq(take_from(out, 1), [child, tree.leaf(3, 3), tree.leaf(4, 4)])
  assert_eq(out, [prefix])
  assert_eq(take_from(out, 0), [prefix])
  assert_eq(list.len(out), 0)
}
