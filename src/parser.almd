// parser — a grammar is a value; parsing is interpreting it over tokens.
//
// Rules are ordinary Almide data, built with the constructors at the
// bottom of this file and looked up by name in a Grammar. The engine is a
// backtracking parser with ordered choice (a PEG): `alt` tries its
// alternatives in order and commits to the first that matches, `rep` is
// greedy, and a rule either matches at a position or does not. No
// separate generator step, no tables — a grammar is edited and run.
//
// Left recursion is not supported and not needed: expressions are written
// as precedence levels (`sum = product (("+" | "-") product)*`) and the
// binary nodes are folded left after the match, which is what every
// hand-written parser does.
//
// Errors: the parser remembers the FARTHEST token any rule failed at and
// what was expected there. That position is where a human would say the
// syntax breaks, and it is what `check` reports.

import self.tree

type Rule =
  | Tok(String)                 // a token of this kind → leaf node (identifier, integer, …)
  | Lit(String)                 // a token with exactly this text, dropped from the tree
  | Keep(String)                // a token with this text, kept as a leaf (operators in binary nodes)
  | Ref(String)                 // another rule, by name
  | Seq(List[Rule])
  | Alt(List[Rule])
  | Rep(Rule)                   // zero or more
  | Rep1(Rule)                  // one or more
  | Opt(Rule)
  | Wrap(String, Rule)          // wrap what the rule produced in a node of this kind
  | Field(String, Rule)         // name the node(s) the rule produced
  | Not(Rule)                   // negative lookahead, consumes nothing
  | Ahead(Rule)                 // positive lookahead, consumes nothing
  | Left(String, Rule, Rule)    // operand (op operand)* folded left into nodes of this kind
  | Eps

type Grammar = { start: String, rules: Map[String, Rule] }

// ── the compiled grammar ─────────────────────────────────────────────────
//
// A Rule value is what a grammar author writes; the engine runs on a flat
// arena instead. Each node is three integers: a kind, and `a`/`b` whose
// meaning depends on the kind (a child index, a target rule, a range in
// the shared child list). Texts live in a parallel list and are fetched
// only by the nodes that need one. So a node visit copies twelve bytes —
// in the native backend every value read is a copy, and running the engine
// on the Rule tree itself cloned a whole sub-grammar at every reference.
//
// Terminals are interned. `compile` numbers every distinct text a terminal
// asks for and stores that number in the node's `b`, which the other kinds
// leave at zero; `kind_ids` and `text_ids` number the token stream the same
// way once. A terminal match is then an integer compare rather than two
// string compares, and reading a token is reading an Int rather than copying
// a record that owns two strings. The first four numbers are fixed so the
// engine can name the kinds it tests by name.
type Op = { kind: Int, a: Int, b: Int }
type Compiled = { ops: List[Op], texts: List[String], kids: List[Int], start: Int, atoms: Map[String, Int] }

let A_NEWLINE = 0
let A_EOF = 1
let A_STRING = 2
let A_NEG = 3
let SEEDS = ["newline", "eof", "string", "neg"]

let K_EPS = 0
let K_TOK = 1
let K_LIT = 2
let K_KEEP = 3
let K_REF = 4
let K_SEQ = 5
let K_ALT = 6
let K_REP = 7
let K_REP1 = 8
let K_OPT = 9
let K_WRAP = 10
let K_FIELD = 11
let K_NOT = 12
let K_AHEAD = 13
let K_LEFT = 14

// A subtree's share of the arena: ops and texts numbered from `base`, child
// index lists numbered from `kbase`. The subtree's own node is the last op.
type Emitted = { ops: List[Op], texts: List[String], kids: List[Int] }

fn emit(r: Rule, base: Int, kbase: Int) -> Emitted = {
  let (kind, text, subs) = match r {
    Eps => (K_EPS, "", []),
    Tok(k) => (K_TOK, k, []),
    Lit(t) => (K_LIT, t, []),
    Keep(t) => (K_KEEP, t, []),
    Ref(n) => (K_REF, n, []),
    Seq(xs) => (K_SEQ, "", xs),
    Alt(xs) => (K_ALT, "", xs),
    Rep(x) => (K_REP, "", [x]),
    Rep1(x) => (K_REP1, "", [x]),
    Opt(x) => (K_OPT, "", [x]),
    Wrap(k, x) => (K_WRAP, k, [x]),
    Field(f, x) => (K_FIELD, f, [x]),
    Not(x) => (K_NOT, "", [x]),
    Ahead(x) => (K_AHEAD, "", [x]),
    Left(k, x, y) => (K_LEFT, k, [x, y]),
  }
  var ops: List[Op] = []
  var texts: List[String] = []
  var kids: List[Int] = []
  var ids: List[Int] = []
  for s in subs {
    let e = emit(s, base + list.len(ops), kbase + list.len(kids))
    for o in e.ops { list.push(ops, o) }
    for t in e.texts { list.push(texts, t) }
    for k in e.kids { list.push(kids, k) }
    list.push(ids, base + list.len(ops) - 1)
  }
  let op = if kind == K_SEQ or kind == K_ALT then {
    let first = kbase + list.len(kids)
    for id in ids { list.push(kids, id) }
    Op { kind: kind, a: first, b: list.len(ids) }
  } else if kind == K_LEFT then Op { kind: kind, a: list.get(ids, 0) ?? 0, b: list.get(ids, 1) ?? 0 }
  else Op { kind: kind, a: list.get(ids, 0) ?? -1, b: 0 }
  list.push(ops, op)
  list.push(texts, text)
  Emitted { ops: ops, texts: texts, kids: kids }
}

fn compile(g: Grammar) -> Compiled = {
  var ops: List[Op] = []
  var texts: List[String] = []
  var kids: List[Int] = []
  var names: Map[String, Int] = [:]
  for (name, rule) in map.entries(g.rules) {
    let e = emit(rule, list.len(ops), list.len(kids))
    for o in e.ops { list.push(ops, o) }
    for t in e.texts { list.push(texts, t) }
    for k in e.kids { list.push(kids, k) }
    map.insert(names, name, list.len(ops) - 1)
  }
  // the start rule plus eof, then resolve every reference to its target
  let e = emit(Seq([Ref(g.start), Tok("eof")]), list.len(ops), list.len(kids))
  for o in e.ops { list.push(ops, o) }
  for t in e.texts { list.push(texts, t) }
  for k in e.kids { list.push(kids, k) }
  let start = list.len(ops) - 1
  // resolve every reference to its target, and number every terminal's text
  var atoms: Map[String, Int] = [:]
  var next = 0
  for s in SEEDS {
    map.insert(atoms, s, next)
    next = next + 1
  }
  var resolved: List[Op] = []
  var i = 0
  while i < list.len(ops) {
    let op = list.get(ops, i) ?? Op { kind: K_EPS, a: 0, b: 0 }
    let text = list.get(texts, i) ?? ""
    if op.kind == K_REF then {
      let target = map.get(names, text) ?? -1
      list.push(resolved, Op { kind: K_REF, a: target, b: 0 })
    } else if op.kind == K_TOK or op.kind == K_LIT or op.kind == K_KEEP then {
      match map.get(atoms, text) {
        some(_) => (),
        none => {
          map.insert(atoms, text, next)
          next = next + 1
        },
      }
      list.push(resolved, Op { kind: op.kind, a: op.a, b: map.get(atoms, text) ?? -1 })
    } else list.push(resolved, op)
    i = i + 1
  }
  Compiled { ops: resolved, texts: texts, kids: kids, start: start, atoms: atoms }
}

// The token stream, numbered against the grammar's terminals. A token whose
// kind or text the grammar never names gets -1, which no terminal asks for.
fn kind_ids(c: Compiled, toks: List[tree.Token]) -> List[Int] = {
  var out: List[Int] = []
  for t in toks { list.push(out, map.get(c.atoms, t.kind) ?? -1) }
  out
}

fn text_ids(c: Compiled, toks: List[tree.Token]) -> List[Int] = {
  var out: List[Int] = []
  for t in toks { list.push(out, map.get(c.atoms, t.text) ?? -1) }
  out
}

// Parser state, threaded through every rule and returned with each result
// (a plain value; nothing is mutated in place). `far` is the farthest token
// index at which something failed to match; `expected` what was wanted
// there. Both only ever move forward.
//
// `expected` is filled only on the second pass. A parse that succeeds never
// needs it, and keeping the set costs a list append and a linear scan at
// every failed alternative, which is the busiest path in the engine. So the
// first pass runs with `collect: false` and an empty list, and `parse` runs
// the whole thing again with `collect: true` when, and only when, it has an
// error to describe. Measured on 109 Go files: 1.50 s to 1.25 s.
//
// `expected` holds arena node ids, not strings: the state is copied on
// every call, and a list of ints copies for free where strings would not.
type State = { far: Int, expected: List[Int], collect: Bool }

fn fresh(collect: Bool) -> State = State { far: 0, expected: [], collect: collect }

type Hit = { kids: List[tree.Node], pos: Int }
type Out = { hit: Option[Hit], st: State }

type Failure = { line: Int, col: Int, found: String, expected: List[String] }

fn noted(st: State, pos: Int, what: Int) -> State =
  if not st.collect then (if pos > st.far then State { far: pos, expected: [], collect: false } else st)
  else if pos > st.far then State { far: pos, expected: [what], collect: true }
  else if pos == st.far and not list.contains(st.expected, what) then State { far: st.far, expected: st.expected + [what], collect: true }
  else st

fn miss(st: State, pos: Int, what: Int) -> Out = Out { hit: none, st: noted(st, pos, what) }
fn hit(st: State, kids: List[tree.Node], pos: Int) -> Out = Out { hit: some(Hit { kids: kids, pos: pos }), st: st }

fn text_at(c: Compiled, id: Int) -> String = match list.get(c.texts, id) { some(t) => t, none => "" }
fn kid_at(c: Compiled, i: Int) -> Int = match list.get(c.kids, i) { some(k) => k, none => 0 }

// Match arena node `id` at token `pos`.
//
// One self-recursive function on purpose: sequence, choice, repetition and
// the left fold are loops inside it rather than helper functions. The
// native backend passes a list by reference only when the function is not
// part of a mutually recursive group; helpers would make every call copy
// the grammar and the token list, and parsing would go quadratic. For the
// same reason there is no `??` on anything holding `c`: that form makes
// the analysis treat the parameter as escaping.
fn parse_rule(c: Compiled, tk: List[Int], tt: List[Int], st0: State, id: Int, pos: Int) -> Out = {
  let op = match list.get(c.ops, id) { some(o) => o, none => Op { kind: K_EPS, a: 0, b: 0 } }
  if op.kind == K_EPS then hit(st0, [], pos)
  else if op.kind == K_TOK then {
    match list.get(tk, pos) {
      some(k) => if k != op.b then miss(st0, pos, id)
        else if op.b == A_NEWLINE or op.b == A_EOF then hit(st0, [], pos + 1)
        else hit(st0, [tree.leaf(text_at(c, id), pos)], pos + 1),
      none => miss(st0, pos, id),
    }
  }
  else if op.kind == K_LIT or op.kind == K_KEEP then {
    match list.get(tt, pos) {
      some(x) => if x != op.b then miss(st0, pos, id)
        else match list.get(tk, pos) {
          some(k) => if k == A_STRING or k == A_NEG then miss(st0, pos, id)
            else if op.kind == K_LIT then hit(st0, [], pos + 1)
            else hit(st0, [tree.leaf("op", pos)], pos + 1),
          none => miss(st0, pos, id),
        },
      none => miss(st0, pos, id),
    }
  }
  else if op.kind == K_REF then {
    if op.a < 0 then miss(st0, pos, id)
    else parse_rule(c, tk, tt,st0, op.a, pos)
  }
  else if op.kind == K_SEQ then {
    var st = st0
    var p = pos
    var kids: List[tree.Node] = []
    var failed = false
    var i = 0
    while not failed and i < op.b {
      let o = parse_rule(c, tk, tt,st, kid_at(c, op.a + i), p)
      st = o.st
      match o.hit {
        some(h) => { p = h.pos; for k in h.kids { list.push(kids, k) } },
        none => { failed = true },
      }
      i = i + 1
    }
    if failed then Out { hit: none, st: st } else hit(st, kids, p)
  }
  else if op.kind == K_ALT then {
    var st = st0
    var found: Option[Hit] = none
    var done = false
    var i = 0
    while not done and i < op.b {
      let o = parse_rule(c, tk, tt,st, kid_at(c, op.a + i), pos)
      st = o.st
      match o.hit {
        some(h) => { found = some(h); done = true },
        none => (),
      }
      i = i + 1
    }
    Out { hit: found, st: st }
  }
  else if op.kind == K_REP or op.kind == K_REP1 then {
    var st = st0
    var p = pos
    var kids: List[tree.Node] = []
    var count = 0
    var go = true
    while go {
      let o = parse_rule(c, tk, tt,st, op.a, p)
      st = o.st
      match o.hit {
        some(h) => if h.pos == p then { go = false } else { p = h.pos; for k in h.kids { list.push(kids, k) }; count = count + 1 },
        none => { go = false },
      }
    }
    if op.kind == K_REP1 and count == 0 then Out { hit: none, st: st } else hit(st, kids, p)
  }
  else if op.kind == K_OPT then {
    let o = parse_rule(c, tk, tt,st0, op.a, pos)
    match o.hit {
      some(_) => o,
      none => hit(o.st, [], pos),
    }
  }
  else if op.kind == K_WRAP then {
    let o = parse_rule(c, tk, tt,st0, op.a, pos)
    match o.hit {
      some(h) => hit(o.st, [tree.node(text_at(c, id), h.kids, pos, h.pos)], h.pos),
      none => o,
    }
  }
  else if op.kind == K_FIELD then {
    let o = parse_rule(c, tk, tt,st0, op.a, pos)
    match o.hit {
      some(h) => {
        let name = text_at(c, id)
        hit(o.st, list.map(h.kids, (k) => tree.with_field(k, name)), h.pos)
      },
      none => o,
    }
  }
  else if op.kind == K_NOT then match parse_rule(c, tk, tt,st0, op.a, pos).hit {
    some(_) => Out { hit: none, st: st0 },
    none => hit(st0, [], pos),
  }
  else if op.kind == K_AHEAD then match parse_rule(c, tk, tt,st0, op.a, pos).hit {
    some(_) => hit(st0, [], pos),
    none => Out { hit: none, st: st0 },
  }
  else {                                                                 // K_LEFT: a = operand, b = op
    let o = parse_rule(c, tk, tt,st0, op.a, pos)
    match o.hit {
      none => o,
      some(h) => {
        var st = o.st
        var p = h.pos
        var left = h.kids
        var go = true
        while go {
          let oo = parse_rule(c, tk, tt,st, op.b, p)
          st = oo.st
          match oo.hit {
            none => { go = false },
            some(oh) => {
              let rr = parse_rule(c, tk, tt,st, op.a, oh.pos)
              st = rr.st
              match rr.hit {
                none => { go = false },
                some(rh) => {
                  let lhs = list.map(left, (n) => tree.with_field(n, "left"))
                  let opk = list.map(oh.kids, (n) => tree.with_field(n, "operator"))
                  let rhs = list.map(rh.kids, (n) => tree.with_field(n, "right"))
                  left = [tree.node(text_at(c, id), lhs + opk + rhs, pos, rh.pos)]
                  p = rh.pos
                },
              }
            },
          }
        }
        hit(st, left, p)
      },
    }
  }
}

type Parsed = { root: tree.Node, toks: List[tree.Token] }

// What an arena node expected, for the error message.
fn expectation(c: Compiled, id: Int) -> String = {
  let op = match list.get(c.ops, id) { some(o) => o, none => Op { kind: K_EPS, a: 0, b: 0 } }
  let text = text_at(c, id)
  if op.kind == K_TOK then text
  else if op.kind == K_REF then "<missing rule " + text + ">"
  else "`" + text + "`"
}

fn failure_at(c: Compiled, toks: List[tree.Token], st: State) -> Failure = {
  let t = list.get(toks, st.far)
  Failure {
    line: option.map(t, (x) => x.line) ?? 0,
    col: option.map(t, (x) => x.col) ?? 0,
    found: match t { some(x) => if x.kind == "eof" then "end of file" else if x.kind == "newline" then "end of line" else "`" + x.text + "`", none => "end of file" },
    expected: list.map(st.expected, (id) => expectation(c, id)),
  }
}

fn format_failure(f: Failure) -> String = {
  let exp = if list.is_empty(f.expected) then "" else " (expected " + list.join(list.take(list.unique(f.expected), 6), ", ") + ")"
  int.to_string(f.line) + ":" + int.to_string(f.col) + ": unexpected " + f.found + exp
}

// Parse the whole token stream with the grammar's start rule. The start
// rule must consume everything up to `eof`; anything left over is the
// error, reported at the farthest point the grammar reached.
fn parse(g: Grammar, toks: List[tree.Token]) -> Result[Parsed, Failure] = {
  let c = compile(g)
  let tk = kind_ids(c, toks)
  let tt = text_ids(c, toks)
  let o = parse_rule(c, tk, tt, fresh(false), c.start, 0)
  match o.hit {
    some(h) => match list.first(list.filter(h.kids, (k) => k.kind != "eof")) {
      some(root) => ok(Parsed { root: root, toks: toks }),
      none => ok(Parsed { root: tree.node(g.start, [], 0, list.len(toks)), toks: toks }),
    },
    // the run above knows where it failed but not what it wanted there;
    // this second run collects that, and only a file that fails pays for it
    none => err(failure_at(c, toks, parse_rule(c, tk, tt, fresh(true), c.start, 0).st)),
  }
}

// ── constructors, so a grammar reads like a grammar ──────────────────────
fn tok(k: String) -> Rule = Tok(k)
fn lit(t: String) -> Rule = Lit(t)
fn keep(t: String) -> Rule = Keep(t)
fn r(name: String) -> Rule = Ref(name)
fn seq(xs: List[Rule]) -> Rule = Seq(xs)
fn alt(xs: List[Rule]) -> Rule = Alt(xs)
fn rep(x: Rule) -> Rule = Rep(x)
fn rep1(x: Rule) -> Rule = Rep1(x)
fn opt(x: Rule) -> Rule = Opt(x)
fn wrap(kind: String, x: Rule) -> Rule = Wrap(kind, x)
fn field(name: String, x: Rule) -> Rule = Field(name, x)
fn nott(x: Rule) -> Rule = Not(x)
fn ahead(x: Rule) -> Rule = Ahead(x)
fn leftf(kind: String, operand: Rule, op: Rule) -> Rule = Left(kind, operand, op)
fn lits(ts: List[String]) -> Rule = Alt(list.map(ts, (t) => Lit(t)))
fn keeps(ts: List[String]) -> Rule = Alt(list.map(ts, (t) => Keep(t)))
// `a, b, c` with an optional trailing comma
fn comma_list(x: Rule) -> Rule = opt(seq([x, rep(seq([lit(","), x])), opt(lit(","))]))

fn grammar(start: String, rules: List[(String, Rule)]) -> Grammar = {
  var m: Map[String, Rule] = [:]
  for (name, rule) in rules { map.insert(m, name, rule) }
  Grammar { start: start, rules: m }
}

// ── a grammar small enough to test the engine with ───────────────────────
fn arith() -> Grammar = grammar("expr", [
  ("expr", leftf("binary", r("term"), keeps(["+", "-"]))),
  ("term", leftf("binary", r("atom"), keeps(["*", "/"]))),
  ("atom", alt([tok("integer"), seq([lit("("), r("expr"), lit(")")])])),
])

fn toks_of(texts: List[String]) -> List[tree.Token] = {
  var out: List[tree.Token] = []
  var i = 0
  for t in texts {
    let kind = if t == "" then "eof" else if string.is_digit(t) then "integer" else "punct"
    list.push(out, tree.Token { kind: kind, text: t, start: i, end: i + 1, line: 1, col: i + 1 })
    i = i + 1
  }
  out
}

test "left fold builds ((1 + 2) - 3) and precedence nests * under +" {
  let p = parse(arith(), toks_of(["1", "+", "2", "-", "3", ""]))!
  assert_eq(tree.sexp(p.root), "(binary left:(binary left:(integer) operator:(op) right:(integer)) operator:(op) right:(integer))")
  let q = parse(arith(), toks_of(["1", "+", "2", "*", "3", ""]))!
  assert_eq(tree.sexp(q.root), "(binary left:(integer) operator:(op) right:(binary left:(integer) operator:(op) right:(integer)))")
}

test "parentheses and a lone atom" {
  let p = parse(arith(), toks_of(["(", "1", "+", "2", ")", "*", "3", ""]))!
  assert_eq(tree.sexp(p.root), "(binary left:(binary left:(integer) operator:(op) right:(integer)) operator:(op) right:(integer))")
  assert_eq(tree.sexp(parse(arith(), toks_of(["7", ""]))!.root), "(integer)")
}

test "the error names the farthest point and what was expected there" {
  match parse(arith(), toks_of(["1", "+", "", ""])) {
    ok(_) => assert(false),
    err(f) => {
      assert_eq(f.col, 3)
      assert(list.contains(f.expected, "integer"))
      assert(list.contains(f.expected, "`(`"))
    },
  }
  match parse(arith(), toks_of(["1", "2", ""])) {
    ok(_) => assert(false),
    err(f) => assert_eq(f.col, 2),
  }
}
