// Versioned parser output for source readers. Never export a recovered tree
// as complete: readers must choose an explicit fallback instead.
//
// The document is text from the start: each row is rendered where it is
// found (tags.symbol_rows), and this joins them. Nothing here builds a Value.
import self.names as nametable
import self.package_api
import self.tree
import self.tags
import self.lang

fn rows_text(rows: List[tags.SymbolRow]) -> String = list.join(list.map(rows, (r) => r.json), ",")

// One file, compiling its grammar for this call alone; a batch uses
// `document_with` over engines it compiled once (lang.engines_for), which on
// a 700-file tree is the difference between one table decode and 700.
fn document(packages: List[package_api.Definition], path: String, source: String) -> Result[String, String] =
  complete_document(lang.read_source(packages, path, source)!, source)
fn document_with(e: lang.Engines, path: String, source: String) -> Result[String, String] =
  complete_document(lang.read_with(e, path, source)!, source)

fn complete_document(d: lang.Reading, source: String) -> Result[String, String] =
  match d.error { some(e) => err(e), none => {
    let bytes_source = bytes.from_string(source)
    let found = rows(d.parsed.root, d.parsed.toks, bytes_source, d.parsed.names, "", d.sep, d.symbols)
    ok("{\"schema_version\":1,\"complete\":true,\"lang\":${tags.json_string(d.language)},\"total_lines\":${int.to_string(tags.line_count(bytes_source))},\"symbols\":[${rows_text(found)}]}")
  } }

// One module boundary per document, rather than per node in the walk. Not
// `collect`: tree has one, and an unqualified call is not reliably the local one.
fn rows(n: tree.Node, toks: List[tree.Token], source: Bytes, names: nametable.Names, scope: String, sep: String, rules: package_api.SymbolRules) -> List[tags.SymbolRow] =
  tags.symbol_rows(n, toks, source, names, scope, sep, rules)

// Explicit opt-in: a package advertises `symbols-recovered` only when its
// recovery never keeps a partial declaration head.
fn recovered_document(packages: List[package_api.Definition], path: String, source: String) -> Result[String, String] = {
  guard lang.supports(packages, path, "symbols-recovered") else err(path + ": language package does not provide recovered symbols")
  recovered_of(lang.read_source(packages, path, source)!, path, source)
}
fn recovered_document_with(e: lang.Engines, path: String, source: String) -> Result[String, String] = {
  guard lang.supports_in(e, path, "symbols-recovered") else err(path + ": language package does not provide recovered symbols")
  recovered_of(lang.read_with(e, path, source)!, path, source)
}

fn recovered_of(d: lang.Reading, path: String, source: String) -> Result[String, String] = {
  let bytes_source = bytes.from_string(source)
  let ranges = tags.error_ranges(d.parsed.root, d.parsed.toks, bytes_source, d.parsed.names)
  guard option.is_none(d.error) or not list.is_empty(ranges) else err(path + ": recovered parse has no bounded error ranges")
  let found = rows(d.parsed.root, d.parsed.toks, bytes_source, d.parsed.names, "", d.sep, d.symbols)
  let errors = list.map(ranges, (r) => "{\"start\":" + int.to_string(r.start) + ",\"end\":" + int.to_string(r.end)
    + ",\"start_byte\":" + int.to_string(r.start_byte) + ",\"end_byte\":" + int.to_string(r.end_byte) + "}")
  ok("{\"schema_version\":1,\"complete\":" + (if option.is_none(d.error) then "true" else "false")
    + ",\"recovery_policy\":\"error-free-declarations-v1\""
    + ",\"lang\":" + tags.json_string(d.language)
    + ",\"total_lines\":" + int.to_string(tags.line_count(bytes_source))
    + ",\"diagnostic\":" + tags.json_string(d.error ?? "")
    + ",\"errors\":[" + list.join(errors, ",") + "]"
    + ",\"symbols\":[" + rows_text(tags.error_free_rows(found, ranges)) + "]}")
}
