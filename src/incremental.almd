// incremental — a parsed file kept as recover items nested in recover
// items, so that an edit re-reads the smallest item it touched.
//
// The full parse gives a tree whose token indices, byte offsets and lines
// are absolute. Kept that way, an edit near the top of a file moves every
// number after it, which is the whole file again. So the file is cut at its
// recover items — the nodes a `recover` or `recover_all` site read, which
// the parser stamps with that site — and each item (a "unit") keeps only
// its own tokens, in runs between its child units, with every offset
// relative to where the run starts. Nothing in a unit changes when
// something before it does; the running bases are summed on the way out.
//
// `reparse` walks down to the deepest unit that holds the edit whole,
// re-lexes the sibling window there through the first token after it, and
// parses the window with the site's body until it reaches that token. If
// the lexer or the parser disagree with what was there — the token after
// the window came out different, or the items did not end where it starts
// — the answer is `false` and the caller parses the whole file. The
// identity `materialize(reparse(...)) == parse(whole)` is what the tests
// hold, and what a language package's random-edit check holds on real code.
import self.tree
import self.parser
import self.names as nametable
import self.lex

type Edit = { start: Int, old_end: Int, new_end: Int }

// A node standing for a child unit in its parent's subtree: `field` is the
// child's index, and it takes one slot of the parent's own token space.
let PLACEHOLDER = -1

// A run of a unit's own tokens: before its first child, between two, after
// the last. Offsets, lines and columns are relative to where the run
// starts; `size` is the bytes to where the next thing starts, `lines` the
// line breaks in those bytes, `tail` the bytes after the last of them (or
// `size` when there is none).
// `atoms` is, per token, the grammar literal its text spells (-1 for none):
// a retyped token may not become or stop being one.
type Piece = { toks: List[tree.Token], atoms: List[Int], size: Int, lines: Int, tail: Int }

// One recover item. Its own token space is pieces and child slots in
// order: piece 0, child 0, piece 1, child 1, …, the last piece. The
// children's totals are their own fields, read where they stand.
// `id` names the item across edits: an item that is not read again keeps
// it, and one read again alone in place of one keeps it too.
// `node_ids` names the nodes of its own subtree, in preorder, placeholders
// left out: a node an edit does not read again keeps its id, and so does
// one read again that comes out the same kind over the same text.
type Item = {
  id: Int, site: Int, child_site: Int, node: tree.Node, node_ids: List[Int], trace: List[String],
  pieces: List[Piece], kids: List[Item],
  size: Int, lines: Int, tail: Int, toks: Int,
}

type Document = { root: Item, names: nametable.Names, trace: List[String], next_id: Int, next_node: Int }

fn empty_unit() -> Item = Item { id: 0, site: -1, child_site: -1, node: tree.node(0, [], 0, 0), node_ids: [], trace: [], pieces: [], kids: [], size: 0, lines: 0, tail: 0, toks: 0 }

// A unit with room for `count` children and the runs around them, and no
// more: a list grown by pushing keeps up to twice what it holds, and a
// document is some tens of thousands of these.
fn sized_unit(count: Int) -> Item = Item {
  id: 0, site: -1, child_site: -1, node: tree.node(0, [], 0, 0), node_ids: [], trace: [],
  pieces: list.with_capacity(count + 1), kids: list.with_capacity(count),
  size: 0, lines: 0, tail: 0, toks: 0,
}

// A run's and a child's measures, read in place. Each is a function of its
// own with the read as its whole body, so the run or child is borrowed and
// never copied: read inside a loop that assigns, a list element is copied
// out, and a child is its whole subtree. They stood once in integer lists
// beside the runs and children, kept in step by every edit, and those were
// a third of a document's size.
fn piece_size(u: Item, k: Int) -> Int = match list.get(u.pieces, k) { some(p) => p.size, none => 0 }
fn piece_lines(u: Item, k: Int) -> Int = match list.get(u.pieces, k) { some(p) => p.lines, none => 0 }
fn piece_tail(u: Item, k: Int) -> Int = match list.get(u.pieces, k) { some(p) => p.tail, none => 0 }
fn piece_count(u: Item, k: Int) -> Int = match list.get(u.pieces, k) { some(p) => list.len(p.toks), none => 0 }
// the kind and length of run k's first token, or (-1, 0) when it has none
fn piece_head(u: Item, k: Int) -> (Int, Int) = match list.get(u.pieces, k) {
  some(p) => (match list.first(p.toks) { some(t) => (t.kind, t.end - t.start), none => (-1, 0) }),
  none => (-1, 0),
}
fn kid_size(u: Item, k: Int) -> Int = match list.get(u.kids, k) { some(x) => x.size, none => 0 }
fn kid_lines(u: Item, k: Int) -> Int = match list.get(u.kids, k) { some(x) => x.lines, none => 0 }
fn kid_tail(u: Item, k: Int) -> Int = match list.get(u.kids, k) { some(x) => x.tail, none => 0 }
fn kid_toks(u: Item, k: Int) -> Int = match list.get(u.kids, k) { some(x) => x.toks, none => 0 }
fn kid_kind(u: Item, k: Int) -> Int = match list.get(u.kids, k) { some(x) => x.node.kind, none => -1 }
// the site a child was read at: its node's stamp, which `restamp_kid` moves
fn kid_site(u: Item, k: Int, otherwise: Int) -> Int = match list.get(u.kids, k) { some(x) => parser.site_of(x.node), none => otherwise }
// the kind and length of a unit's first token: its first run's first, or,
// when that run is empty, its first child's
// (one function recursing on itself: two calling each other may take their
// arguments by value; and not in tail position, where the call becomes a
// loop over an owned value and the child is copied to own it)
fn head_of(u: Item) -> (Int, Int) = {
  let own = match list.first(u.pieces) { some(p) => (match list.first(p.toks) { some(t) => (t.kind, t.end - t.start), none => (-1, 0) }), none => (-1, 0) }
  if own.0 >= 0 then own else match list.first(u.kids) { some(x) => as_is(head_of(x)), none => (-1, 0) }
}
fn as_is(h: (Int, Int)) -> (Int, Int) = h
fn kid_head(u: Item, k: Int) -> (Int, Int) = match list.get(u.kids, k) { some(x) => head_of(x), none => (-1, 0) }
fn kids_toks(u: Item) -> Int = {
  var n = 0
  for x in u.kids { n = n + x.toks }
  n
}
fn has_kid_kind(u: Item, kind: Int) -> Bool = {
  var found = false
  for x in u.kids { found = found or x.node.kind == kind }
  found
}

fn rebase_token(t: tree.Token, byte: Int, line: Int, col: Int) -> tree.Token =
  tree.Token { kind: t.kind, start: t.start - byte, end: t.end - byte, line: t.line - line + 1, col: if t.line == line then t.col - col + 1 else t.col }

// Where a range of tokens ends: the token at `at`, or the end of the file
// (the EOF token's own position) when `at` is past the last token.
type Pos = { byte: Int, line: Int, col: Int }
fn pos_of(toks: List[tree.Token], at: Int, size: Int) -> Pos = match list.get(toks, at) {
  some(t) => Pos { byte: t.start, line: t.line, col: t.col },
  none => match list.last(toks) { some(e) => Pos { byte: size, line: e.line, col: e.col }, none => Pos { byte: size, line: 1, col: 1 } },
}
fn tail_of(size: Int, lines: Int, end: Pos) -> Int = if lines == 0 then size else end.col - 1
// the base after a thing of `size` bytes, `lines` breaks and `tail` bytes after the last
fn after(p: Pos, size: Int, lines: Int, tail: Int) -> Pos =
  Pos { byte: p.byte + size, line: p.line + lines, col: if lines == 0 then p.col + tail else 1 + tail }

// The stamped nodes under `n`, in order, not descending into them: where
// each starts and ends, its site, and the end of the node that holds it.
// Integers only: a child node taken out of the tree would be a copy of its
// subtree, and the nodes near the top of a file hold nearly all of it.
fn find_units(n: tree.Node, mut starts: List[Int], mut ends: List[Int], mut sites: List[Int], mut holders: List[Int]) -> Unit = {
  for k in n.kids {
    let site = parser.site_of(k)
    if site >= 0 then { list.push(starts, k.start); list.push(ends, k.end); list.push(sites, site); list.push(holders, n.end) }
    else { let _ = find_units(k, starts, ends, sites, holders) }
  }
  ()
}
// The child units of `u`, built where the walk meets their nodes, so each
// node is read in place; `u.kids` holds how many are built so far.
fn build_kids(mut c: parser.Compiled, n: tree.Node, toks: List[tree.Token], source: Bytes, c_start: List[Int], c_end: List[Int], mut u: Item, mut ids: List[Int]) -> Unit = {
  for k in n.kids {
    let site = parser.site_of(k)
    if site >= 0 then { let _ = add_kid(c, k, site, toks, source, c_start, c_end, u, ids) }
    else { let _ = build_kids(c, k, toks, source, c_start, c_end, u, ids) }
  }
  ()
}
// Its own function: in a branch inside a loop, the backend copies a value
// used more than once instead of moving it at its last use, and the child
// unit is the whole subtree below it.
fn add_kid(mut c: parser.Compiled, k: tree.Node, site: Int, toks: List[tree.Token], source: Bytes, c_start: List[Int], c_end: List[Int], mut u: Item, mut ids: List[Int]) -> Unit = {
  let at = list.len(u.kids)
  let cs = list.get(c_start, at) ?? 0
  let ce = list.get(c_end, at) ?? 0
  let head = match list.get(toks, cs) { some(t) => Pos { byte: t.start, line: t.line, col: t.col }, none => Pos { byte: 0, line: 1, col: 1 } }
  list.push(u.kids, build(c, k, toks, source, cs, ce, head, site, ids))
  ()
}

// The unit for stamped node `n` over `toks` (coordinates of one slice):
// its tokens are [t_begin, t_end) — the node's, then the separators to the
// next item's head — and it starts at `start` in the slice.
fn build(mut c: parser.Compiled, n: tree.Node, toks: List[tree.Token], source: Bytes, t_begin: Int, t_end: Int, start: Pos, site: Int, mut ids: List[Int]) -> Item = {
  let source_size = bytes.len(source)
  var c_start: List[Int] = []
  var ends: List[Int] = []
  var sites: List[Int] = []
  var holders: List[Int] = []
  let _ = find_units(n, c_start, ends, sites, holders)
  let count = list.len(c_start)
  // each child's tokens extend to the next child's head, or to the first own token after it
  var c_end: List[Int] = list.with_capacity(count)
  var k = 0
  while k < count {
    let ck_end = list.get(ends, k) ?? 0
    // to the separators after it, but never into the next child: a recovered
    // parse can resume on a `;` right after an ERROR item. The next child
    // may sit in another block, with this unit's own tokens between. Nor
    // past the node that holds it: a body whose closer recovery took as
    // there, zero tokens wide, ends right after its last item, and the line
    // break that follows is the enclosing item's.
    let next_start = list.get(c_start, k + 1) ?? t_end
    list.push(c_end, int.max(ck_end, int.min(int.min(own_after(toks, source, ck_end, t_end), next_start), list.get(holders, k) ?? t_end)))
    k = k + 1
  }
  var u = sized_unit(count)
  u.id = list.first(ids) ?? 1
  ids = list.set(ids, 0, u.id + 1)
  u.site = site
  u.child_site = list.first(sites) ?? -1
  // pieces: [t_begin, c_start0), [c_end0, c_start1), …, [c_end_last, t_end)
  var ta = t_begin
  var piece_start = start
  k = 0
  var own_count = 0
  while k <= count {
    let tb = if k < count then list.get(c_start, k) ?? ta else t_end
    if k > 0 then piece_start = pos_of(toks, ta, source_size) else ()
    let end = pos_of(toks, tb, source_size)
    var piece_toks: List[tree.Token] = list.with_capacity(tb - ta)
    var piece_atoms: List[Int] = list.with_capacity(tb - ta)
    var ti = ta
    while ti < tb { match list.get(toks, ti) { some(t) => { list.push(piece_toks, rebase_token(t, piece_start.byte, piece_start.line, piece_start.col)); list.push(piece_atoms, parser.atom_at(c, source, t.start, t.end)) }, none => () }; ti = ti + 1 }
    let size = end.byte - piece_start.byte
    let lines = end.line - piece_start.line
    own_count = own_count + (tb - ta)
    list.push(u.pieces, Piece { toks: piece_toks, atoms: piece_atoms, size: size, lines: lines, tail: tail_of(size, lines, end) })
    if k < count then ta = list.get(c_end, k) ?? ta else ()
    k = k + 1
  }
  // the children, each where its node stands: ids go out in the same
  // order as before, this unit's first and then its children's in turn
  let _ = build_kids(c, n, toks, source, c_start, c_end, u, ids)
  let end = pos_of(toks, t_end, source_size)
  u.size = end.byte - start.byte
  u.lines = end.line - start.line
  u.tail = tail_of(u.size, u.lines, end)
  u.toks = own_count + kids_toks(u)
  u.node = cut(n, t_begin, c_start, c_end, 0)
  // its own nodes named here, after its children's: ids need only be
  // distinct, and `node_ids` reads them back in preorder
  let own_nodes = own_node_count(u.node)
  let first_node = list.get(ids, 1) ?? 1
  var named: List[Int] = list.with_capacity(own_nodes)
  var m = 0
  while m < own_nodes { list.push(named, first_node + m); m = m + 1 }
  u.node_ids = named
  ids = list.set(ids, 1, first_node + own_nodes)
  u
}
fn own_node_count(n: tree.Node) -> Int = if n.kind == PLACEHOLDER then 0 else {
  var total = 1
  for k in n.kids { total = total + own_node_count(k) }
  total
}
// An item's node ends at its last real token; the separators after it —
// line breaks, `;` — were read by the same item rule, and go with the item.
// The first token after them is the parent's own (`}`, the EOF) or the next
// item's head.
fn separator(t: tree.Token, source: Bytes) -> Bool = t.kind == tree.T_NEWLINE or (t.end - t.start == 1 and bytes.get_or(source, t.start, -1) == 59)
fn own_after(toks: List[tree.Token], source: Bytes, from: Int, t_end: Int) -> Int = {
  var t = from
  while t < t_end and (match list.get(toks, t) { some(tok) => separator(tok, source), none => false }) { t = t + 1 }
  t
}
// `n` rewritten into own token space: children collapse to one slot each
fn own_index(t: Int, t_begin: Int, c_start: List[Int], c_end: List[Int]) -> Int = {
  var shrink = 0
  var k = 0
  while k < list.len(c_end) {
    let ce = list.get(c_end, k) ?? 0
    if ce <= t then shrink = shrink + (ce - (list.get(c_start, k) ?? 0)) - 1 else ()
    k = k + 1
  }
  t - t_begin - shrink
}
fn cut(n: tree.Node, t_begin: Int, c_start: List[Int], c_end: List[Int], depth: Int) -> tree.Node =
  cut_preorder(n, t_begin, c_start, c_end, 0, 0).0

// Child units meet the walk in the same preorder as find_units and
// build_kids, including empty children with the same token start. Pass
// the cursor through ordinary wrappers instead of searching by position.
// A placeholder's slot counts only children already collapsed: later
// empty children at the same position must not move this child's slot.
// Parent bounds still use own_index, whose endpoint convention expand
// reverses. The helper returns scalars beside the newly built node.
fn cut_preorder(n: tree.Node, t_begin: Int, c_start: List[Int], c_end: List[Int], next: Int, shrink: Int) -> (tree.Node, Int, Int) = {
  var kids: List[tree.Node] = list.with_capacity(list.len(n.kids))
  var at = next
  var removed = shrink
  for k in n.kids {
    if parser.site_of(k) >= 0 then {
      let cs = list.get(c_start, at) ?? k.start
      let ce = list.get(c_end, at) ?? k.end
      let slot = cs - t_begin - removed
      list.push(kids, tree.Node { kind: PLACEHOLDER, field: at, start: slot, end: slot + 1, kids: [] })
      at = at + 1
      removed = removed + ce - cs - 1
    } else {
      let (child, after, collapsed) = cut_preorder(k, t_begin, c_start, c_end, at, removed)
      list.push(kids, child)
      at = after
      removed = collapsed
    }
  }
  let node = tree.Node { kind: n.kind, field: n.field, start: own_index(n.start, t_begin, c_start, c_end), end: own_index(n.end, t_begin, c_start, c_end), kids: kids }
  (node, at, removed)
}

// The document of a whole-file parse. The root unit is the file: its own
// tokens are what lies before the first item and the EOF after the last.
fn from_parsed(p: parser.Parsed, source: Bytes, mut c: parser.Compiled) -> Document = numbered_from(p, source, c, 1, 1)
// `ids` counts on: the next item id, then the next node id
fn numbered_from(p: parser.Parsed, source: Bytes, mut c: parser.Compiled, first_id: Int, first_node: Int) -> Document = {
  var ids = [first_id, first_node]
  let root = build(c, p.root, p.toks, source, 0, list.len(p.toks), Pos { byte: 0, line: 1, col: 1 }, -1, ids)
  Document { root: root, names: p.names, trace: [], next_id: list.first(ids) ?? first_id, next_node: list.get(ids, 1) ?? first_node }
}
// The document of a whole parse taken after `edit`, when the edit could
// not be read into `old`: ids go on from where `old`'s stopped, so none
// is given twice, and a node the edit left alone keeps its id as it
// would have (`left_alone`). The items are all new.
fn rebuilt(old: Document, p: parser.Parsed, source: Bytes, mut c: parser.Compiled, edit: Edit) -> Document = {
  let base = Pos { byte: 0, line: 1, col: 1 }
  var left = indexed_left_spans(unit_spans(old.root, base), edit, SPAN_BUCKETS)
  var doc = numbered_from(p, source, c, old.next_id, old.next_node)
  let taken = indexed_taken_spans(unit_spans(doc.root, base), left, edit)
  let _ = rename_unit(doc.root, taken)
  doc
}

// ── node ids ─────────────────────────────────────────────────────────────
// Every node's id, in preorder of the tree `materialize` gives: the i-th
// is the id of the i-th node that a preorder walk of that tree meets.
fn node_ids(doc: Document) -> List[Int] = {
  var out: List[Int] = []
  let _ = ids_of_unit(doc.root, out)
  out
}
fn ids_of_unit(u: Item, mut out: List[Int]) -> Unit = {
  let _ = ids_walk(u.node, u, 0, out)
  ()
}
fn ids_walk(n: tree.Node, u: Item, k: Int, mut out: List[Int]) -> Int = {
  if n.kind == PLACEHOLDER then { let _ = ids_of_kid(u, n.field, out); k }
  else {
    list.push(out, list.get(u.node_ids, k) ?? -1)
    var at = k + 1
    for m in n.kids { at = ids_walk(m, u, at, out) }
    at
  }
}
fn ids_of_kid(u: Item, k: Int, mut out: List[Int]) -> Unit = match list.get(u.kids, k) { some(x) => ids_of_unit(x, out), none => () }

// The document's nodes as JSON, in preorder, each with its id, kind, byte
// span and depth; `kept` counts the ids that were among `ids_before`.
fn nodes_json(doc: Document, ids_before: List[Int]) -> String = {
  let tree_now = materialize(doc)
  let ids = node_ids(doc)
  var rows: List[String] = []
  let _ = json_walk(tree_now.root, tree_now.toks, ids, doc.names, 0, 0, rows)
  var olds: Map[Int, Int] = map.new()
  for id in ids_before { map.insert(olds, id, 1) }
  var kept = 0
  for id in ids { kept = kept + (if map.contains(olds, id) then 1 else 0) }
  "{\"schema_version\":1,\"nodes\":[" + list.join(rows, ",") + "],\"kept\":" + int.to_string(kept) + ",\"new\":" + int.to_string(list.len(ids) - kept) + "}"
}
fn json_walk(n: tree.Node, toks: List[tree.Token], ids: List[Int], names: nametable.Names, depth: Int, k: Int, mut rows: List[String]) -> Int = {
  let start = byte_at(toks, n.start)
  let end = if n.end > n.start then (match list.get(toks, n.end - 1) { some(t) => t.end, none => start }) else start
  list.push(rows, "{\"id\":" + int.to_string(list.get(ids, k) ?? -1) + ",\"kind\":\"" + nametable.name_at(names, n.kind) + "\",\"start_byte\":" + int.to_string(start) + ",\"end_byte\":" + int.to_string(end) + ",\"depth\":" + int.to_string(depth) + "}")
  var at = k + 1
  for m in n.kids { at = json_walk(m, toks, ids, names, depth + 1, at, rows) }
  at
}

// Each node of unit `x`, standing at `p`: kind, first byte, end byte and
// id, four numbers a node, in preorder.
// Only recover-item bounds are summarized ahead of the walk. Looking up
// each child's first and last tokens recursively at every parent would
// rescan long chains of recover items; this flat reverse-postorder index visits
// each item once, without building tokens or an expanded syntax tree.
// `nodes` is -1 when an item's placeholders disagree with child order.
// In that case emit's ordinal child walk and ids_walk's field-based walk
// must remain paired by the original emitted-span path for the whole unit.
type SpanBounds = { first: Int, last: Int, before: Int, nodes: Int }
type SpanKid = { byte: Int, slot: Int, bound: Int }
type SpanPlaces = { starts: List[Int], ends: List[Int], counts: List[Int], kids: List[SpanKid] }
fn span_slot_order(n: tree.Node, next: Int) -> Int = {
  if n.kind == PLACEHOLDER then (if n.field == next then next + 1 else -1)
  else {
    var at = next
    for child in n.kids {
      if at >= 0 then at = span_slot_order(child, at) else ()
    }
    at
  }
}
fn span_bounds(u: Item, base: Int, mut bounds: List[SpanBounds]) -> Int = {
  let before = list.len(bounds)
  var first = 0
  var last = 0
  var tokens = 0
  var nodes = if span_slot_order(u.node, 0) == list.len(u.kids) then list.len(u.node_ids) else -1
  var byte = base + u.size
  var k = list.len(u.pieces) - 1
  // Right to left, children before their parent: only pushes, no indexed
  // list replacement (which copies a list in the current backend).
  while k >= 0 {
    match list.get(u.kids, k) {
      some(kid) => {
        byte = byte - kid.size
        let child = span_bounds(kid, byte, bounds)
        match list.get(bounds, child) {
          some(b) => {
            if kid.toks > 0 then {
              if tokens == 0 then last = b.last else ()
              first = b.first
              tokens = tokens + kid.toks
            } else ()
            nodes = if nodes < 0 or b.nodes < 0 then -1 else nodes + b.nodes
          },
          none => (),
        }
      },
      none => (),
    }
    byte = byte - piece_size(u, k)
    let run = piece_span_bounds(u, k, byte)
    if run.2 > 0 then {
      if tokens == 0 then last = run.1 else ()
      first = run.0
      tokens = tokens + run.2
    } else ()
    k = k - 1
  }
  list.push(bounds, SpanBounds { first: first, last: last, before: before, nodes: nodes })
  list.len(bounds) - 1
}
fn piece_span_bounds(u: Item, k: Int, byte: Int) -> (Int, Int, Int) = match list.get(u.pieces, k) {
  some(p) => (match list.first(p.toks) {
    some(first) => (byte + first.start, match list.last(p.toks) { some(last) => byte + last.end, none => byte + first.end }, list.len(p.toks)),
    none => (0, 0, 0),
  }),
  none => (0, 0, 0),
}
// A compressed child slot denotes all of its tokens, which can be empty.
// Counts distinguish a genuinely empty expanded node from one spanning a
// zero-token slot. Starts skip such slots to the next real token. Ends
// use the last token, never the child's byte size (which includes trivia).
// `next` is the following token's start in the WHOLE measured unit, or
// that unit's last token end: an empty nested node can see its parent's
// next token, exactly as byte_at does after emit.
fn span_places(u: Item, byte: Int, bounds: List[SpanBounds], index: Int, next: Int) -> SpanPlaces = {
  let places = u.toks - kids_toks(u) + list.len(u.kids)
  var starts: List[Int] = list.with_capacity(places + 1)
  var ends: List[Int] = list.with_capacity(places)
  var counts: List[Int] = list.with_capacity(places + 1)
  var kids: List[SpanKid] = list.with_capacity(list.len(u.kids))
  var at = byte
  var tokens = 0
  var last = 0
  var child = index - 1
  var k = 0
  while k < list.len(u.pieces) {
    match list.get(u.pieces, k) {
      some(piece) => {
        for t in piece.toks {
          // Any preceding tokenless child slots see this same next token.
          while list.len(starts) < list.len(ends) { list.push(starts, at + t.start) }
          list.push(starts, at + t.start)
          list.push(ends, at + t.end)
          list.push(counts, tokens)
          tokens = tokens + 1
          last = at + t.end
        }
        at = at + piece.size
      },
      none => (),
    }
    if k < list.len(u.kids) then {
      list.push(kids, SpanKid { byte: at, slot: list.len(ends), bound: child })
      list.push(counts, tokens)
      match list.get(bounds, child) {
        some(b) => {
          if kid_toks(u, k) > 0 then {
            while list.len(starts) < list.len(ends) { list.push(starts, b.first) }
            list.push(starts, b.first)
            last = b.last
          } else ()
          child = b.before - 1
        },
        none => (),
      }
      list.push(ends, last)
      tokens = tokens + kid_toks(u, k)
      at = at + kid_size(u, k)
    } else ()
    k = k + 1
  }
  while list.len(starts) <= list.len(ends) { list.push(starts, next) }
  list.push(counts, tokens)
  SpanPlaces { starts: starts, ends: ends, counts: counts, kids: kids }
}
fn direct_spans_walk(n: tree.Node, u: Item, places: SpanPlaces, bounds: List[SpanBounds], fallback: Int, k: Int, mut out: List[Int]) -> Int = {
  if n.kind == PLACEHOLDER then {
    match list.get(places.kids, n.field) {
      some(p) => {
        let next = list.get(places.starts, p.slot + 1) ?? fallback
        let _ = direct_kid_spans(u, n.field, p.byte, p.bound, next, bounds, fallback, out)
      },
      none => (),
    }
    k
  } else {
    let start = list.get(places.starts, n.start) ?? fallback
    let begin = list.get(places.counts, n.start) ?? n.start
    let finish = list.get(places.counts, n.end) ?? n.end
    let end = if finish > begin then list.get(places.ends, n.end - 1) ?? start else start
    list.push(out, n.kind); list.push(out, start); list.push(out, end); list.push(out, list.get(u.node_ids, k) ?? -1)
    var at = k + 1
    for m in n.kids { at = direct_spans_walk(m, u, places, bounds, fallback, at, out) }
    at
  }
}
// The list-element read is the function's whole body, so the backend
// borrows the child rather than copying its complete subtree.
fn direct_kid_spans(u: Item, k: Int, byte: Int, index: Int, next: Int, bounds: List[SpanBounds], fallback: Int, mut out: List[Int]) -> Unit = match list.get(u.kids, k) {
  some(kid) => {
    let places = span_places(kid, byte, bounds, index, next)
    let _ = direct_spans_walk(kid.node, kid, places, bounds, fallback, 0, out)
    ()
  },
  none => (),
}
fn unit_spans(x: Item, p: Pos) -> List[Int] = {
  var bounds: List[SpanBounds] = []
  let index = span_bounds(x, p.byte, bounds)
  let fallback = match list.last(bounds) { some(b) => b.last, none => 0 }
  let nodes = match list.last(bounds) { some(b) => b.nodes, none => 0 }
  guard nodes >= 0 else emitted_unit_spans(x, p)
  let places = span_places(x, p.byte, bounds, index, fallback)
  var out: List[Int] = list.with_capacity(nodes * 4)
  let _ = direct_spans_walk(x.node, x, places, bounds, fallback, 0, out)
  out
}
// The former production path is the byte-span oracle and compatibility
// fallback for nonsequential placeholder fields.
fn emitted_unit_spans(x: Item, p: Pos) -> List[Int] = {
  var toks: List[tree.Token] = []
  let n = emit(x, p, 0, toks)
  var ids: List[Int] = []
  let _ = ids_of_unit(x, ids)
  var out: List[Int] = list.with_capacity(list.len(ids) * 4)
  let _ = spans_walk(n, toks, ids, 0, out)
  out
}
fn spans_walk(n: tree.Node, toks: List[tree.Token], ids: List[Int], k: Int, mut out: List[Int]) -> Int = {
  let start = byte_at(toks, n.start)
  let end = if n.end > n.start then (match list.get(toks, n.end - 1) { some(t) => t.end, none => start }) else start
  list.push(out, n.kind); list.push(out, start); list.push(out, end); list.push(out, list.get(ids, k) ?? -1)
  var at = k + 1
  for m in n.kids { at = spans_walk(m, toks, ids, at, out) }
  at
}
fn byte_at(toks: List[tree.Token], i: Int) -> Int = match list.get(toks, i) {
  some(t) => t.start,
  none => (match list.last(toks) { some(t) => t.end, none => 0 }),
}
// Whether a node over bytes `start..end` of the edited text had its text
// changed by `edit`: it overlaps what was typed, or holds the place where
// something was deleted. One that ends where the edit starts, or starts
// where it ends, did not.
fn changed_by(start: Int, end: Int, edit: Edit) -> Bool = (start < edit.new_end and edit.start < end) or (start < edit.start and edit.new_end < end)

// Where each place of a unit's own token space stands, as the unit is now:
// its own tokens, and each child's slot. A slot's end is taken as the
// child's bytes, which run on to the next token: a node that ends with a
// child may look longer than it is, so a node found to hold the edit that
// way is measured again to the child's last token (`slots` says which
// child a place is, -1 for a token of the unit's own).
fn own_places(u: Item, base: Pos, mut starts: List[Int], mut ends: List[Int], mut slots: List[Int]) -> Unit = {
  var p = base
  var k = 0
  while k < list.len(u.pieces) {
    let _ = piece_places(u, k, p.byte, starts, ends, slots)
    p = after(p, piece_size(u, k), piece_lines(u, k), piece_tail(u, k))
    if k < list.len(u.kids) then {
      list.push(starts, p.byte)
      list.push(ends, p.byte + kid_size(u, k))
      list.push(slots, k)
      p = after(p, kid_size(u, k), kid_lines(u, k), kid_tail(u, k))
    } else ()
    k = k + 1
  }
  ()
}
fn piece_places(u: Item, k: Int, at: Int, mut starts: List[Int], mut ends: List[Int], mut slots: List[Int]) -> Unit = match list.get(u.pieces, k) {
  some(p) => { for t in p.toks { list.push(starts, at + t.start); list.push(ends, at + t.end); list.push(slots, -1) } },
  none => (),
}
// The byte a unit standing at `at` ends its last token at: its last run's
// last token, or its last child's, whichever comes later.
fn last_token_end(u: Item, at: Int) -> Int = {
  var b = at
  var last = at
  var last_kid = -1
  var last_kid_at = at
  var k = 0
  while k < list.len(u.pieces) {
    let run_end = piece_last_end(u, k, b)
    if run_end >= 0 then { last = run_end; last_kid = -1 } else ()
    b = b + piece_size(u, k)
    if k < list.len(u.kids) then { last_kid = k; last_kid_at = b; b = b + kid_size(u, k) } else ()
    k = k + 1
  }
  if last_kid >= 0 then kid_last_end(u, last_kid, last_kid_at) else last
}
fn piece_last_end(u: Item, k: Int, at: Int) -> Int = match list.get(u.pieces, k) {
  some(p) => (match list.last(p.toks) { some(t) => at + t.end, none => -1 }),
  none => -1,
}
fn kid_last_end(u: Item, k: Int, at: Int) -> Int = match list.get(u.kids, k) { some(x) => as_is_int(last_token_end(x, at)), none => at }
fn as_is_int(n: Int) -> Int = n
// The own nodes touched in the old text, in preorder. Removing the first
// or last child can shrink a parent's span clear of the edit, so looking
// only at its new span would incorrectly keep that parent's old id.
fn changes_before(u: Item, base: Pos, edit: Edit) -> List[Bool] = {
  var starts: List[Int] = []
  var ends: List[Int] = []
  var slots: List[Int] = []
  let _ = own_places(u, base, starts, ends, slots)
  list.push(starts, base.byte + u.size)
  var changed: List[Bool] = list.with_capacity(list.len(u.node_ids))
  let _ = changes_walk(u.node, u, starts, ends, slots, Edit { ...edit, new_end: edit.old_end }, changed)
  changed
}
fn changes_walk(n: tree.Node, u: Item, starts: List[Int], ends: List[Int], slots: List[Int], edit: Edit, mut out: List[Bool]) -> Unit = {
  if n.kind == PLACEHOLDER then () else {
    list.push(out, own_changed(n, u, starts, ends, slots, edit))
    for m in n.kids { let _ = changes_walk(m, u, starts, ends, slots, edit, out) }
  }
  ()
}
// The unit's own nodes whose old or new text the edit changed, named from
// `next`; the next number comes back. Replacing children leaves the own
// nodes in the same preorder, even when it changes their token indices.
fn renew_holding(mut u: Item, base: Pos, edit: Edit, before: List[Bool], next: Int) -> Int = {
  // one place per own token and per child, and one past the last
  let places = u.toks - kids_toks(u) + list.len(u.kids) + 1
  var starts: List[Int] = list.with_capacity(places)
  var ends: List[Int] = list.with_capacity(places)
  var slots: List[Int] = list.with_capacity(places)
  let _ = own_places(u, base, starts, ends, slots)
  var ids: List[Int] = list.with_capacity(list.len(u.node_ids))
  // past the last place: where the next token starts, the unit's end
  list.push(starts, base.byte + u.size)
  let (_, after_all) = renew_walk(u.node, u, starts, ends, slots, edit, before, 0, next, ids)
  u.node_ids = ids
  after_all
}
fn renew_walk(n: tree.Node, u: Item, starts: List[Int], ends: List[Int], slots: List[Int], edit: Edit, before: List[Bool], k: Int, next: Int, mut out: List[Int]) -> (Int, Int) = {
  if n.kind == PLACEHOLDER then (k, next)
  else {
    let changed = (list.get(before, k) ?? false) or own_changed(n, u, starts, ends, slots, edit)
    list.push(out, if changed then next else list.get(u.node_ids, k) ?? next)
    var at = (k + 1, if changed then next + 1 else next)
    for m in n.kids { at = renew_walk(m, u, starts, ends, slots, edit, before, at.0, at.1, out) }
    at
  }
}
fn own_changed(n: tree.Node, u: Item, starts: List[Int], ends: List[Int], slots: List[Int], edit: Edit) -> Bool = {
  let start = list.get(starts, n.start) ?? (list.last(starts) ?? 0)
  let loose = if n.end > n.start then list.get(ends, n.end - 1) ?? start else start
  guard changed_by(start, loose, edit) else false
  // ending with a child: measured to the child's last token
  let slot = if n.end > n.start then list.get(slots, n.end - 1) ?? -1 else -1
  guard slot >= 0 else true
  changed_by(start, kid_last_end(u, slot, list.get(starts, n.end - 1) ?? start), edit)
}
fn span_key(kind: Int, start: Int, end: Int) -> String = int.to_string(kind) + "@" + int.to_string(start) + "-" + int.to_string(end)

// The nodes of children `i..j`, standing from `p`, that `edit` leaves
// alone, keyed by kind and span as they stand after it: a node none of
// whose bytes the edit replaced, and a span after the edit moves by it. A
// node that ends where the edit starts, or starts where it ends, is left
// alone too: if the fresh parse has a node of its kind over its span, its
// text is the same, and a letter typed onto it gives a longer span. A key
// met again is told apart by how many times it was met before.
fn untouched_before(u: Item, i: Int, j: Int, p: Pos, edit: Edit) -> Map[String, Int] = {
  var keys: Map[String, Int] = map.new()
  var seen: Map[String, Int] = map.new()
  let delta = edit.new_end - edit.old_end
  var at = p
  var k = i
  while k <= j {
    let spans = kid_spans(u, k, at)
    var m = 0
    while m + 3 < list.len(spans) {
      let start = list.get(spans, m + 1) ?? 0
      let end = list.get(spans, m + 2) ?? 0
      if not changed_by(start, end, Edit { start: edit.start, old_end: edit.old_end, new_end: edit.old_end }) then {
        let shift = if end <= edit.start then 0 else delta
        let key = span_key(list.get(spans, m) ?? 0, start + shift, end + shift)
        let n = map.get(seen, key) ?? 0
        map.insert(seen, key, n + 1)
        map.insert(keys, key + "#" + int.to_string(n), list.get(spans, m + 3) ?? -1)
      } else ()
      m = m + 4
    }
    at = after(at, kid_size(u, k), kid_lines(u, k), kid_tail(u, k))
    if k < j then at = after(at, piece_size(u, k + 1), piece_lines(u, k + 1), piece_tail(u, k + 1)) else ()
    k = k + 1
  }
  keys
}
fn kid_spans(u: Item, k: Int, p: Pos) -> List[Int] = match list.get(u.kids, k) { some(x) => unit_spans(x, p), none => [] }

// The fresh children `at..at + count`, standing from `p`: each node the
// edit left alone that matches one of `before` takes its id. What comes
// back maps a fresh id to the id it takes.
fn matched_ids(u: Item, at: Int, count: Int, p: Pos, edit: Edit, before: Map[String, Int]) -> Map[Int, Int] = {
  var taken: Map[Int, Int] = map.new()
  var seen: Map[String, Int] = map.new()
  var pos = p
  var k = at
  while k < at + count {
    let spans = kid_spans(u, k, pos)
    var m = 0
    while m + 3 < list.len(spans) {
      let start = list.get(spans, m + 1) ?? 0
      let end = list.get(spans, m + 2) ?? 0
      if not changed_by(start, end, edit) then {
        let key = span_key(list.get(spans, m) ?? 0, start, end)
        let n = map.get(seen, key) ?? 0
        map.insert(seen, key, n + 1)
        match map.get(before, key + "#" + int.to_string(n)) { some(old) => map.insert(taken, list.get(spans, m + 3) ?? -1, old), none => () }
      } else ()
      m = m + 4
    }
    pos = after(pos, kid_size(u, k), kid_lines(u, k), kid_tail(u, k))
    if k + 1 < at + count then pos = after(pos, piece_size(u, k + 1), piece_lines(u, k + 1), piece_tail(u, k + 1)) else ()
    k = k + 1
  }
  taken
}

// The rule on whole trees. `left_alone`: the nodes of a tree the edit
// left alone, keyed by kind and span as they stand after it (a span after
// the edit moves by it; a key met again is told apart by how often it was
// met before). `taken_from`: the ids of a tree after the edit that are
// such a node's, mapped to the id they take.
fn left_alone(tree_before: parser.Parsed, ids: List[Int], edit: Edit) -> Map[String, Int] = {
  var spans: List[Int] = []
  let _ = spans_walk(tree_before.root, tree_before.toks, ids, 0, spans)
  left_spans(spans, edit)
}
fn left_spans(spans: List[Int], edit: Edit) -> Map[String, Int] = {
  let as_before = Edit { start: edit.start, old_end: edit.old_end, new_end: edit.old_end }
  let delta = edit.new_end - edit.old_end
  var keys: Map[String, Int] = map.new()
  var seen: Map[String, Int] = map.new()
  var m = 0
  while m + 3 < list.len(spans) {
    let start = list.get(spans, m + 1) ?? 0
    let end = list.get(spans, m + 2) ?? 0
    if not changed_by(start, end, as_before) then {
      let shift = if end <= edit.start then 0 else delta
      let key = span_key(list.get(spans, m) ?? 0, start + shift, end + shift)
      let n = map.get(seen, key) ?? 0
      map.insert(seen, key, n + 1)
      map.insert(keys, key + "#" + int.to_string(n), list.get(spans, m + 3) ?? -1)
    } else ()
    m = m + 4
  }
  keys
}
fn taken_from(tree_after: parser.Parsed, ids: List[Int], left: Map[String, Int], edit: Edit) -> Map[Int, Int] = {
  var spans: List[Int] = []
  let _ = spans_walk(tree_after.root, tree_after.toks, ids, 0, spans)
  taken_spans(spans, left, edit)
}
fn taken_spans(spans: List[Int], left: Map[String, Int], edit: Edit) -> Map[Int, Int] = {
  var taken: Map[Int, Int] = map.new()
  var seen: Map[String, Int] = map.new()
  var m = 0
  while m + 3 < list.len(spans) {
    let start = list.get(spans, m + 1) ?? 0
    let end = list.get(spans, m + 2) ?? 0
    if not changed_by(start, end, edit) then {
      let key = span_key(list.get(spans, m) ?? 0, start, end)
      let n = map.get(seen, key) ?? 0
      map.insert(seen, key, n + 1)
      match map.get(left, key + "#" + int.to_string(n)) { some(old) => map.insert(taken, list.get(spans, m + 3) ?? -1, old), none => () }
    } else ()
    m = m + 4
  }
  taken
}

// Production span lookup, with the string helpers above kept independent
// as compatibility APIs and correctness oracles. A hash only chooses a
// bucket: every match compares all three integers, never a packed key.
// Rows are appended in reverse old preorder, making each bucket's chain
// run in old preorder. Removing the first exact triple is therefore the
// same occurrence rule as the string key's #0, #1, ... suffixes. A failed
// fresh lookup removes nothing, including when another key shares its hash.
//
// The immutable row pool has no list.set copies. Only scalar-key maps are
// mutated: bucket heads and, when a non-head row is removed, link overrides.
// At most 64 old rows may share a bucket, counting duplicate keys too.
// Exceeding that bound discards the partial index and uses the original
// string path for the entire operation, before any IDs have been renamed.
// This fallback pays for the partial build plus the original work; it
// bounds numeric collision/duplicate scans rather than changing semantics.
let SPAN_BUCKETS = 1048573
let SPAN_CHAIN_LIMIT = 64
type SpanRow = { kind: Int, start: Int, end: Int, id: Int, next: Int }
type SpanBucket = { head: Int, count: Int }
type SpanIndex = {
  rows: List[SpanRow], buckets: Map[Int, SpanBucket], links: Map[Int, Int],
  legacy: Map[String, Int], overflow: Bool, modulus: Int,
}
fn new_span_index(capacity: Int, buckets: Int) -> SpanIndex = SpanIndex {
  rows: list.with_capacity(capacity), buckets: map.new(), links: map.new(),
  legacy: map.new(), overflow: false, modulus: int.max(1, int.min(SPAN_BUCKETS, buckets)),
}
// Reduce before mixing: even Int's minimum/maximum are safe (no abs,
// negation or unreduced multiplication). The mixed magnitude is less than
// 70 billion. A smaller modulus is useful for forcing collisions in tests.
fn numeric_span_hash(kind: Int, start: Int, end: Int, modulus: Int) -> Int =
  ((kind % modulus) * 65599 + (start % modulus) * 257 + end % modulus) % modulus

fn index_old_span(mut index: SpanIndex, kind: Int, start: Int, end: Int, id: Int) -> Unit = {
  let hash = numeric_span_hash(kind, start, end, index.modulus)
  let bucket = map.get(index.buckets, hash) ?? SpanBucket { head: -1, count: 0 }
  if bucket.count < SPAN_CHAIN_LIMIT then {
    let row = list.len(index.rows)
    list.push(index.rows, SpanRow { kind: kind, start: start, end: end, id: id, next: bucket.head })
    map.insert(index.buckets, hash, SpanBucket { head: row, count: bucket.count + 1 })
  } else index.overflow = true
  ()
}
fn index_old_spans(mut index: SpanIndex, spans: List[Int], edit: Edit) -> Unit = {
  let as_before = Edit { start: edit.start, old_end: edit.old_end, new_end: edit.old_end }
  let delta = edit.new_end - edit.old_end
  // Ignore an incomplete final row, just like left_spans.
  var m = (list.len(spans) / 4) * 4 - 4
  while m >= 0 and not index.overflow {
    let start = list.get(spans, m + 1) ?? 0
    let end = list.get(spans, m + 2) ?? 0
    if not changed_by(start, end, as_before) then {
      let shift = if end <= edit.start then 0 else delta
      let _ = index_old_span(index, list.get(spans, m) ?? 0, start + shift, end + shift, list.get(spans, m + 3) ?? -1)
    } else ()
    m = m - 4
  }
  ()
}
fn discard_span_index(mut index: SpanIndex) -> Unit = {
  let rows: List[SpanRow] = []
  let buckets: Map[Int, SpanBucket] = map.new()
  let links: Map[Int, Int] = map.new()
  index.rows = rows
  index.buckets = buckets
  index.links = links
  ()
}
fn indexed_left_spans(spans: List[Int], edit: Edit, buckets: Int) -> SpanIndex = {
  var index = new_span_index(list.len(spans) / 4, buckets)
  let _ = index_old_spans(index, spans, edit)
  if index.overflow then {
    let _ = discard_span_index(index)
    index.legacy = left_spans(spans, edit)
  } else ()
  index
}
// Pop the oldest remaining occurrence of this exact triple. The immutable
// next link is overridden only if removing a row from inside a bucket.
fn take_indexed_id(mut index: SpanIndex, kind: Int, start: Int, end: Int) -> Option[Int] = {
  let hash = numeric_span_hash(kind, start, end, index.modulus)
  let bucket = map.get(index.buckets, hash) ?? SpanBucket { head: -1, count: 0 }
  var row = bucket.head
  var previous = -1
  var found: Option[Int] = none
  while row >= 0 {
    match list.get(index.rows, row) {
      some(r) => {
        let next = map.get(index.links, row) ?? r.next
        if r.kind == kind and r.start == start and r.end == end then {
          found = some(r.id)
          if previous < 0 then map.insert(index.buckets, hash, SpanBucket { head: next, count: bucket.count })
          else map.insert(index.links, previous, next)
          row = -1
        } else { previous = row; row = next }
      },
      none => { row = -1 },
    }
  }
  found
}
fn index_fresh_spans(spans: List[Int], mut index: SpanIndex, edit: Edit, mut taken: Map[Int, Int]) -> Unit = {
  var m = 0
  while m + 3 < list.len(spans) {
    let start = list.get(spans, m + 1) ?? 0
    let end = list.get(spans, m + 2) ?? 0
    if not changed_by(start, end, edit) then {
      match take_indexed_id(index, list.get(spans, m) ?? 0, start, end) {
        some(old) => map.insert(taken, list.get(spans, m + 3) ?? -1, old),
        none => (),
      }
    } else ()
    m = m + 4
  }
  ()
}
fn indexed_taken_spans(spans: List[Int], mut index: SpanIndex, edit: Edit) -> Map[Int, Int] = {
  if index.overflow then taken_spans(spans, index.legacy, edit) else {
    var taken: Map[Int, Int] = map.new()
    let _ = index_fresh_spans(spans, index, edit, taken)
    taken
  }
}
fn indexed_untouched_before(u: Item, i: Int, j: Int, p: Pos, edit: Edit, buckets: Int) -> SpanIndex = {
  // Only child bases are collected, not another copy of all their spans.
  var bases: List[Pos] = []
  var at = p
  var k = i
  while k <= j {
    list.push(bases, at)
    at = after(at, kid_size(u, k), kid_lines(u, k), kid_tail(u, k))
    if k < j then at = after(at, piece_size(u, k + 1), piece_lines(u, k + 1), piece_tail(u, k + 1)) else ()
    k = k + 1
  }
  var index = new_span_index(0, buckets)
  k = j
  while k >= i and not index.overflow {
    let _ = index_old_spans(index, kid_spans(u, k, list.get(bases, k - i) ?? p), edit)
    k = k - 1
  }
  if index.overflow then {
    let _ = discard_span_index(index)
    index.legacy = untouched_before(u, i, j, p, edit)
  } else ()
  index
}
fn indexed_matched_ids(u: Item, at: Int, count: Int, p: Pos, edit: Edit, mut index: SpanIndex) -> Map[Int, Int] = {
  if index.overflow then matched_ids(u, at, count, p, edit, index.legacy) else {
    var taken: Map[Int, Int] = map.new()
    var pos = p
    var k = at
    while k < at + count {
      let _ = index_fresh_spans(kid_spans(u, k, pos), index, edit, taken)
      pos = after(pos, kid_size(u, k), kid_lines(u, k), kid_tail(u, k))
      if k + 1 < at + count then pos = after(pos, piece_size(u, k + 1), piece_lines(u, k + 1), piece_tail(u, k + 1)) else ()
      k = k + 1
    }
    taken
  }
}

// Children `at..at + count` with their node ids mapped through `taken`.
fn rename_kids(mut u: Item, at: Int, count: Int, taken: Map[Int, Int]) -> Unit = {
  var aside: List[Item] = []
  while list.len(u.kids) > at + count { match list.pop(u.kids) { some(x) => list.push(aside, x), none => () } }
  var fresh: List[Item] = []
  while list.len(u.kids) > at { match list.pop(u.kids) { some(x) => list.push(fresh, x), none => () } }
  while list.len(fresh) > 0 { let _ = rename_next(u, fresh, taken) }
  while list.len(aside) > 0 { match list.pop(aside) { some(x) => list.push(u.kids, x), none => () } }
  ()
}
fn rename_next(mut u: Item, mut fresh: List[Item], taken: Map[Int, Int]) -> Unit = match list.pop(fresh) {
  some(x) => { var kid = x; let _ = rename_unit(kid, taken); list.push(u.kids, kid) },
  none => (),
}
fn rename_unit(mut u: Item, taken: Map[Int, Int]) -> Unit = {
  var ids: List[Int] = list.with_capacity(list.len(u.node_ids))
  for id in u.node_ids { list.push(ids, map.get(taken, id) ?? id) }
  u.node_ids = ids
  let _ = rename_kids(u, 0, list.len(u.kids), taken)
  ()
}

// ── the whole file again ─────────────────────────────────────────────────
// Runs and children are read where they stand (`match list.get`): taken
// out with a fallback, each would be a copy, and a child near the top of a
// file is most of the document.
fn emit(u: Item, base: Pos, tok_base: Int, mut toks: List[tree.Token]) -> tree.Node = {
  // the slot each child sits at, and its tokens
  var slots: List[Int] = []
  var counts: List[Int] = []
  var own = 0
  var acc = tok_base
  var k = 0
  var p = base
  var kid_nodes: List[tree.Node] = []
  while k < list.len(u.pieces) {
    match list.get(u.pieces, k) {
      some(piece) => {
        for t in piece.toks {
          list.push(toks, tree.Token { kind: t.kind, start: t.start + p.byte, end: t.end + p.byte, line: t.line + p.line - 1, col: if t.line == 1 then t.col + p.col - 1 else t.col })
        }
        own = own + list.len(piece.toks)
        acc = acc + list.len(piece.toks)
        p = after(p, piece.size, piece.lines, piece.tail)
      },
      none => (),
    }
    match list.get(u.kids, k) {
      some(kid) => {
        list.push(slots, own)
        list.push(counts, kid.toks)
        list.push(kid_nodes, emit(kid, p, acc, toks))
        own = own + 1
        acc = acc + kid.toks
        p = after(p, kid.size, kid.lines, kid.tail)
      },
      none => (),
    }
    k = k + 1
  }
  // the placeholders meet the children in order, so the first child goes on
  // top and each is moved into place, not copied
  var stack: List[tree.Node] = list.with_capacity(list.len(kid_nodes))
  while list.len(kid_nodes) > 0 { match list.pop(kid_nodes) { some(x) => list.push(stack, x), none => () } }
  expand(u.node, tok_base, slots, counts, stack)
}
fn abs_index(o: Int, tok_base: Int, slots: List[Int], kid_toks: List[Int]) -> Int = {
  var grow = 0
  var k = 0
  while k < list.len(slots) {
    if (list.get(slots, k) ?? 0) < o then grow = grow + (list.get(kid_toks, k) ?? 0) - 1 else ()
    k = k + 1
  }
  tok_base + o + grow
}
// A loop, not `list.map`: a closure over the children's nodes copied them
// for every node it visited.
fn expand(n: tree.Node, tok_base: Int, slots: List[Int], kid_toks: List[Int], mut stack: List[tree.Node]) -> tree.Node =
  if n.kind == PLACEHOLDER then (list.pop(stack) ?? tree.node(0, [], 0, 0))
  else {
    var kids: List[tree.Node] = list.with_capacity(list.len(n.kids))
    for k in n.kids { list.push(kids, expand(k, tok_base, slots, kid_toks, stack)) }
    tree.Node { kind: n.kind, field: n.field, start: abs_index(n.start, tok_base, slots, kid_toks), end: abs_index(n.end, tok_base, slots, kid_toks), kids: kids }
  }

// Every item of the document, in order, with its id, kind and absolute byte range
type ItemRow = { id: Int, kind: Int, depth: Int, start: Int, end: Int }
fn items(doc: Document) -> List[ItemRow] = {
  var out: List[ItemRow] = []
  let _ = list_items(doc.root, Pos { byte: 0, line: 1, col: 1 }, 0, out)
  out
}
fn list_items(u: Item, base: Pos, depth: Int, mut out: List[ItemRow]) -> Unit = {
  if u.site >= 0 then list.push(out, ItemRow { id: u.id, kind: u.node.kind, depth: depth, start: base.byte, end: base.byte + u.size }) else ()
  let bases = kid_bases(u, base)
  // the children borrowed in turn: read out by index, each was a copy of its subtree
  var k = 0
  for kid in u.kids {
    let _ = list_items(kid, list.get(bases, k) ?? base, depth + 1, out)
    k = k + 1
  }
  ()
}

fn materialize(doc: Document) -> parser.Parsed = {
  var toks: List[tree.Token] = list.with_capacity(doc.root.toks)
  let root = emit(doc.root, Pos { byte: 0, line: 1, col: 1 }, 0, toks)
  // the names through a local: stored straight into the record, they take
  // the document by value, and its caller copies it
  let names = doc.names
  parser.Parsed { root: root, toks: toks, names: names }
}

// ── an edit ──────────────────────────────────────────────────────────────
let DONE = 0       // the unit now describes the edited text
let FALLBACK = 1   // parse the whole file
let ME = 2         // the edit is in this unit's own tokens: re-read it at the parent's level
// why a window could not be re-read, for a benchmark's tally; all mean FALLBACK
let NO_LEX = 11
let NO_HEAD = 12
let NO_PARSE = 13
let NO_SITE = 14
let ROOT_OWN = 15
let ERROR_NEAR = 16   // an ERROR item in the same list: recovery is not local, so the whole file is read

// The bases of every child, from the unit's start.
fn kid_bases(u: Item, base: Pos) -> List[Pos] = {
  var out: List[Pos] = []
  var p = base
  var k = 0
  while k < list.len(u.kids) {
    p = after(p, piece_size(u, k), piece_lines(u, k), piece_tail(u, k))
    list.push(out, p)
    p = after(p, kid_size(u, k), kid_lines(u, k), kid_tail(u, k))
    k = k + 1
  }
  out
}

fn retotal(mut u: Item, delta: Int) -> Unit = {
  u.size = u.size + delta
  var lines = 0
  var tail = 0
  var toks = 0
  var k = 0
  while k < list.len(u.pieces) {
    let pl = piece_lines(u, k)
    lines = lines + pl
    tail = if pl > 0 then piece_tail(u, k) else tail + piece_size(u, k)
    toks = toks + piece_count(u, k)
    if k < list.len(u.kids) then {
      let kl = kid_lines(u, k)
      lines = lines + kl
      tail = if kl > 0 then kid_tail(u, k) else tail + kid_size(u, k)
      toks = toks + kid_toks(u, k)
    } else ()
    k = k + 1
  }
  u.lines = lines
  u.tail = tail
  u.toks = toks
  ()
}

// Move kids `to+1..` aside, drop `from..to`, push `fresh` in order, put the rest back.
// the children `from..to` replaced by `fresh`'s; the replaced ones come back, in order
fn splice(mut u: Item, from: Int, to: Int, mut fresh: Item) -> List[Item] = {
  let count = list.len(fresh.kids)
  var aside: List[Item] = []
  while list.len(u.kids) > to + 1 { match list.pop(u.kids) { some(x) => list.push(aside, x), none => () } }
  var popped: List[Item] = []
  while list.len(u.kids) > from { match list.pop(u.kids) { some(x) => list.push(popped, x), none => () } }
  var rev: List[Item] = []
  while list.len(fresh.kids) > 0 { match list.pop(fresh.kids) { some(x) => list.push(rev, x), none => () } }
  while list.len(rev) > 0 { match list.pop(rev) { some(x) => list.push(u.kids, x), none => () } }
  while list.len(aside) > 0 { match list.pop(aside) { some(x) => list.push(u.kids, x), none => () } }
  // one piece before every child and one after the last: the pieces between
  // the replaced children (empty, or the parse would not have reached the
  // token after them) become as many as the new children need
  var aside_p: List[Piece] = []
  while list.len(u.pieces) > to + 2 { match list.pop(u.pieces) { some(x) => list.push(aside_p, x), none => () } }
  let closing = list.pop(u.pieces) ?? Piece { toks: [], atoms: [], size: 0, lines: 0, tail: 0 }
  while list.len(u.pieces) > from + 1 { let _ = list.pop(u.pieces) }
  var m = 1
  while m < count { list.push(u.pieces, Piece { toks: [], atoms: [], size: 0, lines: 0, tail: 0 }); m = m + 1 }
  list.push(u.pieces, closing)
  while list.len(aside_p) > 0 { match list.pop(aside_p) { some(x) => list.push(u.pieces, x), none => () } }
  // the replaced children in order, moved rather than reversed: reversing
  // a list copies it, children and all
  var replaced: List[Item] = list.with_capacity(list.len(popped))
  while list.len(popped) > 0 { match list.pop(popped) { some(x) => list.push(replaced, x), none => () } }
  replaced
}

// The parent's subtree after children `from..to` became `count` children:
// the placeholders in that range are replaced, later ones renumbered, and
// own slots after the range move by the difference.
fn renumber(n: tree.Node, from: Int, to: Int, count: Int, slot_from: Int, slot_delta: Int) -> tree.Node = {
  var kids: List[tree.Node] = list.with_capacity(list.len(n.kids))
  var placed = false
  for k in n.kids {
    if k.kind == PLACEHOLDER and k.field >= from and k.field <= to then {
      if placed then () else {
        var m = 0
        while m < count { list.push(kids, tree.Node { kind: PLACEHOLDER, field: from + m, start: k.start + m, end: k.start + m + 1, kids: [] }); m = m + 1 }
        placed = true
      }
    }
    else if k.kind == PLACEHOLDER and k.field > to then list.push(kids, tree.Node { ...k, field: k.field + count - (to - from + 1), start: k.start + slot_delta, end: k.end + slot_delta })
    else list.push(kids, renumber(k, from, to, count, slot_from, slot_delta))
  }
  tree.Node { kind: n.kind, field: n.field, start: if n.start > slot_from then n.start + slot_delta else n.start, end: if n.end > slot_from then n.end + slot_delta else n.end, kids: kids }
}

// The items of a window, read with `site`'s body one after another until
// the token at `eof_index`; the separators an item rule leaves behind go
// with the item before, as `build` cuts them. A file or block rule may read
// its first item at one recover site and `sep item` at another: the first
// item is stamped with `first_stamp`, the rest with `rest_stamp`, as the
// whole parse would. The flag is false when an item could not be read.
fn read_items(mut c: parser.Compiled, site: Int, first_stamp: Int, rest_stamp: Int, num: List[Int], toks: List[tree.Token], slice: Bytes, from: Int, eof_index: Int) -> (List[tree.Node], Int, Bool) = {
  var numbers = num
  read_items_in_place(c, site, first_stamp, rest_stamp, numbers, toks, slice, from, eof_index)
}
// The window already owns its numbered tokens. Keep that hot path mutable
// while the original entry point continues to accept an immutable list.
fn read_items_in_place(mut c: parser.Compiled, site: Int, first_stamp: Int, rest_stamp: Int, mut num: List[Int], toks: List[tree.Token], slice: Bytes, from: Int, eof_index: Int) -> (List[tree.Node], Int, Bool) = {
  var nodes: List[tree.Node] = []
  var pos = from
  var fine = true
  while fine and pos < eof_index {
    pos = own_after(toks, slice, pos, eof_index)
    if pos < eof_index then {
      match parser.parse_item(c, site, num, pos) {
        some((n, at)) => if at > pos then {
          let stamp = if list.is_empty(nodes) then first_stamp else rest_stamp
          list.push(nodes, item_stamped(n, site, stamp))
          pos = at
        } else { fine = false },
        none => { fine = false },
      }
    } else ()
  }
  (nodes, pos, fine)
}
// Move the parsed node through its stamp change. A record update directly
// in read_items' loop made the backend copy the node's whole subtree.
fn item_stamped(n: tree.Node, site: Int, stamp: Int) -> tree.Node =
  if stamp == site or n.field != 0 - 2 - site then n else tree.Node { ...n, field: 0 - 2 - stamp }
// A sibling window may replace children, but cannot re-read parent-owned
// tokens between them. Removing such a separator also changes the parent's
// token space, which the child-only splice cannot reconstruct safely.
fn window_owns_tokens(u: Item, i: Int, j: Int) -> Bool = {
  var k = i + 1
  var found = false
  while not found and k <= j { found = piece_count(u, k) > 0; k = k + 1 }
  found
}
// The first/last non-layout token of a parent's piece, as a grammar atom.
// Stop at the nearest text token even when it spells no grammar literal.
fn piece_edge_atom(u: Item, at: Int, last: Bool) -> Int = match list.get(u.pieces, at) {
  some(p) => {
    var k = if last then list.len(p.toks) - 1 else 0
    var atom = -1
    var found = false
    while not found and k >= 0 and k < list.len(p.toks) {
      match list.get(p.toks, k) { some(t) => if not is_layout(t) then { atom = list.get(p.atoms, k) ?? -1; found = true } else (), none => () }
      k = k + (if last then -1 else 1)
    }
    atom
  },
  none => -1,
}
fn window_beside_comma(u: Item, i: Int, j: Int, c: parser.Compiled) -> Bool = {
  var compiled = c
  window_beside_comma_in_place(u, i, j, compiled)
}
fn window_beside_comma_in_place(u: Item, i: Int, j: Int, mut c: parser.Compiled) -> Bool = {
  let comma = parser.atom_at(c, bytes.from_string(","), 0, 1)
  comma >= 0 and (piece_edge_atom(u, i, true) == comma or piece_edge_atom(u, j + 1, false) == comma)
}
// Re-read children `i..j` of `u` from `source`, whose bytes for them now
// run from `base.byte` to `new_end`; `next` is the byte where the token
// after them starts, with its kind and length.
fn rewindow(mut u: Item, i: Int, j: Int, base: Pos, new_end: Int, source: Bytes, tokenize: (String, Bool) -> Result[List[tree.Token], lex.LexError], mut c: parser.Compiled, from_start: Bool, skip: Int, mut ids: List[Int], edit: Edit) -> Int = {
  // the token after the window: the first of this unit's own that follow
  // (`}`, `else`, the EOF), or the next child's head when none do
  let own_next = piece_head(u, j + 1)
  let (head_kind, head_len) = if own_next.0 < 0 and j + 1 < list.len(u.kids) then kid_head(u, j + 1) else own_next
  guard head_kind >= 0 else NO_HEAD
  let at_eof = head_kind == tree.T_EOF
  let stop = if at_eof then bytes.len(source) else new_end + head_len
  guard u.child_site >= 0 else NO_SITE
  guard not has_kid_kind(u, parser.error_kind(c)) else ERROR_NEAR
  // Reading a child's rule cannot validate a changed parent prelude (an
  // opening delimiter or package clause). All its old tokens must remain.
  guard not from_start or skip == piece_count(u, 0) else NO_PARSE
  guard not window_owns_tokens(u, i, j) else NO_PARSE
  // The following head is only lookahead, not part of the replaced window.
  // In particular, changing a closing delimiter to another punctuation
  // token cannot be accepted just because its kind and length still match.
  guard edit.start >= base.byte and edit.new_end <= new_end else NO_PARSE
  guard stop <= bytes.len(source) and new_end >= base.byte else { list.push(u.trace, "window out of range: " + int.to_string(base.byte) + ".." + int.to_string(new_end) + "+" + int.to_string(head_len) + " of " + int.to_string(bytes.len(source))); NO_HEAD }
  let slice = bytes.slice(source, base.byte, stop)
  var toks = match lex_in_place(tokenize, source, base.byte, stop) { some(t) => t, none => ([]: List[tree.Token]) }
  guard list.len(toks) >= 2 or (list.len(toks) == 1 and at_eof) else NO_LEX
  let eof = list.pop(toks) ?? tree.Token { kind: tree.T_EOF, start: 0, end: 0, line: 1, col: 1 }
  var head_ok = true
  var head = eof
  if at_eof then () else {
    // a scanner that closes its input with an empty separator (Go's automatic
    // `;`, Almide's line end) puts one after the head: it is the slice's end,
    // not the file's, and is dropped
    var trailing = true
    while trailing and head_len > 0 and list.len(toks) > 1 {
      match list.last(toks) { some(t) => if t.start == t.end then { let _ = list.pop(toks) } else { trailing = false }, none => { trailing = false } }
    }
    head = list.last(toks) ?? eof
    head_ok = head.kind == head_kind and head.start == new_end - base.byte and head.end - head.start == head_len
  }
  guard head_ok else {
    list.push(u.trace, "head expected kind " + int.to_string(head_kind) + " len " + int.to_string(head_len) + " at " + int.to_string(new_end - base.byte) + ", got kind " + int.to_string(head.kind) + " " + int.to_string(head.start) + "-" + int.to_string(head.end) + " in: …" + string.take_end(bytes.to_string_lossy(slice), 120))
    NO_HEAD
  }
  // the head stays in the window, before the EOF, so that an item rule that
  // looks ahead at what follows it (a block's tail expression at `}`) sees it
  list.push(toks, eof)
  let num = parser.number(c, slice, toks)
  let eof_index = if at_eof then list.len(toks) - 1 else list.len(toks) - 2
  // the window's first item stands where child i stood, and takes its site:
  // the one that reads a list's first item, or the one that reads the rest
  let old_site = kid_site(u, i, u.child_site)
  let bare = parser.first_site_of(c, old_site)
  let rest = parser.rest_site_of(c, bare)
  // a window from the unit's start re-lexes the unit's own tokens before
  // its first child (a file's `package` and imports): the edit did not touch
  // them, so they must come out as they were, and the items start after them
  guard prelude_same(toks, u, skip) else { list.push(u.trace, "the tokens before the first item changed"); NO_PARSE }
  let (nodes, pos, fine) = read_items_in_place(c, bare, old_site, rest, num, toks, slice, skip, eof_index)
  // no tokens at all is a window whose items were deleted; tokens that no
  // item took are a failure
  guard fine and pos == eof_index and (eof_index == 0 or not list.is_empty(nodes)) else {
    list.push(u.trace, "no parse at token " + int.to_string(pos) + " of " + int.to_string(eof_index) + ": " + parser.explain_item(c, bare, slice, toks, num, pos) + " in: " + string.take(bytes.to_string_lossy(slice), 600))
    NO_PARSE
  }
  // A window at a child's head can acquire leading trivia. Keep those
  // bytes in the parent's preceding piece, rather than discarding them
  // when the fresh children move out. Leading tokens would change the
  // parent's own parse, which this window did not read: fall back before
  // building anything or consuming ids.
  let leading_tokens = match list.first(nodes) { some(n) => n.start, none => eof_index }
  guard leading_tokens == (if from_start then skip else 0) else NO_PARSE
  // The list's commas belong to its parent, outside the recover bodies.
  // An empty window would orphan one of them: only a parent/whole parse
  // can decide whether that edited list is valid.
  guard not list.is_empty(nodes) or not window_beside_comma_in_place(u, i, j, c) else NO_PARSE
  // the token at `eof_index` is where the window ends: the head that follows
  // it, or the file's EOF; either is excluded from the items and gives their end
  // the window as a unit of its own, then its children moved into `u`
  let holder = tree.Node { kind: 0, field: -1, start: 0, end: eof_index, kids: nodes }
  var fresh = build(c, holder, toks, bytes.slice(slice, 0, new_end - base.byte), 0, eof_index, Pos { byte: 0, line: 1, col: 1 }, -1, ids)
  let count = list.len(fresh.kids)
  // the replaced children's nodes that the edit leaves alone, where child i stands
  let old_p = if from_start then (list.get(kid_bases(u, base), i) ?? base) else base
  var untouched = indexed_untouched_before(u, i, j, old_p, edit, SPAN_BUCKETS)
  // a fresh node that is one of those, the same kind over the same text,
  // keeps that one's id: named in the window, before the children move into
  // `u`, so that only they are moved to be named
  let fresh_p = after(base, piece_size(fresh, 0), piece_lines(fresh, 0), piece_tail(fresh, 0))
  let _ = rename_kids(fresh, 0, count, indexed_matched_ids(fresh, 0, count, fresh_p, edit, untouched))
  let old_slot = slot_of(u, i)
  // a window from the unit's start read the first piece again (i is 0)
  let leading = if from_start then piece_count(fresh, 0) - piece_count(u, 0) else 0
  u.node = renumber(u.node, i, j, count, old_slot, count - (j - i + 1) + leading)
  if from_start then { let _ = replace_first_piece(u, fresh) }
  else if piece_size(fresh, 0) > 0 then { let _ = append_leading_trivia(u, i, fresh) } else ()
  // the children replaced: an item read again that comes out the same
  // (kind, tokens, size) is the same item and keeps its id, and so do the
  // items inside it
  let before = splice(u, i, j, fresh)
  // when the window emptied and child i read a list's first item, the child
  // now at i is that list's first, if it read the rest of one
  if count == 0 and old_site == bare and rest != bare then { let _ = restamp_kid(u, i, bare, rest) } else ()
  let _ = keep_ids(u, i, count, before)
  DONE
}
// The children `at .. at + count` named again from `before`, the children
// they replaced: one replaced by one is the same item whatever came out;
// otherwise a child is the first one left of `before` it equals in kind,
// token count and size. A child named again names its own children the
// same way, from the one it replaced.
fn keep_ids(mut u: Item, at: Int, count: Int, before: List[Item]) -> Unit = {
  var aside: List[Item] = []
  while list.len(u.kids) > at + count { match list.pop(u.kids) { some(x) => list.push(aside, x), none => () } }
  var fresh: List[Item] = []
  while list.len(u.kids) > at { match list.pop(u.kids) { some(x) => list.push(fresh, x), none => () } }
  let alone = count == 1 and list.len(before) == 1
  var m = 0
  while list.len(fresh) > 0 { m = keep_next(u, fresh, before, m, alone) }
  while list.len(aside) > 0 { match list.pop(aside) { some(x) => list.push(u.kids, x), none => () } }
  ()
}
// Read only the three matching measures, with the item borrowed in place.
// A list.get in the changing search loop would copy its whole subtree.
fn item_matches(before: List[Item], at: Int, kind: Int, toks: Int, size: Int) -> Bool = match list.get(before, at) {
  some(b) => b.node.kind == kind and b.toks == toks and b.size == size,
  none => false,
}
fn matching_item(before: List[Item], from: Int, kind: Int, toks: Int, size: Int) -> Int = {
  var at = from
  while at < list.len(before) and not item_matches(before, at, kind, toks, size) { at = at + 1 }
  if at < list.len(before) then at else -1
}
// Pop in original order and hand each owned child to a function of its own:
// the backend can move it, rather than copying it in a loop's branches.
fn keep_next(mut u: Item, mut fresh: List[Item], before: List[Item], from: Int, alone: Bool) -> Int = match list.pop(fresh) {
  some(x) => keep_item(u, x, before, from, alone),
  none => from,
}
fn keep_item(mut u: Item, x: Item, before: List[Item], from: Int, alone: Bool) -> Int = {
  let at = if alone then 0 else matching_item(before, from, x.node.kind, x.toks, x.size)
  list.push(u.kids, adopt_at(x, before, at))
  if at >= 0 then at + 1 else from
}
fn adopt_at(x: Item, before: List[Item], at: Int) -> Item = match list.get(before, at) {
  some(b) => adopt(x, b),
  none => x,
}
// `x` with `b`'s id, its children named from `b`'s
fn adopt(x: Item, b: Item) -> Item = {
  var named = Item { ...x, id: b.id }
  let _ = keep_owned_ids_from(named, b.kids)
  named
}
// The original helper appends the separately supplied fresh children;
// existing children of u and the caller's fresh list must remain intact.
fn keep_ids_from(mut u: Item, fresh_kids: List[Item], before: List[Item]) -> Unit = {
  var m = 0
  for x in fresh_kids { m = keep_item(u, x, before, m, false) }
  ()
}
// Adoption already owns u's children, so move them through the matcher.
fn keep_owned_ids_from(mut u: Item, before: List[Item]) -> Unit = {
  var fresh: List[Item] = []
  while list.len(u.kids) > 0 { match list.pop(u.kids) { some(x) => list.push(fresh, x), none => () } }
  var m = 0
  while list.len(fresh) > 0 { m = keep_next(u, fresh, before, m, false) }
  ()
}
// child `at` stamped with `first` when its stamp is `rest`
fn restamp_kid(mut u: Item, at: Int, first: Int, rest: Int) -> Unit = {
  var aside: List[Item] = []
  while list.len(u.kids) > at + 1 { match list.pop(u.kids) { some(x) => list.push(aside, x), none => () } }
  match list.pop(u.kids) {
    some(x) => list.push(u.kids, if parser.site_of(x.node) == rest then Item { ...x, node: tree.Node { ...x.node, field: 0 - 2 - first } } else x),
    none => (),
  }
  while list.len(aside) > 0 { match list.pop(aside) { some(x) => list.push(u.kids, x), none => () } }
  ()
}
fn replace_first_piece(mut u: Item, fresh: Item) -> Unit = {
  var aside: List[Piece] = []
  while list.len(u.pieces) > 1 { match list.pop(u.pieces) { some(x) => list.push(aside, x), none => () } }
  let _ = list.pop(u.pieces)
  list.push(u.pieces, list.first(fresh.pieces) ?? Piece { toks: [], atoms: [], size: 0, lines: 0, tail: 0 })
  while list.len(aside) > 0 { match list.pop(aside) { some(x) => list.push(u.pieces, x), none => () } }
  ()
}
// The window starts just after piece k. Its leading piece has no tokens,
// so appending its measures moves the first child without changing any
// parent token or node index. The bytes may contain newlines or comments.
fn append_leading_trivia(mut u: Item, k: Int, fresh: Item) -> Unit = {
  let piece = list.get(u.pieces, k) ?? Piece { toks: [], atoms: [], size: 0, lines: 0, tail: 0 }
  let size = piece_size(fresh, 0)
  let lines = piece_lines(fresh, 0)
  put_piece(u, k, Piece { ...piece, size: piece.size + size, lines: piece.lines + lines,
    tail: if lines > 0 then piece_tail(fresh, 0) else piece.tail + size })
}
fn slot_of(u: Item, k: Int) -> Int = {
  var slot = 0
  var m = 0
  while m <= k { slot = slot + piece_count(u, m) + (if m < k then 1 else 0); m = m + 1 }
  slot
}
// run k replaced in place: `list.set` copies the whole list, every run's tokens
fn put_piece(mut u: Item, k: Int, piece: Piece) -> Unit = {
  var aside: List[Piece] = []
  while list.len(u.pieces) > k + 1 { match list.pop(u.pieces) { some(x) => list.push(aside, x), none => () } }
  let _ = list.pop(u.pieces)
  list.push(u.pieces, piece)
  while list.len(aside) > 0 { match list.pop(aside) { some(x) => list.push(u.pieces, x), none => () } }
  ()
}

// An edit inside one of the unit's own runs that touches none of its tokens:
// the run is lexed again and must give the same tokens, kind for kind and
// length for length (a comment closed or opened by the edit gives others,
// or none, and the ordinary path follows); then only the run's sizes and
// its tokens' positions change. DONE, or ME when this does not apply.
fn own_edit(mut u: Item, base: Pos, edit: Edit, source: Bytes, tokenize: (String, Bool) -> Result[List[tree.Token], lex.LexError], mut c: parser.Compiled) -> Int = {
  let (k, start) = run_holding(u, base, edit)
  guard k >= 0 else ME
  let piece = list.get(u.pieces, k) ?? Piece { toks: [], atoms: [], size: 0, lines: 0, tail: 0 }
  // the tokens the edit touches (closed intervals: a letter put right after
  // a name extends it): none, or one that is retyped and spells no literal
  var touched = 0
  var retyped = -1
  var m = 0
  while touched <= 1 and m < list.len(piece.toks) {
    match list.get(piece.toks, m) { some(t) => if not (edit.old_end < start.byte + t.start or edit.start > start.byte + t.end) then { touched = touched + 1; retyped = m } else (), none => () }
    m = m + 1
  }
  guard touched <= 1 else ME
  guard retyped < 0 or (list.get(piece.atoms, retyped) ?? -1) < 0 else ME
  let delta = edit.new_end - edit.old_end
  let size = piece.size + delta
  let stop = start.byte + size
  guard stop <= bytes.len(source) else ME
  // a line comment the edit opens runs to the end of its line, which must
  // lie inside the run (or the run must end the file), so that what it
  // swallows is seen here
  guard stop == bytes.len(source) or breaks_between(source, edit.new_end, stop) > 0 else ME
  // the lines stay as they were: nothing typed or deleted is a line break,
  // and the edit lies after its line's indentation. Then the layout the
  // scanner read (Python's indent and dedent, a line end that separates)
  // is what it was, and the run's layout tokens are kept where they were,
  // moved by the edit; a slice lexed on its own cannot place them
  let before_edit = breaks_between(source, start.byte, edit.start)
  let lines = before_edit + breaks_between(source, edit.start, stop)
  guard lines == piece.lines and breaks_between(source, edit.start, edit.new_end) == 0 and after_indentation(source, edit.start) else ME
  let tail = tail_after(source, start.byte, stop)
  let fresh = match lex_in_place(tokenize, source, start.byte, stop) { some(t) => same_tokens(piece.toks, t, retyped, delta, edit.start - start.byte, 1 + before_edit), none => none }
  match fresh {
    none => ME,
    some(toks) => {
      var atoms: List[Int] = list.with_capacity(list.len(toks))
      var n = 0
      while n < list.len(toks) { match list.get(toks, n) { some(t) => list.push(atoms, parser.atom_at(c, source, start.byte + t.start, start.byte + t.end)), none => () }; n = n + 1 }
      guard retyped < 0 or (list.get(atoms, retyped) ?? -1) < 0 else ME
      let _ = put_piece(u, k, Piece { toks: toks, atoms: atoms, size: size, lines: lines, tail: tail })
      let _ = retotal(u, delta)
      DONE
    },
  }
}
// the line breaks in a run, and the bytes after the last of them (the run's size when there is none)
// The line breaks in `source` from `from` to `to`
fn breaks_between(source: Bytes, from: Int, to: Int) -> Int = {
  var lines = 0
  var i = from
  while i < to { if bytes.get_or(source, i, 0) == 10 then lines = lines + 1 else (); i = i + 1 }
  lines
}
// The bytes of `source` after the last line break in `from`..`to` (all of
// them when there is none)
fn tail_after(source: Bytes, from: Int, to: Int) -> Int = {
  var i = to
  while i > from and bytes.get_or(source, i - 1, 0) != 10 { i = i - 1 }
  to - i
}
// The run of the unit's own bytes holding the whole edit, and where it
// starts; -1 when the edit is not inside one run
fn run_holding(u: Item, base: Pos, edit: Edit) -> (Int, Pos) = {
  var p = base
  var k = 0
  var found = -1
  var start = base
  while found < 0 and k < list.len(u.pieces) {
    let size = piece_size(u, k)
    if edit.start >= p.byte and edit.old_end <= p.byte + size then { found = k; start = p } else ()
    p = after(p, size, piece_lines(u, k), piece_tail(u, k))
    if k < list.len(u.kids) then p = after(p, kid_size(u, k), kid_lines(u, k), kid_tail(u, k)) else ()
    k = k + 1
  }
  (found, start)
}
// true when byte `at` of `source` lies after the blank space that opens its line
fn after_indentation(source: Bytes, at: Int) -> Bool = {
  var i = at - 1
  var blank_only = true
  while blank_only and i >= 0 and bytes.get_or(source, i, 10) != 10 { let b = bytes.get_or(source, i, 0); blank_only = b == 32 or b == 9; i = i - 1 }
  not blank_only
}
// A token that is layout rather than text: a line end (a scanner may give
// it the line break's own length, and may leave it out at its input's end,
// where nothing follows to separate), an indent, a dedent, the EOF.
fn is_layout(t: tree.Token) -> Bool = t.kind == tree.T_NEWLINE or t.kind == tree.T_INDENT or t.kind == tree.T_DEDENT or t.kind == tree.T_EOF or t.end == t.start
// The run's tokens again when the fresh ones are the old ones kind for
// kind and length for length (token `retyped`, when there is one, longer
// by `delta`), compared over the tokens that have text: the layout ones
// are the run's own as they were, moved by `delta` when they stood at or
// after `edit_at` (their column too, on the edit's line).
fn same_tokens(old: List[tree.Token], fresh: List[tree.Token], retyped: Int, delta: Int, edit_at: Int, edit_line: Int) -> Option[List[tree.Token]] = {
  let reals = list.filter(fresh, (t) => not is_layout(t))
  var m = 0
  var fine = true
  var out: List[tree.Token] = list.with_capacity(list.len(old))
  var k = 0
  while fine and k < list.len(old) {
    let o = list.get(old, k) ?? tree.Token { kind: tree.T_EOF, start: 0, end: 0, line: 1, col: 1 }
    if not is_layout(o) then {
      match list.get(reals, m) {
        some(f) => if f.kind == o.kind and o.end - o.start + (if k == retyped then delta else 0) == f.end - f.start then { list.push(out, f); m = m + 1 } else { fine = false },
        none => { fine = false },
      }
    } else {
      let moved = o.start >= edit_at
      list.push(out, if moved then tree.Token { ...o, start: o.start + delta, end: o.end + delta, col: if o.line == edit_line then o.col + delta else o.col } else o)
    }
    k = k + 1
  }
  if fine and m == list.len(reals) then some(out) else none
}
// `source[from, to)` lexed as the line it stands on: the blank space before
// it on its line goes in front, so that a scanner reading layout (Python's
// indentation) sees the slice at its depth, and the tokens come back with
// offsets from `from`. A slice that starts after code on its line is lexed
// as it is. None when the scanner refuses.
fn lex_in_place(tokenize: (String, Bool) -> Result[List[tree.Token], lex.LexError], source: Bytes, from: Int, to: Int) -> Option[List[tree.Token]] = {
  var line_start = from
  while line_start > 0 and bytes.get_or(source, line_start - 1, 10) != 10 { line_start = line_start - 1 }
  var blank = true
  var i = line_start
  while blank and i < from { let b = bytes.get_or(source, i, 0); blank = b == 32 or b == 9; i = i + 1 }
  let lead = if blank then from - line_start else 0
  match tokenize(bytes.to_string_lossy(bytes.slice(source, from - lead, to)), false) {
    err(_) => none,
    ok(t) => some(without_leading_empty(if lead == 0 then t else list.map(list.filter(t, (x) => x.start >= lead), (x) => tree.Token { ...x, start: x.start - lead, end: x.end - lead, col: if x.line == 1 then x.col - lead else x.col }))),
  }
}
// A slice lexed on its own may open with empty tokens that in the file
// belong to what came before it (a layout scanner's `indent` for a line
// deeper than column one): a window or run never starts with one
fn without_leading_empty(toks: List[tree.Token]) -> List[tree.Token] = {
  var n = 0
  while n < list.len(toks) - 1 and (match list.get(toks, n) { some(t) => t.start == t.end, none => false }) { n = n + 1 }
  if n == 0 then toks else list.drop(toks, n)
}
fn same_length(a: Option[tree.Token], b: Option[tree.Token], grown: Int) -> Bool = match (a, b) {
  (some(x), some(y)) => x.kind == y.kind and x.end - x.start + grown == y.end - y.start,
  _ => false,
}
// The children whose bytes hold an edit's start and end, whether the
// window must start where the unit does, and whether the edit lies in the
// unit's own bytes outside every child: (i, j, from_start, outside).
fn locate(u: Item, base: Pos, bases: List[Pos], edit: Edit) -> (Int, Int, Bool, Bool) = {
  let count = list.len(u.kids)
  // the child whose bytes hold the edit's start, and the one holding its end
  var i = -1
  var j = -1
  var k = 0
  while k < count {
    let b = (list.get(bases, k) ?? base).byte
    let e = b + kid_size(u, k)
    if i < 0 and edit.start >= b and edit.start < e then i = k else ()
    if edit.old_end > edit.start and edit.old_end > b and edit.old_end <= e then j = k else ()
    k = k + 1
  }
  // an insertion right after the last child, where nothing but the parent's
  // closing token or the EOF follows, extends that child
  if count > 0 then {
    let last_end = (list.get(bases, count - 1) ?? base).byte + kid_size(u, count - 1)
    if i < 0 and edit.start == last_end then i = count - 1 else ()
    if j < 0 and edit.old_end > edit.start and edit.old_end == last_end then j = count - 1 else ()
  } else ()
  if edit.old_end == edit.start then j = i else ()
  let outside = i < 0 and j < 0
  // at the file's level, what lies before the first item or after the last
  // (a comment, blank lines) is read with that item: the window then starts
  // at the file's start, or runs to its end
  var from_start = false
  if u.site < 0 and count > 0 then {
    let first_base = (list.get(bases, 0) ?? base).byte
    let last_end = (list.get(bases, count - 1) ?? base).byte + kid_size(u, count - 1)
    if i < 0 and edit.start < first_base then { i = 0; from_start = true; if j < 0 then j = 0 else () } else ()
    if i < 0 and edit.start >= last_end then { i = count - 1; j = count - 1 } else ()
    if j < 0 and edit.old_end > last_end then j = count - 1 else ()
  } else ()
  (i, j, from_start, outside)
}
// An edit read into unit `u`, and then its own nodes that hold the edit
// named again: their text changed, whichever way the edit was read.
fn reparse_in(mut u: Item, base: Pos, source: Bytes, edit: Edit, tokenize: (String, Bool) -> Result[List[tree.Token], lex.LexError], mut c: parser.Compiled, mut ids: List[Int]) -> Int = {
  // Insertions cannot remove an old boundary. For deletions/replacements,
  // remember the old spans before reparse_here changes any pieces or kids.
  // This read-only snapshot also leaves a failed reparse untouched.
  let before = if edit.old_end > edit.start then changes_before(u, base, edit) else ([]: List[Bool])
  let status = reparse_here(u, base, source, edit, tokenize, c, ids)
  if status == DONE then {
    ids = list.set(ids, 1, renew_holding(u, base, edit, before, list.get(ids, 1) ?? 1))
    DONE
  } else status
}
fn reparse_here(mut u: Item, base: Pos, source: Bytes, edit: Edit, tokenize: (String, Bool) -> Result[List[tree.Token], lex.LexError], mut c: parser.Compiled, mut ids: List[Int]) -> Int = {
  let delta = edit.new_end - edit.old_end
  let bases = kid_bases(u, base)
  let (i, j, from_start, outside) = locate(u, base, bases, edit)
  // an edit in this unit's own bytes that touches no token (in a comment, in
  // blank space), or retypes one, changes positions and nothing else: no
  // item is read
  let own = if outside then own_edit(u, base, edit, source, tokenize, c) else ME
  if own == DONE then DONE
  else if i < 0 or j < 0 or j < i then ME
  else {
    let head_edit = edit.start == (list.get(bases, i) ?? base).byte
    if from_start then window_from(u, base, 0, j, bases, delta, source, tokenize, c, prelude_untouched(u, base, edit), ids, edit)
    else if i == j and not head_edit then {
      // inside child i: let it try first
      var aside: List[Item] = []
      while list.len(u.kids) > i + 1 { match list.pop(u.kids) { some(x) => list.push(aside, x), none => () } }
      var kid = list.pop(u.kids) ?? empty_unit()
      let status = reparse_in(kid, list.get(bases, i) ?? base, source, edit, tokenize, c, ids)
      while list.len(kid.trace) > 0 { match list.pop(kid.trace) { some(t) => list.push(u.trace, t), none => () } }
      list.push(u.kids, kid)
      while list.len(aside) > 0 { match list.pop(aside) { some(x) => list.push(u.kids, x), none => () } }
      // the child's measures, and its head if it was retyped, are its own
      // fields: nothing here needs setting again but the totals
      if status == DONE then {
        let _ = retotal(u, delta)
        DONE
      }
      else if status == ME then read_window(u, i, i, bases, delta, source, tokenize, c, ids, edit)
      else status
    }
    else {
      // an edit at a child's first byte can join it to the child before,
      // when nothing of this unit's own stands between them
      let adjacent = i > 0 and i < list.len(u.pieces) and piece_count(u, i) == 0
      let from = if head_edit and adjacent then i - 1 else i
      if from_start then window_from(u, base, from, j, bases, delta, source, tokenize, c, prelude_untouched(u, base, edit), ids, edit) else read_window(u, from, j, bases, delta, source, tokenize, c, ids, edit)
    }
  }
}
fn read_window(mut u: Item, i: Int, j: Int, bases: List[Pos], delta: Int, source: Bytes, tokenize: (String, Bool) -> Result[List[tree.Token], lex.LexError], mut c: parser.Compiled, mut ids: List[Int], edit: Edit) -> Int = {
  let base = list.get(bases, i) ?? Pos { byte: 0, line: 1, col: 1 }
  let end = (list.get(bases, j) ?? base).byte + kid_size(u, j) + delta
  let status = rewindow(u, i, j, base, end, source, tokenize, c, false, 0, ids, edit)
  if status == DONE then { let _ = retotal(u, delta); DONE } else status
}
// How many of the unit's own tokens before its first child an edit left
// alone: all of them when it touches none (it fell in a comment or in
// blank space between them), else none — a changed token is a changed
// parse, and the window then has to read them, which only a unit without
// any can.
fn prelude_untouched(u: Item, base: Pos, edit: Edit) -> Int = {
  let piece = list.first(u.pieces) ?? Piece { toks: [], atoms: [], size: 0, lines: 0, tail: 0 }
  if list.all(piece.toks, (t) => edit.old_end < base.byte + t.start or edit.start > base.byte + t.end) then list.len(piece.toks) else 0
}
// the first `skip` tokens of a re-lexed window, kind for kind and length for length, are the unit's own as they were
fn prelude_same(toks: List[tree.Token], u: Item, skip: Int) -> Bool = {
  let piece = list.first(u.pieces) ?? Piece { toks: [], atoms: [], size: 0, lines: 0, tail: 0 }
  var k = 0
  var same_so_far = skip <= list.len(toks)
  while same_so_far and k < skip {
    match (list.get(toks, k), list.get(piece.toks, k)) {
      (some(a), some(b)) => { same_so_far = a.kind == b.kind and a.end - a.start == b.end - b.start },
      _ => { same_so_far = false },
    }
    k = k + 1
  }
  same_so_far
}
// the same, with the window starting where the unit itself starts, so that
// the unit's first piece is read again with the first child
fn window_from(mut u: Item, base: Pos, i: Int, j: Int, bases: List[Pos], delta: Int, source: Bytes, tokenize: (String, Bool) -> Result[List[tree.Token], lex.LexError], mut c: parser.Compiled, skip: Int, mut ids: List[Int], edit: Edit) -> Int = {
  let end = (list.get(bases, j) ?? base).byte + kid_size(u, j) + delta
  let status = rewindow(u, i, j, base, end, source, tokenize, c, true, skip, ids, edit)
  if status == DONE then { let _ = retotal(u, delta); DONE } else status
}

// Re-read what an edit touched. `source` is the text after the edit. True
// when the document now describes `source`; false when the caller must
// parse the whole file (the document is then unchanged).
fn reparse(mut doc: Document, source: Bytes, edit: Edit, tokenize: (String, Bool) -> Result[List[tree.Token], lex.LexError], mut c: parser.Compiled) -> Bool =
  reparse_status(doc, source, edit, tokenize, c) == DONE
// DONE, or why not: ME at the root means the edit fell in the file's own tokens
fn reparse_status(mut doc: Document, source: Bytes, edit: Edit, tokenize: (String, Bool) -> Result[List[tree.Token], lex.LexError], mut c: parser.Compiled) -> Int = {
  // the next item id and the next node id
  var ids = [doc.next_id, doc.next_node]
  let status = reparse_in(doc.root, Pos { byte: 0, line: 1, col: 1 }, source, edit, tokenize, c, ids)
  doc.next_id = list.first(ids) ?? doc.next_id
  doc.next_node = list.get(ids, 1) ?? doc.next_node
  while list.len(doc.root.trace) > 0 { match list.pop(doc.root.trace) { some(t) => list.push(doc.trace, t), none => () } }
  if status == ME then ROOT_OWN else status
}

// ── the same answer? ─────────────────────────────────────────────────────
// Pairs read in place, one index at a time: zipped, both trees were copied.
fn same_node(a: tree.Node, b: tree.Node) -> Bool = {
  var fine = a.kind == b.kind and a.field == b.field and a.start == b.start and a.end == b.end and list.len(a.kids) == list.len(b.kids)
  var k = 0
  while fine and k < list.len(a.kids) {
    fine = match list.get(a.kids, k) { some(x) => (match list.get(b.kids, k) { some(y) => same_node(x, y), none => false }), none => false }
    k = k + 1
  }
  fine
}
fn same_token(a: tree.Token, b: tree.Token) -> Bool = a.kind == b.kind and a.start == b.start and a.end == b.end and a.line == b.line and a.col == b.col
fn same(a: parser.Parsed, b: parser.Parsed) -> Bool = {
  var fine = list.len(a.toks) == list.len(b.toks)
  var k = 0
  while fine and k < list.len(a.toks) {
    fine = match list.get(a.toks, k) { some(x) => (match list.get(b.toks, k) { some(y) => same_token(x, y), none => false }), none => false }
    k = k + 1
  }
  fine and same_node(a.root, b.root)
}

fn first_difference(a: parser.Parsed, b: parser.Parsed) -> String = first_difference_named(a, b, a.names)
fn first_difference_named(a: parser.Parsed, b: parser.Parsed, names: nametable.Names) -> String = {
  var i = 0
  var found = ""
  while found == "" and i < int.max(list.len(a.toks), list.len(b.toks)) {
    match (list.get(a.toks, i), list.get(b.toks, i)) {
      (some(x), some(y)) => if not same_token(x, y) then found = "token " + int.to_string(i) + ": " + int.to_string(x.kind) + "@" + int.to_string(x.start) + ":" + int.to_string(x.line) + ":" + int.to_string(x.col) + " vs " + int.to_string(y.kind) + "@" + int.to_string(y.start) + ":" + int.to_string(y.line) + ":" + int.to_string(y.col)
        + " | a: " + context(a.toks, i) + " | b: " + context(b.toks, i) else (),
      _ => { found = "token count " + int.to_string(list.len(a.toks)) + " vs " + int.to_string(list.len(b.toks)) },
    }
    i = i + 1
  }
  if found == "" and not same_node(a.root, b.root) then "tree differs: " + node_difference(a.root, b.root, "", names) else found
}
// the tokens around index `i`, as kind@start-end
fn context(toks: List[tree.Token], i: Int) -> String = {
  var out: List[String] = []
  var k = int.max(i - 4, 0)
  while k <= i + 4 { match list.get(toks, k) { some(t) => list.push(out, int.to_string(t.kind) + "@" + int.to_string(t.start) + "-" + int.to_string(t.end)), none => () }; k = k + 1 }
  list.join(out, " ")
}
fn node_difference(a: tree.Node, b: tree.Node, path: String, names: nametable.Names) -> String =
  if a.kind != b.kind or a.field != b.field or a.start != b.start or a.end != b.end or list.len(a.kids) != list.len(b.kids) then
    path + " " + nametable.name_at(names, a.kind) + "/" + nametable.name_at(names, b.kind) + " field " + int.to_string(a.field) + "/" + int.to_string(b.field)
    + " " + int.to_string(a.start) + "-" + int.to_string(a.end) + " vs " + int.to_string(b.start) + "-" + int.to_string(b.end) + " kids " + int.to_string(list.len(a.kids)) + "/" + int.to_string(list.len(b.kids))
    + " a:[" + list.join(list.map(a.kids, (k) => nametable.name_at(names, k.kind) + " " + int.to_string(k.start) + "-" + int.to_string(k.end)), ", ") + "]"
    + " b:[" + list.join(list.map(b.kids, (k) => nametable.name_at(names, k.kind) + " " + int.to_string(k.start) + "-" + int.to_string(k.end)), ", ") + "]"
  else deeper(a, b, path, names)
// the first kid pair that differs, and its own chain below it
fn deeper(a: tree.Node, b: tree.Node, path: String, names: nametable.Names) -> String = {
  var out = ""
  var k = 0
  while out == "" and k < int.min(list.len(a.kids), list.len(b.kids)) {
    let x = list.get(a.kids, k) ?? tree.node(0, [], 0, 0)
    let y = list.get(b.kids, k) ?? tree.node(0, [], 0, 0)
    if same_node(x, y) then () else {
      let here = if x.kind != y.kind or x.field != y.field or x.start != y.start or x.end != y.end or list.len(x.kids) != list.len(y.kids) then
        path + "/" + int.to_string(k) + " " + nametable.name_at(names, x.kind) + "/" + nametable.name_at(names, y.kind) + " field " + int.to_string(x.field) + "/" + int.to_string(y.field) + " " + int.to_string(x.start) + "-" + int.to_string(x.end) + " vs " + int.to_string(y.start) + "-" + int.to_string(y.end)
        + " a:[" + list.join(list.map(x.kids, (m) => nametable.name_at(names, m.kind) + " " + int.to_string(m.start) + "-" + int.to_string(m.end)), ", ") + "]"
        + " b:[" + list.join(list.map(y.kids, (m) => nametable.name_at(names, m.kind) + " " + int.to_string(m.start) + "-" + int.to_string(m.end)), ", ") + "]"
        else ""
      let below = deeper(x, y, path + "/" + int.to_string(k), names)
      out = if here == "" then below else here + (if below == "" then "" else "\n    then " + below)
    }
    k = k + 1
  }
  out
}

// The text after an edit.
fn apply(source: Bytes, edit: Edit, text: Bytes) -> Bytes =
  bytes.concat(bytes.concat(bytes.slice(source, 0, edit.start), text), bytes.slice(source, edit.old_end, bytes.len(source)))

// Compare each item both in its real position and alone: the latter has
// a different end-of-stream lookahead from its containing document.
fn check_direct_spans(u: Item, base: Pos) -> Unit = {
  assert_eq(unit_spans(u, base), emitted_unit_spans(u, base))
  let bases = kid_bases(u, base)
  var k = 0
  for kid in u.kids {
    let _ = check_direct_spans(kid, list.get(bases, k) ?? base)
    k = k + 1
  }
  ()
}
fn check_document_spans(doc: Document) -> Unit = {
  let _ = check_direct_spans(doc.root, Pos { byte: 0, line: 1, col: 1 })
  let _ = check_direct_spans(doc.root, Pos { byte: 37, line: 8, col: 4 })
  ()
}
fn emitted_rebuilt(old: Document, p: parser.Parsed, source: Bytes, mut c: parser.Compiled, edit: Edit) -> Document = {
  let left = left_alone(materialize(old), node_ids(old), edit)
  var doc = numbered_from(p, source, c, old.next_id, old.next_node)
  let taken = taken_from(materialize(doc), node_ids(doc), left, edit)
  let _ = rename_unit(doc.root, taken)
  doc
}
fn span_test_piece(toks: List[tree.Token], size: Int) -> Piece =
  Piece { toks: toks, atoms: [], size: size, lines: 0, tail: size }

// ── tests, over a language of items holding statements ───────────────────
fn spec() -> lex.Spec = lex.Spec {
  keywords: ["fn"], operators: ["{", "}", "(", ")", ";", "="], numbers: lex.N_GO, strings: lex.S_GO, newlines: lex.NL_NONE,
  ends_kw: [], line_comment: [35], block_open: [60, 35], block_close: [35, 62], nested_block: false, block_comment_newline: false,
  upper_is_type: false, backtick_ident: false, neg_token: false,
}
fn scan(source: String, recovering: Bool) -> Result[List[tree.Token], lex.LexError] = lex.tokenize_with(source, spec(), recovering)
fn item_grammar() -> parser.Grammar = parser.grammar("source_file", [
  ("source_file", parser.wrap("source_file", parser.rep(parser.recover_all(parser.r("item"))))),
  ("item", parser.wrap("item", parser.seq([
    parser.lit("fn"), parser.field("name", parser.tok("identifier")), parser.lit("("), parser.lit(")"), parser.r("block")
  ]))),
  ("block", parser.wrap("block", parser.seq([parser.lit("{"), parser.rep(parser.recover(parser.r("stmt"))), parser.lit("}")]))),
  ("stmt", parser.alt([
    parser.wrap("assign", parser.seq([parser.tok("identifier"), parser.lit("="), parser.alt([parser.tok("identifier"), parser.tok("integer")]), parser.opt(parser.lit(";"))])),
    parser.wrap("call", parser.seq([parser.tok("identifier"), parser.lit("("), parser.lit(")"), parser.opt(parser.lit(";"))])),
    // `give` is no keyword of the scanner: a name that spells a literal of the grammar
    parser.wrap("give", parser.seq([parser.lit("give"), parser.tok("identifier"), parser.opt(parser.lit(";"))])),
    parser.r("block"),
  ])),
])
fn whole(mut c: parser.Compiled, text: String) -> parser.Parsed = match scan(text, false) {
  ok(toks) => match parser.parse_with(c, bytes.from_string(text), toks) { ok(p) => p, err(_) => parser.Parsed { root: tree.node(0, [], 0, 0), toks: [], names: c.names } },
  err(_) => parser.Parsed { root: tree.node(0, [], 0, 0), toks: [], names: c.names },
}
fn at(needle: String) -> Int = string.index_of(TEXT, needle) ?? -1
fn edited(mut c: parser.Compiled, text: String, start: Int, old_end: Int, insert: String) -> (Bool, Bool, String) = {
  let source = bytes.from_string(text)
  var doc = from_parsed(whole(c, text), source, c)
  let edit = Edit { start: start, old_end: old_end, new_end: start + bytes.len(bytes.from_string(insert)) }
  let after = apply(source, edit, bytes.from_string(insert))
  let ok_inc = reparse(doc, after, edit, (s, r) => scan(s, r), c)
  let full = whole(c, bytes.to_string_lossy(after))
  let got = materialize(doc)
  (ok_inc, same(got, full), first_difference(got, full))
}
let TEXT = "fn a() { x = 1; y() }\nfn b() { p = q\n  { r(); s = 2 }\n}\n\nfn c() { }"

test "the document of a whole parse materializes to the parse itself" {
  var c = parser.compile(item_grammar())
  let p = whole(c, TEXT)
  assert(list.len(p.toks) > 0, "the test text must parse")
  let doc = from_parsed(p, bytes.from_string(TEXT), c)
  assert_eq(list.len(doc.root.kids), 3)
  assert_eq([kid_size(doc.root, 0), kid_size(doc.root, 1), kid_size(doc.root, 2)], [22, 35, 10])
  assert_eq(list.map(doc.root.kids, (u) => list.len(u.kids)), [2, 2, 0])
  assert(same(materialize(doc), p), first_difference(materialize(doc), p))
}

test "an edit inside a statement re-reads that statement and matches the whole parse" {
  var c = parser.compile(item_grammar())
  // `y()` -> `yes()` in a; `q` -> `qq` in b's first statement; `s = 2` -> `s = 22` in the nested block
  for case in [(at("y()"), at("y()") + 1, "yes"), (at("q\n"), at("q\n") + 1, "qq"), (at("2 }"), at("2 }") + 1, "22"), (at("}\n\nfn c"), at("}\n\nfn c"), "\n\n")] {
    let (inc, equal, why) = edited(c, TEXT, case.0, case.1, case.2)
    assert(inc, "not incremental at " + int.to_string(case.0))
    assert(equal, why)
  }
}

test "an edit that adds, removes or joins items or statements still matches" {
  var c = parser.compile(item_grammar())
  for case in [(bytes.len(bytes.from_string(TEXT)), bytes.len(bytes.from_string(TEXT)), "\nfn d() { }"), (at("fn b"), at("fn c"), ""), (at("fn c"), at("fn c"), "fn e() { }\n"),
               (at("y() }") + 3, at("y() }") + 3, " z = 3;"), (at("x = 1;"), at("y()"), ""), (at("s = 2"), at("s = 2"), "t(); ")] {
    let (inc, equal, why) = edited(c, TEXT, case.0, case.1, case.2)
    assert(inc, "not incremental at " + int.to_string(case.0))
    assert(equal, why + " at " + int.to_string(case.0))
  }
}

test "an edit that breaks an item falls back, and the document is untouched" {
  var c = parser.compile(item_grammar())
  let source = bytes.from_string(TEXT)
  var doc = from_parsed(whole(c, TEXT), source, c)
  let edit = Edit { start: at("x = 1"), old_end: at("x = 1"), new_end: at("x = 1") + 1 }
  let after = apply(source, edit, bytes.from_string("{"))
  assert(not reparse(doc, after, edit, (s, r) => scan(s, r), c))
  assert(same(materialize(doc), whole(c, TEXT)))
}


// ── the same over a language whose file rule reads `sep item` after its first
// item, from a scanner that closes its input with an empty separator ──
fn line_spec() -> lex.Spec = lex.Spec { ...spec(), keywords: ["fn", "if", "else", "package"], newlines: lex.NL_SEMI }
fn line_scan(source: String, recovering: Bool) -> Result[List[tree.Token], lex.LexError] = lex.tokenize_with(source, line_spec(), recovering)
fn line_grammar() -> parser.Grammar = {
  let sep = parser.rep1(parser.tok("newline"))
  parser.grammar("source_file", [
    ("source_file", parser.wrap("source_file", parser.seq([parser.opt(sep), parser.opt(parser.wrap("package", parser.seq([parser.lit("package"), parser.tok("identifier"), sep]))),
      parser.opt(parser.seq([parser.recover_all(parser.r("item")), parser.rep(parser.recover_all(parser.seq([sep, parser.r("item")])))])), parser.opt(sep)]))),
    ("item", parser.wrap("item", parser.seq([
      parser.lit("fn"), parser.field("name", parser.tok("identifier")), parser.lit("("), parser.lit(")"), parser.r("block")
    ]))),
    ("block", parser.wrap("block", parser.seq([parser.lit("{"), parser.opt(sep),
      parser.opt(parser.seq([parser.recover(parser.r("stmt")), parser.rep(parser.recover(parser.seq([sep, parser.r("stmt")])))])), parser.opt(sep), parser.lit("}")]))),
    ("stmt", parser.alt([
      parser.wrap("assign", parser.seq([parser.tok("identifier"), parser.lit("="), parser.alt([parser.tok("identifier"), parser.tok("integer")])])),
      parser.wrap("call", parser.seq([parser.tok("identifier"), parser.lit("("), parser.lit(")")])),
      parser.wrap("if", parser.seq([parser.lit("if"), parser.tok("identifier"), parser.r("block"), parser.lit("else"), parser.r("block")])),
      parser.r("block"),
    ])),
  ])
}
let LINES = "# a comment before the package clause\npackage m\n\nfn a() {\n  x = 1\n  y()\n}\nfn b() {\n  p = q\n  {\n    r()\n    s = 2\n  }\n  if p {\n    u()\n  } else {\n    v = 3\n    w()\n  }\n}\n\nfn c() { }\n"
fn line_whole(mut c: parser.Compiled, text: String) -> parser.Parsed = match line_scan(text, false) {
  ok(toks) => match parser.parse_with(c, bytes.from_string(text), toks) { ok(p) => p, err(_) => parser.Parsed { root: tree.node(0, [], 0, 0), toks: [], names: c.names } },
  err(_) => parser.Parsed { root: tree.node(0, [], 0, 0), toks: [], names: c.names },
}
fn line_at(needle: String) -> Int = string.index_of(LINES, needle) ?? -1
fn line_edited(mut c: parser.Compiled, start: Int, old_end: Int, insert: String) -> (Bool, Bool, String) = {
  let source = bytes.from_string(LINES)
  var doc = from_parsed(line_whole(c, LINES), source, c)
  let edit = Edit { start: start, old_end: old_end, new_end: start + bytes.len(bytes.from_string(insert)) }
  let after = apply(source, edit, bytes.from_string(insert))
  let ok_inc = reparse(doc, after, edit, (s, r) => line_scan(s, r), c)
  let full = line_whole(c, bytes.to_string_lossy(after))
  let got = materialize(doc)
  (ok_inc, same(got, full), if ok_inc then first_difference(got, full) else list.join(doc.trace, " | "))
}

test "items after the first, read at a second site behind a separator, keep that site's stamp" {
  var c = parser.compile(line_grammar())
  let p = line_whole(c, LINES)
  assert(list.len(p.toks) > 0, "the test text must parse")
  let doc = from_parsed(p, bytes.from_string(LINES), c)
  assert_eq(list.len(doc.root.kids), 3)
  assert(same(materialize(doc), p), first_difference(materialize(doc), p))
  // inside a statement, at the head of the second and third items, appending an item, inside a nested block
  for case in [(line_at("y()"), line_at("y()") + 1, "yes"), (line_at("b()"), line_at("b()") + 1, "bb"), (line_at("c()"), line_at("c()") + 1, "cc"),
               (bytes.len(bytes.from_string(LINES)), bytes.len(bytes.from_string(LINES)), "fn d() { }\n"), (line_at("2\n"), line_at("2\n") + 1, "22"),
               (line_at("fn b"), line_at("fn c"), ""), (line_at("s = 2"), line_at("s = 2"), "t()\n    "),
               // the first item removed, one put before it, the first statement of a block removed, one put before it
               (line_at("fn a"), line_at("fn b"), ""), (line_at("fn a"), line_at("fn a"), "fn z() { }\n"), (line_at("x = 1"), line_at("y()"), ""), (line_at("x = 1"), line_at("x = 1"), "w()\n  "),
               // an `if` item holds two lists: inside the first statement of the second, that statement removed, one put before it, its last removed
               (line_at("v = 3") + 4, line_at("v = 3") + 5, "33"), (line_at("v = 3"), line_at("w()"), ""), (line_at("v = 3"), line_at("v = 3"), "vv()\n    "), (line_at("w()"), line_at("w()") + 4, ""),
               // in the comment before the package clause, and in the blank line after it: the file's own tokens stay, the first item is re-read
               (line_at("comment") + 3, line_at("comment") + 3, "x"), (line_at("\n\nfn a") + 1, line_at("\n\nfn a") + 1, "\n"),
               // the package's name retyped: a token of the file's own, before any item
               (line_at("package m") + 8, line_at("package m") + 8, "ai")] {
    let (inc, equal, why) = line_edited(c, case.0, case.1, case.2)
    assert(inc, "not incremental at " + int.to_string(case.0) + ": " + why)
    assert(equal, why + " at " + int.to_string(case.0))
  }
}

// ── edits that touch no token: comments and blank space ─────────────────
let COMMENTED = "# about a\nfn a() { x = 1; # after x\n y() }\n\n<# about b,\n   at length #>\nfn b() { p = q\n  <# inside #> { r(); s = 2 }\n}\n"
fn commented_at(needle: String) -> Int = string.index_of(COMMENTED, needle) ?? -1

test "an edit inside a comment or in blank space moves positions and reads no item" {
  var c = parser.compile(item_grammar())
  // in the comment before the first item, in a comment after a statement, in the
  // block comment between items, in a comment inside a block, a blank line added
  // between statements, a blank line added at the end, a letter deleted in a comment
  for case in [(commented_at("about a") + 3, commented_at("about a") + 3, "x"), (commented_at("after x") + 2, commented_at("after x") + 2, "yz"),
               (commented_at("at length") + 3, commented_at("at length") + 3, "some "), (commented_at("inside") + 2, commented_at("inside") + 2, "q"),
               (commented_at("\n y()"), commented_at("\n y()"), "\n"), (bytes.len(bytes.from_string(COMMENTED)), bytes.len(bytes.from_string(COMMENTED)), "\n\n"),
               (commented_at("length") + 1, commented_at("length") + 3, "")] {
    let source = bytes.from_string(COMMENTED)
    var doc = from_parsed(whole(c, COMMENTED), source, c)
    let edit = Edit { start: case.0, old_end: case.1, new_end: case.0 + bytes.len(bytes.from_string(case.2)) }
    let after = apply(source, edit, bytes.from_string(case.2))
    let status = reparse_status(doc, after, edit, (s, r) => scan(s, r), c)
    assert(status == DONE, "not done at " + int.to_string(case.0) + ": " + int.to_string(status))
    let full = whole(c, bytes.to_string_lossy(after))
    assert(same(materialize(doc), full), first_difference(materialize(doc), full) + " at " + int.to_string(case.0))
  }
}

test "an edit that opens or closes a comment is not a comment edit" {
  var c = parser.compile(item_grammar())
  // the block comment's close removed: the file no longer lexes, and the document is untouched
  let source = bytes.from_string(COMMENTED)
  var doc = from_parsed(whole(c, COMMENTED), source, c)
  let at = commented_at("#>\nfn b")
  let edit = Edit { start: at, old_end: at + 2, new_end: at }
  let after = apply(source, edit, bytes.new(0))
  assert(not reparse(doc, after, edit, (s, r) => scan(s, r), c))
  assert(same(materialize(doc), whole(c, COMMENTED)))
  // a comment opened in blank space before `y()`: the statement is swallowed, and the whole parse agrees
  var doc2 = from_parsed(whole(c, COMMENTED), source, c)
  let at2 = commented_at(" y()")
  let edit2 = Edit { start: at2, old_end: at2, new_end: at2 + 2 }
  let after2 = apply(source, edit2, bytes.from_string("# "))
  let status = reparse_status(doc2, after2, edit2, (s, r) => scan(s, r), c)
  let full = whole(c, bytes.to_string_lossy(after2))
  assert(status != DONE or same(materialize(doc2), full), first_difference(materialize(doc2), full))
}

// ── edits that retype one token ─────────────────────────────────────────
let RETYPED = "fn alpha() { counter = 1; give counter\n  reader()\n}\nfn beta() { p = q }\n"
fn retyped_at(needle: String) -> Int = string.index_of(RETYPED, needle) ?? -1
fn retyped_edit(mut c: parser.Compiled, start: Int, old_end: Int, insert: String) -> (Int, Bool, String) = {
  let source = bytes.from_string(RETYPED)
  var doc = from_parsed(whole(c, RETYPED), source, c)
  let edit = Edit { start: start, old_end: old_end, new_end: start + bytes.len(bytes.from_string(insert)) }
  let after = apply(source, edit, bytes.from_string(insert))
  let status = reparse_status(doc, after, edit, (s, r) => scan(s, r), c)
  let full = whole(c, bytes.to_string_lossy(after))
  (status, same(materialize(doc), full), first_difference(materialize(doc), full))
}

test "a letter typed or deleted inside a name moves positions and reads no item" {
  var c = parser.compile(item_grammar())
  // a function's name, extended, cut, and a letter put after it; a statement's name; a number
  for case in [(retyped_at("alpha") + 2, retyped_at("alpha") + 2, "x"), (retyped_at("alpha") + 1, retyped_at("alpha") + 3, ""), (retyped_at("alpha") + 5, retyped_at("alpha") + 5, "s"),
               (retyped_at("counter =") + 3, retyped_at("counter =") + 3, "tt"), (retyped_at("reader") + 6, retyped_at("reader") + 6, "s"), (retyped_at("= 1;") + 2, retyped_at("= 1;") + 2, "2")] {
    let (status, equal, why) = retyped_edit(c, case.0, case.1, case.2)
    assert(status == DONE, "not done at " + int.to_string(case.0) + ": " + int.to_string(status))
    assert(equal, why + " at " + int.to_string(case.0))
  }
}

test "a name that spells or comes to spell a literal of the grammar is read the ordinary way" {
  var c = parser.compile(item_grammar())
  // `give` -> `gives` (no longer the literal: the statement stops parsing), `giv` -> `give` would be the reverse; `counter` -> `give`
  // stays a name here since a bare name is no statement; the second `counter` -> `counte` keeps `give counte`
  for case in [(retyped_at("give") + 4, retyped_at("give") + 4, "s"), (retyped_at("give counter") + 5, retyped_at("give counter") + 12, "give"), (retyped_at("give counter") + 11, retyped_at("give counter") + 12, "")] {
    let (status, equal, why) = retyped_edit(c, case.0, case.1, case.2)
    assert(status != DONE or equal, why + " at " + int.to_string(case.0))
  }
  // the first case must not have been taken as a retyped name: the whole parse fails there
  let (status, _, _) = retyped_edit(c, retyped_at("give") + 4, retyped_at("give") + 4, "s")
  assert(status != DONE, "a literal retyped was read as a name")
}

test "a retyped head is what the next window is measured against" {
  var c = parser.compile(item_grammar())
  let source = bytes.from_string(RETYPED)
  var doc = from_parsed(whole(c, RETYPED), source, c)
  // `reader` -> `reder`: the head of the third statement, retyped in place
  // and shorter, so that a window measured with its old length would take
  // its `(` for part of it
  let at = retyped_at("reader") + 2
  let first = Edit { start: at, old_end: at + 1, new_end: at }
  let once = apply(source, first, bytes.new(0))
  assert_eq(reparse_status(doc, once, first, (s, r) => scan(s, r), c), DONE)
  // then a `;` put after `give counter`: that statement is read again, up to the head `reder`
  let at2 = string.index_of(bytes.to_string_lossy(once), "give counter") ?? -1
  let second = Edit { start: at2 + 12, old_end: at2 + 12, new_end: at2 + 13 }
  let twice = apply(once, second, bytes.from_string(";"))
  let status = reparse_status(doc, twice, second, (s, r) => scan(s, r), c)
  assert(status == DONE, "status " + int.to_string(status) + " " + list.join(doc.trace, " | "))
  let full = whole(c, bytes.to_string_lossy(twice))
  assert(same(materialize(doc), full), first_difference(materialize(doc), full))
}

test "an edit in a comment after the last item, or in a file with no item, reads nothing" {
  var c = parser.compile(item_grammar())
  for text in ["# only a comment\n# and another\n", "fn a() { }\n# after the last item\n"] {
    let source = bytes.from_string(text)
    var doc = from_parsed(whole(c, text), source, c)
    let at = (string.index_of(text, "comment") ?? 0) + 3
    let edit = Edit { start: at, old_end: at, new_end: at + 2 }
    let after = apply(source, edit, bytes.from_string("xy"))
    let status = reparse_status(doc, after, edit, (s, r) => scan(s, r), c)
    assert(status == DONE, "status " + int.to_string(status) + " in " + text)
    let full = whole(c, bytes.to_string_lossy(after))
    assert(same(materialize(doc), full), first_difference(materialize(doc), full))
  }
}

// ── item ids across edits ───────────────────────────────────────────────
fn ids_of(doc: Document) -> List[Int] = list.map(items(doc), (r) => r.id)
fn kept(before: List[Int], after: List[Int]) -> Int = list.count(before, (id) => list.contains(after, id))

test "items keep their ids across edits; an item read again in place of itself keeps its id; new items get new ids" {
  var c = parser.compile(item_grammar())
  let source = bytes.from_string(RETYPED)
  var doc = from_parsed(whole(c, RETYPED), source, c)
  let start = ids_of(doc)
  assert(list.len(start) == list.len(list.dedup(list.sort(start))), "ids are distinct")
  assert(list.all(start, (id) => id > 0), "ids are positive")
  // a name retyped: every id stays
  var text = source
  let e1 = Edit { start: retyped_at("counter =") + 3, old_end: retyped_at("counter =") + 3, new_end: retyped_at("counter =") + 4 }
  text = apply(text, e1, bytes.from_string("t"))
  assert_eq(reparse_status(doc, text, e1, (s, r) => scan(s, r), c), DONE)
  assert_eq(ids_of(doc), start)
  // a `;` after `give counter`: that statement is read again alone, and keeps its id
  let at2 = (string.index_of(bytes.to_string_lossy(text), "give counter") ?? -1) + 12
  let e2 = Edit { start: at2, old_end: at2, new_end: at2 + 1 }
  text = apply(text, e2, bytes.from_string(";"))
  let s2 = reparse_status(doc, text, e2, (s, r) => scan(s, r), c)
  assert(s2 == DONE, "status " + int.to_string(s2) + ": " + list.join(doc.trace, " | ") + " text: " + bytes.to_string_lossy(text))
  assert_eq(ids_of(doc), start)
  // a statement added before `reader`: the others keep their ids, the new one is newer than all
  let at3 = string.index_of(bytes.to_string_lossy(text), "reader") ?? -1
  let e3 = Edit { start: at3, old_end: at3, new_end: at3 + 8 }
  text = apply(text, e3, bytes.from_string("t = 2\n  "))
  let s3 = reparse_status(doc, text, e3, (s, r) => scan(s, r), c)
  assert(s3 == DONE, "status " + int.to_string(s3) + ": " + list.join(doc.trace, " | "))
  let grown = ids_of(doc)
  assert_eq(kept(start, grown), list.len(start))
  assert_eq(list.len(grown), list.len(start) + 1)
  assert(list.all(grown, (id) => list.contains(start, id) or id > (list.max(start) ?? 0)), "the new item's id is new")
  // that statement removed again: everything else keeps its id
  let e4 = Edit { start: at3, old_end: at3 + 8, new_end: at3 }
  text = apply(text, e4, bytes.new(0))
  assert_eq(reparse_status(doc, text, e4, (s, r) => scan(s, r), c), DONE)
  assert_eq(ids_of(doc), start)
  let full = whole(c, bytes.to_string_lossy(text))
  assert(same(materialize(doc), full), first_difference(materialize(doc), full))
}

// ── node ids across edits ───────────────────────────────────────────────
fn node_count(n: tree.Node) -> Int = {
  var total = 1
  for k in n.kids { total = total + node_count(k) }
  total
}
fn distinct(xs: List[Int]) -> Bool = list.len(xs) == list.len(list.dedup(list.sort(xs)))
// The rule, checked against whole trees: every node the edit left alone
// keeps its id, every other node's id is one no node had before, and no
// two nodes share one. Empty when it holds, else the first node that
// breaks it.
fn node_id_breaks(tree_before: parser.Parsed, ids_before: List[Int], tree_after: parser.Parsed, ids_after: List[Int], edit: Edit) -> String = {
  let left = left_alone(tree_before, ids_before, edit)
  var spans: List[Int] = []
  let _ = spans_walk(tree_after.root, tree_after.toks, ids_after, 0, spans)
  var seen: Map[String, Int] = map.new()
  var olds: Map[Int, Int] = map.new()
  for id in ids_before { map.insert(olds, id, 1) }
  var out = if list.len(ids_after) != list.len(list.dedup(list.sort(ids_after))) then "two nodes share an id" else ""
  var m = 0
  while out == "" and m + 3 < list.len(spans) {
    let start = list.get(spans, m + 1) ?? 0
    let end = list.get(spans, m + 2) ?? 0
    let id = list.get(spans, m + 3) ?? -1
    let key = span_key(list.get(spans, m) ?? 0, start, end)
    let n = map.get(seen, key) ?? 0
    map.insert(seen, key, n + 1)
    let want = if changed_by(start, end, edit) then -1 else map.get(left, key + "#" + int.to_string(n)) ?? -1
    out = if want >= 0 and id != want then "node " + key + " has id " + int.to_string(id) + ", was " + int.to_string(want)
      else if want < 0 and map.contains(olds, id) then "node " + key + " is new but has the old id " + int.to_string(id)
      else ""
    m = m + 4
  }
  out
}
fn id_edit(mut c: parser.Compiled, mut doc: Document, text: Bytes, edit: Edit, insert: String) -> (Bytes, String) = {
  let _ = check_document_spans(doc)
  let before = materialize(doc)
  let before_ids = node_ids(doc)
  let after = apply(text, edit, bytes.from_string(insert))
  let status = reparse_status(doc, after, edit, (s, r) => scan(s, r), c)
  let _ = check_document_spans(doc)
  let got = materialize(doc)
  let got_ids = node_ids(doc)
  let full = whole(c, bytes.to_string_lossy(after))
  let why = if status != DONE then "status " + int.to_string(status)
    else if not same(got, full) then first_difference(got, full)
    else if list.len(got_ids) != node_count(got.root) then "ids for " + int.to_string(list.len(got_ids)) + " of " + int.to_string(node_count(got.root)) + " nodes"
    else node_id_breaks(before, before_ids, got, got_ids, edit)
  (after, why)
}

test "nodes keep their ids across edits: a node the edit left alone keeps its id, one whose text it changed is named anew" {
  var c = parser.compile(item_grammar())
  let source = bytes.from_string(RETYPED)
  var doc = from_parsed(whole(c, RETYPED), source, c)
  let start = node_ids(doc)
  assert_eq(list.len(start), node_count(materialize(doc).root))
  assert(distinct(start), "node ids are distinct")
  assert(list.all(start, (id) => id > 0), "node ids are positive")
  // a name retyped, a `;` put after a statement, a statement typed before
  // another and deleted again, a comment-free space typed between two
  var text = source
  let at1 = retyped_at("counter =") + 3
  let (t1, w1) = id_edit(c, doc, text, Edit { start: at1, old_end: at1, new_end: at1 + 1 }, "t")
  assert(w1 == "", "retyped: " + w1)
  text = t1
  let at2 = (string.index_of(bytes.to_string_lossy(text), "give counter") ?? -1) + 12
  let (t2, w2) = id_edit(c, doc, text, Edit { start: at2, old_end: at2, new_end: at2 + 1 }, ";")
  assert(w2 == "", "semicolon: " + w2)
  text = t2
  let kept_before = node_ids(doc)
  let at3 = string.index_of(bytes.to_string_lossy(text), "reader") ?? -1
  let (t3, w3) = id_edit(c, doc, text, Edit { start: at3, old_end: at3, new_end: at3 + 8 }, "t = 2\n  ")
  assert(w3 == "", "statement typed: " + w3)
  text = t3
  let (t4, w4) = id_edit(c, doc, text, Edit { start: at3, old_end: at3 + 8, new_end: at3 }, "")
  assert(w4 == "", "statement deleted: " + w4)
  text = t4
  // the statement came and went: the nodes that do not hold it are as they were
  let back = node_ids(doc)
  assert_eq(list.len(back), list.len(kept_before))
  let at5 = string.index_of(bytes.to_string_lossy(text), "fn beta") ?? -1
  let (_, w5) = id_edit(c, doc, text, Edit { start: at5, old_end: at5, new_end: at5 + 1 }, "\n")
  assert(w5 == "", "line break between items: " + w5)
}

test "a document read again whole after an edit keeps the ids of the nodes the edit left alone, and gives none twice" {
  var c = parser.compile(item_grammar())
  let source = bytes.from_string(RETYPED)
  var doc = from_parsed(whole(c, RETYPED), source, c)
  let at = retyped_at("give counter") + 12
  let edit = Edit { start: at, old_end: at, new_end: at + 1 }
  let after = apply(source, edit, bytes.from_string(";"))
  var again = rebuilt(doc, whole(c, bytes.to_string_lossy(after)), after, c, edit)
  let breaks = node_id_breaks(materialize(doc), node_ids(doc), materialize(again), node_ids(again), edit)
  assert(breaks == "", breaks)
  assert(again.next_node > doc.next_node, "numbering goes on")
  // everything but the statement that took the `;` and what holds it keeps its id
  assert(list.len(list.filter(node_ids(again), (id) => list.contains(node_ids(doc), id))) > 0, "some ids are kept")
}

// A window's children start at their first tokens, not at the window's
// first byte. Inserting trivia at a head must preserve the bytes between.
fn prefix_round_trip(mut c: parser.Compiled, text: String, at: Int, prefix: String, line_tokens: Bool) -> Unit = {
  let source = bytes.from_string(text)
  let parsed = if line_tokens then line_whole(c, text) else whole(c, text)
  assert(list.len(parsed.toks) > 0, "the prefix fixture must parse")
  var doc = from_parsed(parsed, source, c)
  let size = bytes.len(bytes.from_string(prefix))
  let add = Edit { start: at, old_end: at, new_end: at + size }
  let after = apply(source, add, bytes.from_string(prefix))
  let before_ids = node_ids(doc)
  let item_ids = ids_of(doc)
  let status = reparse_status(doc, after, add, (s, r) => if line_tokens then line_scan(s, r) else scan(s, r), c)
  assert(status == DONE, "prefix insertion status " + int.to_string(status) + " at " + int.to_string(at) + ": " + list.join(doc.trace, " | "))
  let full = if line_tokens then line_whole(c, bytes.to_string_lossy(after)) else whole(c, bytes.to_string_lossy(after))
  let got = materialize(doc)
  assert(same(got, full), first_difference(got, full))
  assert_eq(doc.root.size, bytes.len(after))
  assert_eq(ids_of(doc), item_ids)
  let _ = check_document_spans(doc)
  let added_ids = node_ids(doc)
  let add_breaks = node_id_breaks(parsed, before_ids, got, added_ids, add)
  assert(add_breaks == "", add_breaks)

  let remove = Edit { start: at, old_end: at + size, new_end: at }
  assert(apply(after, remove, bytes.new(0)) == source, "removing the prefix must restore the exact source bytes")
  let back_status = reparse_status(doc, source, remove, (s, r) => if line_tokens then line_scan(s, r) else scan(s, r), c)
  assert(back_status == DONE, "prefix deletion status " + int.to_string(back_status) + " at " + int.to_string(at) + ": " + list.join(doc.trace, " | "))
  let _ = check_document_spans(doc)
  let back = materialize(doc)
  assert(same(back, parsed), first_difference(back, parsed))
  assert_eq(doc.root.size, bytes.len(source))
  assert_eq(ids_of(doc), item_ids)
  let remove_breaks = node_id_breaks(got, added_ids, back, node_ids(doc), remove)
  assert(remove_breaks == "", remove_breaks)
  ()
}

test "trivia inserted at the first file token preserves positions and ids on insertion and deletion" {
  var c = parser.compile(item_grammar())
  for prefix in [" ", "\t", "\n ", "\r\n  ", "# prefix\n", "<# prefix #> ", "<# first\r\n second #>\n "] {
    let _ = prefix_round_trip(c, TEXT, 0, prefix, false)
  }
}

test "trivia inserted at nested first-child heads extends their preceding nonempty piece" {
  var c = parser.compile(item_grammar())
  for offset in [at("x = 1"), at("p = q"), at("r()")] {
    for prefix in [" ", "\n ", "\r\n  ", "# prefix\n ", "<# first\n second #> "] {
      let _ = prefix_round_trip(c, TEXT, offset, prefix, false)
    }
  }
}

test "prefix trivia preserves a nonempty root prelude and its layout tokens" {
  var c = parser.compile(line_grammar())
  let doc = from_parsed(line_whole(c, LINES), bytes.from_string(LINES), c)
  assert(piece_count(doc.root, 0) > 0, "this fixture must have tokens before the first child")
  for offset in [0, line_at("fn a"), line_at("x = 1")] {
    for prefix in [" ", "\n ", "\r\n  ", "# prefix\n", "<# first\n second #> "] {
      let _ = prefix_round_trip(c, LINES, offset, prefix, true)
    }
  }
}

test "an invalid or token-bearing prefix falls back without changing the document or ids" {
  var c = parser.compile(item_grammar())
  let source = bytes.from_string(TEXT)
  let parsed = whole(c, TEXT)
  // An unterminated block comment is still a strict scanner failure;
  // an unmatched opener fails the item parse; a separator is not trivia.
  for prefix in ["<#", "{", ";"] {
    var doc = from_parsed(parsed, source, c)
    let before_ids = node_ids(doc)
    let before_items = ids_of(doc)
    let next_id = doc.next_id
    let next_node = doc.next_node
    let edit = Edit { start: 0, old_end: 0, new_end: bytes.len(bytes.from_string(prefix)) }
    let after = apply(source, edit, bytes.from_string(prefix))
    if prefix == "<#" then assert(result.is_err(scan(bytes.to_string_lossy(after), false))) else ()
    assert(reparse_status(doc, after, edit, (s, r) => scan(s, r), c) != DONE)
    assert(same(materialize(doc), parsed), first_difference(materialize(doc), parsed))
    assert_eq(node_ids(doc), before_ids)
    assert_eq(ids_of(doc), before_items)
    assert_eq(doc.next_id, next_id)
    assert_eq(doc.next_node, next_node)
  }
}

test "deleting an appended item renews the shrinking root and preserves untouched descendant ids" {
  var c = parser.compile(item_grammar())
  // The original root ends before the trailing CRLF, and therefore before
  // the append/delete point: its new span alone cannot detect the deletion.
  let text = TEXT + "\r\n"
  let source = bytes.from_string(text)
  var doc = from_parsed(whole(c, text), source, c)
  let descendants = list.drop(node_ids(doc), 1)
  let offset = bytes.len(source)
  let suffix = "\nfn appended() { x = 1 }\n"
  let size = bytes.len(bytes.from_string(suffix))
  var cycle = 0
  while cycle < 3 {
    let (after, add_why) = id_edit(c, doc, source, Edit { start: offset, old_end: offset, new_end: offset + size }, suffix)
    assert(add_why == "", "append: " + add_why)
    let root_after_append = list.first(node_ids(doc)) ?? -1
    let (back, remove_why) = id_edit(c, doc, after, Edit { start: offset, old_end: offset + size, new_end: offset }, "")
    assert(remove_why == "", "delete appended item: " + remove_why)
    assert(back == source, "the append/delete cycle restores exact source bytes")
    assert((list.first(node_ids(doc)) ?? -1) != root_after_append, "the shortened root must have a fresh id")
    assert_eq(list.drop(node_ids(doc), 1), descendants)
    assert(list.all(node_ids(doc), (id) => id > 0), "node ids remain positive")
    cycle = cycle + 1
  }
}

test "deleting a prepended item renews a root whose new start is the deletion boundary" {
  var c = parser.compile(item_grammar())
  let source = bytes.from_string(TEXT)
  var doc = from_parsed(whole(c, TEXT), source, c)
  let descendants = list.drop(node_ids(doc), 1)
  let prefix = "fn prepended() { }\n"
  let size = bytes.len(bytes.from_string(prefix))
  let (after, add_why) = id_edit(c, doc, source, Edit { start: 0, old_end: 0, new_end: size }, prefix)
  assert(add_why == "", "prepend: " + add_why)
  let root_after_prepend = list.first(node_ids(doc)) ?? -1
  let (_, remove_why) = id_edit(c, doc, after, Edit { start: 0, old_end: size, new_end: 0 }, "")
  assert(remove_why == "", "delete prepended item: " + remove_why)
  assert((list.first(node_ids(doc)) ?? -1) != root_after_prepend, "the shortened root must have a fresh id")
  assert_eq(list.drop(node_ids(doc), 1), descendants)
}

test "deleting the only item gives the empty root a new id" {
  var c = parser.compile(item_grammar())
  let text = "fn only() { }"
  let source = bytes.from_string(text)
  var doc = from_parsed(whole(c, text), source, c)
  let old_root = list.first(node_ids(doc)) ?? -1
  let (_, why) = id_edit(c, doc, source, Edit { start: 0, old_end: bytes.len(source), new_end: 0 }, "")
  assert(why == "", why)
  assert((list.first(node_ids(doc)) ?? -1) != old_root, "the empty root must have a fresh id")
}

test "removing a recovered unmatched opener obeys the same node identity rule" {
  var c = parser.compile(item_grammar())
  let text = "{" + TEXT
  let source = bytes.from_string(text)
  let toks = scan(text, false)!
  assert(result.is_err(parser.parse_with(c, source, toks)), "the leading opener must break the strict parse")
  let parsed = parser.parse_recovering(c, source, toks)!
  var doc = from_parsed(parsed, source, c)
  let before_ids = node_ids(doc)
  let edit = Edit { start: 0, old_end: 1, new_end: 0 }
  let after = apply(source, edit, bytes.new(0))
  let full = whole(c, TEXT)
  let status = reparse_status(doc, after, edit, (s, r) => scan(s, r), c)
  if status != DONE then {
    assert(same(materialize(doc), parsed), "a failed reparse must preserve the recovered document")
    assert_eq(node_ids(doc), before_ids)
    doc = rebuilt(doc, full, after, c, edit)
  } else ()
  assert(same(materialize(doc), full), first_difference(materialize(doc), full))
  let why = node_id_breaks(parsed, before_ids, materialize(doc), node_ids(doc), edit)
  assert(why == "", why)
  assert((list.first(node_ids(doc)) ?? -1) != (list.first(before_ids) ?? -1), "removing the opener changes the root's text")
}

test "a window from the file start cannot add unparsed separator tokens to its prelude" {
  for case in [(" " + TEXT, 0, false), (LINES, line_at("fn a") - 1, true)] {
    var c = parser.compile(if case.2 then line_grammar() else item_grammar())
    let source = bytes.from_string(case.0)
    let parsed = if case.2 then line_whole(c, case.0) else whole(c, case.0)
    var doc = from_parsed(parsed, source, c)
    let before_ids = node_ids(doc)
    let before_items = ids_of(doc)
    let next_id = doc.next_id
    let next_node = doc.next_node
    let base = Pos { byte: 0, line: 1, col: 1 }
    let edit = Edit { start: case.1, old_end: case.1, new_end: case.1 + 1 }
    assert(locate(doc.root, base, kid_bases(doc.root, base), edit).2, "the fixture must re-read the root prelude")
    assert_eq(prelude_untouched(doc.root, base, edit), piece_count(doc.root, 0))
    if case.2 then assert(piece_count(doc.root, 0) > 0, "the second fixture has a nonempty prelude") else ()
    let after = apply(source, edit, bytes.from_string(";"))
    let scan_after = if case.2 then line_scan(bytes.to_string_lossy(after), false)! else scan(bytes.to_string_lossy(after), false)!
    assert(result.is_err(parser.parse_with(c, after, scan_after)), "the extra separator must fail a strict whole parse")
    let status = reparse_status(doc, after, edit, (s, r) => if case.2 then line_scan(s, r) else scan(s, r), c)
    assert_eq(status, NO_PARSE)
    assert(same(materialize(doc), parsed), "the rejected prelude edit must leave the document unchanged")
    assert_eq(node_ids(doc), before_ids)
    assert_eq(ids_of(doc), before_items)
    assert_eq(doc.next_id, next_id)
    assert_eq(doc.next_node, next_node)
  }
}

// A generic comma-separated syntax. Each recover body checks its right
// delimiter, while the comma itself remains owned by the enclosing node.
fn comma_scan(source: String, recovering: Bool) -> Result[List[tree.Token], lex.LexError] =
  lex.tokenize_with(source, lex.Spec { ...spec(), operators: ["[", "]", "{", "}", ",", ":"] }, recovering)
fn comma_members(item: parser.Rule, close: String) -> parser.Rule = {
  let bounded = parser.seq([item, parser.ahead(parser.alt([parser.lit(","), parser.lit(close)]))])
  parser.opt(parser.seq([parser.recover_all(bounded), parser.rep(parser.seq([parser.lit(","), parser.recover_all(bounded)]))]))
}
fn comma_grammar() -> parser.Grammar = parser.grammar("document", [
  ("document", parser.wrap("document", parser.alt([parser.r("array"), parser.r("object")]))),
  ("array", parser.wrap("array", parser.seq([parser.lit("["), comma_members(parser.wrap("value", parser.tok("integer")), "]"), parser.lit("]")]))),
  ("object", parser.wrap("object", parser.seq([parser.lit("{"), comma_members(parser.r("pair"), "}"), parser.lit("}")]))),
  ("pair", parser.wrap("pair", parser.seq([parser.tok("identifier"), parser.lit(":"), parser.wrap("value", parser.tok("integer"))]))),
])
fn comma_parse(mut c: parser.Compiled, text: String, recovering: Bool) -> Result[parser.Parsed, String] = {
  let toks = comma_scan(text, false) |> result.map_err((e) => e.message)!
  let parsed = if recovering then parser.parse_recovering(c, bytes.from_string(text), toks) else parser.parse_with(c, bytes.from_string(text), toks)
  parsed |> result.map_err((e) => parser.format_failure(e))
}
fn comma_edit_case(text: String, start: Int, old_end: Int, insert: String, valid: Bool, incremental: Bool) -> Result[Unit, String] = {
  var c = parser.compile(comma_grammar())
  let source = bytes.from_string(text)
  let parsed = comma_parse(c, text, false)!
  var doc = from_parsed(parsed, source, c)
  let before_ids = node_ids(doc)
  let before_items = ids_of(doc)
  let next_id = doc.next_id
  let next_node = doc.next_node
  let edit = Edit { start: start, old_end: old_end, new_end: start + bytes.len(bytes.from_string(insert)) }
  let after = apply(source, edit, bytes.from_string(insert))
  let strict = comma_parse(c, bytes.to_string_lossy(after), false)
  assert_eq(result.is_ok(strict), valid)
  let status = reparse_status(doc, after, edit, (s, r) => comma_scan(s, r), c)
  let _ = check_document_spans(doc)
  assert_eq(status == DONE, incremental)
  if status != DONE then {
    assert(same(materialize(doc), parsed), "a rejected comma-list edit must preserve the old document")
    assert_eq(node_ids(doc), before_ids)
    assert_eq(ids_of(doc), before_items)
    assert_eq(doc.next_id, next_id)
    assert_eq(doc.next_node, next_node)
  } else ()
  // Some malformed lists have no recovered whole tree. The strict error
  // and untouched-document fallback above are still required; when a
  // whole tree is available, its rebuild must also obey the identity rule.
  let full = if valid then strict else comma_parse(c, bytes.to_string_lossy(after), true)
  match full {
    ok(p) => {
      if status != DONE then {
        let reference = emitted_rebuilt(doc, p, after, c, edit)
        doc = rebuilt(doc, p, after, c, edit)
        assert_eq(node_ids(doc), node_ids(reference))
      } else ()
      let _ = check_document_spans(doc)
      let actual = materialize(doc)
      assert(same(actual, p), first_difference(actual, p))
      let ids = node_ids(doc)
      assert_eq(list.len(ids), node_count(actual.root))
      assert(distinct(ids) and list.all(ids, (id) => id > 0), "comma-list node ids remain distinct and positive")
      let why = node_id_breaks(parsed, before_ids, actual, ids, edit)
      assert(why == "", why)
    },
    err(_) => assert(not valid and not incremental and status != DONE, "only a rejected malformed edit may lack a recovered tree"),
  }
  ok(())
}

test "bounded comma-list recover bodies reject adjacent items without a separator" {
  let _ = comma_edit_case("[1]", 1, 2, "1 2", false, false)!
  let _ = comma_edit_case("{a:1}", 1, 4, "a:1 b:2", false, false)!
}

test "deleting a comma-list first or last item cannot orphan a parent-owned comma" {
  for case in [("[1,2]", 1, 2), ("[1,2]", 3, 4), ("{a:1,b:2}", 1, 4), ("{a:1,b:2}", 5, 8),
               ("[1, <# gap #> 2]", 1, 2), ("[1, <# gap #> 2]", 14, 15)] {
    let _ = comma_edit_case(case.0, case.1, case.2, "", false, false)!
  }
}

test "deleting a sole comma-list item stays incremental and deleting all items safely rebuilds" {
  let _ = comma_edit_case("[1]", 1, 2, "", true, true)!
  let _ = comma_edit_case("{a:1}", 1, 4, "", true, true)!
  let _ = comma_edit_case("[1,2]", 1, 4, "", true, false)!
  let _ = comma_edit_case("{a:1,b:2}", 1, 8, "", true, false)!
  let _ = comma_edit_case("[1,2]", 1, 4, "3", true, false)!
}

test "a child window cannot delete or replace its parent's opening delimiter" {
  let _ = comma_edit_case("[1]", 0, 1, "", false, false)!
  let _ = comma_edit_case("[1]", 0, 1, " ", false, false)!
  let _ = comma_edit_case("[1]", 0, 1, "{", false, false)!
  let _ = comma_edit_case("{a:1}", 0, 1, "", false, false)!
  let _ = comma_edit_case("{a:1}", 0, 1, " ", false, false)!
}

test "a child window cannot change its parent-owned closing lookahead token" {
  let _ = comma_edit_case("[1]", 2, 3, ",", false, false)!
  let _ = comma_edit_case("[1]", 2, 3, "}", false, false)!
  let _ = comma_edit_case("[1]", 2, 3, "", false, false)!
  let _ = comma_edit_case("{a:1}", 4, 5, ",", false, false)!
  let _ = comma_edit_case("{a:1}", 4, 5, "]", false, false)!
  let _ = comma_edit_case("{a:1}", 4, 5, "", false, false)!
}

test "valid insertions immediately before the parent-owned lookahead stay inside the window" {
  for insert in [" ", "\r\n ", "<# boundary #>", "2"] {
    let _ = comma_edit_case("[1]", 2, 2, insert, true, true)!
    let _ = comma_edit_case("{a:1}", 4, 4, insert, true, true)!
  }
}

test "changing or deleting package prelude tokens requires a parent parse" {
  for case in [(line_at("package m"), line_at("package m") + 7, "namespace", false),
               (line_at("package m") + 8, line_at("package m") + 9, "", false),
               (line_at("package m"), line_at("fn a"), "", true)] {
    var c = parser.compile(line_grammar())
    let source = bytes.from_string(LINES)
    let parsed = line_whole(c, LINES)
    var doc = from_parsed(parsed, source, c)
    let before_ids = node_ids(doc)
    let before_items = ids_of(doc)
    let next_id = doc.next_id
    let next_node = doc.next_node
    let edit = Edit { start: case.0, old_end: case.1, new_end: case.0 + bytes.len(bytes.from_string(case.2)) }
    let after = apply(source, edit, bytes.from_string(case.2))
    let toks = line_scan(bytes.to_string_lossy(after), false)!
    let full = parser.parse_with(c, after, toks)
    assert_eq(result.is_ok(full), case.3)
    let status = reparse_status(doc, after, edit, (s, r) => line_scan(s, r), c)
    assert_eq(status, NO_PARSE)
    assert(same(materialize(doc), parsed), "a rejected prelude-token edit must preserve the document")
    assert_eq(node_ids(doc), before_ids)
    assert_eq(ids_of(doc), before_items)
    assert_eq(doc.next_id, next_id)
    assert_eq(doc.next_node, next_node)
    match full {
      ok(p) => {
        doc = rebuilt(doc, p, after, c, edit)
        assert(same(materialize(doc), p), first_difference(materialize(doc), p))
        let why = node_id_breaks(parsed, before_ids, materialize(doc), node_ids(doc), edit)
        assert(why == "", why)
      },
      err(_) => (),
    }
  }
}

// Small identity fixtures isolate the move/order contract from parsing.
fn naming_item(id: Int, kind: Int, kids: List[Item]) -> Item = Item {
  ...empty_unit(), id: id, node: tree.node(kind, [], 0, 1),
  node_ids: [id + 1000], trace: [int.to_string(id)], kids: kids,
  size: 3, toks: 1,
}

test "item adoption moves children in order and matches repeated shapes only forward" {
  let before = [
    naming_item(10, 1, [naming_item(11, 7, []), naming_item(12, 7, [])]),
    naming_item(20, 2, []), naming_item(30, 1, []),
  ]
  let original = before
  let prefix = naming_item(900, 9, [])
  let suffix = naming_item(901, 9, [])
  var u = naming_item(1, 0, [prefix,
    naming_item(101, 1, [naming_item(111, 7, []), naming_item(112, 8, []), naming_item(113, 7, [])]),
    naming_item(102, 3, []), naming_item(103, 1, []), suffix,
  ])
  let _ = keep_ids(u, 1, 3, before)
  assert_eq(list.map(u.kids, (x) => x.id), [900, 10, 102, 30, 901])
  let first = list.get(u.kids, 1)!
  assert_eq(list.map(first.kids, (x) => x.id), [11, 112, 12])
  assert_eq(list.map(first.kids, (x) => x.node.kind), [7, 8, 7])
  assert_eq(first.node_ids, [1101])
  assert_eq(first.trace, ["101"])
  assert_eq(list.map(first.kids, (x) => x.node_ids), [[1111], [1112], [1113]])
  assert_eq(list.get(u.kids, 0)!, prefix)
  assert_eq(list.get(u.kids, 4)!, suffix)
  assert_eq(before, original)
}

test "one-for-one adoption keeps its item id without forcing a changed child match" {
  let before = [naming_item(10, 1, [naming_item(11, 7, [])])]
  var u = naming_item(1, 0, [naming_item(101, 2, [naming_item(111, 8, [])])])
  let _ = keep_ids(u, 0, 1, before)
  let first = list.first(u.kids)!
  assert_eq(first.id, 10)
  assert_eq(first.node.kind, 2)
  assert_eq(list.map(first.kids, (x) => x.id), [111])
  assert_eq(first.node_ids, [1101])
}

test "moving a parsed item changes only its matching recover stamp" {
  let n = tree.Node { kind: 3, field: 0 - 2 - 4, start: 1, end: 3, kids: [tree.node(5, [], 1, 2)] }
  assert_eq(item_stamped(n, 4, 4), n)
  assert_eq(item_stamped(n, 7, 8), n)
  assert_eq(item_stamped(n, 4, 8), tree.Node { ...n, field: 0 - 2 - 8 })
}


test "direct spans equal emitted spans for empty recovered Unicode CRLF and nested documents" {
  var c = parser.compile(item_grammar())
  for text in ["", " \r\n<# café 日本🙂 #> ", TEXT, "<# café 日本🙂 #>\r\n" + TEXT + "\r\n  ",
               "fn a() { { { x = 1; x = 1 } }; { x = 1 } }\r\nfn a() { }",
               "{" + TEXT, "fn a() { x = 1;", "fn a() { x = ; y() }\r\nfn b() { }"] {
    let source = bytes.from_string(text)
    let toks = scan(text, true)!
    let parsed = parser.parse_recovering(c, source, toks)!
    let doc = from_parsed(parsed, source, c)
    assert(same(materialize(doc), parsed), first_difference(materialize(doc), parsed))
    let _ = check_document_spans(doc)
  }
  var lines = parser.compile(line_grammar())
  for text in ["", LINES, "<# café 日本🙂 #>\r\npackage m\r\nfn a() {\r\n x = 1\r\n}\r\n", "fn a() {\r\n x = 1\r\n"] {
    let source = bytes.from_string(text)
    let toks = line_scan(text, true)!
    let parsed = parser.parse_recovering(lines, source, toks)!
    let _ = check_document_spans(from_parsed(parsed, source, lines))
  }
}

test "direct spans preserve empty child lookahead repeated keys placeholders and zero width EOF" {
  // The middle child's first token follows its own leading trivia, and
  // its last node is empty after that token. Its following byte position
  // is the enclosing EOF, not its own token end or trailing-trivia end.
  let token = tree.Token { kind: tree.T_IDENTIFIER, start: 2, end: 5, line: 1, col: 3 }
  let eof = tree.Token { kind: tree.T_EOF, start: 3, end: 3, line: 1, col: 4 }
  let marker = tree.Token { kind: tree.T_PUNCT, start: 1, end: 2, line: 1, col: 2 }
  let vacant = Item { ...empty_unit(), node: tree.node(600, [], 0, 0), node_ids: [100], pieces: [span_test_piece([], 3)], size: 3, tail: 3 }
  let middle = Item { ...empty_unit(), node: tree.node(700, [tree.node(700, [tree.node(700, [], 0, 1)], 0, 1), tree.node(701, [], 1, 1)], 0, 1),
    node_ids: [110, 111, 112, 113], pieces: [span_test_piece([token], 10)], size: 10, tail: 10, toks: 1 }
  let vacant_after = Item { ...vacant, node_ids: [120], pieces: [span_test_piece([], 2)], size: 2, tail: 2 }
  let root = Item { ...empty_unit(), node: tree.node(500, [
      tree.node(601, [], 1, 2), tree.Node { kind: PLACEHOLDER, field: 0, start: 1, end: 2, kids: [] },
      tree.node(702, [tree.Node { kind: PLACEHOLDER, field: 1, start: 2, end: 3, kids: [] }], 2, 3),
      tree.Node { kind: PLACEHOLDER, field: 2, start: 3, end: 4, kids: [] }, tree.node(603, [], 5, 5)
    ], 0, 5), node_ids: [90, 91, 92, 93], kids: [vacant, middle, vacant_after],
    pieces: [span_test_piece([marker], 4), span_test_piece([], 2), span_test_piece([], 1), span_test_piece([eof], 3)], size: 25, tail: 25, toks: 3 }
  let base = Pos { byte: 100, line: 7, col: 4 }
  let _ = check_direct_spans(root, base)
  assert_eq(unit_spans(root, base), [
    500, 101, 125, 90, 601, 111, 111, 91, 600, 111, 111, 100, 702, 111, 114, 92,
    700, 111, 114, 110, 700, 111, 114, 111, 700, 111, 114, 112, 701, 125, 125, 113,
    600, 125, 125, 120, 603, 125, 125, 93,
  ])
  assert_eq(unit_spans(vacant, base), [600, 0, 0, 100])
  let edit = Edit { start: 105, old_end: 105, new_end: 108 }
  assert_eq(left_spans(unit_spans(root, base), edit), left_spans(emitted_unit_spans(root, base), edit))
  let before = left_spans(unit_spans(root, base), Edit { start: 130, old_end: 130, new_end: 130 })
  assert_eq(taken_spans(unit_spans(root, base), before, Edit { start: 130, old_end: 130, new_end: 130 }),
    taken_spans(emitted_unit_spans(root, base), before, Edit { start: 130, old_end: 130, new_end: 130 }))
  assert_eq(map.get(before, span_key(700, 111, 114) + "#0"), some(110))
  assert_eq(map.get(before, span_key(700, 111, 114) + "#1"), some(111))
  assert_eq(map.get(before, span_key(700, 111, 114) + "#2"), some(112))
}

test "direct rebuild mapping matches the emitted oracle before and after incremental mutations" {
  var c = parser.compile(item_grammar())
  var doc = from_parsed(whole(c, TEXT), bytes.from_string(TEXT), c)
  var text = bytes.from_string(TEXT)
  for change in [(at("x = 1") + 4, at("x = 1") + 5, "22"), (0, 0, "<# café 日本🙂 #>\r\n"),
                 (0, 0, "fn repeated() { x = 1; x = 1 }\r\n"), (0, 0, "{")] {
    let edit = Edit { start: change.0, old_end: change.1, new_end: change.0 + bytes.len(bytes.from_string(change.2)) }
    let after = apply(text, edit, bytes.from_string(change.2))
    let toks = scan(bytes.to_string_lossy(after), true)!
    let parsed = parser.parse_recovering(c, after, toks)!
    let reference = emitted_rebuilt(doc, parsed, after, c, edit)
    let direct = rebuilt(doc, parsed, after, c, edit)
    assert_eq(node_ids(direct), node_ids(reference))
    assert_eq(direct.next_node, reference.next_node)
    assert_eq(direct.next_id, reference.next_id)
    assert(same(materialize(direct), materialize(reference)))
    let _ = check_document_spans(direct)
    let status = reparse_status(doc, after, edit, (s, r) => scan(s, r), c)
    let _ = check_document_spans(doc)
    if status != DONE then doc = direct else ()
    text = after
  }
}


test "consecutive empty recover rules get sequential fields slots and distinct node IDs" {
  let grammar = parser.grammar("source_file", [
    ("source_file", parser.wrap("source_file", parser.seq([
      parser.recover_all(parser.wrap("A", parser.seq([]))),
      parser.recover_all(parser.wrap("B", parser.seq([]))),
    ]))),
  ])
  var c = parser.compile(grammar)
  for text in ["", " \r\n"] {
    let source = bytes.from_string(text)
    let parsed = parser.parse_with(c, source, scan(text, false)!)!
    let doc = from_parsed(parsed, source, c)
    assert_eq(list.len(doc.root.kids), 2)
    assert_eq(list.map(doc.root.node.kids, (n) => n.field), [0, 1])
    assert_eq(list.map(doc.root.node.kids, (n) => (n.start, n.end)), [(0, 1), (1, 2)])
    assert_eq(list.map(doc.root.kids, (kid) => kid.node_ids), [[1], [2]])
    assert_eq(node_ids(doc), [3, 1, 2])
    assert_eq(span_slot_order(doc.root.node, 0), 2)
    assert(same(materialize(doc), parsed), first_difference(materialize(doc), parsed))
    let spans = unit_spans(doc.root, Pos { byte: 0, line: 1, col: 1 })
    assert_eq(list.len(spans), 12)
    assert_eq(nametable.name_at(c.names, list.get(spans, 4) ?? -1), "A")
    assert_eq(nametable.name_at(c.names, list.get(spans, 8) ?? -1), "B")
    assert_eq(list.get(spans, 7), some(1))
    assert_eq(list.get(spans, 11), some(2))
    let _ = check_document_spans(doc)
    let edit = Edit { start: 0, old_end: 0, new_end: 0 }
    let direct = rebuilt(doc, parsed, source, c, edit)
    let reference = emitted_rebuilt(doc, parsed, source, c, edit)
    assert_eq(node_ids(direct), node_ids(reference))
    assert_eq(unit_spans(direct.root, Pos { byte: 0, line: 1, col: 1 }), emitted_unit_spans(reference.root, Pos { byte: 0, line: 1, col: 1 }))
  }
}

// Every physical child has exactly one placeholder, in its own-token
// slot, even through non-recover wrappers or inside another recover item.
fn placeholder_rows(n: tree.Node, mut out: List[(Int, Int, Int)]) -> Unit = {
  if n.kind == PLACEHOLDER then list.push(out, (n.field, n.start, n.end))
  else { for k in n.kids { let _ = placeholder_rows(k, out) } }
  ()
}
fn check_child_placeholders(u: Item) -> Unit = {
  var rows: List[(Int, Int, Int)] = []
  let _ = placeholder_rows(u.node, rows)
  assert_eq(list.len(rows), list.len(u.kids))
  assert_eq(span_slot_order(u.node, 0), list.len(u.kids))
  var slot = 0
  var at = 0
  for kid in u.kids {
    slot = slot + piece_count(u, at)
    assert_eq(list.get(rows, at), some((at, slot, slot + 1)))
    let _ = check_child_placeholders(kid)
    slot = slot + 1
    at = at + 1
  }
  ()
}
fn check_zero_recover_case(body: parser.Rule, text: String, root_children: Int) -> Result[Unit, String] = {
  var c = parser.compile(parser.grammar("source_file", [("source_file", parser.wrap("source_file", body))]))
  let source = bytes.from_string(text)
  let toks = scan(text, false) |> result.map_err((e) => e.message)!
  let parsed = parser.parse_with(c, source, toks) |> result.map_err((e) => parser.format_failure(e))!
  let doc = from_parsed(parsed, source, c)
  assert_eq(list.len(doc.root.kids), root_children)
  let _ = check_child_placeholders(doc.root)
  let actual = materialize(doc)
  assert(same(actual, parsed), first_difference(actual, parsed))
  let ids = node_ids(doc)
  assert_eq(list.len(ids), node_count(parsed.root))
  assert(distinct(ids) and list.all(ids, (id) => id > 0), "every parsed node has one distinct positive ID")
  let _ = check_document_spans(doc)
  let edit = Edit { start: 0, old_end: 0, new_end: 0 }
  let direct = rebuilt(doc, parsed, source, c, edit)
  let reference = emitted_rebuilt(doc, parsed, source, c, edit)
  assert(same(materialize(direct), parsed), first_difference(materialize(direct), parsed))
  assert_eq(node_ids(direct), node_ids(reference))
  assert(distinct(node_ids(direct)) and list.all(node_ids(direct), (id) => id > 0), "rebuild keeps repeated zero-width nodes distinct")
  let _ = check_child_placeholders(direct.root)
  let _ = check_document_spans(direct)
  ok(())
}

test "empty recover children before and after consuming children keep preorder slots" {
  let empty = parser.recover_all(parser.wrap("empty", parser.seq([])))
  let token = parser.recover_all(parser.wrap("value", parser.tok("identifier")))
  for text in ["word", " \r\nword \r\n"] {
    let _ = check_zero_recover_case(parser.seq([empty, empty, token]), text, 3)!
    let _ = check_zero_recover_case(parser.seq([token, empty, empty]), text, 3)!
    let _ = check_zero_recover_case(parser.seq([empty, token, empty, empty]), text, 4)!
  }
}

test "ordinary wrappers carry the recover cursor across equal-start children" {
  let empty = parser.recover_all(parser.wrap("empty", parser.seq([])))
  let token = parser.recover_all(parser.wrap("value", parser.tok("identifier")))
  for text in ["word", " \r\nword \r\n"] {
    let body = parser.seq([
      parser.wrap("before", parser.wrap("deeper", parser.seq([empty, empty]))),
      parser.wrap("middle", parser.seq([empty, token, parser.wrap("tail", empty)])),
      empty,
      parser.wrap("after", parser.wrap("deeper", empty)),
    ])
    let _ = check_zero_recover_case(body, text, 7)!
  }
  for text in ["", " \r\n"] {
    let body = parser.seq([
      parser.wrap("group", parser.seq([empty, parser.wrap("inner", empty)])),
      parser.wrap("group", parser.wrap("inner", empty)),
      empty,
    ])
    let _ = check_zero_recover_case(body, text, 4)!
  }
}

test "nested recover items reset their own preorder cursor with repeated empty spans" {
  let empty = parser.recover_all(parser.wrap("same", parser.seq([])))
  let nested = parser.recover_all(parser.wrap("same", parser.seq([
    parser.wrap("group", parser.seq([empty, empty])), empty,
  ])))
  for text in ["", " \r\n"] {
    let _ = check_zero_recover_case(parser.seq([empty, nested, nested, empty]), text, 4)!
  }
  let token = parser.recover_all(parser.wrap("value", parser.tok("identifier")))
  let nested_token = parser.recover_all(parser.wrap("same", parser.seq([empty, token, empty])))
  for text in ["word", " \r\nword \r\n"] {
    let _ = check_zero_recover_case(parser.seq([empty, nested_token, nested, empty]), text, 4)!
  }
  for text in ["{word}", " \r\n{ word \r\n} "] {
    let _ = check_zero_recover_case(parser.seq([parser.lit("{"), nested_token, empty, parser.lit("}")]), text, 2)!
  }
}

test "duplicate placeholder fields trigger the emitted oracle through enclosing units" {
  let a = Item { ...empty_unit(), node: tree.node(600, [], 0, 0), node_ids: [100], pieces: [span_test_piece([], 0)] }
  let b = Item { ...empty_unit(), node: tree.node(700, [tree.node(701, [], 0, 0)], 0, 0), node_ids: [110, 111], pieces: [span_test_piece([], 0)] }
  let duplicate = Item { ...empty_unit(), node: tree.node(500, [
    tree.Node { kind: PLACEHOLDER, field: 0, start: 0, end: 1, kids: [] },
    tree.Node { kind: PLACEHOLDER, field: 0, start: 1, end: 2, kids: [] },
  ], 0, 2), node_ids: [90], kids: [a, b], pieces: [span_test_piece([], 0), span_test_piece([], 0), span_test_piece([], 0)] }
  let after = Item { ...a, node: tree.node(800, [], 0, 0), node_ids: [120] }
  let outer = Item { ...empty_unit(), node: tree.node(400, [
    tree.Node { kind: PLACEHOLDER, field: 0, start: 0, end: 1, kids: [] },
    tree.Node { kind: PLACEHOLDER, field: 1, start: 1, end: 2, kids: [] },
  ], 0, 2), node_ids: [80], kids: [duplicate, after], pieces: [span_test_piece([], 0), span_test_piece([], 0), span_test_piece([], 0)] }
  let base = Pos { byte: 37, line: 8, col: 4 }
  assert_eq(span_slot_order(outer.node, 0), 2)
  assert_eq(unit_spans(duplicate, base), [500, 0, 0, 90, 600, 0, 0, 100, 700, 0, 0, 100, 701, 0, 0, -1])
  // The different child shapes also shift the old ID vector's pairing
  // with nodes after the duplicate. Falling back just that child would
  // change this behavior; the enclosing measured unit must fall back too.
  assert_eq(unit_spans(outer, base), [400, 0, 0, 80, 500, 0, 0, 90, 600, 0, 0, 100, 700, 0, 0, 100, 701, 0, 0, 120, 800, 0, 0, -1])
  let _ = check_direct_spans(outer, base)
}

// These compare the complete fresh-ID mapping with the unchanged string
// oracle, not merely the set of IDs. Forcing one bucket exercises exact
// triple checks and linked-list removal independently of hash quality.
fn check_indexed_mapping(before: List[Int], fresh: List[Int], edit: Edit, buckets: Int, fallback: Bool) -> Map[Int, Int] = {
  let expected = taken_spans(fresh, left_spans(before, edit), edit)
  var index = indexed_left_spans(before, edit, buckets)
  assert_eq(index.overflow, fallback)
  if fallback then {
    assert_eq(list.len(index.rows), 0)
    assert_eq(map.len(index.buckets), 0)
    assert_eq(map.len(index.links), 0)
  } else ()
  let actual = indexed_taken_spans(fresh, index, edit)
  assert_eq(actual, expected)
  actual
}

test "numeric span buckets preserve repeated keys amid forced collisions and unmatched fresh nodes" {
  let before = [
    7, 20, 21, 100, 8, 20, 21, 101, 7, 20, 21, 102,
    7, 20, 22, 103, 8, 20, 21, 104, 7, 20, 21, 105,
    7, 19, 21, 106,
  ]
  let fresh = [
    7, 20, 22, 200, 7, 20, 21, 201, 9, 20, 21, 202,
    8, 20, 21, 203, 7, 20, 21, 204, 7, 19, 21, 205,
    8, 20, 21, 206, 7, 20, 21, 207, 7, 20, 21, 208,
    9, 20, 21, 209, 8, 20, 21, 210,
  ]
  let edit = Edit { start: 10, old_end: 10, new_end: 10 }
  for buckets in [1, 2, SPAN_BUCKETS] {
    let taken = check_indexed_mapping(before, fresh, edit, buckets, false)
    assert_eq(map.get(taken, 200), some(103))
    assert_eq(map.get(taken, 201), some(100))
    assert_eq(map.get(taken, 203), some(101))
    assert_eq(map.get(taken, 204), some(102))
    assert_eq(map.get(taken, 205), some(106))
    assert_eq(map.get(taken, 206), some(104))
    assert_eq(map.get(taken, 207), some(105))
    for id in [202, 208, 209, 210] { assert_eq(map.get(taken, id), none) }
  }
}

test "numeric span buckets apply deletion filtering shifting and merged boundary occurrence order" {
  let before = [
    1, 9, 10, 100, 2, 10, 10, 101, 3, 10, 12, 102,
    2, 12, 12, 103, 4, 12, 15, 104, 5, 9, 15, 105,
    6, 11, 11, 106, 2, 12, 12, 107, 2, 10, 10, 108,
  ]
  let fresh = [
    1, 9, 10, 200, 2, 10, 10, 201, 4, 10, 13, 202,
    2, 10, 10, 203, 5, 9, 13, 204, 2, 10, 10, 205,
    2, 10, 10, 206, 2, 10, 10, 207, 6, 9, 9, 208,
  ]
  let edit = Edit { start: 10, old_end: 12, new_end: 10 }
  for buckets in [1, SPAN_BUCKETS] {
    let taken = check_indexed_mapping(before, fresh, edit, buckets, false)
    assert_eq(map.get(taken, 200), some(100))
    assert_eq(map.get(taken, 201), some(101))
    assert_eq(map.get(taken, 202), some(104))
    assert_eq(map.get(taken, 203), some(103))
    assert_eq(map.get(taken, 205), some(107))
    assert_eq(map.get(taken, 206), some(108))
    for id in [204, 207, 208] { assert_eq(map.get(taken, id), none) }
  }
}

test "numeric span buckets preserve insertion boundary rules and ignore changed fresh occurrences" {
  let before = [1, 9, 10, 100, 2, 10, 10, 101, 3, 10, 12, 102, 4, 9, 12, 103, 5, 12, 12, 104]
  let fresh = [
    1, 9, 10, 200, 2, 10, 10, 201, 3, 10, 12, 202,
    3, 12, 14, 203, 4, 9, 14, 204, 5, 14, 14, 205,
    2, 12, 12, 206, 5, 14, 14, 207,
  ]
  let edit = Edit { start: 10, old_end: 10, new_end: 12 }
  for buckets in [1, SPAN_BUCKETS] {
    let taken = check_indexed_mapping(before, fresh, edit, buckets, false)
    assert_eq(map.get(taken, 200), some(100))
    assert_eq(map.get(taken, 201), some(101))
    assert_eq(map.get(taken, 203), some(102))
    assert_eq(map.get(taken, 205), some(104))
    for id in [202, 204, 206, 207] { assert_eq(map.get(taken, id), none) }
  }
}

test "numeric span hashing handles negative and full width integer triples without packing" {
  let high = 9223372036854775807
  let low = 0 - 9223372036854775807 - 1
  let before = [
    low, low, low + 1, -1, high, high - 1, high, high,
    -7, -20, -19, -9, -7, -20, -19, -10,
    high, low, low, low, low, high, high, 0,
  ]
  let fresh = [
    high, high - 1, high, 200, -7, -20, -19, 201,
    low, low, low + 1, 202, -7, -20, -19, 203,
    low, high, high, 204, high, low, low, 205,
    -7, -20, -19, 206, high - 1, high - 1, high, 207,
  ]
  let edit = Edit { start: 0, old_end: 0, new_end: 0 }
  for buckets in [1, 17, SPAN_BUCKETS] {
    let taken = check_indexed_mapping(before, fresh, edit, buckets, false)
    assert_eq(map.get(taken, 200), some(high))
    assert_eq(map.get(taken, 201), some(-9))
    assert_eq(map.get(taken, 202), some(-1))
    assert_eq(map.get(taken, 203), some(-10))
    assert_eq(map.get(taken, 204), some(0))
    assert_eq(map.get(taken, 205), some(low))
    assert_eq(map.get(taken, 206), none)
    assert_eq(map.get(taken, 207), none)
  }
}

test "numeric span buckets fall back above the collision and duplicate bound before matching" {
  let edit = Edit { start: 0, old_end: 0, new_end: 0 }
  for same_key in [true, false] {
    for count in [SPAN_CHAIN_LIMIT, SPAN_CHAIN_LIMIT + 1, SPAN_CHAIN_LIMIT * 3] {
      var before: List[Int] = []
      var fresh: List[Int] = []
      var i = 0
      while i < count {
        let kind = if same_key then 7 else i
        for v in [kind, 10, 11, 1000 + i] { list.push(before, v) }
        // Reverse the keys, without reversing each key's old occurrence order.
        let fresh_kind = if same_key then 7 else count - i - 1
        for v in [fresh_kind, 10, 11, 2000 + i] { list.push(fresh, v) }
        i = i + 1
      }
      for v in [999, 10, 11, 3000, 7, 10, 11, 3001] { list.push(fresh, v) }
      let _ = check_indexed_mapping(before, fresh, edit, 1, count > SPAN_CHAIN_LIMIT)
      if same_key then { let _ = check_indexed_mapping(before, fresh, edit, SPAN_BUCKETS, count > SPAN_CHAIN_LIMIT) } else ()
    }
  }
}

test "numeric span mapping agrees with the string oracle for deterministic varied span lists" {
  var seed = 1729
  var trial = 0
  while trial < 40 {
    var before: List[Int] = []
    var fresh: List[Int] = []
    var i = 0
    while i < 48 {
      seed = (seed * 48271) % 2147483647
      let kind = seed % 9 - 4
      let start = (seed / 9) % 31 - 15
      let end = start + (seed / 279) % 5
      for v in [kind, start, end, 1000 + i] { list.push(before, v) }
      // Some matching, shifted, duplicate, and absent keys; IDs may repeat
      // too, exercising the old map's last-write rule for malformed inputs.
      let shift = i % 5 - 2
      for v in [kind, start + shift, end + shift, 2000 + i / 2] { list.push(fresh, v) }
      if i % 7 == 0 then {
        for v in [kind, start, end, 3000 + i] { list.push(before, v) }
        for v in [kind, start, end, 4000 + i] { list.push(fresh, v) }
      } else ()
      i = i + 1
    }
    let edit = Edit { start: trial % 11 - 5, old_end: trial % 11 - 5 + trial % 4, new_end: trial % 11 - 5 + trial % 6 }
    for buckets in [1, 7, SPAN_BUCKETS] { let _ = check_indexed_mapping(before, fresh, edit, buckets, false) }
    trial = trial + 1
  }
}

test "numeric span mapping retains empty truncated and repeated fresh ID compatibility" {
  let edit = Edit { start: 0, old_end: 0, new_end: 0 }
  let _ = check_indexed_mapping([], [], edit, 1, false)
  let _ = check_indexed_mapping([7, 10, 11], [7, 10, 11, 200], edit, 1, false)
  let _ = check_indexed_mapping([7, 10, 11, 100], [7, 10, 11], edit, 1, false)
  let taken = check_indexed_mapping([7, 10, 11, 100, 8, 10, 11, 101, 9, 10, 11],
    [7, 10, 11, 200, 8, 10, 11, 200, 8, 10, 11, 200, 7, 10], edit, 1, false)
  assert_eq(map.get(taken, 200), some(101))
}

test "numeric window mapping shares occurrence order across children and keeps string fallback" {
  let edit = Edit { start: 10, old_end: 10, new_end: 10 }
  let p = Pos { byte: 37, line: 8, col: 4 }
  for count in [6, SPAN_CHAIN_LIMIT + 1] {
    var old_kids: List[Item] = []
    var fresh_kids: List[Item] = []
    var pieces: List[Piece] = []
    var i = 0
    while i < count {
      let kind = i % 3
      list.push(old_kids, Item { ...empty_unit(), node: tree.node(kind, [], 0, 0), node_ids: [1000 + i], pieces: [span_test_piece([], 0)] })
      list.push(fresh_kids, Item { ...empty_unit(), node: tree.node(2 - kind, [], 0, 0), node_ids: [2000 + i], pieces: [span_test_piece([], 0)] })
      list.push(pieces, span_test_piece([], i % 3))
      i = i + 1
    }
    list.push(pieces, span_test_piece([], 0))
    let old = Item { ...empty_unit(), kids: old_kids, pieces: pieces }
    let fresh = Item { ...empty_unit(), kids: fresh_kids, pieces: pieces }
    for bounds in [(0, count - 1), (1, count - 2), (0, -1)] {
      let expected = matched_ids(fresh, 0, count, p, edit, untouched_before(old, bounds.0, bounds.1, p, edit))
      var index = indexed_untouched_before(old, bounds.0, bounds.1, p, edit, 1)
      assert_eq(index.overflow, bounds.1 - bounds.0 + 1 > SPAN_CHAIN_LIMIT)
      assert_eq(indexed_matched_ids(fresh, 0, count, p, edit, index), expected)
    }
  }
}

test "numeric window mapping matches existing helpers at varied bases and edit boundaries" {
  var c = parser.compile(item_grammar())
  let old = from_parsed(whole(c, TEXT), bytes.from_string(TEXT), c)
  for change in [(at("x = 1") + 4, at("x = 1") + 5, "22"), (0, 0, "fn before() { }\r\n"),
                 (0, 0, "<# café 日本🙂 #>\r\n"), (at("fn b"), bytes.len(bytes.from_string(TEXT)), "")] {
    let edit = Edit { start: change.0, old_end: change.1, new_end: change.0 + bytes.len(bytes.from_string(change.2)) }
    let text = apply(bytes.from_string(TEXT), edit, bytes.from_string(change.2))
    let fresh = numbered_from(whole(c, bytes.to_string_lossy(text)), text, c, old.next_id, old.next_node)
    for p in [Pos { byte: 0, line: 1, col: 1 }, Pos { byte: 37, line: 8, col: 4 }] {
      for buckets in [1, SPAN_BUCKETS] {
        let expected = matched_ids(fresh.root, 0, list.len(fresh.root.kids), p, edit,
          untouched_before(old.root, 0, list.len(old.root.kids) - 1, p, edit))
        var index = indexed_untouched_before(old.root, 0, list.len(old.root.kids) - 1, p, edit, buckets)
        assert_eq(indexed_matched_ids(fresh.root, 0, list.len(fresh.root.kids), p, edit, index), expected)
      }
    }
  }
}
