// names — the table a parse carries so a reader can say what a node is.
//
// A node's kind and field are numbers; this is what they stand for. The table
// is built once per grammar and travels with the parse, so it is stored the
// way a token stream is stored: the bytes end to end, with the bounds beside
// them. A list of strings would be copied string by string at every hand-off.

// The names, end to end in one byte string with the bounds beside them. A
// list of strings is copied string by string at every hand-off — a thousand
// allocations each time a parse is passed to a reader — where this is two.
type Names = { blob: Bytes, start: List[Int], end: List[Int] }

// Joined once with a separator no name can hold — a grammar's kinds, fields
// and spellings are source text, and source text holds no NUL — then cut by
// scanning for it. Building the blob a string at a time cost an allocation per
// name; this costs four for the whole table.
fn names_of(texts: List[String]) -> Names = {
  let blob = bytes.from_string(list.join(texts, "\u{0000}"))
  var start: List[Int] = []
  var end: List[Int] = []
  var from = 0
  var i = 0
  let width = bytes.len(blob)
  while i <= width {
    if i == width or bytes.get_or(blob, i, -1) == 0 then {
      list.push(start, from)
      list.push(end, i)
      from = i + 1
    } else ()
    i = i + 1
  }
  Names { blob: blob, start: start, end: end }
}

fn name_at(names: Names, id: Int) -> String = {
  let from = match list.get(names.start, id) { some(v) => v, none => 0 }
  let to = match list.get(names.end, id) { some(v) => v, none => 0 }
  if id < 0 or to < from then "" else bytes.to_string_lossy(bytes.slice(names.blob, from, to))
}

// The number a name answers to, or -1 for a name this grammar never uses. The
// wanted name is read as bytes once and compared where the names already are.
fn id_of(names: Names, name: String) -> Int = {
  let want = bytes.from_string(name)
  let width = bytes.len(want)
  var found = -1
  var i = 0
  while found < 0 and i < list.len(names.start) {
    let from = match list.get(names.start, i) { some(v) => v, none => 0 }
    let to = match list.get(names.end, i) { some(v) => v, none => 0 }
    if to - from == width then {
      var k = 0
      var same = true
      while same and k < width {
        same = bytes.get_or(names.blob, from + k, -1) == bytes.get_or(want, k, -2)
        k = k + 1
      }
      if same then found = i else ()
    } else ()
    i = i + 1
  }
  found
}

// A token is a range, not a copy. `start` and `end` count bytes into the
// source the lexer read, and the text is whatever those bytes are: no stage of
// the pipeline ever rewrites a token's text, so carrying an owned string on
// the record cost one allocation per token per hand-off and said nothing the
// offsets did not already say.
type Token = { kind: Int, start: Int, end: Int, line: Int, col: Int }

// ── token kinds ───────────────────────────────────────────────────────────
//
// A kind is a number, not a name. Every stage copies the token stream — the
// lexer builds it, a layout pass rewrites it, the reader hands it to the
// parser — and a record of scalars is copied without touching the heap, where
// a record holding an owned string costs one allocation per copy per field.
// The names live here rather than in a language package because a grammar
// names its terminals (`tok("identifier")`) and the compiler has to resolve
// those to the numbers the lexer wrote.
//
// `kind_names` is the one table: an id is a position in it, so the two
// directions cannot disagree and a new kind is one line. A name it does not
// hold answers -1, which no token carries and so no terminal ever matches.
let T_NONE = 0             // the scanner has not decided yet; never in a stream
let T_ERROR = 1
let T_EOF = 2
let T_IDENTIFIER = 3
let T_KEYWORD = 4
let T_TYPE_NAME = 5
let T_PUNCT = 6
let T_NEG = 7
let T_INTEGER = 8
let T_FLOAT = 9
let T_IMAGINARY = 10
let T_NUMBER = 11
let T_STRING = 12
let T_RUNE = 13
let T_BYTES = 14
let T_COMMENT = 15
let T_NEWLINE = 16
let T_INDENT = 17
let T_DEDENT = 18
let T_CONTINUATION = 19
let T_FSTRING_START = 20
let T_FSTRING_MIDDLE = 21
let T_FSTRING_END = 22
let T_TSTRING_START = 23
let T_TSTRING_MIDDLE = 24
let T_TSTRING_END = 25

// Naming one token at a time rebuilds the table; a loop over a stream holds it
// once and calls `kind_name_in`.