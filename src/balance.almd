// balance — the check a language without a grammar can still have.
//
// A parser is the right gate, and gramide has one for Almide and Go. For
// everything else the honest options are no gate at all, or the language's
// own compiler — which needs the whole project to tell a syntax error from
// a missing symbol, and one that refuses a correct edit is worse than none.
//
// This is the third option. It lexes a C-family file (line and block
// comments, string, character and raw-string literals) and asks two
// questions a valid file always answers yes to: do `()`, `[]` and `{}`
// balance and nest, and does every literal and comment close? A file that
// fails either is broken in every C-family language, so a rejection here is
// never wrong. It cannot see a missing semicolon, and does not claim to.
//
// This is exactly the failure it exists for: a generation that stops
// halfway leaves an open brace, and a model that answers with prose or a
// markdown fence leaves an unterminated something. Those were the writes
// that reached disk when there was no gate.

import self.lexer.{ is_space }
import self.tree

type Flaw = { line: Int, col: Int, message: String }

fn at(bytes: List[Int], i: Int) -> Int = list.get(bytes, i) ?? -1

fn closer_of(b: Int) -> Int = if b == 40 then 41 else if b == 91 then 93 else 125   // ( → ) , [ → ] , { → }
fn name_of(b: Int) -> String = if b == 40 then "(" else if b == 91 then "[" else if b == 123 then "{"
  else if b == 41 then ")" else if b == 93 then "]" else "}"

// Skip a string opened at `start` with `quote`; `raw` disables escapes.
// Returns the index just past the closing quote, or -1 when unterminated.
fn skip_quoted(bytes: List[Int], start: Int, quote: Int, raw: Bool, multiline: Bool) -> Int = {
  var i = start + 1
  var done = false
  var end = -1
  while not done {
    let b = at(bytes, i)
    if b == -1 then done = true
    else if b == 92 and not raw then i = i + 2
    else if b == quote then { end = i + 1; done = true }
    else if b == 10 and not multiline then done = true
    else i = i + 1
  }
  end
}

// A Java text block or a C++/Python triple-quoted string: `"""…"""`.
fn skip_triple(bytes: List[Int], start: Int, quote: Int) -> Int = {
  var i = start + 3
  var done = false
  var end = -1
  while not done {
    let b = at(bytes, i)
    if b == -1 then done = true
    else if b == 92 then i = i + 2
    else if b == quote and at(bytes, i + 1) == quote and at(bytes, i + 2) == quote then { end = i + 3; done = true }
    else i = i + 1
  }
  end
}

// `R"delim(…)delim"` — C++ raw strings, whose body may hold anything.
fn skip_raw_cxx(bytes: List[Int], start: Int) -> Int = {
  var i = start + 2                                   // past R"
  var delim: List[Int] = []
  var bad = false
  while at(bytes, i) != 40 and not bad {              // up to (
    if at(bytes, i) == -1 or list.len(delim) > 16 then bad = true else { list.push(delim, at(bytes, i)); i = i + 1 }
  }
  if bad then -1
  else {
    i = i + 1
    var done = false
    var end = -1
    while not done {
      if at(bytes, i) == -1 then done = true
      else if at(bytes, i) == 41 then {               // ) delim "
        var k = 0
        var same = true
        while same and k < list.len(delim) { if at(bytes, i + 1 + k) != (list.get(delim, k) ?? -2) then same = false else k = k + 1 }
        if same and at(bytes, i + 1 + list.len(delim)) == 34 then { end = i + 2 + list.len(delim); done = true } else i = i + 1
      }
      else i = i + 1
    }
    end
  }
}

// The first thing wrong with this file, or none.
fn check(source: String) -> Option[Flaw] = {
  let bytes = string.to_bytes(source)
  let n = list.len(bytes)
  var stack: List[Int] = []          // byte of each open delimiter
  var lines: List[Int] = []          // the line each was opened on
  var i = 0
  var line = 1
  var line_start = 0
  var flaw: Option[Flaw] = none
  while i < n and option.is_none(flaw) {
    let b = at(bytes, i)
    let col = i - line_start + 1
    if b == 10 then { line = line + 1; i = i + 1; line_start = i }
    else if is_space(b) then i = i + 1
    else if b == 47 and at(bytes, i + 1) == 47 then { while i < n and at(bytes, i) != 10 { i = i + 1 } }
    else if b == 47 and at(bytes, i + 1) == 42 then {
      let open_line = line
      i = i + 2
      var closed = false
      while i < n and not closed {
        if at(bytes, i) == 10 then { line = line + 1; line_start = i + 1 } else ()
        if at(bytes, i) == 42 and at(bytes, i + 1) == 47 then { closed = true; i = i + 2 } else i = i + 1
      }
      if not closed then { flaw = some(Flaw { line: open_line, col: col, message: "unterminated block comment" }) } else ()
    }
    else if (b == 82 or b == 114) and at(bytes, i + 1) == 34 then {          // R"…(…)…"
      let e = skip_raw_cxx(bytes, i)
      if e < 0 then { flaw = some(Flaw { line: line, col: col, message: "unterminated raw string" }) }
      else { var k = i; while k < e { if at(bytes, k) == 10 then { line = line + 1; line_start = k + 1 } else (); k = k + 1 }; i = e }
    }
    else if b == 34 or b == 39 or b == 96 then {
      let triple = b == 34 and at(bytes, i + 1) == 34 and at(bytes, i + 2) == 34
      // a backtick string (Go, JavaScript) spans lines; a plain one does not
      let e = if triple then skip_triple(bytes, i, b) else skip_quoted(bytes, i, b, b == 96, b == 96)
      if e < 0 then { flaw = some(Flaw { line: line, col: col, message: "unterminated " + (if b == 39 then "character literal" else "string") }) }
      else { var k = i; while k < e { if at(bytes, k) == 10 then { line = line + 1; line_start = k + 1 } else (); k = k + 1 }; i = e }
    }
    else if b == 40 or b == 91 or b == 123 then { list.push(stack, b); list.push(lines, line); i = i + 1 }
    else if b == 41 or b == 93 or b == 125 then {
      match list.last(stack) {
        none => { flaw = some(Flaw { line: line, col: col, message: "closing `" + name_of(b) + "` with nothing open" }) },
        some(open) => {
          if closer_of(open) != b then
            flaw = some(Flaw { line: line, col: col, message: "closing `" + name_of(b) + "` does not match the `" + name_of(open) + "` opened on line " + int.to_string(list.last(lines) ?? 0) })
          else { stack = list.take(stack, list.len(stack) - 1); lines = list.take(lines, list.len(lines) - 1) }
        },
      }
      i = i + 1
    }
    else i = i + 1
  }
  match flaw {
    some(f) => some(f),
    none => match list.last(stack) {
      none => none,
      some(open) => some(Flaw { line: list.last(lines) ?? 0, col: 1, message: "`" + name_of(open) + "` opened here is never closed" }),
    },
  }
}

test "balanced files pass, including the awkward literals" {
  assert_eq(check("int main() { return 0; }\n"), none)
  assert_eq(check("char c = '}';\nif (a) { b(); }\n"), none)
  assert_eq(check("// } a comment\n/* { */\nvoid f() {}\n"), none)
  assert_eq(check("String s = \"a } b\";\nclass X { }\n"), none)
  assert_eq(check("var s = `a ) multi\nline }`;\nfunction f() {}\n"), none)
  assert_eq(check("auto s = R\"x(anything ) { here)x\";\nint f() { return 1; }\n"), none)
  assert_eq(check("String t = \"\"\"\n  } not a brace\n  \"\"\";\nclass Y {}\n"), none)
}

test "a truncated file, a mismatch and an unterminated literal are all caught" {
  assert_eq(option.map(check("void f() {\n  g();\n"), (x) => x.message), some("`{` opened here is never closed"))
  assert_eq(option.map(check("f(a]\n"), (x) => x.line), some(1))
  assert(string.contains(option.map(check("f(a]"), (x) => x.message) ?? "", "does not match"))
  assert(string.contains(option.map(check("s = \"abc\n"), (x) => x.message) ?? "", "unterminated string"))
  assert(string.contains(option.map(check("/* open\n"), (x) => x.message) ?? "", "unterminated block comment"))
  assert(string.contains(option.map(check("}\n"), (x) => x.message) ?? "", "nothing open"))
}
