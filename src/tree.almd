import self.names as nametable

// tree — the syntax tree gramide produces, and the ways to look at it.
//
// A Node spans a range of TOKENS (start inclusive, end exclusive); byte and
// line positions come from the tokens, so a node never carries a position
// that could drift from the text it names. `field` is the name the parent's
// grammar gave this child ("name", "body", …) or "" when the child is
// positional. Leaves are tokens the grammar asked to keep (identifiers,
// literals); punctuation and keywords are matched and dropped unless a rule
// keeps them on purpose.

// A node's kind and field are numbers into a name table the parse carries with
// it: the same name always answers the same number, so a reader compares
// integers, and building a node no longer copies two strings out of the
// grammar for every node in the file.
type Node = { kind: Int, field: Int, start: Int, end: Int, kids: List[Node] }

// A token is a range, not a copy. `start` and `end` count bytes into the
// source the lexer read, and the text is whatever those bytes are: no stage of
// the pipeline ever rewrites a token's text, so carrying an owned string on
// the record cost one allocation per token per hand-off and said nothing the
// offsets did not already say.
type Token = { kind: Int, start: Int, end: Int, line: Int, col: Int }

fn token_text(source: Bytes, t: Token) -> String = bytes.to_string_lossy(bytes.slice(source, t.start, t.end))

// ── token kinds ───────────────────────────────────────────────────────────
//
// A kind is a number, not a name. Every stage copies the token stream — the
// lexer builds it, a layout pass rewrites it, the reader hands it to the
// parser — and a record of scalars is copied without touching the heap, where
// a record holding an owned string costs one allocation per copy per field.
// The names live here rather than in a language package because a grammar
// names its terminals (`tok("identifier")`) and the compiler has to resolve
// those to the numbers the lexer wrote.
//
// `kind_names` is the one table: an id is a position in it, so the two
// directions cannot disagree and a new kind is one line. A name it does not
// hold answers -1, which no token carries and so no terminal ever matches.
let T_NONE = 0             // the scanner has not decided yet; never in a stream
let T_ERROR = 1
let T_EOF = 2
let T_IDENTIFIER = 3
let T_KEYWORD = 4
let T_TYPE_NAME = 5
let T_PUNCT = 6
let T_NEG = 7
let T_INTEGER = 8
let T_FLOAT = 9
let T_IMAGINARY = 10
let T_NUMBER = 11
let T_STRING = 12
let T_RUNE = 13
let T_BYTES = 14
let T_COMMENT = 15
let T_NEWLINE = 16
let T_INDENT = 17
let T_DEDENT = 18
let T_CONTINUATION = 19
let T_FSTRING_START = 20
let T_FSTRING_MIDDLE = 21
let T_FSTRING_END = 22
let T_TSTRING_START = 23
let T_TSTRING_MIDDLE = 24
let T_TSTRING_END = 25

fn kind_names() -> List[String] = ["", "error", "eof", "identifier", "keyword", "type_name",
  "punct", "neg", "integer", "float", "imaginary", "number", "string", "rune", "bytes",
  "comment", "newline", "indent", "dedent", "continuation",
  "fstring_start", "fstring_middle", "fstring_end",
  "tstring_start", "tstring_middle", "tstring_end"]

// Naming one token at a time rebuilds the table; a loop over a stream holds it
// once and calls `kind_name_in`.
fn kind_name_in(names: List[String], id: Int) -> String = match list.get(names, id) {
  some(name) => name,
  none => "",
}
fn kind_name(id: Int) -> String = kind_name_in(kind_names(), id)
fn kind_id(name: String) -> Int = match list.index_of(kind_names(), name) {
  some(id) => id,
  none => -1,
}

fn leaf(kind: Int, at: Int) -> Node = {
  let none_kids: List[Node] = []
  Node { kind: kind, field: -1, start: at, end: at + 1, kids: none_kids }
}

fn node(kind: Int, kids: List[Node], start: Int, end: Int) -> Node =
  Node { kind: kind, field: -1, start: start, end: end, kids: kids }

fn with_field(n: Node, field: Int) -> Node =
  Node { kind: n.kind, field: field, start: n.start, end: n.end, kids: n.kids }

// The same, in place. `with_field` rebuilds the record, and the native
// backend renders that as a copy of the node's whole subtree; a parser that
// names a child on every match cannot afford one copy of the subtree per
// name. Assigning through a `mut` binding writes the one field.
fn set_field(mut n: Node, field: Int) -> Unit = {
  n.field = field
}

// The child a grammar named `field`, if the node has one.
// A name this grammar never uses is -1, and so is "this child has no name":
// asking for one must not answer with the other.
fn child(n: Node, field: Int) -> Option[Node] = if field < 0 then none else list.find(n.kids, (k) => k.field == field)

fn children_of_kind(n: Node, kind: Int) -> List[Node] = list.filter(n.kids, (k) => k.kind == kind)

// The text a node spans, with the original gaps — the only way to get at
// whitespace and comments, which the token stream drops.
//
// A token's `start` and `end` count bytes, because the lexer reads bytes,
// while `string.slice` counts characters. On a file holding a `§` or a `—`
// anywhere before the node the two disagree and the slice comes out shifted,
// so the source is cut as bytes. That costs a pass over the whole source per
// call: this is for pulling one node out of a file, not for walking a tree.
// `span_text` below is the one to use in a walk.
fn text_of(n: Node, toks: List[Token], source: Bytes) -> String = {
  let first = list.get(toks, n.start)
  let last = list.get(toks, n.end - 1)
  match (first, last) {
    (some(f), some(l)) => bytes.to_string_lossy(bytes.slice(source, f.start, l.end)),
    _ => "",
  }
}

// The text a node spans, joined from its tokens. No source, no gaps, and
// nothing to get wrong about bytes: `Vec < u8 >` comes back as `Vec<u8>`.
// This is what a name wants.
fn span_text(n: Node, toks: List[Token], source: Bytes) -> String = {
  var s = ""
  var i = n.start
  while i < n.end {
    match list.get(toks, i) { some(t) => { s = s + token_text(source, t) }, none => () }
    i = i + 1
  }
  s
}

// The text of a leaf's single token.
fn leaf_text(n: Node, toks: List[Token], source: Bytes) -> String = match list.get(toks, n.start) {
  some(t) => token_text(source, t),
  none => "",
}

fn start_line(n: Node, toks: List[Token]) -> Int = match list.get(toks, n.start) {
  some(t) => t.line,
  none => 0,
}

fn end_line(n: Node, toks: List[Token]) -> Int = match list.get(toks, n.end - 1) {
  some(t) => t.line,
  none => 0,
}

// S-expression rendering, the form every parser test compares against.
// `(kind field:(child) (child))` — leaves print their kind only, so a tree
// stays stable across whitespace and renames of the text it covers.
fn sexp(n: Node, table: nametable.Names) -> String = {
  let head = if n.field < 0 then "(" + nametable.name_at(table, n.kind) else nametable.name_at(table, n.field) + ":(" + nametable.name_at(table, n.kind)
  if list.is_empty(n.kids) then head + ")"
  else head + " " + list.join(list.map(n.kids, (k) => sexp(k, table)), " ") + ")"
}

fn count_nodes(n: Node) -> Int = 1 + list.sum(list.map(n.kids, (k) => count_nodes(k)))

// Depth-first walk collecting every node for which `keep` says yes.
fn collect(n: Node, keep: (Node) -> Bool) -> List[Node] = {
  let here = if keep(n) then [n] else []
  here + list.flat_map(n.kids, (k) => collect(k, keep))
}

test "sexp renders fields and leaves" {
  let table = nametable.names_of(["identifier", "name", "function_declaration", "block"])
  let name = with_field(leaf(0, 1), 1)
  let f = node(2, [name, node(3, [], 2, 4)], 0, 4)
  assert_eq(sexp(f, table), "(function_declaration name:(identifier) (block))")
  assert_eq(count_nodes(f), 3)
}

test "child by field" {
  let name = with_field(leaf(0, 1), 1)
  let f = node(2, [name], 0, 2)
  assert_eq(option.map(child(f, 1), (n) => n.kind), some(0))
  assert_eq(child(f, 9), none)
}

test "a node's text is cut by bytes, not by characters" {
  // `//! —` is 6 characters and 8 bytes, so a character-indexed cut of the
  // source would return `neDb` here. Offsets come from a lexer reading bytes.
  let source = bytes.from_string("//! —\nSpineDb x")
  let toks = [
    Token { kind: T_IDENTIFIER, start: 8, end: 15, line: 2, col: 1 },
    Token { kind: T_IDENTIFIER, start: 16, end: 17, line: 2, col: 9 },
  ]
  let n = node(0, [], 0, 1)
  assert_eq(text_of(n, toks, source), "SpineDb")
  assert_eq(span_text(node(1, [], 0, 2), toks, source), "SpineDbx")
}

test "kind names and ids are one table read both ways" {
  assert_eq(kind_id("identifier"), T_IDENTIFIER)
  assert_eq(kind_name(T_IDENTIFIER), "identifier")
  assert_eq(kind_name(T_TSTRING_END), "tstring_end")
  assert_eq(kind_id(kind_name(T_NEWLINE)), T_NEWLINE)
  // A terminal the table does not name can never match a token.
  assert_eq(kind_id("not_a_kind"), -1)
  assert_eq(kind_name(-1), "")
  assert_eq(kind_name(list.len(kind_names())), "")
}
