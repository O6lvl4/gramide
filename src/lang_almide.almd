// lang_almide — the Almide grammar, written as a value.
//
// Read this next to docs/GRAMMAR.md in the Almide repository; the rule
// names follow it. The tree it produces is what `outline` walks, so the
// node kinds that matter are the declarations (function_declaration,
// type_declaration, let_declaration, test_declaration, protocol_declaration)
// and their `name` / `body` fields. Expressions get a shallower tree —
// binary operators fold into `binary` nodes, postfix chains stay flat —
// which is all a syntax gate or an outline needs.
//
// Deliberately more permissive than the compiler in a few places (chained
// comparisons, `|>` with an arbitrary right-hand side): a file gramide
// accepts may still fail `almide check`, but a file gramide rejects is
// broken for the compiler too. That direction is the one a syntax gate
// must get right.
//
// Newlines: the lexer emits one `newline` token per run. `nl` allows one
// where a line may continue (after an opening bracket, a comma, `=`, `=>`,
// `then`, `else`, before or after a binary operator); `sep` is what
// separates statements and declarations.

import self.lex
import self.tree
import self.parser
import self.parser.{ tok, lit, keep, r, seq, alt, rep, rep1, opt, wrap, field, ahead, leftf, lits, keeps, grammar, recover, recover_all, recover_all_keeping }

let nl = opt(tok("newline"))
let sep = rep1(alt([lit(";"), tok("newline")]))

// `a, b, c` with newlines allowed around commas and an optional trailing comma.
fn items(x: parser.Rule) -> parser.Rule =
  opt(seq([nl, x, rep(seq([nl, lit(","), nl, x])), nl, opt(lit(","))]))

fn bracketed(open: String, x: parser.Rule, close: String) -> parser.Rule =
  seq([lit(open), items(x), nl, lit(close)])

let name = alt([tok("identifier"), tok("type_name")])
let ident = tok("identifier")
let tname = tok("type_name")
let qualified_tname = seq([opt(seq([ident, lit(".")])), tname])
let dotted = wrap("path", seq([ident, rep(seq([lit("."), ident]))]))
let expr = r("expr")
let ty = r("type")
let pattern = r("pattern")
let block = r("block")

// ── how Almide is lexed ───────────────────────────────────────────────────
//
// `&&` and `||` are not Almide (it has `and` / `or`), but lexing them as one
// token each makes the parse error name the whole operator a writer typed
// rather than half of it. The four foreign keywords at the end of KEYWORDS are
// there for the same reason: rejecting them makes `return x` or `class Foo`
// fail instead of parsing as two statements.
let KEYWORDS = ["module", "import", "type", "protocol", "for", "in", "fn", "let", "var", "mut", "if", "then", "else",
  "match", "true", "false", "not", "and", "or", "pub", "effect", "test", "guard", "break", "continue", "while",
  "local", "mod", "fan",
  "return", "class", "impl", "deriving", "newtype"]

let OPERATORS = ["..<", "...", "?.", "??", "->", "=>", "==", "!=", "<=", ">=", "|>", ">>", "**", "..", "&&", "||",
  "=", "+", "-", "*", "/", "%", "^", "<", ">", "!", "?", ".", ",", ":", ";", "(", ")", "[", "]",
  "{", "}", "|", "@", "&", "#"]

fn spec() -> lex.Spec = lex.Spec {
  keywords: KEYWORDS,
  operators: OPERATORS,
  numbers: lex.N_ALMIDE,
  strings: lex.S_ALMIDE,
  newlines: lex.NL_EVERY,
  ends_kw: [],
  line_comment: [47, 47],                 // //
  block_open: [47, 42],                   // /*
  block_close: [42, 47],                  // */
  nested_block: true,
  block_comment_newline: false,
  upper_is_type: true,
  backtick_ident: true,
  neg_token: true,
}

fn almide() -> parser.Grammar = grammar("source_file", [
  ("source_file", wrap("source_file", seq([opt(sep), opt(seq([recover_all_keeping(r("decl"), r("decl_head")), rep(recover_all_keeping(seq([sep, r("decl")]), seq([sep, r("decl_head")]))), opt(sep)]))]))),

  // ── declarations ──────────────────────────────────────────────────────
  ("decl", alt([r("import"), r("module"), r("type_decl"), r("fn_decl"), r("protocol_decl"),
                r("test_where_def"), r("test_decl"), r("top_let")])),
  // what is still worth knowing about a declaration that is half-typed: its
  // kind and its name
  ("decl_head", alt([
     wrap("function_declaration", seq([r("visibility"), opt(lit("effect")), lit("fn"), field("name", r("fn_name"))])),
     wrap("type_declaration", seq([opt(lits(["local", "mod"])), lit("type"), field("name", tname)])),
     wrap("protocol_declaration", seq([lit("protocol"), field("name", tname)])),
     wrap("test_declaration", seq([lit("test"), field("name", tok("string"))])),
     wrap("let_declaration", seq([r("visibility"), lits(["let", "var"]), field("name", name)]))])),
  ("import", wrap("import", seq([lit("import"), field("path", dotted),
     opt(alt([seq([lit("."), bracketed("{", name, "}")]), seq([lit("as"), ident])]))]))),
  ("module", wrap("module", seq([lit("module"), field("path", dotted)]))),
  ("attr", wrap("attribute", seq([lit("@"), field("name", ident), opt(bracketed("(", r("attr_arg"), ")"))]))),
  ("attr_arg", alt([seq([ident, lit("="), expr]), expr])),
  ("visibility", seq([opt(lit("pub")), opt(lits(["local", "mod"]))])),

  ("type_decl", wrap("type_declaration", seq([opt(lits(["local", "mod"])), lit("type"), field("name", tname),
     opt(r("generic_params")), opt(seq([lit(":"), ty, rep(seq([lit(","), ty]))])),
     lit("="), nl, field("body", r("type_body"))]))),
  ("type_body", alt([r("variant_type"), r("record_type"), ty])),
  ("record_type", wrap("record_type", seq([lit("{"), items(r("field_decl")), nl, opt(lit("..")), nl, lit("}")]))),
  ("field_decl", wrap("field", seq([rep(r("attr")), field("name", name), opt(seq([lit("as"), tok("string")])),
     lit(":"), field("type", ty), opt(seq([lit("="), expr]))]))),
  ("variant_type", wrap("variant_type", alt([
     seq([nl, lit("|"), nl, r("variant"), rep(seq([nl, lit("|"), nl, r("variant")]))]),
     seq([r("variant"), rep1(seq([nl, lit("|"), nl, r("variant")]))])]))),
  ("variant", wrap("variant", seq([field("name", tname),
     opt(alt([bracketed("(", ty, ")"), bracketed("{", r("field_decl"), "}")]))]))),
  ("generic_params", bracketed("[", r("gparam"), "]")),
  ("gparam", seq([tname, opt(seq([lit(":"), alt([r("record_type"), seq([ty, rep(seq([lit("+"), ty]))])])]))])),

  ("fn_decl", wrap("function_declaration", seq([rep(seq([r("attr"), nl])), r("visibility"), opt(lit("effect")), lit("fn"),
     field("name", r("fn_name")), opt(r("generic_params")), r("params"), lit("->"), nl, field("return", ty),
     opt(seq([nl, lit("="), nl, field("body", r("fn_body"))]))]))),
  ("fn_name", alt([wrap("method_name", seq([field("type", tname), lit("."), field("name", ident)])), ident])),
  ("params", wrap("parameters", bracketed("(", r("param"), ")"))),
  ("param", wrap("parameter", seq([rep(r("attr")), opt(lit("mut")), field("name", ident),
     opt(seq([lit(":"), field("type", ty)])), opt(seq([lit("="), expr]))]))),
  ("fn_body", alt([r("braceless"), expr])),
  ("braceless", wrap("block", seq([ahead(lits(["let", "var", "guard"])), r("stmt"), rep(seq([sep, r("stmt")]))]))),

  ("protocol_decl", wrap("protocol_declaration", seq([lit("protocol"), field("name", tname), opt(r("generic_params")),
     lit("{"), opt(sep), opt(seq([r("method_sig"), rep(seq([sep, r("method_sig")])), opt(sep)])), lit("}")]))),
  ("method_sig", wrap("method_signature", seq([opt(lit("effect")), lit("fn"), field("name", r("fn_name")),
     opt(r("generic_params")), r("params"), lit("->"), field("return", ty)]))),

  ("top_let", wrap("let_declaration", seq([r("visibility"), lits(["let", "var"]), field("name", name),
     opt(seq([lit(":"), ty])), lit("="), nl, field("value", expr)]))),

  ("test_decl", wrap("test_declaration", seq([lit("test"), field("name", tok("string")),
     rep(seq([nl, r("where_clause")])), nl, field("body", block)]))),
  // `where [ "case" [a = 1, b = 2], ... ]` — a table of named cases
  ("where_table", seq([lit("where"), bracketed("[", seq([tok("string"), bracketed("[", r("where_cell"), "]")]), "]")])),
  ("where_cell", alt([seq([ident, bracketed("(", pattern, ")"), lit("=>"), nl, expr]), seq([ident, lit("="), nl, expr])])),
  ("where_clause", alt([r("where_table"), seq([lit("where"), alt([r("where_case"), r("where_binding")])])])),
  ("where_case", seq([tok("string"), lit("{"), opt(sep), rep(seq([opt(lit("where")), r("where_binding"), opt(sep)])), lit("}")])),
  ("where_binding", alt([
     seq([dotted, bracketed("(", pattern, ")"), lit("=>"), nl, expr]),
     seq([dotted, lit("="), nl, expr])])),
  ("test_where_def", wrap("test_environment", seq([opt(lits(["local", "mod"])), lit("test"), lit("where"), lit("{"), opt(sep),
     rep(seq([opt(lit("where")), r("where_binding"), opt(sep)])), lit("}")]))),

  // ── types ─────────────────────────────────────────────────────────────
  // `T?` optional, `T!` fallible, `T!E` fallible with a typed error
  ("type", seq([r("type_atom"), rep(alt([lit("?"), seq([lit("!"), opt(r("type_atom"))])]))])),
  ("type_atom", alt([
     // `fn(A) -> B`, `effect (A) -> B`, `(A) -> B`, `(A, B)` tuple, `()` unit
     seq([opt(lit("effect")), opt(lits(["fn", "Fn"])), bracketed("(", ty, ")"), opt(seq([lit("->"), nl, ty]))]),
     r("record_type"),
     wrap("type_name", seq([qualified_tname, opt(r("type_args"))])),
     tok("integer")])),
  ("type_args", bracketed("[", ty, "]")),

  // ── expressions: loosest to tightest ──────────────────────────────────
  ("expr", r("or_expr")),
  ("or_expr", leftf("binary", r("and_expr"), seq([nl, keep("or"), nl]))),
  ("and_expr", leftf("binary", r("cmp_expr"), seq([nl, keep("and"), nl]))),
  ("cmp_expr", leftf("binary", r("pipe_expr"), seq([nl, keeps(["==", "!=", "<=", ">=", "<", ">"]), nl]))),
  ("pipe_expr", leftf("pipe", r("range_expr"), seq([nl, keep("|>"), nl]))),
  ("range_expr", leftf("range", r("sum_expr"), keeps(["..<", "..."]))),
  ("sum_expr", leftf("binary", r("product_expr"), seq([nl, keeps(["+", "-"]), nl]))),
  ("product_expr", leftf("binary", r("power_expr"), seq([nl, keeps(["*", "/", "%"]), nl]))),
  ("power_expr", leftf("binary", r("compose_expr"), seq([nl, keeps(["^", "**"]), nl]))),
  ("compose_expr", leftf("binary", r("unary"), seq([nl, keep(">>"), nl]))),
  ("unary", alt([
     wrap("unary", seq([field("operator", keeps(["-", "not"])), r("unary")])),
     wrap("unary", seq([tok("neg"), r("unary")])),
     r("postfix")])),
  ("postfix", seq([r("primary"), rep(r("postfix_op"))])),
  ("postfix_op", alt([
     wrap("arguments", bracketed("(", r("arg"), ")")),
     wrap("type_arguments", seq([bracketed("[", ty, "]"), ahead(lit("("))])),
     wrap("index", seq([lit("["), nl, expr, nl, lit("]")])),
     wrap("field_access", seq([lit("."), field("field", alt([name, tok("integer"), tok("float")]))])),
     wrap("try", lit("!")),
     wrap("unwrap", lit("?")),
     wrap("optional_chain", seq([lit("?."), ident])),
     wrap("coalesce", seq([lit("??"), nl, r("unary")]))])),
  ("arg", alt([wrap("named_argument", seq([field("name", ident), lit(":"), nl, expr])), expr])),

  ("primary", alt([
     r("lambda"), r("if_let"), r("if"), r("match"), r("for"), r("while"), r("fan"),
     tok("integer"), tok("float"), tok("string"),
     wrap("boolean", lits(["true", "false"])),
     wrap("break", lit("break")), wrap("continue", lit("continue")),
     wrap("record", seq([qualified_tname, lit("{"), r("record_body"), lit("}")])),
     wrap("record", seq([lit("{"), ahead(r("record_start")), r("record_body"), lit("}")])),
     block,
     ident, tname,
     wrap("group", bracketed("(", seq([expr, opt(seq([lit(":"), ty]))]), ")")),
     r("collection")])),
  // `[a, b]`, `["k": v]`, `[]`, `[:]` — the first element is parsed once, then
  // the token after it decides list or map
  ("collection", seq([lit("["), nl, alt([
     wrap("map", seq([lit(":"), nl, lit("]"), opt(seq([lit(":"), ty]))])),
     wrap("list", seq([lit("]"), opt(seq([lit(":"), ty]))])),
     seq([expr, alt([
       wrap("map", seq([lit(":"), nl, expr, rep(seq([nl, lit(","), nl, r("map_entry")])), nl, opt(lit(",")), nl, lit("]")])),
       wrap("list", seq([rep(seq([nl, lit(","), nl, expr])), nl, opt(lit(",")), nl, lit("]")]))])])])])),
  ("map_entry", seq([expr, lit(":"), nl, expr])),
  ("record_start", alt([seq([name, lit(":")]), lit("..."), seq([name, lit(",")]), seq([name, lit("}")]), lit("}")])),
  ("record_body", seq([nl, opt(seq([lit("..."), nl, expr, nl, opt(lit(","))])), items(r("field_init")), nl])),
  ("field_init", wrap("field_init", seq([field("name", name), opt(seq([lit(":"), nl, expr]))]))),

  // statements normally sit on their own lines; the compiler also accepts two
  // on one line with no separator (`let m = n * 2 m + 1`), so the separator is optional
  ("block", wrap("block", seq([lit("{"), opt(sep), opt(seq([recover(r("stmt")), rep(recover(seq([opt(sep), r("stmt")]))), opt(sep)])), lit("}")]))),
  // an expression, or an assignment to one: parsed once, never re-parsed
  ("stmt", alt([r("let"), r("var"), r("guard"), r("expr_stmt")])),
  ("expr_stmt", seq([expr, opt(wrap("assignment", seq([lit("="), nl, field("value", expr)])))])),
  ("let", wrap("let", seq([lit("let"), alt([
       wrap("tuple_pattern", bracketed("(", r("tuple_pat"), ")")),
       wrap("record_pattern", bracketed("{", ident, "}")),
       field("name", name)]),
     opt(seq([lit(":"), ty])), lit("="), nl, field("value", expr)]))),
  ("tuple_pat", alt([bracketed("(", r("tuple_pat"), ")"), ident])),
  ("var", wrap("var", seq([lit("var"), field("name", name), opt(seq([lit(":"), ty])), lit("="), nl, field("value", expr)]))),
  ("guard", wrap("guard", seq([lit("guard"), opt(seq([lit("let"), ident, lit("=")])), expr, nl, lit("else"), nl, r("stmt")]))),

  ("if", wrap("if", seq([lit("if"), field("condition", expr), nl, lit("then"), nl, field("then", r("stmt")),
     opt(seq([nl, lit("else"), nl, field("else", r("stmt"))]))]))),
  ("if_let", wrap("if_let", seq([lit("if"), lit("let"), field("name", ident), lit("="), expr, nl, block, nl, lit("else"), nl, block]))),
  // `match x { … }`, or `|> match { … }` with the piped value
  ("match", wrap("match", seq([lit("match"), alt([ahead(lit("{")), field("value", expr)]), nl, lit("{"), opt(sep),
     rep(seq([r("arm"), opt(lit(",")), opt(sep)])), lit("}")]))),
  ("arm", wrap("match_arm", seq([field("pattern", pattern), rep(seq([lit("|"), pattern])), opt(seq([lit("if"), expr])),
     lit("=>"), nl, field("body", r("stmt"))]))),
  ("for", wrap("for", seq([lit("for"), alt([bracketed("(", ident, ")"), ident]), lit("in"), expr, nl, block]))),
  ("while", wrap("while", seq([lit("while"), expr, nl, block]))),
  // `fan { a b c }` runs juxtaposed expressions concurrently; `fan.map(...)` is the module
  // `fan.bounded(budget) { a b }` — a fan combinator with its trailing block
  ("fan", alt([
     wrap("fan", seq([lit("fan"), r("fan_block")])),
     wrap("fan", seq([lit("fan"), lit("."), field("name", ident), opt(wrap("arguments", bracketed("(", r("arg"), ")"))), opt(r("fan_block"))]))])),
  ("fan_block", wrap("block", seq([lit("{"), opt(sep), rep(seq([expr, opt(lit(",")), opt(sep)])), lit("}")]))),
  ("lambda", wrap("lambda", seq([bracketed("(", r("lparam"), ")"), lit("=>"), nl, field("body", expr)]))),
  ("lparam", alt([bracketed("(", ident, ")"), seq([ident, opt(seq([lit(":"), ty]))])])),

  // ── patterns ──────────────────────────────────────────────────────────
  ("pattern", alt([
     wrap("record_pattern", seq([qualified_tname, lit("{"), items(r("field_pat")), nl, opt(seq([lit(".."), opt(lit(","))])), nl, lit("}")])),
     wrap("constructor_pattern", seq([qualified_tname, opt(bracketed("(", pattern, ")"))])),
     wrap("tuple_pattern", bracketed("(", pattern, ")")),
     wrap("list_pattern", bracketed("[", pattern, "]")),
     seq([ident, opt(bracketed("(", pattern, ")"))]),
     tok("integer"), tok("float"), tok("string"),
     seq([alt([lit("-"), tok("neg")]), alt([tok("integer"), tok("float")])]),
     wrap("boolean", lits(["true", "false"]))])),
  ("field_pat", seq([name, opt(seq([lit(":"), pattern]))])),
])

// ── tests ──────────────────────────────────────────────────────────────
fn parse_src(src: String) -> Result[parser.Parsed, String] = {
  let toks = lex.tokenize(src, spec()) |> result.map_err((e) => "lex " + int.to_string(e.line) + ":" + int.to_string(e.col) + " " + e.message)!
  parser.parse(almide(), toks) |> result.map_err((f) => parser.format_failure(f))
}

fn top_kinds(src: String) -> List[String] = match parse_src(src) {
  ok(p) => list.map(p.root.kids, (k) => k.kind),
  err(e) => ["ERROR " + e],
}

// what a reader gets from a file that does not parse
fn recovered_kinds(src: String) -> List[String] = {
  let toks = lex.tokenize_recovering(src, spec())
  match parser.parse_recovering(parser.compile(almide()), toks) {
    ok(p) => list.map(p.root.kids, (k) => k.kind),
    err(_) => ["NOTHING"],
  }
}

test "declarations of every kind parse" {
  let src = "import self.tree\nimport std.io.{ read, write }\n\ntype P = { x: Int, y: Int }\ntype R = | A(Int) | B\n\nfn add(a: Int, b: Int) -> Int = a + b\neffect fn main() -> Unit = println(\"hi\")\nlet N = 3\nprotocol Show { fn show(self) -> String }\ntest \"t\" { assert_eq(1, 1) }\n"
  assert_eq(top_kinds(src), ["import", "import", "type_declaration", "type_declaration", "function_declaration", "function_declaration", "let_declaration", "protocol_declaration", "test_declaration"])
}

test "the tree carries names and bodies" {
  let p = parse_src("fn add(a: Int, b: Int) -> Int = a + b\n")!
  let f = list.first(p.root.kids)!
  assert_eq(f.kind, "function_declaration")
  assert_eq(option.map(tree.child(f, "name"), (n) => tree.leaf_text(n, p.toks)), some("add"))
  assert_eq(option.map(tree.child(f, "body"), (n) => tree.sexp(n)), some("body:(binary left:(identifier) operator:(op) right:(identifier))"))
}

test "blocks, statements, control flow, lambdas, records, maps" {
  let src = """
fn f(xs: List[Int]) -> Int = {
  var total = 0
  for x in xs { total = total + x }
  let (a, b) = (1, 2)
  let ys = xs |> list.map((x) => x * 2) |> list.filter((x) => x > 1)
  let m = ["a": 1, "b": 2]
  let e = [:]
  let p = Point { x: 1, y: 2 }
  let q = { ...p, x: 3 }
  match list.first(ys) {
    some(v) if v > 0 => total = total + v,
    some(_) | none => (),
  }
  if total > 3 then total
  else if total == 0 then -1
  else total
    + a
    - b
}
"""
  assert_eq(top_kinds(src), ["function_declaration"])
}

test "a broken file fails at the right place" {
  match parse_src("fn f() -> Int = {\n  let x = \n}\n") {
    ok(_) => assert(false),
    err(e) => assert(string.starts_with(e, "3:1")),
  }
  match parse_src("type T = { a: Int\n") {
    ok(_) => assert(false),
    err(e) => assert(string.starts_with(e, "2:1")),
  }
}

test "a broken declaration keeps its name and loses only its body" {
  let src = "fn alpha(x: Int) -> Int = x + 1\n\nfn beta(y: -> Int = y\n\nfn gamma(s: String) -> String = s\n"
  match parse_src(src) { ok(_) => assert(false), err(e) => assert(string.starts_with(e, "3:")) }
  // beta survives as a declaration with a name; what follows its name is the ERROR
  assert_eq(recovered_kinds(src), ["function_declaration", "function_declaration", "ERROR", "function_declaration"])
}

test "an unterminated string still gives up only the line it is on" {
  let src = "fn alpha() -> String = \"hello\n\nfn beta() -> Int = 2\n"
  assert_eq(result.is_err(lex.tokenize(src, spec())), true)
  assert_eq(list.contains(recovered_kinds(src), "function_declaration"), true)
}

test "a file that parses recovers to exactly the same tree" {
  let src = "fn alpha(x: Int) -> Int = x + 1\n"
  assert_eq(recovered_kinds(src), top_kinds(src))
}

// ── lexing ────────────────────────────────────────────────────────────────

test "words, keywords, numbers, operators" {
  let toks = lex.tokenize("fn add(x: Int) -> Int = x + 0x1F", spec())!
  assert_eq(lex.texts(toks), ["fn", "add", "(", "x", ":", "Int", ")", "->", "Int", "=", "x", "+", "0x1F", "", ""])
  assert_eq(lex.kinds(toks), ["keyword", "identifier", "punct", "identifier", "punct", "type_name", "punct", "punct", "type_name", "punct", "identifier", "punct", "integer", "newline", "eof"])
}

test "floats and ranges do not eat each other" {
  assert_eq(lex.texts(lex.tokenize("1.5 1..5 xs.0 2e3", spec())!), ["1.5", "1", "..", "5", "xs", ".", "0", "2e3", "", ""])
}

test "strings: escapes, interpolation with nested braces and quotes, heredoc, raw" {
  let toks = lex.tokenize("\"a\\\"b\" \"x \${ f({y: \"}\"}) } z\" \"\"\"\nmulti\n\"\"\" r\"\"\"raw \\ \"\"\" 'q'", spec())!
  assert_eq(lex.kinds(list.take(toks, 5)), ["string", "string", "string", "string", "string"])
  assert_eq(list.get(lex.texts(toks), 1), some("\"x \${ f({y: \"}\"}) } z\""))
}

test "an unterminated string is an error with a position" {
  assert_eq(result.is_err(lex.tokenize("let s = \"abc", spec())), true)
  match lex.tokenize("let s = \"abc", spec()) { err(e) => { assert_eq(e.line, 1); assert_eq(e.col, 9) }, ok(_) => assert(false) }
}

test "comments vanish, newlines collapse, `?` is always its own token, backtick names" {
  let toks = lex.tokenize("// c\nfn f() = 1 /* a /* b */ c */\n\n\nfn is_ok?(x: Int) -> Bool = x?\nlet `type` = 1\n", spec())!
  assert_eq(lex.texts(toks), ["fn", "f", "(", ")", "=", "1", "", "fn", "is_ok", "?", "(", "x", ":", "Int", ")", "->", "Bool", "=", "x", "?", "", "let", "`type`", "=", "1", "", ""])
  assert_eq(list.get(lex.kinds(toks), 22), some("identifier"))
}

test "line and column are 1-based and survive a heredoc" {
  let toks = lex.tokenize("a\n\"\"\"\nx\n\"\"\"\nb", spec())!
  let b = list.find(toks, (t) => t.text == "b")
  assert_eq(option.map(b, (t) => t.line), some(5))
  assert_eq(option.map(b, (t) => t.col), some(1))
}
