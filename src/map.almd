// map — a ranked map of a repository, sized to a token budget.
//
// Every file's definitions and references (tags.almd) become a graph:
// file A referencing a name that file B defines is an edge A → B, weighted
// by how often and by how distinctive the name is. PageRank over that graph,
// personalised toward files the task mentions, ranks the definitions; the
// best ones are rendered file by file until the budget is spent. This is
// the map an agent reads before it decides which files to open.

import fs
import self.tree
import self.tags
import self.lang

let MENTIONED_MUL = 10.0
let WELL_NAMED_MUL = 10.0
let PRIVATE_MUL = 0.1
let UBIQUITOUS_MUL = 0.1
let SELF_EDGE_WEIGHT = 0.1
let WELL_NAMED_MIN_LEN = 8
let UBIQUITOUS_DEF_COUNT = 5
let DAMPING = 0.85
let ITERATIONS = 60
let EPSILON = 0.000000001
let BUDGET_TOLERANCE = 0.15
let MAX_FILE_BYTES = 524288

// directories that are never part of the code an agent edits
let SKIP = [".git", "node_modules", "target", "dist", "build", ".next", "__pycache__", ".venv", "vendor", ".claude", "worktrees"]

type FileTags = { path: String, tags: List[tags.Tag] }
type Ranked = { path: String, name: String, kind: String, line: Int, rank: Float, referenced: Bool }
type Edge = { from: Int, to: Int, ident: String, weight: Float }
type Scan = { files: List[FileTags], errors: List[String] }

fn skipped(rel: String) -> Bool = list.any(string.split(rel, "/"), (seg) => list.contains(SKIP, seg))

// Every file under root the grammars know, in path order, with its tags. A
// file that does not parse is read as far as the grammar can and reported;
// leaving it out entirely would hide whatever an agent is halfway through
// editing, which is exactly the file it most wants on the map.
effect fn scan(root: String) -> Result[Scan, String] = {
  let all = fs.walk(root) |> result.map_err((e) => root + ": " + e)!
  var files: List[FileTags] = []
  var errors: List[String] = []
  // compiled once for the whole walk, not once per file
  let engines = lang.engines_for(all)
  for p in list.sort(all) {
    let rel = if string.starts_with(p, root + "/") then string.slice(p, string.len(root) + 1, string.len(p)) else p
    if lang.supports(p, "map") and not skipped(rel) then {
      let size = fs.file_size(p) ?? 0
      if size > MAX_FILE_BYTES then list.push(errors, rel + ": skipped, larger than 512 KB")
      else match fs.read_text(p) {
        err(e) => list.push(errors, rel + ": " + e),
        // a file that does not parse still contributes what it could be read
        // as; the reason is reported either way
        ok(src) => match lang.read_with(engines, rel, src) {
          err(e) => list.push(errors, e + " [skipped]"),
          ok(d) => {
            match d.error { some(e) => list.push(errors, e + " [recovered]"), none => () }
            list.push(files, FileTags { path: rel, tags: tags.of_tree(d.parsed.root, d.parsed.toks, bytes.from_string(src), d.parsed.names, d.sep, d.symbols) })
          },
        },
      }
    } else ()
  }
  ok(Scan { files: files, errors: errors })
}

fn is_well_named(ident: String) -> Bool =
  string.len(ident) >= WELL_NAMED_MIN_LEN and (string.contains(ident, "_") or string.contains(ident, "-")
    or (string.to_lower(ident) != ident and string.to_upper(ident) != ident))

fn pagerank(n: Int, edges: List[Edge], personal: List[Float]) -> List[Float] = {
  var out_sum: List[Float] = list.map(list.range(0, n), (_) => 0.0)
  for e in edges { out_sum = list.set(out_sum, e.from, (list.get(out_sum, e.from) ?? 0.0) + e.weight) }
  var score = personal
  var iter = 0
  var done = false
  while not done and iter < ITERATIONS {
    var next: List[Float] = list.map(list.range(0, n), (_) => 0.0)
    var dangling = 0.0
    var i = 0
    while i < n {
      if (list.get(out_sum, i) ?? 0.0) <= 0.0 then dangling = dangling + (list.get(score, i) ?? 0.0) else ()
      i = i + 1
    }
    for e in edges {
      let o = list.get(out_sum, e.from) ?? 0.0
      if o > 0.0 then next = list.set(next, e.to, (list.get(next, e.to) ?? 0.0) + (list.get(score, e.from) ?? 0.0) * e.weight / o) else ()
    }
    var delta = 0.0
    i = 0
    while i < n {
      let p = list.get(personal, i) ?? 0.0
      let v = DAMPING * ((list.get(next, i) ?? 0.0) + dangling * p) + (1.0 - DAMPING) * p
      delta = delta + float.abs(v - (list.get(score, i) ?? 0.0))
      next = list.set(next, i, v)
      i = i + 1
    }
    score = next
    if delta < EPSILON then done = true else ()
    iter = iter + 1
  }
  score
}

// A sortable key: referenced first, then rank descending, then path and name.
fn sort_key(r: Ranked) -> String = {
  let bucket = if r.referenced then "0" else "1"
  let inv = 1000000000 - float.to_int(r.rank * 1000000.0)
  bucket + string.pad_start(int.to_string(inv), 12, "0") + " " + r.path + " " + r.name
}

fn rank(files: List[FileTags], mentioned: List[String]) -> List[Ranked] = {
  var defines: Map[String, List[String]] = [:]
  var references: Map[String, Map[String, Int]] = [:]
  var def_tags: Map[String, tags.Tag] = [:]
  for f in files {
    for t in f.tags {
      // A definition is indexed under its bare name, because that is what a
      // call site writes; the tag kept beside it still carries the name with
      // its type, which is what the map prints.
      if t.role == "def" then {
        var ds = map.get(defines, t.base) ?? []
        if not list.contains(ds, f.path) then list.push(ds, f.path) else ()
        map.insert(defines, t.base, ds)
        let key = f.path + " " + t.base
        if not map.contains(def_tags, key) then map.insert(def_tags, key, t) else ()
      } else {
        var m = map.get(references, t.name) ?? [:]
        map.insert(m, f.path, (map.get(m, f.path) ?? 0) + 1)
        map.insert(references, t.name, m)
      }
    }
  }
  let paths = list.map(files, (f) => f.path)
  var index: Map[String, Int] = [:]
  var i = 0
  for p in paths { map.insert(index, p, i); i = i + 1 }
  var edges: List[Edge] = []
  for (ident, definers) in map.entries(defines) {
    var mul = 1.0
    if list.contains(mentioned, ident) then mul = mul * MENTIONED_MUL else ()
    if is_well_named(ident) then mul = mul * WELL_NAMED_MUL else ()
    if string.starts_with(ident, "_") then mul = mul * PRIVATE_MUL else ()
    if list.len(definers) > UBIQUITOUS_DEF_COUNT then mul = mul * UBIQUITOUS_MUL else ()
    let refs = list.filter(map.entries(map.get(references, ident) ?? [:]), (r) => not list.contains(definers, r.0))
    if list.is_empty(refs) then {
      for d in definers {
        match map.get(index, d) { some(k) => list.push(edges, Edge { from: k, to: k, ident: ident, weight: SELF_EDGE_WEIGHT }), none => () }
      }
    } else {
      for (referencer, count) in refs {
        for definer in definers {
          match (map.get(index, referencer), map.get(index, definer)) {
            (some(from), some(to)) => list.push(edges, Edge { from: from, to: to, ident: ident, weight: mul * float.sqrt(float.from_int(count)) }),
            _ => (),
          }
        }
      }
    }
  }
  let n = list.len(paths)
  let share = if n == 0 then 0.0 else 100.0 / float.from_int(n)
  var personal: List[Float] = list.map(paths, (p) => if list.any(mentioned, (m) => string.contains(p, m)) then share else 0.0)
  let total = list.fold(personal, 0.0, (a, b) => a + b)
  personal = if total > 0.0 then list.map(personal, (v) => v / total) else list.map(paths, (_) => 1.0 / float.from_int(int.max(1, n)))
  let scores = pagerank(n, edges, personal)
  var out_weight: List[Float] = list.map(paths, (_) => 0.0)
  for e in edges { out_weight = list.set(out_weight, e.from, (list.get(out_weight, e.from) ?? 0.0) + e.weight) }
  var ranked: Map[String, Float] = [:]
  var order: List[String] = []
  var referenced: List[String] = []
  for e in edges {
    let o = list.get(out_weight, e.from) ?? 0.0
    if o > 0.0 then {
      let key = (list.get(paths, e.to) ?? "") + " " + e.ident
      if not map.contains(ranked, key) then list.push(order, key) else ()
      map.insert(ranked, key, (map.get(ranked, key) ?? 0.0) + (list.get(scores, e.from) ?? 0.0) * e.weight / o)
      if e.from != e.to and not list.contains(referenced, key) then list.push(referenced, key) else ()
    } else ()
  }
  var out: List[Ranked] = []
  for key in order {
    match map.get(def_tags, key) {
      some(t) => list.push(out, Ranked { path: string.split(key, " ") |> list.first ?? "", name: t.name, kind: t.kind, line: t.line,
        rank: map.get(ranked, key) ?? 0.0, referenced: list.contains(referenced, key) }),
      none => (),
    }
  }
  list.sort_by(out, (r) => sort_key(r))
}

fn render(symbols: List[Ranked]) -> String = {
  var order: List[String] = []
  var by_file: Map[String, List[Ranked]] = [:]
  for s in symbols {
    if not map.contains(by_file, s.path) then list.push(order, s.path) else ()
    var group = map.get(by_file, s.path) ?? []
    list.push(group, s)
    map.insert(by_file, s.path, group)
  }
  var out = ""
  for path in order {
    let group = list.sort_by(map.get(by_file, path) ?? [], (s) => s.line)
    out = out + path + ":\n"
    for s in group { out = out + "  " + s.kind + " " + s.name + "\n" }
  }
  out
}

fn approx_tokens(s: String) -> Int = (string.len(s) + 3) / 4

// The longest prefix of the ranking that renders within `budget` tokens
// (binary search; a render within 15% of the budget is accepted as is).
fn fit_to_budget(ranked: List[Ranked], budget: Int) -> (String, Int) = {
  if list.is_empty(ranked) or budget == 0 then ("", 0)
  else {
    var lower = 0
    var upper = list.len(ranked)
    var middle = int.min(int.max(budget / 25, 1), list.len(ranked))
    var best = ""
    var best_n = 0
    var best_tokens = 0
    var done = false
    while not done and lower <= upper {
      let text = render(list.take(ranked, middle))
      let tokens = approx_tokens(text)
      let pct_err = float.abs(float.from_int(tokens - budget)) / float.from_int(budget)
      if (tokens <= budget and tokens > best_tokens) or pct_err < BUDGET_TOLERANCE then {
        best = text
        best_tokens = tokens
        best_n = middle
        if pct_err < BUDGET_TOLERANCE then done = true else ()
      } else ()
      if not done then {
        if tokens < budget then lower = middle + 1
        else if middle == 0 then done = true
        else upper = middle - 1
        if lower > upper then done = true else ()
        middle = (lower + upper) / 2
        if middle == 0 then done = true else ()
      } else ()
    }
    (best, best_n)
  }
}

// strip `.`, `/` and `-` from both ends
fn trim_edges(s: String) -> String = {
  var bs = string.to_bytes(s)
  while list.len(bs) > 0 and list.contains([46, 47, 45], list.first(bs) ?? 0) { bs = list.drop(bs, 1) }
  while list.len(bs) > 0 and list.contains([46, 47, 45], list.last(bs) ?? 0) { bs = list.take(bs, list.len(bs) - 1) }
  string.from_bytes(bs)
}

// Identifiers and path fragments in the task text: the only signal about
// what matters this time. `src/solve.ts` yields both itself and `solve`.
fn mentions_in(task: String) -> List[String] = {
  var out: List[String] = []
  var cur: List[Int] = []
  let bytes = string.to_bytes(task) + [32]
  for b in bytes {
    let word_byte = (b >= 48 and b <= 57) or (b >= 65 and b <= 90) or (b >= 97 and b <= 122) or b == 95 or b == 46 or b == 47 or b == 45 or b >= 128
    if word_byte then list.push(cur, b)
    else {
      if not list.is_empty(cur) then {
        let w = trim_edges(string.from_bytes(cur))
        let has_alpha = list.any(string.to_bytes(w), (c) => (c >= 65 and c <= 90) or (c >= 97 and c <= 122))
        if string.len(w) >= 3 and has_alpha then {
          if not list.contains(out, w) then list.push(out, w) else ()
          let last = list.last(string.split(w, "/")) ?? ""
          let stem = list.first(string.split(last, ".")) ?? ""
          if string.len(stem) >= 3 and stem != w and not list.contains(out, stem) then list.push(out, stem) else ()
        } else ()
      } else ()
      cur = []
    }
  }
  list.sort(out)
}

type Map = { text: String, files_scanned: Int, symbols_total: Int, symbols_shown: Int, approx_tokens: Int, errors: List[String] }

fn build(scan: Scan, task: String, budget: Int) -> Map = {
  let total = list.sum(list.map(scan.files, (f) => list.len(list.filter(f.tags, (t) => t.role == "def"))))
  let ranked = rank(scan.files, mentions_in(task))
  let (text, shown) = fit_to_budget(ranked, budget)
  Map { text: text, files_scanned: list.len(scan.files), symbols_total: total, symbols_shown: shown, approx_tokens: approx_tokens(text), errors: scan.errors }
}

test "mentions: identifiers, paths and their stems" {
  assert_eq(mentions_in("fix parse_rule in src/parser.almd, see #12"), ["fix", "parse_rule", "parser", "see", "src/parser.almd"])
}

test "a reference across files ranks the definition, and the budget bounds the text" {
  let a = FileTags { path: "a.almd", tags: [tags.Tag { role: "def", kind: "function", name: "compute_total", base: "compute_total", line: 3, end_line: 9 }] }
  let b = FileTags { path: "b.almd", tags: [tags.Tag { role: "ref", kind: "call", name: "compute_total", base: "compute_total", line: 1, end_line: 0 },
                                            tags.Tag { role: "def", kind: "function", name: "main", base: "main", line: 1, end_line: 2 }] }
  let ranked = rank([a, b], [])
  assert_eq(option.map(list.first(ranked), (r) => r.name), some("compute_total"))
  // a method is joined to its call sites on the bare name and shown with its type
  let c = FileTags { path: "c.rs", tags: [tags.Tag { role: "def", kind: "method", name: "Db::open", base: "open", line: 2, end_line: 4 }] }
  let d = FileTags { path: "d.rs", tags: [tags.Tag { role: "ref", kind: "call", name: "open", base: "open", line: 1, end_line: 0 }] }
  assert_eq(option.map(list.first(rank([c, d], [])), (r) => r.name), some("Db::open"))
  assert_eq(option.map(list.first(ranked), (r) => r.referenced), some(true))
  let (text, shown) = fit_to_budget(ranked, 100)
  assert_eq(shown, 2)
  assert(string.starts_with(text, "a.almd:\n  function compute_total\n"))
}
